;;-*-Lisp-*-
(in-package goal)

#|

  mods-menu.gc -- Unified "Mods" menu for the Jak 3 PC port.

  GOAL / Circuit 1 (logic & skeletons).

  ------------------------------------------------------------------------------
  WHY THIS FILE EXISTS
  ------------------------------------------------------------------------------
  Every mod branch wants to expose a few toggles (spawn a variant, switch a
  faction, force a state, ...). If each branch edits `default-menu-pc.gc` or
  `progress-static-pc.gc` directly, two things go wrong:
    1. Symbol / menu-node collisions between branches (two mods both add a
       "Mods" submenu, or both name a pick-func `dm-toggle`).
    2. Constant merge conflicts on the shared menu files whenever branches are
       rebased on `master-dev`.

  This file installs ONE popup menu -- opened in-game with L3 + SELECT -- and a
  tiny runtime registry. A mod never edits this file: it calls
  `(mods-menu-register "<slug>" builder)` from its own already-compiled `.gc`
  file. The registry rebuilds the live menu, sorted by label, so branch merge
  order never changes what the player sees.

  ------------------------------------------------------------------------------
  WHY *NOT* THE DEBUG MENU (this file used to be `pc/debug/mods-menu.gc`)
  ------------------------------------------------------------------------------
  The OpenGOAL launcher boots the game with `-boot`, which sets both
  `MasterDebug` and `DebugSegment` to 0 (see `game/kernel/jak3/kmachine.cpp`).
  That has three consequences, each one fatal on its own:
    * Any file marked `(declare-file (debug))` is NOT linked at all --
      `klink.cpp` skips the DEBUG segment entirely.
    * `kdebugheap` is set to NULL, so the whole `debug-menu` framework (which
      allocates its nodes with `(new 'debug ...)`) has no heap to live on.
    * `main.gc` gates the L3+SELECT debug-menu gesture behind `*debug-segment*`,
      so the menu could never be opened even if it were linked.
  In other words a player launching a mod normally could never reach a toggle
  that lived in `Debug > Mods`. This file therefore builds on `popup-menu`
  (`pc/util/popup-menu.gc`), which is plain non-debug code that ships in
  `GAME.CGO` and is already used by speedrunner mode.

  ------------------------------------------------------------------------------
  RESULTING HIERARCHY
  ------------------------------------------------------------------------------
    [L3 + SELECT] > Mods > [mod-slug] > [variant / sub-module] > [options]
                         > Misc options > Weather (always last, see below)

  Example (branch jak3/features/spargus-invasion):
    Mods > spargus-invasion > blueguard-waves > [Enable / Disable]

  ------------------------------------------------------------------------------
  PUBLIC API (call these from your mod file, nothing else)
  ------------------------------------------------------------------------------
    (mods-menu-register (name string) (builder (function popup-menu-entry)))
        Register (or, on hot-reload, replace) one mod's submenu. `builder` takes
        no argument and must return a `popup-menu-entry` -- normally a
        `popup-menu-submenu` holding your own entries. Returning `#f` hides the
        mod (useful for a toggle that does not apply to the current level).

    (mods-menu-rebuild)
        Force a rebuild of the live menu from the registry. Rarely needed by
        hand -- `mods-menu-register` already calls it, and so does every open.

  See the copy-paste template in
  docs/modding/templates/mod_menu.template.gc and the full write-up in
  docs/modding/guides/mods_menu.md

  ------------------------------------------------------------------------------
  CONTROLS (handled by popup-menu.gc, listed here for convenience)
  ------------------------------------------------------------------------------
    L3 + SELECT  open / close          UP / DOWN    move by 1
    X            confirm / enter       LEFT / RIGHT move by 5
    CIRCLE       back (exit at root)   SELECT       close from anywhere

|#

;; NOTE: deliberately NO `(declare-file (debug))`. This file must survive a
;; retail boot -- that is the entire point of it. Do not add one.

;; `*pc-dead-pool*` lives in pckernel.gc, which links AFTER this file. It is
;; only referenced at runtime, so a forward declaration is enough (same trick
;; as pc/features/speedruns.gc).
(define-extern *pc-dead-pool* dead-pool)

;; How many mods can show up in the root menu at once. Bumping this only costs
;; 4 bytes per slot, but popup-menu paginates at 15 rows so keep it sane.
(defconstant MODS_MENU_MAX_ENTRIES 32)

;; ============================================================================
;; Registry type
;; ============================================================================

(deftype mod-menu-entry (basic)
  ((name     string)                            ;; label shown in "Mods" (use the mod slug)
   (builder  (function popup-menu-entry))       ;; returns this mod's submenu entry
   )
  (:methods
    (new (symbol type string (function popup-menu-entry)) _type_)
    )
  )

(defmethod new mod-menu-entry ((allocation symbol)
                               (type-to-make type)
                               (name string)
                               (builder (function popup-menu-entry))
                               )
  "Allocate a registry entry. `allocation` should be 'global -- unlike the old
   debug-menu version we can NOT use the debug heap, it does not exist in a
   retail boot."
  (let ((obj (object-new allocation type-to-make (the-as int (-> type-to-make size)))))
    (set! (-> obj name) name)
    (set! (-> obj builder) builder)
    obj
    )
  )

;; ============================================================================
;; State
;; ============================================================================

;; All registered mod entries: a plain list whose cars are `mod-menu-entry`,
;; kept sorted by name on every rebuild.
;; NOTE: a hot-reload of THIS file resets the registry -- re-run (mi) (which
;; re-runs every mod's top-level register call) or reboot to repopulate.
;; Reloading a mod file on its own is always safe.
(define *mods-menu-entries* (the-as pair '()))

;; The live root entry array handed to the popup menu. Allocated ONCE, then
;; refilled in place on every rebuild, so opening the menu never allocates.
(define *mods-menu-items* (new 'global 'boxed-array popup-menu-entry MODS_MENU_MAX_ENTRIES))

;; The popup-menu process, spawned lazily the first time the menu is opened.
(define *mods-popup-menu* (the-as (pointer popup-menu) #f))

;; Buttons that open/close the menu, as a `pad-buttons` bitfield.
;; L3+SELECT mirrors the original debug-menu gesture and is inert in a retail
;; boot (main.gc gates that gesture behind *debug-segment*), so it cannot
;; collide with anything the player does normally. It is also distinct from
;; speedrunner mode's L1+R1+SELECT / L1+R1+START.
;; A mod may override this at load time, e.g.
;;   (set! *mods-menu-bind* (pad-buttons l1 r1 triangle))
(define *mods-menu-bind* (pad-buttons l3 select))

;; #t while WE own the popup menu (as opposed to the speedrunner menu).
(define *mods-menu-open?* #f)

;; Edge detection for the keybind: set while the combo is still held down, so
;; holding it does not toggle the menu once per frame.
(define *mods-menu-bind-consumed?* #f)

;; ============================================================================
;; Misc options: settings of the whole game, not of one mod
;; ============================================================================

;; The weather picked in Misc options > Weather, in every level (Jak 2 and Jak 3
;; share the weather system of engine/gfx/mood/mood.gc: clouds and fog drift
;; towards random targets, it rains when both are high, it snows when the snow
;; setting is on):
;;   0  changing: the game's own weather, untouched. The default.
;;   1  sunny, 2 cloudy, 3 foggy, 4 light rain, 5 rain, 6 thunderstorm, 7 snow:
;;      fixed, held every frame by mods-menu-weather-update, so nothing the game
;;      does (a level's, a mission's weather) takes it over.
;; Not saved: every boot starts on 0. From the Haven City: New Dawn mod.
(define *mods-menu-weather* 0)

;; the weather held on the last frame the game ran (-1: none yet)
(define *mods-menu-weather-held* -1)

;; clouds, fog and snow of the fixed weathers (index: 3 * (weather - 1)). The
;; rain comes from the clouds and the fog: min(0.75, 4 (cloud - 0.5) (fog - 0.5)).
(define *mods-menu-weather-presets* (new 'static 'boxed-array :type float
                                      ;; cloud fog snow
                                      0.0 0.0 0.0   ;; sunny
                                      0.75 0.4 0.0  ;; cloudy
                                      0.4 1.0 0.0   ;; foggy
                                      0.75 0.75 0.0 ;; light rain (0.25)
                                      0.9 0.9 0.0   ;; rain (0.64)
                                      1.0 1.0 0.0   ;; thunderstorm (0.75, the most)
                                      1.0 0.5 1.0   ;; snow (no rain)
                                      )
        )

(defun mods-menu-weather-update ()
  "Hold the weather of *mods-menu-weather*. Called by mods-menu-update on every
   frame the game runs (not while it is paused: the particles stand still then,
   and rain switched off would leave its drops hanging under the new sky).
   A fixed weather overrides the mood's clouds and fog and sets the snow; back
   to 0, the sky starts from the fixed weather's and the game draws its own
   again (set-time-for-random-weather!). Nothing happens while 0 stays picked."
  (let ((ctrl *mood-control*)
        (weather *mods-menu-weather*)
        )
    (cond
      ((> weather 0)
       (let ((i (* 3 (+ weather -1))))
         (set! (-> ctrl overide cloud) (-> *mods-menu-weather-presets* i))
         (set! (-> ctrl overide fog) (-> *mods-menu-weather-presets* (+ i 1)))
         (set! (-> ctrl overide-weather-flag) #t)
         (set! (-> *setting-control* user-default snow) (-> *mods-menu-weather-presets* (+ i 2)))
         )
       )
      ((> *mods-menu-weather-held* 0)
       ;; back to the changing weather, from the fixed one's sky
       (set! (-> ctrl current-interp cloud) (-> ctrl overide cloud))
       (set! (-> ctrl current-interp fog) (-> ctrl overide fog))
       (set! (-> ctrl target-interp cloud) (-> ctrl overide cloud))
       (set! (-> ctrl target-interp fog) (-> ctrl overide fog))
       (set-time-for-random-weather! ctrl 900.0 900.0)
       (set! (-> ctrl overide-weather-flag) #f)
       (set! (-> *setting-control* user-default snow) 0.0)
       )
      )
    (set! *mods-menu-weather-held* weather)
    )
  (none)
  )

(defmacro mods-menu-weather-flag (label weather)
  "A choice of Misc options > Weather: checked while it is the weather picked."
  `(new 'static 'popup-menu-flag :label ,label
        :is-toggled? (lambda () (= *mods-menu-weather* ,weather))
        :on-confirm (lambda () (set! *mods-menu-weather* ,weather) (none))
        )
  )

;; The root menu's last row, after the mods: options of the whole game.
(define *mods-menu-misc-entry*
  (new 'static 'popup-menu-submenu :label "Misc options"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-submenu :label "Weather"
        :entries (new 'static 'boxed-array :type popup-menu-entry
          (mods-menu-weather-flag "Changing (the game's weather)" 0)
          (mods-menu-weather-flag "Sunny" 1)
          (mods-menu-weather-flag "Cloudy" 2)
          (mods-menu-weather-flag "Foggy" 3)
          (mods-menu-weather-flag "Light rain" 4)
          (mods-menu-weather-flag "Rain" 5)
          (mods-menu-weather-flag "Thunderstorm" 6)
          (mods-menu-weather-flag "Snow" 7)
          )
        )
      )
    )
  )

;; ============================================================================
;; Rebuild
;; ============================================================================

(defun mods-menu-count ()
  "How many mods are currently registered. Walks the registry list; only ever
   called from the console, never per-frame."
  (let ((n 0)
        (iter *mods-menu-entries*)
        )
    (while (not (null? iter))
      (+! n 1)
      (set! iter (cdr iter))
      )
    n
    )
  )

(defun mods-menu-rebuild ()
  "Refill the live root entry array from the registry, sorted by label, then
   Misc options.
   Allocation-free: only the (already allocated) array's contents and length
   change. Runs on register and on every open, never per-frame."
  ;; stable, merge-proof ordering: sort registered mods alphabetically by slug
  (when (pair? *mods-menu-entries*)
    (set! *mods-menu-entries*
          (the-as pair
                  (sort *mods-menu-entries*
                        (lambda ((a mod-menu-entry) (b mod-menu-entry))
                          (string<=? (-> a name) (-> b name))
                          )
                        )
                  )
          )
    )
  (let ((n 0)
        (iter *mods-menu-entries*)
        )
    (while (not (null? iter))
      (when (< n MODS_MENU_MAX_ENTRIES)
        ;; a builder may return #f to opt out of showing up right now
        (let ((node ((-> (the-as mod-menu-entry (car iter)) builder))))
          (when node
            (set! (-> *mods-menu-items* n) node)
            (+! n 1)
            )
          )
        )
      (set! iter (cdr iter))
      )
    ;; Misc options always last (so the root menu is never empty either)
    (set! (-> *mods-menu-items* (min n (+ MODS_MENU_MAX_ENTRIES -1))) *mods-menu-misc-entry*)
    (set! (-> *mods-menu-items* length) (min (+ n 1) MODS_MENU_MAX_ENTRIES))
    )
  (none)
  )

;; ============================================================================
;; Register (public)
;; ============================================================================

(defun mods-menu-register ((name string) (builder (function popup-menu-entry)))
  "Register a mod's submenu builder under the in-game Mods menu.
     name    : menu label -- use your branch mod slug (e.g. \"crimson-blueguard\").
     builder : (function popup-menu-entry). Called on every rebuild; must be
               idempotent and allocation-light. Return a submenu entry (normally
               a static `popup-menu-submenu`) or #f to hide the mod for now.
   Hot-reload safe: calling again with the same `name` replaces the builder in
   place instead of adding a duplicate row."
  (let ((found #f)
        (iter *mods-menu-entries*)
        )
    (while (not (null? iter))
      (when (string= (-> (the-as mod-menu-entry (car iter)) name) name)
        (set! (-> (the-as mod-menu-entry (car iter)) builder) builder)
        (set! found #t)
        )
      (set! iter (cdr iter))
      )
    (when (not found)
      ;; global heap: this must outlive everything, and the debug heap may be NULL
      (set! *mods-menu-entries*
            (the-as pair (cons (new 'global 'mod-menu-entry name builder) *mods-menu-entries*))
            )
      )
    )
  (mods-menu-rebuild)
  (none)
  )

;; ============================================================================
;; Spawn / open / close
;; ============================================================================

(defun mods-menu-spawn! ()
  "Create the popup-menu process. Called from `mods-menu-update`, never from
   `mods-menu-open!`.

   THIS SEPARATION IS LOAD-BEARING. `process-spawn` does not run the init
   behaviour immediately: the process has no state installed until the kernel
   dispatches it, which happens on the NEXT frame. `send-event-function` on a
   stateless process silently does nothing, so spawning and opening in the same
   frame loses the 'open-menu event and the menu never appears.

   (jak3 spawns via the `-by-other` convention: `process-spawn` with no `:init`
   calls `popup-menu-init-by-other`.)"
  (when (not *mods-popup-menu*)
    (mods-menu-rebuild)
    (set! *mods-popup-menu*
          (the-as (pointer popup-menu)
                  (process-spawn popup-menu
                                 "Mods" *mods-menu-items*
                                 :from *pc-dead-pool*
                                 :to *pc-pool*
                                 )
                  )
          )
    )
  (none)
  )

(defun mods-menu-close! ()
  "Close the menu and hand control back to the game."
  (false! *mods-menu-open?*)
  (when *mods-popup-menu*
    (send-event (ppointer->process *mods-popup-menu*) 'close-menu)
    )
  ;; NOTE: unlike jak2, jak3's `popup-menu-event-handler` calls `set-master-mode`
  ;; itself on 'open-menu / 'close-menu, so we must NOT do it here -- doing it
  ;; twice fights the handler.
  (none)
  )

(defun mods-menu-open! ()
  "Refresh the menu contents and open it. Assumes the process already exists."
  ;; only one popup menu can be on screen at a time (`*popup-menu-open*` is a
  ;; single global shared with speedrunner mode) -- never steal it.
  (when (and *mods-popup-menu* (not *popup-menu-open*))
    (mods-menu-rebuild)
    ;; always reopen at the root: the entry array may have been rebuilt under
    ;; a stale nested menu-state, which would then index the wrong nodes.
    (let ((menu (the-as popup-menu (ppointer->process *mods-popup-menu*))))
      (set! (-> menu curr-state-index) 0)
      (set! (-> menu menu-states 0 title) "Mods")
      (set! (-> menu menu-states 0 entries) *mods-menu-items*)
      (set! (-> menu menu-states 0 entry-index) 0)
      (false! (-> menu menu-states 0 dynamic-menu?))
      )
    (true! *mods-menu-open?*)
    ;; jak3's handler sets the master mode to 'menu for us.
    (send-event (ppointer->process *mods-popup-menu*) 'open-menu)
    )
  (none)
  )

;; ============================================================================
;; Per-frame update -- installed into *mods-menu-hook*, called from main.gc
;; ============================================================================

(defun mods-menu-update ()
  "Poll the keybind, keep the master mode in sync and tick the popup menu.
   Called once per frame from `main.gc`'s menu-hook block, which is the only
   place in the main loop that still runs while the game is frozen in 'menu
   master mode."
  ;; --- keybind edge detection -----------------------------------------------
  (cond
    ;; combo not fully held: re-arm
    ((!= (logand (cpad-hold 0) *mods-menu-bind*) *mods-menu-bind*)
     (false! *mods-menu-bind-consumed?*)
     )
    ;; combo held and not yet consumed: toggle.
    ;; Opening during a blackout is known to misbehave (same guard as
    ;; speedrunner mode), so just swallow the press. `*mods-popup-menu*` is
    ;; guaranteed to have been spawned on an earlier frame (see below).
    ((and (not *mods-menu-bind-consumed?*)
          *mods-popup-menu*
          (< (-> *game-info* blackout-time) (current-time))
          )
     (true! *mods-menu-bind-consumed?*)
     (if *mods-menu-open?*
       (mods-menu-close!)
       (mods-menu-open!)
       )
     ;; don't let the rest of the frame see the combo (SELECT would reach the
     ;; pause code, L3 the speedrun practice-reset code, ...)
     (logclear! (cpad-hold 0) *mods-menu-bind*)
     (logclear! (cpad-pressed 0) *mods-menu-bind*)
     )
    )
  ;; --- the popup can close itself (SELECT, or CIRCLE at the root) -----------
  ;; jak3's handler already restored the master mode; just drop our ownership
  ;; flag so the next press of the bind opens instead of closing.
  (when (and *mods-menu-open?* (not *popup-menu-open*))
    (false! *mods-menu-open?*)
    )
  ;; --- NO tick here ---------------------------------------------------------
  ;; Unlike jak2, jak3's popup-menu drives itself: `popup-menu-init-by-other`
  ;; clears the `menu` and `pause` bits from its process mask, so its `idle`
  ;; state keeps running while the game is frozen and its `:trans` calls
  ;; `update-menu!`. Calling update-menu! from here as well would read the pad
  ;; and draw the menu twice per frame.
  ;; --- Misc options > Weather, held on every frame the game runs -------------
  (if (not (paused?))
      (mods-menu-weather-update)
      )
  ;; --- lazy spawn, deliberately LAST ---------------------------------------
  ;; Doing it here guarantees a spawn and an open never happen on the same
  ;; frame (see `mods-menu-spawn!`), and costs nothing until the game is
  ;; actually running.
  (when (and (not *mods-popup-menu*)
             (< (-> *game-info* blackout-time) (current-time))
             )
    (mods-menu-spawn!)
    )
  (none)
  )

;; Install the per-frame hook. `*mods-menu-hook*` is declared in main-h.gc and
;; called from main.gc; going through a symbol keeps main.gc's diff to a single
;; line that never has to change again.
(set! *mods-menu-hook* mods-menu-update)
