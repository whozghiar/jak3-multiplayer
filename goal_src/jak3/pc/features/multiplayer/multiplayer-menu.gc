;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer-menu.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- menus:
;;   - Title screen: Host Game (a new game or a save) and Join Game (an address), both leading to the
;;     lobby where the players choose their character, the host the game mode, and the host starts
;;     once every guest is ready (after himstan's Jak and Daxter II Multiplayer, see below).
;;   - START > Options > Multiplayer: name, character, color, server address, host / join /
;;     disconnect, and the Server administration page while hosting (kick, ban, teleports, cheat
;;     permission, time-of-day sharing, stop). The entry only exists while the mod is enabled.
;;   - Mods menu (L3 + SELECT) > multiplayer: the on/off toggle, the cheats, the teleports.
;; The start menu ring has exactly ten slots (36 degrees each, matching its 3D model), so the
;; Multiplayer page hangs off the Options page instead, which is a plain list.

;; ------------------------------------------------------------------------------------------------
;; Players listed in menus (connected remote players, in slot order)
;; ------------------------------------------------------------------------------------------------

(defun mp-player-count ()
  "Number of remote players connected."
  (let ((n 0))
    (dotimes (i MP_MAX_PLAYERS)
      (if (-> *mp-players* valid i)
          (+! n 1)
          )
      )
    n
    )
  )

(defun mp-nth-player-slot ((n int))
  "Slot of the n-th connected remote player, or -1."
  (dotimes (i MP_MAX_PLAYERS)
    (when (-> *mp-players* valid i)
      (if (zero? n)
          (return i)
          )
      (+! n -1)
      )
    )
  -1
  )

(defun mp-player-label ((n int) (dst string))
  "Name of the n-th connected remote player, into `dst`."
  (let ((slot (mp-nth-player-slot n)))
    (if (>= slot 0)
        (string<-charp dst (-> *mp-players* state slot name))
        (clear dst)
        )
    )
  (none)
  )

(define *mp-menu-label* (new 'global 'string 64 (the-as string #f)))

(defun mp-status-text ()
  "One line describing the session, for the menus."
  (let ((players (+ 1 (mp-player-count))))
    (case *mp-mode*
      (((mp-mode host))
       (format (clear *mp-menu-label*) "Hosting: ~D player(s)" players)
       )
      (((mp-mode client))
       (format (clear *mp-menu-label*) "Connected: ~D player(s)" players)
       )
      (((mp-mode connecting))
       (format (clear *mp-menu-label*) "Connecting to ~S..." *mp-address*)
       )
      (else
        (pc-mp-message *mp-status*)
        (if (zero? (length *mp-status*))
            (format (clear *mp-menu-label*) "Offline")
            (format (clear *mp-menu-label*) "Offline: ~S" *mp-status*)
            )
        )
      )
    )
  *mp-menu-label*
  )

;; ------------------------------------------------------------------------------------------------
;; Start menu: a read-only line, and a text field edited with the D-pad
;; ------------------------------------------------------------------------------------------------

;; A grayed line whose text comes from a function (the session status).
(deftype menu-mp-label-option (menu-generic-option)
  ((get-label (function string))
   )
  )

(defmethod draw-option ((this menu-mp-label-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "Draw the current text of the line."
  ;; a static object's symbol fields start at 0, not #f (same test as the stock pages)
  (when (or (zero? (-> this mounted?)) (not (-> this mounted?)))
    (on-mount! this)
    )
  (draw-generic-simple-string-option this progress font-ctx option-index ((-> this get-label)))
  (none)
  )

(defmethod respond-progress ((this menu-mp-label-option) (progress progress) (selected? symbol))
  "Read-only."
  0
  )

;; A text field (player name, server address): its label, then its value. Confirming it opens the
;; on-screen keyboard page (mp-keyboard, below), which edits the value. A link for the scrolling
;; page: it opens a page instead of taking the next presses.
(deftype menu-mp-text-option (menu-generic-link-option)
  ((get-value  (function string)) ;; the string this field edits
   (layout     int32)             ;; keyboard layout: 0 name (letters, digits, - _ . !), 1 address
   (max-length int32)
   (on-confirm (function none))   ;; called after a confirmed edit
   )
  )

(define-extern mp-keyboard-open (function menu-mp-text-option progress none)) ;; below

(defmethod on-mount! ((this menu-mp-text-option))
  "Nothing to set up."
  (set! (-> this mounted?) #t)
  (none)
  )

(defun mp-text-trim! ((str string))
  "Remove trailing spaces."
  (let ((i (+ (length str) -1)))
    (while (and (>= i 0) (= (-> str data i) 32))
      (set! (-> str data i) (the-as uint 0))
      (+! i -1)
      )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-text-option) (progress progress) (selected? symbol))
  "Confirm opens the keyboard on this field's value."
  (when (and selected? (cpad-pressed? 0 confirm))
    (cpad-clear! 0 confirm)
    (sound-play "window-expand")
    (mp-keyboard-open this progress)
    (set! (-> progress selected-option) #f)
    )
  0
  )

(defmethod draw-option ((this menu-mp-text-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "Label on the first line, value on the second."
  ;; a static object's symbol fields start at 0, not #f (same test as the stock pages)
  (when (or (zero? (-> this mounted?)) (not (-> this mounted?)))
    (on-mount! this)
    )
  (let ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition))))))
    (set! (-> font-ctx alpha) alpha)
    (set-flags! font-ctx (font-flags kerning middle large))
    (set-scale! font-ctx FONT_SIZE_OPTION)
    (+! (-> font-ctx origin y) (if (= (get-aspect-ratio) 'aspect4x3)
                                   7.0
                                   5.0
                                   )
        )
    (cond
      ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
       (set-color! font-ctx (font-color font-color-33))
       (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE alpha)
       )
      (else
        (set-color! font-ctx (font-color font-color-32))
        )
      )
    (print-game-text (lookup-text! *common-text* (-> this name) #f) font-ctx #f 44 (bucket-id hud-draw-hud-alpha))
    (+! (-> font-ctx origin y) 18.0)
    (set-scale! font-ctx FONT_SIZE_OPTION_EXTRA)
    (format (clear *progress-generic-temp-string*) "~S" ((-> this get-value)))
    (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id hud-draw-hud-alpha))
    )
  (none)
  )

;; A yes / no confirmation that only acts on yes. The stock menu-generic-confirm-option calls its
;; action on confirm whatever the choice (pc/progress/progress-generic-pc.gc).
(deftype menu-mp-confirm-option (menu-generic-confirm-option)
  ()
  )

(defmethod call-on-confirm ((this menu-mp-confirm-option))
  "Run the action only when the player chose yes."
  (when (and (-> this confirmed?) (nonzero? (-> this on-confirm)) (-> this on-confirm))
    (set! (-> this confirmed?) #f)
    ((-> this on-confirm))
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Administration (host)
;; ------------------------------------------------------------------------------------------------

;; Player chosen in the administration page, -1 for none.
(define *mp-admin-slot* -1)

(defun mp-admin-index ()
  "Position of the chosen player in the carousel."
  (let ((n 0))
    (dotimes (i MP_MAX_PLAYERS)
      (when (-> *mp-players* valid i)
        (if (= i *mp-admin-slot*)
            (return n)
            )
        (+! n 1)
        )
      )
    )
  0
  )

(defun mp-admin-no-player? ()
  "#t when no connected player is chosen."
  (not (mp-remote-state *mp-admin-slot*))
  )

(defun mp-admin-kick ((ban symbol))
  "Disconnect the chosen player (and refuse its address until the server stops, with `ban`)."
  (when (mp-remote-state *mp-admin-slot*)
    (string<-charp *mp-temp-string* (-> *mp-players* state *mp-admin-slot* name))
    (format (clear *mp-message*) (if ban "~S was banned" "~S was kicked") *mp-temp-string*)
    (set! (-> *mp-globals* message-time) (mp-now))
    (pc-mp-kick *mp-admin-slot* ban)
    (set! *mp-admin-slot* -1)
    )
  (none)
  )

(defun mp-admin-bring ((all? symbol))
  "Teleport the chosen player (or everyone) to the host."
  (when (or all? (mp-remote-state *mp-admin-slot*))
    (mp-send-event (mp-event-kind teleport) (if all? -1 *mp-admin-slot*) *mp-local-slot* 0.0)
    (mp-show-message "Teleport sent")
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Start menu pages
;; ------------------------------------------------------------------------------------------------

(define-extern mp-skin-open (function progress none)) ;; "Appearance", below

(define *mp-menu-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-multiplayer)
    (new 'static 'menu-mp-label-option
      :name (text-id progress-mp-multiplayer)
      :should-disable? (lambda () #t)
      :get-label (lambda () (mp-status-text))
      )
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-name)
      :get-value (lambda () *mp-name*)
      :layout 0
      :max-length 15
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-character)
      :items (new 'static 'boxed-array :type text-id (text-id progress-mp-jak) (text-id progress-mp-daxter))
      :get-item-index-fn (lambda () (-> *mp-config* character))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* character) index)
                    (mp-config-save!)
                    (none)
                    )
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-color)
      :items (new 'static 'boxed-array :type text-id
               (text-id progress-mp-color-white)
               (text-id progress-mp-color-red)
               (text-id progress-mp-color-blue)
               (text-id progress-mp-color-green)
               (text-id progress-mp-color-yellow)
               (text-id progress-mp-color-purple)
               (text-id progress-mp-color-orange)
               (text-id progress-mp-color-cyan)
               (text-id progress-mp-color-pink)
               (text-id progress-mp-color-gray)
               )
      :get-item-index-fn (lambda () (-> *mp-config* color))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* color) index)
                    (mp-config-save!)
                    (none)
                    )
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-appearance)
      :on-confirm (lambda ((the-progress progress)) (mp-skin-open the-progress) (none))
      )
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-address)
      :get-value (lambda () *mp-address*)
      :layout 1
      :max-length 31
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-mode)
      :items (new 'static 'boxed-array :type text-id (text-id progress-mp-mode-free) (text-id progress-mp-mode-coop))
      :get-item-index-fn (lambda () (-> *mp-config* mode))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* mode) index)
                    (mp-config-save!)
                    ;; a host switches its running server too
                    (if (= *mp-mode* (mp-mode host))
                        (mp-apply-mode!)
                        )
                    (none)
                    )
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-host)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-host!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-join)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-join!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-leave)
      :should-disable? (lambda () (= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-leave!) (none))
      )
    (progress-new-generic-link-to-scrolling-page (text-id progress-mp-admin)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode host)))
      (new 'static 'menu-mp-label-option
        :name (text-id progress-mp-admin)
        :should-disable? (lambda () #t)
        :get-label (lambda () (mp-status-text))
        )
      (new 'static 'menu-generic-carousel-option
        :name (text-id progress-mp-player)
        :get-max-size-fn (lambda () (mp-player-count))
        :get-item-label-fn (lambda ((index int)) (mp-player-label index *mp-menu-label*) *mp-menu-label*)
        :get-item-index-fn (lambda () (mp-admin-index))
        :on-confirm (lambda ((index int) (the-progress progress)) (set! *mp-admin-slot* (mp-nth-player-slot index)) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-kick)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-kick #f) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-ban)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-kick #t) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-bring)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-bring #f) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-bring-all)
        :on-confirm (lambda ((the-progress progress)) (mp-admin-bring #t) (none))
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-allow-cheats)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag cheats)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag cheats))
                          (logclear! *mp-world* (mp-world-flag cheats))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-pvp)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag pvp)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag pvp))
                          (logclear! *mp-world* (mp-world-flag pvp))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-share-progress)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag progress)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag progress))
                          (logclear! *mp-world* (mp-world-flag progress))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-sync-time)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag sync-time)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag sync-time))
                          (logclear! *mp-world* (mp-world-flag sync-time))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-mp-confirm-option
        :name (text-id progress-mp-stop)
        :on-confirm (lambda () (mp-leave!) (none))
        )
      )
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Title screen and lobby
;;
;; The way into a session follows himstan's Jak and Daxter II Multiplayer
;; (https://github.com/himstan/Jak-And-Daxter-2-Multiplayer, goal_src/jak2/multiplayer/ui/
;; mp-lobby-progress.gc, ISC license): Host Game and Join Game on the title screen; the host picks
;; a new game or a save, then everyone waits in a lobby that lists the players on the left and
;; details the selected one on the right, with his keys: X ready (guest) or start (host, once every
;; guest is ready), L1 / R1 character, circle multiplayer options, triangle leave. Written anew for
;; Jak 3's menus, with these differences: square switches the game mode (the host chooses free roam
;; or co-op here), the start countdown lasts 10 s (his: 3 s; X again cancels it, as his does), and
;; guests join by address.
;; ------------------------------------------------------------------------------------------------

;; Title screen entries, shown while the mod is enabled (mp-update-title).
(define *mp-title-host*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-host-game) :next-state 'mp-lobby-host)
  )

(define *mp-title-join*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-join-game) :next-state 'mp-join-game)
  )

;; The stock entries (New Game, Load Game, Options, Secrets, Quit) and their heights, captured once
;; (a REPL reload must not capture the modded ones).
(define-perm *mp-stock-title* (array menu-option) (-> *title-pc* options))

(define-perm *mp-stock-title-offsets* (array float)
  (let ((offsets (new 'global 'boxed-array float (-> *mp-stock-title* length))))
    (dotimes (i (-> *mp-stock-title* length))
      (set! (-> offsets i) (-> *mp-stock-title* i offset-y))
      )
    offsets
    )
  )

(define *mp-title-options* (new 'global 'boxed-array menu-option 7))

(defun mp-update-title ()
  "Title screen list: Host Game and Join Game after Load Game while the mod is enabled, the stock list
   otherwise. Until Secrets is unlocked, the stock skips index 3 when moving and draws the entries
   0.08 lower and Quit 0.07 higher (pc/progress/progress-generic-pc.gc, progress-draw-pc.gc), so the
   hidden Secrets entry stays at index 3. Called every frame and when the title menu opens."
  (let ((stock *mp-stock-title*)
        (arr *mp-title-options*)
        )
    (cond
      ((not (mp-enabled?))
       (dotimes (i (-> stock length))
         (set! (-> stock i offset-y) (-> *mp-stock-title-offsets* i))
         )
       (set! (-> *title-pc* options) stock)
       )
      (else
        (let ((locked? (not (memcard-unlocked-secrets? #f #f)))
              (shown 0)
              )
          (set! (-> arr 0) (-> stock 0))
          (set! (-> arr 1) (-> stock 1))
          (set! (-> arr 2) *mp-title-host*)
          (set! (-> arr 3) (if locked? (-> stock 3) *mp-title-join*))
          (set! (-> arr 4) (if locked? *mp-title-join* (-> stock 2)))
          (set! (-> arr 5) (if locked? (-> stock 2) (-> stock 3)))
          (set! (-> arr 6) (-> stock 4))
          ;; the entries shown 0.1 apart as drawn: from 0.15 (seven) or 0.2 (six, Secrets hidden)
          (dotimes (i 7)
            (cond
              ((not locked?)
               (set! (-> arr i offset-y) (+ 0.15 (* 0.1 (the float i))))
               )
              ((!= (-> arr i) (-> stock 3))
               (set! (-> arr i offset-y) (+ 0.2 (* 0.1 (the float shown)) (if (= i 6) 0.07 -0.08)))
               (+! shown 1)
               )
              )
            )
          )
        (set! (-> *title-pc* options) arr)
        )
      )
    )
  (none)
  )

;; Join Game: the host's address, then the lobby.
(define *mp-join-game-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-join-game)
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-address)
      :get-value (lambda () *mp-address*)
      :layout 1
      :max-length 31
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-connect)
      :on-confirm (lambda ((the-progress progress))
                    (mp-join!)
                    (push-state the-progress)
                    (set-next-state the-progress 'mp-lobby-join 0)
                    (none)
                    )
      )
    )
  )

;; The lobby page: a single option that draws the whole page and reads its keys.
(deftype menu-mp-lobby-option (menu-option)
  ((selected int32) ;; row of the player detailed on the right
   )
  )

(define *mp-lobby-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-mp-lobby-option :name (text-id progress-mp-lobby))
      )
    )
  )

(define *mp-lobby-line* (new 'global 'string 128 (the-as string #f)))

(define-extern mp-lobby-mode-line (function string string)) ;; "Game modes", below

(defun mp-lobby-slot ((row int))
  "Slot of the player on lobby row `row`: everyone in slot order (the host first), ourselves
   included; -1 (ourselves) before the server gave us a slot."
  (dotimes (i MP_MAX_PLAYERS)
    (when (or (= i *mp-local-slot*) (mp-remote-state i))
      (if (zero? row)
          (return i)
          )
      (+! row -1)
      )
    )
  -1
  )

(defun mp-slot-state ((slot int))
  "A player's state, ours included (slot -1 is ours before we have a slot)."
  (if (or (< slot 0) (= slot *mp-local-slot*))
      *mp-local*
      (mp-remote-state slot)
      )
  )

(defun mp-lobby-coop? ()
  "#t when the session's game mode is co-op. The host chooses it; a guest reads it in the host's
   state (its world event only comes once the host plays)."
  (if (= *mp-mode* (mp-mode client))
      (let ((host (mp-remote-state 0)))
        (and host (logtest? (-> host flags) (mp-flag coop)))
        )
      (= (-> *mp-config* mode) 1)
      )
  )

(defun mp-lobby-all-ready? ()
  "#t when every connected guest said it is ready (always with no guest)."
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i)))
      (if (and st (not (logtest? (-> st flags) (mp-flag ready))))
          (return #f)
          )
      )
    )
  #t
  )

(defun mp-lobby-status-id ((st mp-player-state) (slot int))
  "What the lobby says of a player: host, ready or not ready."
  (cond
    ((or (zero? slot) (and (< slot 0) (= *mp-mode* (mp-mode host))))
     (text-id progress-mp-role-host)
     )
    ((logtest? (-> st flags) (mp-flag ready))
     (text-id progress-mp-ready)
     )
    (else
      (text-id progress-mp-not-ready)
      )
    )
  )

(defun mp-lobby-print ((ctx font-context) (str string) (x float) (y float) (width float) (scale float) (color font-color))
  "Print `str` at x, y in a box `width` wide, with the font flags already set."
  (set! (-> ctx origin x) x)
  (set! (-> ctx origin y) y)
  (set-width! ctx (the int width))
  (set-scale! ctx scale)
  (set-color! ctx color)
  (print-game-text str ctx #f 44 (bucket-id hud-draw-hud-alpha))
  (none)
  )

(defun mp-lobby-draw-square ((x int) (y int) (color int))
  "A player's color square, as in the player list."
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id hud-draw-hud-alpha))
    (dma-buffer-add-gs-set-flusha buf
                                  (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                  (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                  )
    (draw-sprite2d-xy buf x y 9 9 (new 'static 'rgba :a #x80) #x3fffff)
    (draw-sprite2d-xy buf (+ x 1) (+ y 1) 7 7 (mp-color-rgba color) #x3fffff)
    )
  (none)
  )

(defun mp-menu-box ((x int) (y int) (w int) (h int) (color rgba))
  "A filled box in the menu's layer (under its text)."
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id hud-draw-hud-alpha))
    (dma-buffer-add-gs-set-flusha buf
                                  (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                  (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                  )
    (draw-sprite2d-xy buf x y w h color #x3fffff)
    )
  (none)
  )

(defun mp-lobby-cancel-countdown! ()
  "Host: stop the lobby's start countdown, if one runs (X again, a guest no longer ready, another
   page opened)."
  (when (nonzero? (-> *mp-globals* lobby-go))
    (set! (-> *mp-globals* lobby-go) 0)
    (set! (-> *mp-globals* lobby-cancel) (mp-now))
    (format 0 "[multiplayer] lobby countdown cancelled~%")
    (sound-play "roll-over")
    )
  (none)
  )

(defun mp-lobby-update-countdown ()
  "Every frame the lobby is shown. Host: the countdown is cancelled when a guest is no longer ready,
   and starts the game once over. Guest: a countdown of the host's that went away well before its
   end was cancelled (its hint)."
  (cond
    ((= *mp-mode* (mp-mode host))
     (when (nonzero? (-> *mp-globals* lobby-go))
       (cond
         ((not (mp-lobby-all-ready?))
          (mp-lobby-cancel-countdown!)
          )
         ((>= (mp-now) (-> *mp-globals* lobby-go))
          (set! (-> *mp-globals* lobby-go) 0)
          (format 0 "[multiplayer] lobby countdown over: the game starts~%")
          (sound-play "window-expand")
          (if (not (mp-start-game))
              (sound-play "roll-over")
              )
          )
         )
       )
     )
    (else
      (if (and (zero? (mp-lobby-countdown-ms)) (< 600 (-> *mp-globals* lobby-last)))
          (set! (-> *mp-globals* lobby-cancel) (mp-now))
          )
      )
    )
  (set! (-> *mp-globals* lobby-last) (mp-lobby-countdown-ms))
  (none)
  )

(defmethod draw-option ((this menu-mp-lobby-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "The lobby: session status and game mode, the players on the left, the selected one on the right,
   a hint and the keys at the bottom."
  (let* ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
         (wide? (= (get-aspect-ratio) 'aspect16x9))
         ;; the page's frame (draw-page-border), squeezed to the screen's aspect ratio as the stock
         ;; pages' scissor is (begin-scissor-scrolling-page)
         (vis? (-> *pc-settings* use-vis?))
         (x0 (if wide? 79.0 70.0))
         (x1 (if wide? 435.0 445.0))
         (left (+ 8.0 (if vis? x0 (the float (adjust-game-x x0)))))
         (width (- (if vis? x1 (the float (adjust-game-x x1))) left 8.0))
         (top (if wide? 86.0 112.0))
         (bottom (if wide? 362.0 329.0))
         (rows (+ 1 (mp-player-count)))
         (row-top (+ top 42.0))
         (row-h (fmin 20.0 (/ (- bottom 72.0 row-top) (the float (max rows 4)))))
         (sel (max 0 (min (-> this selected) (+ rows -1))))
         (host? (!= *mp-mode* (mp-mode client)))
         (host-st (mp-remote-state 0))
         (detail-x (+ left (* 0.6 width)))
         (detail-w (* 0.38 width))
         (hint (the-as text-id 0))
         )
    (set! (-> this selected) sel)
    (set! (-> font-ctx alpha) alpha)
    (draw-page-header font-ctx (text-id progress-mp-lobby) alpha)
    ;; session status and game mode, centered
    (set-flags! font-ctx (font-flags kerning middle large))
    (mp-lobby-print font-ctx (mp-status-text) left top width 0.45 (font-color font-color-32))
    (mp-lobby-print font-ctx (mp-lobby-mode-line *mp-lobby-line*) left (+ top 17.0) width 0.45 (font-color font-color-32))
    ;; the players: color, name and status, the selected one highlighted
    (set-flags! font-ctx (font-flags kerning large))
    (dotimes (row rows)
      (let* ((slot (mp-lobby-slot row))
             (st (mp-slot-state slot))
             (y (+ row-top (* row-h (the float row))))
             (color (if (= row sel) (font-color font-color-33) (font-color font-color-32)))
             )
        (when st
          (mp-lobby-draw-square (the int (+ left 14.0)) (the int (+ y 3.0)) (-> st color))
          (string<-charp *mp-lobby-line* (-> st name))
          (mp-lobby-print font-ctx *mp-lobby-line* (+ left 28.0) y (* 0.4 width) 0.45 color)
          (mp-lobby-print font-ctx (lookup-text! *common-text* (mp-lobby-status-id st slot) #f)
                          (+ left (* 0.42 width)) (+ y 2.0) (* 0.17 width) 0.35 color
                          )
          )
        )
      )
    ;; the selected player: name, character, ping, status
    (let* ((slot (mp-lobby-slot sel))
           (st (mp-slot-state slot))
           )
      (when st
        (string<-charp *mp-lobby-line* (-> st name))
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x row-top detail-w 0.55 (font-color font-color-33))
        (format (clear *mp-lobby-line*) "~S: ~S"
                (lookup-text! *common-text* (text-id progress-mp-character) #f)
                (lookup-text! *common-text* (if (= (logand (-> st character) 15) 1) (text-id progress-mp-daxter) (text-id progress-mp-jak)) #f)
                )
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x (+ row-top 24.0) detail-w 0.42 (font-color font-color-32))
        (let ((ping (pc-mp-player-ping slot)))
          (if (< ping 0)
              (format (clear *mp-lobby-line*) "~S: --" (lookup-text! *common-text* (text-id progress-mp-col-ping) #f))
              (format (clear *mp-lobby-line*) "~S: ~D ms" (lookup-text! *common-text* (text-id progress-mp-col-ping) #f) ping)
              )
          )
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x (+ row-top 42.0) detail-w 0.42 (font-color font-color-32))
        (mp-lobby-print font-ctx (lookup-text! *common-text* (mp-lobby-status-id st slot) #f)
                        detail-x (+ row-top 60.0) detail-w 0.42 (font-color font-color-32)
                        )
        )
      )
    ;; a hint: the co-op duo for a guest with the host's character, then what everyone waits for
    (cond
      ((and (not host?) host-st (mp-lobby-coop?)
            (= (logand (-> host-st character) 15) (logand (-> *mp-local* character) 15))
            )
       (set! hint (text-id progress-mp-coop-offer))
       )
      ((and (not host?) *mp-lobby-ready*)
       (set! hint (text-id progress-mp-lobby-wait))
       )
      ((and host? (not (mp-lobby-all-ready?)))
       (set! hint (text-id progress-mp-lobby-not-ready))
       )
      ((not (mp-lobby-coop?))
       (set! hint (text-id progress-mp-free-hint))
       )
      )
    (set-flags! font-ctx (font-flags kerning middle large))
    (let ((ms (mp-lobby-countdown-ms)))
      (cond
        ;; the start countdown, for every player of the lobby, in place of the hint; the host's keys
        ;; say X cancels it
        ((> ms 0)
         (format (clear *mp-lobby-line*) (lookup-text! *common-text* (text-id progress-mp-countdown) #f) (/ (+ ms 999) 1000))
         (mp-lobby-print font-ctx *mp-lobby-line* left (- bottom 72.0) width 0.6 (font-color font-color-33))
         )
        ((and (nonzero? (-> *mp-globals* lobby-cancel)) (< (- (mp-now) (-> *mp-globals* lobby-cancel)) (seconds 3)))
         (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-countdown-cancelled) #f)
                         left (- bottom 66.0) width 0.4 (font-color font-color-33)
                         )
         )
        ((nonzero? hint)
         (mp-lobby-print font-ctx (lookup-text! *common-text* hint #f) left (- bottom 66.0) width 0.4 (font-color font-color-33))
         )
        )
      (mp-lobby-print font-ctx
                      (lookup-text! *common-text* (cond
                                                    ((and host? (> ms 0)) (text-id progress-mp-countdown-keys))
                                                    (host? (text-id progress-mp-lobby-keys-host))
                                                    (else (text-id progress-mp-lobby-keys-guest))
                                                    )
                                    #f
                                    )
                      left (- bottom 46.0) width 0.4 (font-color font-color-32)
                      )
      )
    (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-lobby-keys-2) #f)
                    left (- bottom 28.0) width 0.4 (font-color font-color-32)
                    )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-lobby-option) (progress progress) (selected? symbol))
  "The lobby keys: up / down choose the player detailed, X ready (guest) or start (host, once every
   guest is ready: a 10 s countdown every player sees, X again cancels it), L1 / R1 character, square
   game mode (host), circle multiplayer options, triangle leave (the stock respond-to-cpad then goes
   back a page). While the countdown runs a guest can change neither its ready state nor its
   character, and the host's other pages cancel it."
  (let ((host? (!= *mp-mode* (mp-mode client)))
        (counting? (> (mp-lobby-countdown-ms) 0))
        )
    (mp-lobby-update-countdown)
    (cond
      ((cpad-pressed? 0 up l-analog-up)
       (cpad-clear! 0 up l-analog-up)
       (set! (-> this selected) (max 0 (+ (-> this selected) -1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 down l-analog-down)
       (cpad-clear! 0 down l-analog-down)
       (set! (-> this selected) (min (mp-player-count) (+ (-> this selected) 1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 confirm)
       (cpad-clear! 0 confirm)
       (cond
         ((and (= *mp-mode* (mp-mode client)) counting?)
          (sound-play "roll-over")
          )
         ((= *mp-mode* (mp-mode client))
          (set! *mp-lobby-ready* (not *mp-lobby-ready*))
          (sound-play "generic-beep")
          )
         ((and (= *mp-mode* (mp-mode host)) counting?)
          (mp-lobby-cancel-countdown!)
          )
         ((and (= *mp-mode* (mp-mode host)) (mp-lobby-all-ready?))
          (set! (-> *mp-globals* lobby-go) (+ (mp-now) MP_LOBBY_COUNTDOWN))
          (format 0 "[multiplayer] lobby countdown started~%")
          (sound-play "generic-beep")
          )
         (else
           (sound-play "roll-over")
           )
         )
       )
      ((cpad-pressed? 0 l1 r1)
       (cpad-clear! 0 l1 r1)
       (cond
         ((and (not host?) (or *mp-lobby-ready* counting?))
          (sound-play "roll-over")
          )
         (else
           (set! (-> *mp-config* character) (if (= (-> *mp-config* character) 1) 0 1))
           (mp-config-save!)
           (sound-play "generic-beep")
           )
         )
       )
      ((and host? (cpad-pressed? 0 square))
       (cpad-clear! 0 square)
       (mp-lobby-cancel-countdown!)
       (sound-play "window-expand")
       (push-state progress)
       (set-next-state progress 'mp-mode 0)
       )
      ((cpad-pressed? 0 circle)
       (cpad-clear! 0 circle)
       (if host?
           (mp-lobby-cancel-countdown!)
           )
       (sound-play "window-expand")
       (push-state progress)
       (set-next-state progress 'multiplayer 0)
       )
      ((cpad-pressed? 0 triangle)
       (mp-leave!)
       )
      )
    )
  0
  )

;; ------------------------------------------------------------------------------------------------
;; On-screen keyboard: the page a text field opens (player name, server address). A grid of keys
;; moved over with the D-pad or the left stick, as the consoles' keyboards: X types the key, square
;; deletes, L1 switches capitals, START or the OK key keeps the text, triangle cancels.
;; ------------------------------------------------------------------------------------------------

(deftype mp-keyboard-state (structure)
  ((field     menu-mp-text-option) ;; the field edited
   (edit      string)              ;; working copy
   (row       int32)               ;; key highlighted: rows 0-3 characters, row 4 actions
   (col       int32)
   (shift?    symbol)              ;; capitals (name layout)
   (last-move time-frame)
   )
  )

(define *mp-keyboard* (new 'global 'mp-keyboard-state))
(set! (-> *mp-keyboard* edit) (new 'global 'string 40 (the-as string #f)))
(set! (-> *mp-keyboard* shift?) #f)

;; Character rows of each layout (10 keys each): the name's, then the address's.
(define *mp-keyboard-rows*
  (new 'static 'boxed-array :type string
    "abcdefghij" "klmnopqrst" "uvwxyz-_.!" "0123456789"
    "1234567890" ".:abcdefgh" "ijklmnopqr" "stuvwxyz-_"
    )
  )

;; The action row: capitals, space, delete, OK.
(define *mp-keyboard-actions*
  (new 'static 'boxed-array :type text-id
    (text-id progress-mp-key-shift)
    (text-id progress-mp-key-space)
    (text-id progress-mp-key-delete)
    (text-id progress-mp-key-ok)
    )
  )

(defun mp-keyboard-char ((row int) (col int))
  "The character of key row, col (rows 0-3), capital when shift is on (name layout)."
  (let* ((kb *mp-keyboard*)
         (c (-> *mp-keyboard-rows* (+ row (* 4 (-> kb field layout))) data col))
         )
    (if (and (-> kb shift?) (>= c 97) (<= c 122))
        (+ c -32)
        c
        )
    )
  )

(defun mp-keyboard-open ((field menu-mp-text-option) (progress progress))
  "Open the keyboard page on `field`'s current value."
  (let ((kb *mp-keyboard*))
    (set! (-> kb field) field)
    (copy-string<-string (-> kb edit) ((-> field get-value)))
    (set! (-> kb row) 0)
    (set! (-> kb col) 0)
    (set! (-> kb shift?) #f)
    )
  (push-state progress)
  (set-next-state progress 'mp-keyboard 0)
  (none)
  )

(defun mp-keyboard-type ((c uint))
  "Add character `c` at the end of the text, within the field's length."
  (let* ((edit (-> *mp-keyboard* edit))
         (n (length edit))
         )
    (when (< n (-> *mp-keyboard* field max-length))
      (set! (-> edit data n) c)
      (set! (-> edit data (+ n 1)) (the-as uint 0))
      )
    )
  (none)
  )

(defun mp-keyboard-delete ()
  "Remove the last character."
  (let* ((edit (-> *mp-keyboard* edit))
         (n (length edit))
         )
    (if (> n 0)
        (set! (-> edit data (+ n -1)) (the-as uint 0))
        )
    )
  (none)
  )

(defun mp-keyboard-done ((progress progress))
  "Keep the text (trailing spaces removed) and go back to the field's page."
  (let ((kb *mp-keyboard*))
    (mp-text-trim! (-> kb edit))
    (copy-string<-string ((-> kb field get-value)) (-> kb edit))
    ((-> kb field on-confirm))
    )
  (sound-play "generic-beep")
  (pop-state progress)
  (none)
  )

(defun mp-keyboard-move ((drow int) (dcol int))
  "Move the highlight; between the character rows (10 keys) and the action row (4), the column
   follows the key's place."
  (let* ((kb *mp-keyboard*)
         (row (-> kb row))
         (to (mod (+ row drow 5) 5))
         (col (-> kb col))
         )
    (cond
      ((and (< row 4) (= to 4))
       (set! col (/ (* col 4) 10))
       )
      ((and (= row 4) (< to 4))
       (set! col (min 9 (+ 1 (/ (* col 10) 4))))
       )
      )
    (set! (-> kb row) to)
    (set! (-> kb col) (mod (+ col dcol (if (= to 4) 4 10)) (if (= to 4) 4 10)))
    )
  (sound-play "roll-over")
  (none)
  )

(deftype menu-mp-keyboard-option (menu-option)
  ()
  )

(define *mp-keyboard-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-mp-keyboard-option :name (text-id progress-mp-name))
      )
    )
  )

(define *mp-keyboard-char* (new 'global 'string 4 (the-as string #f)))

(defmethod draw-option ((this menu-mp-keyboard-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "The field's name, the text with a cursor, the keys (the highlighted one in a box), the hints."
  (let* ((kb *mp-keyboard*)
         (alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
         (wide? (= (get-aspect-ratio) 'aspect16x9))
         (vis? (-> *pc-settings* use-vis?))
         (x0 (if wide? 79.0 70.0))
         (x1 (if wide? 435.0 445.0))
         (left (+ 8.0 (if vis? x0 (the float (adjust-game-x x0)))))
         (width (- (if vis? x1 (the float (adjust-game-x x1))) left 8.0))
         (top (if wide? 86.0 112.0))
         (bottom (if wide? 362.0 329.0))
         (grid-left (+ left (* 0.06 width)))
         (key-w (/ (* 0.88 width) 10.0))
         (key-h (if wide? 26.0 21.0))
         (grid-top (+ top 50.0))
         )
    (when (-> kb field)
      (set! (-> font-ctx alpha) alpha)
      (draw-page-header font-ctx (-> kb field name) alpha)
      ;; the text and its cursor
      (set-flags! font-ctx (font-flags kerning middle large))
      (format (clear *mp-lobby-line*) "~S_" (-> kb edit))
      (mp-lobby-print font-ctx *mp-lobby-line* left (+ top 12.0) width 0.6 (font-color font-color-33))
      ;; the keys
      (dotimes (row 5)
        (let ((n (if (= row 4) 4 10)))
          (dotimes (col n)
            (let* ((w (if (= row 4) (* 2.5 key-w) key-w))
                   (x (+ grid-left (* w (the float col))))
                   (y (+ grid-top (* key-h (the float row))))
                   (on? (and (= row (-> kb row)) (= col (-> kb col))))
                   )
              (if on?
                  (mp-menu-box (the int (+ x 1.0)) (the int (+ y -2.0)) (the int (+ w -2.0)) (the int (+ key-h -2.0))
                               (new 'static 'rgba :r #x80 :g #x80 :b #x40 :a #x40)
                               )
                  )
              (cond
                ((< row 4)
                 (set! (-> *mp-keyboard-char* data 0) (mp-keyboard-char row col))
                 (set! (-> *mp-keyboard-char* data 1) (the-as uint 0))
                 (mp-lobby-print font-ctx *mp-keyboard-char* x y w 0.6 (if on? (font-color font-color-33) (font-color font-color-32)))
                 )
                (else
                  (mp-lobby-print font-ctx (lookup-text! *common-text* (-> *mp-keyboard-actions* col) #f) x (+ y 2.0) w 0.45
                                  (if (or on? (and (zero? col) (-> kb shift?)))
                                      (font-color font-color-33)
                                      (font-color font-color-32)
                                      )
                                  )
                  )
                )
              )
            )
          )
        )
      (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-keyboard-keys) #f) left (- bottom 46.0) width 0.4 (font-color font-color-32))
      (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-keyboard-keys-2) #f) left (- bottom 28.0) width 0.4 (font-color font-color-32))
      )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-keyboard-option) (progress progress) (selected? symbol))
  "The keyboard's keys (see above); triangle is left to the stock, which goes back a page."
  (let ((kb *mp-keyboard*)
        (repeat? (time-elapsed? (-> *mp-keyboard* last-move) (seconds 0.15)))
        )
    (when (-> kb field)
      (cond
        ((or (cpad-pressed? 0 up l-analog-up) (and repeat? (cpad-hold? 0 up l-analog-up)))
         (cpad-clear! 0 up l-analog-up)
         (set-time! (-> kb last-move))
         (mp-keyboard-move -1 0)
         )
        ((or (cpad-pressed? 0 down l-analog-down) (and repeat? (cpad-hold? 0 down l-analog-down)))
         (cpad-clear! 0 down l-analog-down)
         (set-time! (-> kb last-move))
         (mp-keyboard-move 1 0)
         )
        ((or (cpad-pressed? 0 left l-analog-left) (and repeat? (cpad-hold? 0 left l-analog-left)))
         (set-time! (-> kb last-move))
         (mp-keyboard-move 0 -1)
         )
        ((or (cpad-pressed? 0 right l-analog-right) (and repeat? (cpad-hold? 0 right l-analog-right)))
         (set-time! (-> kb last-move))
         (mp-keyboard-move 0 1)
         )
        ((cpad-pressed? 0 confirm)
         (cpad-clear! 0 confirm)
         (cond
           ((< (-> kb row) 4)
            (mp-keyboard-type (mp-keyboard-char (-> kb row) (-> kb col)))
            (sound-play "generic-beep")
            )
           ((zero? (-> kb col))
            (set! (-> kb shift?) (not (-> kb shift?)))
            (sound-play "generic-beep")
            )
           ((= (-> kb col) 1)
            (if (zero? (-> kb field layout))
                (mp-keyboard-type (the-as uint 32))
                )
            (sound-play "generic-beep")
            )
           ((= (-> kb col) 2)
            (mp-keyboard-delete)
            (sound-play "generic-beep")
            )
           (else
             (mp-keyboard-done progress)
             )
           )
         )
        ((cpad-pressed? 0 square)
         (cpad-clear! 0 square)
         (mp-keyboard-delete)
         (sound-play "generic-beep")
         )
        ((cpad-pressed? 0 l1)
         (cpad-clear! 0 l1)
         (set! (-> kb shift?) (not (-> kb shift?)))
         (sound-play "generic-beep")
         )
        ((cpad-pressed? 0 start)
         (cpad-clear! 0 start)
         (mp-keyboard-done progress)
         )
        )
      )
    )
  0
  )

;; ------------------------------------------------------------------------------------------------
;; Appearance: a color for each part of Jak's and Daxter's clothes ("Outfits" in multiplayer.gc).
;; The page follows himstan's Jak and Daxter II Multiplayer skin editor
;; (https://github.com/himstan/Jak-And-Daxter-2-Multiplayer, goal_src/jak2/multiplayer/ui/
;; mp-lobby-skin-editor.gc, ISC license), written anew for Jak 3: the part chosen with L2 / R2, its
;; red, green, blue and tint strength on sliders (up / down choose one, left / right change it, L1 /
;; R1 by larger steps), a color swatch, a turning preview of the character wearing it (circle: Jak
;; or Daxter, each with his parts), X keeps it (saved, sent to the others), triangle puts back the
;; outfit the page opened with. Our own model shows the draft meanwhile.
;; ------------------------------------------------------------------------------------------------

;; The preview's size, 2.6 m in front of the camera.
(defconstant MP_SKIN_PREVIEW_JAK 0.26)
(defconstant MP_SKIN_PREVIEW_DAXTER 0.52)

(deftype mp-skin-edit-state (structure)
  ((group           int32)      ;; part edited (1-9 Jak's, 10-12 Daxter's)
   (slider          int32)      ;; 0 red, 1 green, 2 blue, 3 strength
   (daxter?         symbol)     ;; the page shows Daxter (his parts) rather than Jak
   (preview-daxter? symbol)     ;; what the preview shows
   (last-move       time-frame) ;; repeat of held keys
   (spin            float)      ;; the preview's turn
   (original        uint32 16)  ;; the outfit when the page opened
   (responds        int32)      ;; frames the page read its keys, and the last ones (test log)
   (last-keys       uint32)
   )
  )

(define *mp-skin-edit* (new 'global 'mp-skin-edit-state))

;; The parts' names, by group (0 unused).
(define *mp-skin-names*
  (new 'static 'boxed-array :type text-id
    (text-id progress-mp-appearance)
    (text-id progress-mp-skin-shirt)
    (text-id progress-mp-skin-armor)
    (text-id progress-mp-skin-pants)
    (text-id progress-mp-skin-boots)
    (text-id progress-mp-skin-scarf)
    (text-id progress-mp-skin-straps)
    (text-id progress-mp-skin-gloves)
    (text-id progress-mp-skin-hair)
    (text-id progress-mp-skin-goggles)
    (text-id progress-mp-skin-fur)
    (text-id progress-mp-skin-light-fur)
    (text-id progress-mp-skin-belt)
    )
  )

(defun mp-skin-begin ()
  "Start editing: the draft and the original are the saved outfit; the page shows the character we
   play."
  (let ((e *mp-skin-edit*)
        (s *mp-skins*)
        )
    (dotimes (i 16)
      (set! (-> e original i) (-> *mp-config* skin i))
      (set! (-> s draft i) (-> *mp-config* skin i))
      )
    (set! (-> e daxter?) (= (-> *mp-config* character) 1))
    (set! (-> e group) (if (-> e daxter?) MP_SKIN_FIRST_DAXTER 1))
    (set! (-> e slider) 0)
    (set! (-> s editing?) #t)
    )
  (none)
  )

(defun mp-skin-open ((progress progress))
  "The Appearance page, from the multiplayer options."
  (mp-skin-begin)
  (push-state progress)
  (set-next-state progress 'mp-skin 0)
  (none)
  )

(defun mp-skin-preview-kill ()
  "Remove the page's preview."
  (let ((proc (handle->process (-> *mp-skins* preview))))
    (if proc
        (deactivate proc)
        )
    )
  (set! (-> *mp-skins* preview) (the-as handle #f))
  (none)
  )

(defun mp-skin-end ((keep? symbol))
  "Stop editing: keep the draft (saved, sent to the others) or put the original back."
  (let ((s *mp-skins*))
    (when keep?
      (dotimes (i 16)
        (set! (-> *mp-config* skin i) (-> s draft i))
        )
      (mp-config-save!)
      (if (mp-online?)
          (mp-send-skin -1)
          )
      (format 0 "[multiplayer] outfit saved~%")
      )
    (set! (-> s editing?) #f)
    )
  (mp-skin-preview-kill)
  (none)
  )

(defun mp-skin-watch ()
  "Every frame from the hook: the page closed some other way than X (START, the menu gone) keeps
   the outfit it opened with; no preview left without the page."
  (when (-> *mp-skins* editing?)
    (when (not (and *progress-process*
                    (or (= (-> *progress-process* 0 current) 'mp-skin) (= (-> *progress-process* 0 next) 'mp-skin))
                    )
               )
      (mp-skin-end #f)
      )
    )
  (if (and (not (-> *mp-skins* editing?)) (handle->process (-> *mp-skins* preview)))
      (mp-skin-preview-kill)
      )
  (none)
  )

(defun mp-skin-value ((slider int))
  "The slider's value in the part edited: red, green, blue 0-255, strength 0-255. A part never
   tinted starts at the player's marker color."
  (let ((tint (-> *mp-skins* draft (-> *mp-skin-edit* group))))
    (when (zero? tint)
      (let ((c (mp-color-rgba (-> *mp-config* color))))
        (set! tint (the-as uint (logior (shl (min 255 (* 2 (-> c r))) 16) (shl (min 255 (* 2 (-> c g))) 8) (min 255 (* 2 (-> c b))))))
        )
      )
    (the-as int (logand (shr tint (case slider ((0) 16) ((1) 8) ((2) 0) (else 24))) 255))
    )
  )

(defun mp-skin-set-value ((slider int) (value int))
  "Set a slider of the part edited (0-255); the others keep their value."
  (let ((v (new 'stack-no-clear 'array 'int32 4)))
    (dotimes (i 4)
      (set! (-> v i) (mp-skin-value i))
      )
    (set! (-> v slider) (max 0 (min 255 value)))
    (set! (-> *mp-skins* draft (-> *mp-skin-edit* group))
          (the-as uint (logior (shl (-> v 3) 24) (shl (-> v 0) 16) (shl (-> v 1) 8) (-> v 2)))
          )
    )
  (none)
  )

(defun mp-skin-next-part ((step int))
  "The next part (step 1) or the previous one (-1) of the character shown."
  (let* ((e *mp-skin-edit*)
         (first (if (-> e daxter?) MP_SKIN_FIRST_DAXTER 1))
         (n (if (-> e daxter?) (+ (- MP_SKIN_LAST MP_SKIN_FIRST_DAXTER) 1) (+ MP_SKIN_FIRST_DAXTER -1)))
         )
    (set! (-> e group) (+ first (mod (+ (- (-> e group) first) step n) n)))
    )
  (none)
  )

(defun mp-skin-preview-update ((x float) (y float))
  "The page's preview of our character wearing the draft: spawned when missing (Jak or Daxter as the
   page shows), in the 3D scene 2.6 m in front of the camera at screen offset x, y (from the
   center), turning, lit as the menu's ring (title-light). The page's background leaves that part
   of the screen open (draw-bg-box-alpha-1, below): HUD models are drawn by the generic renderer,
   which has no outfit tint. It lives in the first pool, which runs under every menu."
  (let ((e *mp-skin-edit*)
        (proc (the-as manipy (handle->process (-> *mp-skins* preview))))
        )
    (when (and proc (!= (-> e preview-daxter?) (-> e daxter?)))
      (mp-skin-preview-kill)
      (set! proc #f)
      )
    (when (not proc)
      (let ((sg (mp-character-skel (-> e daxter?) (mp-local-outfit))))
        (when sg
          (let ((pp (process-spawn
                      manipy
                      :init manipy-init
                      (math-camera-pos)
                      (the-as entity-actor #f)
                      sg
                      (the-as vector #f)
                      (the-as manipy-options 0)
                      :name "mp-skin-preview"
                      :to *mp-input-pool*
                      ;; Jak's model and its scarf (cloth) need the room a puppet has
                      :stack-size #x20000
                      )
                    )
                )
            (when pp
              (set! proc (the-as manipy (ppointer->process pp)))
              (set! (-> *mp-skins* preview) (ppointer->handle pp))
              (set! (-> e preview-daxter?) (-> e daxter?))
              (logclear! (-> proc mask) (process-mask freeze pause menu progress actor-pause))
              (logior! (-> proc draw global-effect) (draw-control-global-effect title-light))
              ;; no cloth (Jak's scarf and flap): it is simulated at world scale, the preview is
              ;; drawn small, so it stretched far out of the model
              (set! (-> proc draw cloth-instances) (the-as (array cloth-on-skeleton) #f))
              ;; Jak's body segments as ours shows them (a new model shows none)
              (if (not (-> e daxter?))
                  (setup-masks (-> proc draw) -1 (if (and *target* (not (focus-test? *target* indax)))
                                                     (the-as int (-> *target* draw seg-mask))
                                                     1
                                                     )
                               )
                  )
              ;; standing idle, the clip found by name in the model's art group
              (send-event proc 'art-joint-anim (if (-> e daxter?) "daxter-indax-stance" "jakb-stance-loop") 0)
              (send-event proc 'anim-mode 'loop)
              )
            )
          )
        )
      )
    (when proc
      (let ((pos (new 'stack-no-clear 'vector))
            (scr (new 'stack 'vector))
            (dir (new 'stack-no-clear 'vector))
            )
        (set! (-> scr x) x)
        (set! (-> scr y) y)
        (position-in-front-of-screen! pos (meters 2.6) scr)
        (vector-copy! (-> proc root trans) pos)
        ;; facing the camera, turning
        (+! (-> e spin) (* 8192.0 (seconds-per-frame)))
        (vector-! dir (math-camera-pos) pos)
        (set! (-> dir y) 0.0)
        (vector-normalize! dir 1.0)
        (quaternion-look-at! (-> proc root quat) dir *up-vector*)
        (quaternion-rotate-y! (-> proc root quat) (-> proc root quat) (-> e spin))
        (let ((k (if (-> e daxter?) MP_SKIN_PREVIEW_DAXTER MP_SKIN_PREVIEW_JAK)))
          (set-vector! (-> proc root scale) k k k 1.0)
          )
        )
      )
    )
  (none)
  )

;; MOD multiplayer -- the menu pages' background hides the 3D scene behind them
;; (engine/ui/progress/progress-draw.gc, pc/progress/progress-draw-pc.gc): on the Appearance page it
;; covers the left part only, where the sliders are; the preview turns in the right part.
(define-perm *mp-stock-draw-bg-box-alpha-1* (function progress progress-box float object)
  (method-of-type progress draw-bg-box-alpha-1)
  )

(defmethod draw-bg-box-alpha-1 ((this progress) (arg0 progress-box) (arg1 float))
  "Stock, except on the Appearance page: the left 60 % of the box (multiplayer mod)."
  (cond
    ((and (= (-> this current) 'mp-skin) (-> *mp-skins* editing?))
     (let ((box (new 'stack-no-clear 'progress-box)))
       (mem-copy! (the-as pointer box) (the-as pointer arg0) (size-of progress-box))
       (set! (-> box aspect4x3 max x) (+ (-> box aspect4x3 min x) (* 0.6 (- (-> box aspect4x3 max x) (-> box aspect4x3 min x)))))
       (set! (-> box aspect16x9 max x) (+ (-> box aspect16x9 min x) (* 0.6 (- (-> box aspect16x9 max x) (-> box aspect16x9 min x)))))
       (*mp-stock-draw-bg-box-alpha-1* this box arg1)
       )
     )
    (else
      (*mp-stock-draw-bg-box-alpha-1* this arg0 arg1)
      )
    )
  )

(defun mp-skin-rgba ()
  "The part's color, for its swatch and its strength bar (#x80 is full)."
  (the-as rgba (logior (shr (mp-skin-value 0) 1) (shl (shr (mp-skin-value 1) 1) 8) (shl (shr (mp-skin-value 2) 1) 16) (shl #x80 24)))
  )

(deftype menu-mp-skin-option (menu-option)
  ()
  )

(define *mp-skin-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-mp-skin-option :name (text-id progress-mp-appearance))
      )
    )
  )

(defmethod draw-option ((this menu-mp-skin-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "The part edited (character and name), its color swatch, the four sliders (the chosen one
   highlighted), the keys; the preview turns on the right."
  (let* ((e *mp-skin-edit*)
         (alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
         (wide? (= (get-aspect-ratio) 'aspect16x9))
         (vis? (-> *pc-settings* use-vis?))
         (x0 (if wide? 79.0 70.0))
         (x1 (if wide? 435.0 445.0))
         (left (+ 8.0 (if vis? x0 (the float (adjust-game-x x0)))))
         (width (- (if vis? x1 (the float (adjust-game-x x1))) left 8.0))
         (top (if wide? 86.0 112.0))
         (bottom (if wide? 362.0 329.0))
         (col-w (* 0.58 width))
         (bar-x (+ left (* 0.06 width)))
         (bar-w (* 0.46 width))
         (strength (mp-skin-value 3))
         )
    (when (-> *mp-skins* editing?)
      (set! (-> font-ctx alpha) alpha)
      (draw-page-header font-ctx (text-id progress-mp-appearance) alpha)
      ;; the part: "Jak: Shirt"
      (set-flags! font-ctx (font-flags kerning middle large))
      (format (clear *mp-lobby-line*) "~S: ~S"
              (lookup-text! *common-text* (if (-> e daxter?) (text-id progress-mp-daxter) (text-id progress-mp-jak)) #f)
              (lookup-text! *common-text* (-> *mp-skin-names* (-> e group)) #f)
              )
      (mp-lobby-print font-ctx *mp-lobby-line* left (+ top 6.0) col-w 0.6 (font-color font-color-33))
      ;; the color swatch (gray striped when the part keeps its stock texture)
      (let ((sw-x (the int (+ left (* 0.2 width))))
            (sw-y (the int (+ top 30.0)))
            )
        (mp-menu-box (+ sw-x -1) (+ sw-y -1) (+ (the int (* 0.18 width)) 2) 20 (new 'static 'rgba :a #x80))
        (mp-menu-box sw-x sw-y (the int (* 0.18 width)) 18
                     (if (zero? strength)
                         (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a #x80)
                         (mp-skin-rgba)
                         )
                     )
        )
      ;; the sliders
      (set-flags! font-ctx (font-flags kerning large))
      (dotimes (i 4)
        (let* ((y (+ top 52.0 (* 28.0 (the float i))))
               (v (mp-skin-value i))
               (on? (= i (-> e slider)))
               )
          (if on?
              (mp-menu-box (the int (+ bar-x -4.0)) (the int (+ y -2.0)) (the int (+ bar-w 8.0)) 27
                           (new 'static 'rgba :r #x50 :g #x50 :b #x60 :a #x50)
                           )
              )
          (cond
            ((< i 3)
             (format (clear *mp-lobby-line*) "~S: ~D"
                     (lookup-text! *common-text* (case i
                                                   ((0) (text-id progress-mp-skin-red))
                                                   ((1) (text-id progress-mp-skin-green))
                                                   (else (text-id progress-mp-skin-blue))
                                                   )
                                   #f
                                   )
                     v
                     )
             )
            ((zero? v)
             (format (clear *mp-lobby-line*) "~S: 0% (~S)" (lookup-text! *common-text* (text-id progress-mp-skin-strength) #f)
                     (lookup-text! *common-text* (text-id progress-mp-skin-stock) #f)
                     )
             )
            (else
              (format (clear *mp-lobby-line*) "~S: ~D%" (lookup-text! *common-text* (text-id progress-mp-skin-strength) #f)
                      (/ (+ (* v 100) 127) 255)
                      )
              )
            )
          (mp-lobby-print font-ctx *mp-lobby-line* bar-x y col-w 0.38 (if on? (font-color font-color-33) (font-color font-color-32)))
          (mp-menu-box (the int bar-x) (the int (+ y 15.0)) (the int bar-w) 6 (new 'static 'rgba :r #x18 :g #x18 :b #x1c :a #x80))
          (mp-menu-box (the int bar-x) (the int (+ y 15.0)) (the int (/ (* bar-w (the float v)) 255.0)) 6
                       (case i
                         ((0) (new 'static 'rgba :r #x80 :g #x18 :b #x18 :a #x80))
                         ((1) (new 'static 'rgba :r #x18 :g #x80 :b #x18 :a #x80))
                         ((2) (new 'static 'rgba :r #x18 :g #x18 :b #x80 :a #x80))
                         (else (mp-skin-rgba))
                         )
                       )
          )
        )
      ;; the keys
      (set-flags! font-ctx (font-flags kerning middle large))
      (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-skin-keys) #f) left (- bottom 64.0) width 0.38 (font-color font-color-32))
      (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-skin-keys-2) #f) left (- bottom 46.0) width 0.38 (font-color font-color-32))
      (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-skin-keys-3) #f) left (- bottom 28.0) width 0.38 (font-color font-color-32))
      ;; the preview, on the page's right side (offsets from the screen's center)
      (mp-skin-preview-update (+ (* 0.78 width) left -256.0) (- bottom 290.0))
      )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-skin-option) (progress progress) (selected? symbol))
  "The page's keys (see above). Triangle is left to the stock, which goes back a page, once the
   outfit the page opened with is put back."
  (let* ((e *mp-skin-edit*)
         (repeat? (time-elapsed? (-> e last-move) (seconds 0.05))) ;; held: after 0.3 s, every 0.05 s
         (big (if (= (-> e slider) 3) 26 16))
         (small (if (= (-> e slider) 3) 3 1))
         )
    (when (-> *mp-skins* editing?)
      (+! (-> e responds) 1)
      (if (nonzero? (-> *cpad-list* cpads 0 button0-rel 0))
          (set! (-> e last-keys) (the-as uint (-> *cpad-list* cpads 0 button0-rel 0)))
          )
      (cond
        ((cpad-pressed? 0 triangle)
         (mp-skin-end #f)
         )
        ((cpad-pressed? 0 confirm)
         (cpad-clear! 0 confirm)
         (mp-skin-end #t)
         (sound-play "generic-beep")
         (pop-state progress)
         )
        ((cpad-pressed? 0 l2)
         (cpad-clear! 0 l2)
         (mp-skin-next-part -1)
         (set! (-> e slider) 0)
         (sound-play "roll-over")
         )
        ((cpad-pressed? 0 r2)
         (cpad-clear! 0 r2)
         (mp-skin-next-part 1)
         (set! (-> e slider) 0)
         (sound-play "roll-over")
         )
        ((cpad-pressed? 0 circle)
         (cpad-clear! 0 circle)
         (set! (-> e daxter?) (not (-> e daxter?)))
         (set! (-> e group) (if (-> e daxter?) MP_SKIN_FIRST_DAXTER 1))
         (set! (-> e slider) 0)
         (sound-play "generic-beep")
         )
        ((cpad-pressed? 0 up l-analog-up)
         (cpad-clear! 0 up l-analog-up)
         (set! (-> e slider) (mod (+ (-> e slider) 3) 4))
         (sound-play "roll-over")
         )
        ((cpad-pressed? 0 down l-analog-down)
         (cpad-clear! 0 down l-analog-down)
         (set! (-> e slider) (mod (+ (-> e slider) 1) 4))
         (sound-play "roll-over")
         )
        ((cpad-pressed? 0 left l-analog-left)
         (set! (-> e last-move) (+ (current-time) (seconds 0.25)))
         (mp-skin-set-value (-> e slider) (- (mp-skin-value (-> e slider)) small))
         )
        ((cpad-pressed? 0 right l-analog-right)
         (set! (-> e last-move) (+ (current-time) (seconds 0.25)))
         (mp-skin-set-value (-> e slider) (+ (mp-skin-value (-> e slider)) small))
         )
        ((cpad-pressed? 0 l1)
         (set! (-> e last-move) (+ (current-time) (seconds 0.25)))
         (mp-skin-set-value (-> e slider) (- (mp-skin-value (-> e slider)) big))
         )
        ((cpad-pressed? 0 r1)
         (set! (-> e last-move) (+ (current-time) (seconds 0.25)))
         (mp-skin-set-value (-> e slider) (+ (mp-skin-value (-> e slider)) big))
         )
        (repeat?
          (cond
            ((cpad-hold? 0 left l-analog-left)
             (set-time! (-> e last-move))
             (mp-skin-set-value (-> e slider) (- (mp-skin-value (-> e slider)) (* 4 small)))
             )
            ((cpad-hold? 0 right l-analog-right)
             (set-time! (-> e last-move))
             (mp-skin-set-value (-> e slider) (+ (mp-skin-value (-> e slider)) (* 4 small)))
             )
            ((cpad-hold? 0 l1)
             (set-time! (-> e last-move))
             (mp-skin-set-value (-> e slider) (- (mp-skin-value (-> e slider)) big))
             )
            ((cpad-hold? 0 r1)
             (set-time! (-> e last-move))
             (mp-skin-set-value (-> e slider) (+ (mp-skin-value (-> e slider)) big))
             )
            )
          )
        )
      )
    )
  0
  )

;; ------------------------------------------------------------------------------------------------
;; Game modes (square in the lobby, host): the eight modes, those not playable yet grayed out; co-op
;; then asks how the campaign starts, and a mission when one is chosen. See "Game modes" in
;; multiplayer.gc for what each starts.
;; ------------------------------------------------------------------------------------------------

(defun mp-mode-available? ((mode int))
  "#t for the modes that can be played: free roam (6) and co-op (7), two players at most."
  (case mode
    ((6) #t)
    ((7) (<= (mp-player-count) 1))
    (else #f)
    )
  )

(defun mp-choose-mode ((mode int) (progress progress))
  "The host chose mode `mode` of the list: free roam goes back to the lobby, co-op goes on to how
   the campaign starts."
  (set! (-> *mp-config* mode) (if (= mode 7) 1 0))
  (mp-config-save!)
  (mp-apply-mode!)
  (if (= mode 7)
      (set-next-state progress 'mp-coop-start 0)
      (pop-state progress)
      )
  (none)
  )

;; One entry of the mode list: the mode's name, "coming soon" (or "2 players at most" for co-op with
;; more players) after it while it cannot be chosen.
(deftype menu-mp-mode-option (menu-generic-button-option)
  ((mode int32) ;; place in the list: 0 parkour ... 6 free roam, 7 co-op
   )
  )

(define *mp-mode-label* (new 'global 'string 96 (the-as string #f)))

(defmethod draw-option ((this menu-mp-mode-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "The mode's name, grayed with the reason while it cannot be chosen."
  (when (or (zero? (-> this mounted?)) (not (-> this mounted?)))
    (on-mount! this)
    )
  (if (mp-mode-available? (-> this mode))
      (format (clear *mp-mode-label*) "~S" (lookup-text! *common-text* (-> this name) #f))
      (format (clear *mp-mode-label*) "~S  (~S)" (lookup-text! *common-text* (-> this name) #f)
              (lookup-text! *common-text* (if (= (-> this mode) 7) (text-id progress-mp-coop-max) (text-id progress-mp-coming-soon)) #f)
              )
      )
  (draw-generic-simple-string-option this progress font-ctx option-index *mp-mode-label*)
  (none)
  )

(define *mp-mode-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-mode)
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-parkour) :mode 0
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-egg-hunt) :mode 1
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-pvp) :mode 2
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-battlefront) :mode 3
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-hide-seek) :mode 4
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-races) :mode 5
         :should-disable? (lambda () #t) :on-confirm (lambda ((p progress)) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-free) :mode 6
         :should-disable? (lambda () (not (mp-mode-available? 6)))
         :on-confirm (lambda ((p progress)) (mp-choose-mode 6 p) (none)))
    (new 'static 'menu-mp-mode-option :name (text-id progress-mp-mode-coop) :mode 7
         :should-disable? (lambda () (not (mp-mode-available? 7)))
         :on-confirm (lambda ((p progress)) (mp-choose-mode 7 p) (none)))
    )
  )

;; The multiplayer campaign's completion, read when the co-op page opens (-1: none).
(define *mp-campaign-percent* -1.0)

(defun mp-campaign-label ()
  "The co-op page's first line: the multiplayer campaign and how far it went, or that there is none."
  (if (< *mp-campaign-percent* 0.0)
      (format (clear *mp-menu-label*) "~S" (lookup-text! *common-text* (text-id progress-mp-no-campaign) #f))
      (format (clear *mp-menu-label*) "~S: ~D%" (lookup-text! *common-text* (text-id progress-mp-campaign) #f)
              (the int *mp-campaign-percent*)
              )
      )
  *mp-menu-label*
  )

(defun mp-choose-coop-start ((start int) (progress progress))
  "The host chose how the campaign starts (0 new, 1 continue, 2 a mission); back to the lobby."
  (set! (-> *mp-session* coop-start) start)
  (pop-state progress)
  (none)
  )

(define *mp-coop-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-coop-start)
    (new 'static 'menu-mp-label-option
      :name (text-id progress-mp-campaign)
      :should-disable? (lambda () #t)
      :get-label (lambda () (mp-campaign-label))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-coop-new)
      :on-confirm (lambda ((p progress)) (mp-choose-coop-start 0 p) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-coop-continue)
      :should-disable? (lambda () (< *mp-campaign-percent* 0.0))
      :on-confirm (lambda ((p progress)) (mp-choose-coop-start 1 p) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-coop-mission)
      :on-confirm (lambda ((p progress)) (set-next-state p 'mp-mission 0) (none))
      )
    )
  )

(defun mp-mission-row ((task int))
  "Place of mission `task` in the list offered, 0 when it is not there."
  (dotimes (i (mp-mission-count))
    (if (= (mp-mission-task i) task)
        (return i)
        )
    )
  0
  )

(define *mp-mission-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-mission)
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-mission)
      :get-max-size-fn (lambda () (mp-mission-count))
      :get-item-label-fn (lambda ((index int)) (mp-mission-name (mp-mission-task index)))
      :get-item-index-fn (lambda () (mp-mission-row (-> *mp-session* coop-mission)))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-session* coop-mission) (mp-mission-task index))
                    (mp-choose-coop-start 2 the-progress)
                    (none)
                    )
      )
    )
  )

(defun mp-lobby-mode-line ((dst string))
  "The lobby's game mode line: the mode, and for co-op how it starts (the host's choice; a guest
   reads it in the host's state)."
  (let* ((host (mp-remote-state 0))
         (client? (= *mp-mode* (mp-mode client)))
         (coop? (mp-lobby-coop?))
         (start (if (and client? host) (the-as int (-> host lobby-start)) (-> *mp-session* coop-start)))
         (mission (if (and client? host) (the-as int (-> host lobby-mission)) (-> *mp-session* coop-mission)))
         )
    (format (clear dst) "~S: ~S"
            (lookup-text! *common-text* (text-id progress-mp-mode) #f)
            (lookup-text! *common-text* (if coop? (text-id progress-mp-mode-coop) (text-id progress-mp-mode-free)) #f)
            )
    (when coop?
      (case start
        ((1)
         (format dst " - ~S" (lookup-text! *common-text* (text-id progress-mp-coop-continue) #f))
         )
        ((2)
         (format dst " - ~S: ~S" (lookup-text! *common-text* (text-id progress-mp-mission) #f) (mp-mission-name mission))
         )
        (else
          (format dst " - ~S" (lookup-text! *common-text* (text-id progress-mp-coop-new) #f))
          )
        )
      )
    )
  dst
  )

;; MOD multiplayer -- route the multiplayer pages (START > Options > Multiplayer, the title screen's
;; Host Game and Join Game, the lobby) and let every other page through the stock method
;; (pc/progress/progress-pc.gc). define-perm keeps the stock method when this file is reloaded in a
;; REPL session.
(define-perm *mp-stock-set-menu-options* (function progress symbol int)
  (the-as (function progress symbol int) (method-of-type progress set-menu-options))
  )

(defmethod set-menu-options ((this progress) (arg0 symbol))
  "Stock behavior, plus the multiplayer pages."
  (case arg0
    (('multiplayer)
     (set! (-> this current-options) *mp-menu-options*)
     0
     )
    (('mp-mode)
     (set! (-> (the-as menu-generic-scrolling-page (-> *mp-mode-options* options 0)) selected-option-index) -1)
     (set! (-> *progress-pc-generic-store* current-menu-hover-index) (if (= (-> *mp-config* mode) 1) 7 6))
     ;; the list scrolled so the mode chosen shows at the bottom (five lines shown)
     (set! (-> *progress-pc-generic-store* current-menu-scroll-index)
           (the float (+ (-> *progress-pc-generic-store* current-menu-hover-index) -4))
           )
     (set! (-> this current-options) *mp-mode-options*)
     0
     )
    (('mp-coop-start)
     (set! *mp-campaign-percent* (mp-campaign-percent))
     (set! (-> (the-as menu-generic-scrolling-page (-> *mp-coop-options* options 0)) selected-option-index) -1)
     (set! (-> *progress-pc-generic-store* current-menu-hover-index) (+ 1 (-> *mp-session* coop-start)))
     (set! (-> *progress-pc-generic-store* current-menu-scroll-index) 0.0)
     (set! (-> this current-options) *mp-coop-options*)
     0
     )
    (('mp-mission)
     (set! (-> (the-as menu-generic-scrolling-page (-> *mp-mission-options* options 0)) selected-option-index) -1)
     (set! (-> *progress-pc-generic-store* current-menu-hover-index) 0)
     (set! (-> *progress-pc-generic-store* current-menu-scroll-index) 0.0)
     (set! (-> this current-options) *mp-mission-options*)
     0
     )
    (('mp-keyboard)
     (set! (-> this current-options) *mp-keyboard-options*)
     0
     )
    (('mp-skin)
     (set! (-> this current-options) *mp-skin-options*)
     0
     )
    (('mp-join-game)
     ;; on the address, nothing left selected from the last visit
     (set! (-> (the-as menu-generic-scrolling-page (-> *mp-join-game-options* options 0)) selected-option-index) -1)
     (set! (-> *progress-pc-generic-store* current-menu-hover-index) 0)
     (set! (-> this current-options) *mp-join-game-options*)
     0
     )
    (('mp-lobby-host 'mp-lobby-join)
     ;; a host's server starts with its lobby (mp-host! does nothing once hosting): guests can join
     ;; it at once, before the host starts the game
     (when (= arg0 'mp-lobby-host)
       ;; as the server starts (not on coming back from the mode pages): co-op continues the
       ;; campaign when there is one, else starts a new one (the host can choose otherwise)
       (if (= *mp-mode* (mp-mode offline))
           (set! (-> *mp-session* coop-start) (if (>= (mp-campaign-percent) 0.0) 1 0))
           )
       (mp-host!)
       )
     (set! (-> this current-options) *mp-lobby-options*)
     0
     )
    (else
      (if (= arg0 'title)
          (mp-update-title)
          )
      (*mp-stock-set-menu-options* this arg0)
      )
    )
  )

;; The Options page entry, added to the stock list while the mod is enabled. The page places its
;; entries at fractions of its height (offset-y), so the entries are spread again to make room.
(define *mp-options-entry*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-multiplayer) :offset-y 0.8 :next-state 'multiplayer)
  )

(define-perm *mp-stock-options* (array menu-option) (-> *options-options-pc* options))

;; The stock entries' offsets, captured once (a REPL reload must not capture the spread ones).
(define-perm *mp-stock-offsets* (array float)
  (let ((offsets (new 'global 'boxed-array float (-> *mp-stock-options* length))))
    (dotimes (i (-> *mp-stock-options* length))
      (set! (-> offsets i) (-> *mp-stock-options* i offset-y))
      )
    offsets
    )
  )

(define *mp-options-with-entry* (new 'global 'boxed-array menu-option (+ (-> *mp-stock-options* length) 1)))

(dotimes (i (-> *mp-stock-options* length))
  (set! (-> *mp-options-with-entry* i) (-> *mp-stock-options* i))
  )

(set! (-> *mp-options-with-entry* (-> *mp-stock-options* length)) *mp-options-entry*)

(defun mp-update-options-entry ()
  "Show the Multiplayer entry in START > Options only while the mod is enabled."
  (let ((n (-> *mp-stock-options* length)))
    (cond
      ((mp-enabled?)
       ;; n + 1 entries over the stock span (first to last offset)
       (let* ((first (-> *mp-stock-offsets* 0))
              (step (/ (- (-> *mp-stock-offsets* (+ n -1)) first) (the float n)))
              )
         (dotimes (i (+ n 1))
           (set! (-> *mp-options-with-entry* i offset-y) (+ first (* step (the float i))))
           )
         )
       (set! (-> *options-options-pc* options) *mp-options-with-entry*)
       )
      (else
        (dotimes (i n)
          (set! (-> *mp-stock-options* i offset-y) (-> *mp-stock-offsets* i))
          )
        (set! (-> *options-options-pc* options) *mp-stock-options*)
        )
      )
    )
  (none)
  )

(mp-update-options-entry)

;; ------------------------------------------------------------------------------------------------
;; Cheats and teleports (Mods menu)
;; ------------------------------------------------------------------------------------------------

(defun mp-set-enabled! ((on? symbol))
  "Turn the mod on or off, remember it between boots."
  (set! (-> *mp-config* enabled) (if on? 1 0))
  (mp-config-save!)
  (mp-update-options-entry)
  (mp-update-title)
  (none)
  )

(defun mp-cheat-ammo ()
  "Refill every gun's ammo to its current maximum."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* gun-ammo 0) (get-max-ammo-for-gun *game-info* (pickup-type ammo-yellow)))
    (set! (-> *game-info* gun-ammo 1) (get-max-ammo-for-gun *game-info* (pickup-type ammo-red)))
    (set! (-> *game-info* gun-ammo 2) (get-max-ammo-for-gun *game-info* (pickup-type ammo-blue)))
    (set! (-> *game-info* gun-ammo 3) (get-max-ammo-for-gun *game-info* (pickup-type ammo-dark)))
    (mp-show-message "Ammo refilled")
    )
  (none)
  )

(defun mp-cheat-health ()
  "Restore full health."
  (when (and (mp-cheats-allowed?) *target*)
    (set! (-> *target* fact health) (-> *target* fact health-max))
    (mp-show-message "Health restored")
    )
  (none)
  )

(defun mp-cheat-dark-eco ()
  "Fill the dark eco meter."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* eco-pill-dark) (-> *FACT-bank* eco-pill-dark-max-default))
    (mp-show-message "Dark eco restored")
    )
  (none)
  )

(defun mp-cheat-light-eco ()
  "Fill the light eco meter."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* eco-pill-light) (-> *FACT-bank* eco-pill-light-max-default))
    (mp-show-message "Light eco restored")
    )
  (none)
  )

(defun mp-teleport-zone ((index int))
  "Go to zone `index` of *mp-zones* (through its continue point)."
  (when (and (mp-cheats-allowed?) *target* (>= index 0) (< (* 2 index) (-> *mp-zones* length)))
    (let ((cp (get-continue-by-name *game-info* (-> *mp-zones* (+ (* 2 index) 1)))))
      (if cp
          (send-event *target* 'continue cp)
          (mp-show-message "Unknown zone")
          )
      )
    )
  (none)
  )

(defun mp-teleport-player ((index int))
  "Go to the index-th connected player (applied by the manager on its next frame)."
  (when (and (mp-cheats-allowed?) (>= (mp-nth-player-slot index) 0))
    (set! *mp-request-teleport* (mp-nth-player-slot index))
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Mods menu
;; ------------------------------------------------------------------------------------------------

(define *mod-multiplayer-menu*
  (new 'static 'popup-menu-submenu :label "multiplayer"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-flag :label "Enable multiplayer (START > Options)"
           :is-toggled? (lambda () (mp-enabled?))
           :on-confirm (lambda () (mp-set-enabled! (not (mp-enabled?))) (none))
           )
      (new 'static 'popup-menu-button :label "Refill ammo"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-ammo) (none))
           )
      (new 'static 'popup-menu-button :label "Restore health"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-health) (none))
           )
      (new 'static 'popup-menu-button :label "Restore dark eco"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-dark-eco) (none))
           )
      (new 'static 'popup-menu-button :label "Restore light eco"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-light-eco) (none))
           )
      (new 'static 'popup-menu-button :label "Give every weapon (Jak and Daxter)"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (when (mp-cheats-allowed?) (mp-give-all-weapons) (mp-show-message "Every weapon given")) (none))
           )
      (new 'static 'popup-menu-flag :label "Invincible"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :is-toggled? (lambda () *mp-invulnerable*)
           :on-confirm (lambda () (set! *mp-invulnerable* (and (not *mp-invulnerable*) (mp-cheats-allowed?))) (none))
           )
      (new 'static 'popup-menu-dynamic-submenu :label "Teleport to a zone"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :get-length (lambda () (/ (-> *mp-zones* length) 2))
           :get-entry-label (lambda ((index int) (dst string)) (copy-string<-string dst (-> *mp-zones* (* 2 index))) (none))
           :on-entry-confirm (lambda ((index int)) (mp-teleport-zone index) (none))
           :entry-selected? (lambda ((index int)) #f)
           :on-reset (lambda () (none))
           )
      (new 'static 'popup-menu-dynamic-submenu :label "Teleport to a player"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :get-length (lambda () (mp-player-count))
           :get-entry-label (lambda ((index int) (dst string)) (mp-player-label index dst) (none))
           :on-entry-confirm (lambda ((index int)) (mp-teleport-player index) (none))
           :entry-selected? (lambda ((index int)) #f)
           :on-reset (lambda () (none))
           )
      )
    )
  )

(defun mod-multiplayer-build-menu ()
  "Return this mod's entry for the Mods menu (pure: the menu is static)."
  (the-as popup-menu-entry *mod-multiplayer-menu*)
  )

(mods-menu-register "multiplayer" mod-multiplayer-build-menu)
