;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer-menu.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- menus:
;;   - Title screen: Host Game (a new game or a save) and Join Game (an address), both leading to the
;;     lobby where the players choose their character, the host the game mode, and the host starts
;;     once every guest is ready (after himstan's Jak and Daxter II Multiplayer, see below).
;;   - START > Options > Multiplayer: name, character, color, server address, host / join /
;;     disconnect, and the Server administration page while hosting (kick, ban, teleports, cheat
;;     permission, time-of-day sharing, stop). The entry only exists while the mod is enabled.
;;   - Mods menu (L3 + SELECT) > multiplayer: the on/off toggle, the cheats, the teleports.
;; The start menu ring has exactly ten slots (36 degrees each, matching its 3D model), so the
;; Multiplayer page hangs off the Options page instead, which is a plain list.

;; ------------------------------------------------------------------------------------------------
;; Players listed in menus (connected remote players, in slot order)
;; ------------------------------------------------------------------------------------------------

(defun mp-player-count ()
  "Number of remote players connected."
  (let ((n 0))
    (dotimes (i MP_MAX_PLAYERS)
      (if (-> *mp-players* valid i)
          (+! n 1)
          )
      )
    n
    )
  )

(defun mp-nth-player-slot ((n int))
  "Slot of the n-th connected remote player, or -1."
  (dotimes (i MP_MAX_PLAYERS)
    (when (-> *mp-players* valid i)
      (if (zero? n)
          (return i)
          )
      (+! n -1)
      )
    )
  -1
  )

(defun mp-player-label ((n int) (dst string))
  "Name of the n-th connected remote player, into `dst`."
  (let ((slot (mp-nth-player-slot n)))
    (if (>= slot 0)
        (string<-charp dst (-> *mp-players* state slot name))
        (clear dst)
        )
    )
  (none)
  )

(define *mp-menu-label* (new 'global 'string 64 (the-as string #f)))

(defun mp-status-text ()
  "One line describing the session, for the menus."
  (let ((players (+ 1 (mp-player-count))))
    (case *mp-mode*
      (((mp-mode host))
       (format (clear *mp-menu-label*) "Hosting: ~D player(s)" players)
       )
      (((mp-mode client))
       (format (clear *mp-menu-label*) "Connected: ~D player(s)" players)
       )
      (((mp-mode connecting))
       (format (clear *mp-menu-label*) "Connecting to ~S..." *mp-address*)
       )
      (else
        (pc-mp-message *mp-status*)
        (if (zero? (length *mp-status*))
            (format (clear *mp-menu-label*) "Offline")
            (format (clear *mp-menu-label*) "Offline: ~S" *mp-status*)
            )
        )
      )
    )
  *mp-menu-label*
  )

;; ------------------------------------------------------------------------------------------------
;; Start menu: a read-only line, and a text field edited with the D-pad
;; ------------------------------------------------------------------------------------------------

;; A grayed line whose text comes from a function (the session status).
(deftype menu-mp-label-option (menu-generic-option)
  ((get-label (function string))
   )
  )

(defmethod draw-option ((this menu-mp-label-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "Draw the current text of the line."
  ;; a static object's symbol fields start at 0, not #f (same test as the stock pages)
  (when (or (zero? (-> this mounted?)) (not (-> this mounted?)))
    (on-mount! this)
    )
  (draw-generic-simple-string-option this progress font-ctx option-index ((-> this get-label)))
  (none)
  )

(defmethod respond-progress ((this menu-mp-label-option) (progress progress) (selected? symbol))
  "Read-only."
  0
  )

;; A text field, for controllers as well as keyboards: confirm to edit, up / down change the
;; character under the cursor, left / right move the cursor, square deletes, confirm saves,
;; triangle cancels.
(deftype menu-mp-text-option (menu-generic-option)
  ((get-value  (function string)) ;; the string this field edits
   (charset    string)            ;; characters offered, in order
   (max-length int32)
   (on-confirm (function none))   ;; called after a confirmed edit
   (edit       string)            ;; working copy while editing
   (cursor     int32)
   (last-move  time-frame)
   )
  )

(defmethod on-mount! ((this menu-mp-text-option))
  "Allocate the working copy once."
  (set! (-> this mounted?) #t)
  (if (zero? (-> this edit))
      (set! (-> this edit) (new 'global 'string 40 (the-as string #f)))
      )
  (none)
  )

(defun mp-charset-index ((charset string) (c uint))
  "Position of character `c` in `charset`, or -1."
  (dotimes (i (length charset))
    (if (= (-> charset data i) c)
        (return i)
        )
    )
  -1
  )

(defun mp-text-cycle! ((this menu-mp-text-option) (dir int))
  "Change the character under the cursor by `dir` steps in the charset; at the end of the text,
   add a character."
  (let* ((edit (-> this edit))
         (len (length edit))
         (cur (-> this cursor))
         (cs (-> this charset))
         (n (length cs))
         )
    (cond
      ((< cur len)
       (let ((idx (mp-charset-index cs (-> edit data cur))))
         (set! (-> edit data cur) (-> cs data (mod (+ idx dir n) n)))
         )
       )
      ((< len (-> this max-length))
       (set! (-> edit data cur) (-> cs data (if (> dir 0)
                                                 0
                                                 (+ n -1)
                                                 )
                                     )
             )
       (set! (-> edit data (+ cur 1)) (the-as uint 0))
       )
      )
    )
  (none)
  )

(defun mp-text-delete! ((this menu-mp-text-option))
  "Delete the character under the cursor, or the last one when the cursor is at the end."
  (let* ((edit (-> this edit))
         (len (length edit))
         (cur (-> this cursor))
         )
    (cond
      ((< cur len)
       (let ((i cur))
         (while (< i len)
           (set! (-> edit data i) (-> edit data (+ i 1)))
           (+! i 1)
           )
         )
       )
      ((> cur 0)
       (set! (-> edit data (+ cur -1)) (the-as uint 0))
       (set! (-> this cursor) (+ cur -1))
       )
      )
    )
  (none)
  )

(defun mp-text-trim! ((str string))
  "Remove trailing spaces."
  (let ((i (+ (length str) -1)))
    (while (and (>= i 0) (= (-> str data i) 32))
      (set! (-> str data i) (the-as uint 0))
      (+! i -1)
      )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-text-option) (progress progress) (selected? symbol))
  "Edit the text while the option is selected (see the type's comment for the buttons)."
  (if (zero? (-> this edit))
      (on-mount! this)
      )
  (let ((edit (-> this edit)))
    (cond
      ((not selected?)
       ;; this confirm selects the option: start from the current value
       (when (cpad-pressed? 0 confirm)
         (copy-string<-string edit ((-> this get-value)))
         (set! (-> this cursor) (length edit))
         )
       )
      ((cpad-pressed? 0 confirm)
       (mp-text-trim! edit)
       (copy-string<-string ((-> this get-value)) edit)
       ((-> this on-confirm))
       (sound-play "generic-beep")
       )
      ((or (cpad-pressed? 0 up l-analog-up)
           (and (cpad-hold? 0 up l-analog-up) (time-elapsed? (-> this last-move) (seconds 0.15)))
           )
       (set-time! (-> this last-move))
       (mp-text-cycle! this 1)
       (sound-play "roll-over")
       )
      ((or (cpad-pressed? 0 down l-analog-down)
           (and (cpad-hold? 0 down l-analog-down) (time-elapsed? (-> this last-move) (seconds 0.15)))
           )
       (set-time! (-> this last-move))
       (mp-text-cycle! this -1)
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 right l-analog-right)
       (set! (-> this cursor) (min (+ (-> this cursor) 1) (min (length edit) (+ (-> this max-length) -1))))
       )
      ((cpad-pressed? 0 left l-analog-left)
       (set! (-> this cursor) (max 0 (+ (-> this cursor) -1)))
       )
      ((cpad-pressed? 0 square)
       (mp-text-delete! this)
       (sound-play "generic-beep")
       )
      )
    )
  0
  )

(define *mp-text-before* (new 'global 'string 40 (the-as string #f)))
(define *mp-text-after* (new 'global 'string 40 (the-as string #f)))

(defmethod draw-option ((this menu-mp-text-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "Label on the first line, value on the second; while editing, the cursor is highlighted."
  ;; a static object's symbol fields start at 0, not #f (same test as the stock pages)
  (when (or (zero? (-> this mounted?)) (not (-> this mounted?)))
    (on-mount! this)
    )
  (let ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition))))))
    (set! (-> font-ctx alpha) alpha)
    (set-flags! font-ctx (font-flags kerning middle large))
    (set-scale! font-ctx FONT_SIZE_OPTION)
    (+! (-> font-ctx origin y) (if (= (get-aspect-ratio) 'aspect4x3)
                                   7.0
                                   5.0
                                   )
        )
    (cond
      (selected?
        (set-color! font-ctx (font-color font-color-34))
        (draw-generic-highlight (the int (- (-> font-ctx origin y) 2.0)) HIGHLIGHT_SIZE_LARGE alpha)
        )
      ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
       (set-color! font-ctx (font-color font-color-33))
       (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) HIGHLIGHT_SIZE alpha)
       )
      (else
        (set-color! font-ctx (font-color font-color-32))
        )
      )
    (print-game-text (lookup-text! *common-text* (-> this name) #f) font-ctx #f 44 (bucket-id hud-draw-hud-alpha))
    (+! (-> font-ctx origin y) 18.0)
    (set-scale! font-ctx FONT_SIZE_OPTION_EXTRA)
    (cond
      (selected?
        (let* ((edit (-> this edit))
               (len (length edit))
               (cur (min (-> this cursor) len))
               )
          (copyn-string<-charp *mp-text-before* (-> edit data) cur)
          (if (< cur len)
              (string<-charp *mp-text-after* (&-> edit data (+ cur 1)))
              (clear *mp-text-after*)
              )
          (format
            (clear *progress-generic-temp-string*)
            "~1L~S~33L~C~1L~S"
            *mp-text-before*
            (if (< cur len)
                (-> edit data cur)
                95 ;; "_" marks the end, where up / down add a character
                )
            *mp-text-after*
            )
          )
        )
      (else
        (format (clear *progress-generic-temp-string*) "~S" ((-> this get-value)))
        )
      )
    (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id hud-draw-hud-alpha))
    )
  (none)
  )

;; A yes / no confirmation that only acts on yes. The stock menu-generic-confirm-option calls its
;; action on confirm whatever the choice (pc/progress/progress-generic-pc.gc).
(deftype menu-mp-confirm-option (menu-generic-confirm-option)
  ()
  )

(defmethod call-on-confirm ((this menu-mp-confirm-option))
  "Run the action only when the player chose yes."
  (when (and (-> this confirmed?) (nonzero? (-> this on-confirm)) (-> this on-confirm))
    (set! (-> this confirmed?) #f)
    ((-> this on-confirm))
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Administration (host)
;; ------------------------------------------------------------------------------------------------

;; Player chosen in the administration page, -1 for none.
(define *mp-admin-slot* -1)

(defun mp-admin-index ()
  "Position of the chosen player in the carousel."
  (let ((n 0))
    (dotimes (i MP_MAX_PLAYERS)
      (when (-> *mp-players* valid i)
        (if (= i *mp-admin-slot*)
            (return n)
            )
        (+! n 1)
        )
      )
    )
  0
  )

(defun mp-admin-no-player? ()
  "#t when no connected player is chosen."
  (not (mp-remote-state *mp-admin-slot*))
  )

(defun mp-admin-kick ((ban symbol))
  "Disconnect the chosen player (and refuse its address until the server stops, with `ban`)."
  (when (mp-remote-state *mp-admin-slot*)
    (string<-charp *mp-temp-string* (-> *mp-players* state *mp-admin-slot* name))
    (format (clear *mp-message*) (if ban "~S was banned" "~S was kicked") *mp-temp-string*)
    (set! (-> *mp-globals* message-time) (mp-now))
    (pc-mp-kick *mp-admin-slot* ban)
    (set! *mp-admin-slot* -1)
    )
  (none)
  )

(defun mp-admin-bring ((all? symbol))
  "Teleport the chosen player (or everyone) to the host."
  (when (or all? (mp-remote-state *mp-admin-slot*))
    (mp-send-event (mp-event-kind teleport) (if all? -1 *mp-admin-slot*) *mp-local-slot* 0.0)
    (mp-show-message "Teleport sent")
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Start menu pages
;; ------------------------------------------------------------------------------------------------

(define *mp-menu-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-multiplayer)
    (new 'static 'menu-mp-label-option
      :name (text-id progress-mp-multiplayer)
      :should-disable? (lambda () #t)
      :get-label (lambda () (mp-status-text))
      )
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-name)
      :get-value (lambda () *mp-name*)
      :charset "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_ "
      :max-length 15
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-character)
      :items (new 'static 'boxed-array :type text-id (text-id progress-mp-jak) (text-id progress-mp-daxter))
      :get-item-index-fn (lambda () (-> *mp-config* character))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* character) index)
                    (mp-config-save!)
                    (none)
                    )
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-color)
      :items (new 'static 'boxed-array :type text-id
               (text-id progress-mp-color-white)
               (text-id progress-mp-color-red)
               (text-id progress-mp-color-blue)
               (text-id progress-mp-color-green)
               (text-id progress-mp-color-yellow)
               (text-id progress-mp-color-purple)
               (text-id progress-mp-color-orange)
               (text-id progress-mp-color-cyan)
               (text-id progress-mp-color-pink)
               (text-id progress-mp-color-gray)
               )
      :get-item-index-fn (lambda () (-> *mp-config* color))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* color) index)
                    (mp-config-save!)
                    (none)
                    )
      )
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-address)
      :get-value (lambda () *mp-address*)
      :charset "0123456789.:abcdefghijklmnopqrstuvwxyz-"
      :max-length 31
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-mp-mode)
      :items (new 'static 'boxed-array :type text-id (text-id progress-mp-mode-free) (text-id progress-mp-mode-coop))
      :get-item-index-fn (lambda () (-> *mp-config* mode))
      :on-confirm (lambda ((index int) (the-progress progress))
                    (set! (-> *mp-config* mode) index)
                    (mp-config-save!)
                    ;; a host switches its running server too
                    (if (= *mp-mode* (mp-mode host))
                        (mp-apply-mode!)
                        )
                    (none)
                    )
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-host)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-host!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-join)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-join!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-leave)
      :should-disable? (lambda () (= *mp-mode* (mp-mode offline)))
      :on-confirm (lambda ((the-progress progress)) (mp-leave!) (none))
      )
    (progress-new-generic-link-to-scrolling-page (text-id progress-mp-admin)
      :should-disable? (lambda () (!= *mp-mode* (mp-mode host)))
      (new 'static 'menu-mp-label-option
        :name (text-id progress-mp-admin)
        :should-disable? (lambda () #t)
        :get-label (lambda () (mp-status-text))
        )
      (new 'static 'menu-generic-carousel-option
        :name (text-id progress-mp-player)
        :get-max-size-fn (lambda () (mp-player-count))
        :get-item-label-fn (lambda ((index int)) (mp-player-label index *mp-menu-label*) *mp-menu-label*)
        :get-item-index-fn (lambda () (mp-admin-index))
        :on-confirm (lambda ((index int) (the-progress progress)) (set! *mp-admin-slot* (mp-nth-player-slot index)) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-kick)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-kick #f) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-ban)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-kick #t) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-bring)
        :should-disable? (lambda () (mp-admin-no-player?))
        :on-confirm (lambda ((the-progress progress)) (mp-admin-bring #f) (none))
        )
      (new 'static 'menu-generic-button-option
        :name (text-id progress-mp-bring-all)
        :on-confirm (lambda ((the-progress progress)) (mp-admin-bring #t) (none))
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-allow-cheats)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag cheats)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag cheats))
                          (logclear! *mp-world* (mp-world-flag cheats))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-pvp)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag pvp)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag pvp))
                          (logclear! *mp-world* (mp-world-flag pvp))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-share-progress)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag progress)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag progress))
                          (logclear! *mp-world* (mp-world-flag progress))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-mp-sync-time)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (logtest? *mp-world* (mp-world-flag sync-time)))
        :on-confirm (lambda ((val symbol))
                      (if val
                          (logior! *mp-world* (mp-world-flag sync-time))
                          (logclear! *mp-world* (mp-world-flag sync-time))
                          )
                      (none)
                      )
        )
      (new 'static 'menu-mp-confirm-option
        :name (text-id progress-mp-stop)
        :on-confirm (lambda () (mp-leave!) (none))
        )
      )
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Title screen and lobby
;;
;; The way into a session follows himstan's Jak and Daxter II Multiplayer
;; (https://github.com/himstan/Jak-And-Daxter-2-Multiplayer, goal_src/jak2/multiplayer/ui/
;; mp-lobby-progress.gc, ISC license): Host Game and Join Game on the title screen; the host picks
;; a new game or a save, then everyone waits in a lobby that lists the players on the left and
;; details the selected one on the right, with his keys: X ready (guest) or start (host, once every
;; guest is ready), L1 / R1 character, circle multiplayer options, triangle leave. Written anew for
;; Jak 3's menus, with these differences: square switches the game mode (the host chooses free roam
;; or co-op here), the host starts at once (no countdown), and guests join by address.
;; ------------------------------------------------------------------------------------------------

;; Title screen entries, shown while the mod is enabled (mp-update-title).
(define *mp-title-host*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-host-game) :next-state 'mp-host-game)
  )

(define *mp-title-join*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-join-game) :next-state 'mp-join-game)
  )

;; The stock entries (New Game, Load Game, Options, Secrets, Quit) and their heights, captured once
;; (a REPL reload must not capture the modded ones).
(define-perm *mp-stock-title* (array menu-option) (-> *title-pc* options))

(define-perm *mp-stock-title-offsets* (array float)
  (let ((offsets (new 'global 'boxed-array float (-> *mp-stock-title* length))))
    (dotimes (i (-> *mp-stock-title* length))
      (set! (-> offsets i) (-> *mp-stock-title* i offset-y))
      )
    offsets
    )
  )

(define *mp-title-options* (new 'global 'boxed-array menu-option 7))

(defun mp-update-title ()
  "Title screen list: Host Game and Join Game after Load Game while the mod is enabled, the stock list
   otherwise. Until Secrets is unlocked, the stock skips index 3 when moving and draws the entries
   0.08 lower and Quit 0.07 higher (pc/progress/progress-generic-pc.gc, progress-draw-pc.gc), so the
   hidden Secrets entry stays at index 3. Called every frame and when the title menu opens."
  (let ((stock *mp-stock-title*)
        (arr *mp-title-options*)
        )
    (cond
      ((not (mp-enabled?))
       (dotimes (i (-> stock length))
         (set! (-> stock i offset-y) (-> *mp-stock-title-offsets* i))
         )
       (set! (-> *title-pc* options) stock)
       )
      (else
        (let ((locked? (not (memcard-unlocked-secrets? #f #f)))
              (shown 0)
              )
          (set! (-> arr 0) (-> stock 0))
          (set! (-> arr 1) (-> stock 1))
          (set! (-> arr 2) *mp-title-host*)
          (set! (-> arr 3) (if locked? (-> stock 3) *mp-title-join*))
          (set! (-> arr 4) (if locked? *mp-title-join* (-> stock 2)))
          (set! (-> arr 5) (if locked? (-> stock 2) (-> stock 3)))
          (set! (-> arr 6) (-> stock 4))
          ;; the entries shown 0.1 apart as drawn: from 0.15 (seven) or 0.2 (six, Secrets hidden)
          (dotimes (i 7)
            (cond
              ((not locked?)
               (set! (-> arr i offset-y) (+ 0.15 (* 0.1 (the float i))))
               )
              ((!= (-> arr i) (-> stock 3))
               (set! (-> arr i offset-y) (+ 0.2 (* 0.1 (the float shown)) (if (= i 6) 0.07 -0.08)))
               (+! shown 1)
               )
              )
            )
          )
        (set! (-> *title-pc* options) arr)
        )
      )
    )
  (none)
  )

;; Host Game: a new game or a save, then the lobby (the server starts with it).
(define *mp-host-game-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-sub-menu-option :name (text-id progress-title-new-game) :offset-y 0.3 :next-state 'mp-lobby-new)
      (new 'static 'menu-sub-menu-option :name (text-id progress-load-save) :offset-y 0.45 :next-state 'mp-lobby-load)
      )
    )
  )

;; Join Game: the host's address, then the lobby.
(define *mp-join-game-options*
  (progress-new-generic-scrolling-page (text-id progress-mp-join-game)
    (new 'static 'menu-mp-text-option
      :name (text-id progress-mp-address)
      :get-value (lambda () *mp-address*)
      :charset "0123456789.:abcdefghijklmnopqrstuvwxyz-"
      :max-length 31
      :on-confirm (lambda () (mp-config-save!) (none))
      )
    (new 'static 'menu-generic-button-option
      :name (text-id progress-mp-connect)
      :on-confirm (lambda ((the-progress progress))
                    (mp-join!)
                    (push-state the-progress)
                    (set-next-state the-progress 'mp-lobby-join 0)
                    (none)
                    )
      )
    )
  )

;; The lobby page: a single option that draws the whole page and reads its keys.
(deftype menu-mp-lobby-option (menu-option)
  ((selected int32) ;; row of the player detailed on the right
   )
  )

(define *mp-lobby-options*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 15
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-mp-lobby-option :name (text-id progress-mp-lobby))
      )
    )
  )

;; Where the host's start goes: the save menu of a new game ('select-save-title) or of a save to
;; load ('select-load), chosen on the Host Game page.
(define *mp-lobby-start* 'select-save-title)

(define *mp-lobby-line* (new 'global 'string 128 (the-as string #f)))

(defun mp-lobby-slot ((row int))
  "Slot of the player on lobby row `row`: everyone in slot order (the host first), ourselves
   included; -1 (ourselves) before the server gave us a slot."
  (dotimes (i MP_MAX_PLAYERS)
    (when (or (= i *mp-local-slot*) (mp-remote-state i))
      (if (zero? row)
          (return i)
          )
      (+! row -1)
      )
    )
  -1
  )

(defun mp-slot-state ((slot int))
  "A player's state, ours included (slot -1 is ours before we have a slot)."
  (if (or (< slot 0) (= slot *mp-local-slot*))
      *mp-local*
      (mp-remote-state slot)
      )
  )

(defun mp-lobby-coop? ()
  "#t when the session's game mode is co-op. The host chooses it; a guest reads it in the host's
   state (its world event only comes once the host plays)."
  (if (= *mp-mode* (mp-mode client))
      (let ((host (mp-remote-state 0)))
        (and host (logtest? (-> host flags) (mp-flag coop)))
        )
      (= (-> *mp-config* mode) 1)
      )
  )

(defun mp-lobby-all-ready? ()
  "#t when every connected guest said it is ready (always with no guest)."
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i)))
      (if (and st (not (logtest? (-> st flags) (mp-flag ready))))
          (return #f)
          )
      )
    )
  #t
  )

(defun mp-lobby-status-id ((st mp-player-state) (slot int))
  "What the lobby says of a player: host, ready or not ready."
  (cond
    ((or (zero? slot) (and (< slot 0) (= *mp-mode* (mp-mode host))))
     (text-id progress-mp-role-host)
     )
    ((logtest? (-> st flags) (mp-flag ready))
     (text-id progress-mp-ready)
     )
    (else
      (text-id progress-mp-not-ready)
      )
    )
  )

(defun mp-lobby-print ((ctx font-context) (str string) (x float) (y float) (width float) (scale float) (color font-color))
  "Print `str` at x, y in a box `width` wide, with the font flags already set."
  (set! (-> ctx origin x) x)
  (set! (-> ctx origin y) y)
  (set-width! ctx (the int width))
  (set-scale! ctx scale)
  (set-color! ctx color)
  (print-game-text str ctx #f 44 (bucket-id hud-draw-hud-alpha))
  (none)
  )

(defun mp-lobby-draw-square ((x int) (y int) (color int))
  "A player's color square, as in the player list."
  (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id hud-draw-hud-alpha))
    (dma-buffer-add-gs-set-flusha buf
                                  (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                  (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                  )
    (draw-sprite2d-xy buf x y 9 9 (new 'static 'rgba :a #x80) #x3fffff)
    (draw-sprite2d-xy buf (+ x 1) (+ y 1) 7 7 (mp-color-rgba color) #x3fffff)
    )
  (none)
  )

(defmethod draw-option ((this menu-mp-lobby-option) (progress progress) (font-ctx font-context) (option-index int) (selected? symbol))
  "The lobby: session status and game mode, the players on the left, the selected one on the right,
   a hint and the keys at the bottom."
  (let* ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> progress menu-transition)))))
         (wide? (= (get-aspect-ratio) 'aspect16x9))
         ;; the page's frame (draw-page-border), squeezed to the screen's aspect ratio as the stock
         ;; pages' scissor is (begin-scissor-scrolling-page)
         (vis? (-> *pc-settings* use-vis?))
         (x0 (if wide? 79.0 70.0))
         (x1 (if wide? 435.0 445.0))
         (left (+ 8.0 (if vis? x0 (the float (adjust-game-x x0)))))
         (width (- (if vis? x1 (the float (adjust-game-x x1))) left 8.0))
         (top (if wide? 86.0 112.0))
         (bottom (if wide? 362.0 329.0))
         (rows (+ 1 (mp-player-count)))
         (row-top (+ top 42.0))
         (row-h (fmin 20.0 (/ (- bottom 72.0 row-top) (the float (max rows 4)))))
         (sel (max 0 (min (-> this selected) (+ rows -1))))
         (host? (!= *mp-mode* (mp-mode client)))
         (host-st (mp-remote-state 0))
         (detail-x (+ left (* 0.6 width)))
         (detail-w (* 0.38 width))
         (hint (the-as text-id 0))
         )
    (set! (-> this selected) sel)
    (set! (-> font-ctx alpha) alpha)
    (draw-page-header font-ctx (text-id progress-mp-lobby) alpha)
    ;; session status and game mode, centered
    (set-flags! font-ctx (font-flags kerning middle large))
    (mp-lobby-print font-ctx (mp-status-text) left top width 0.45 (font-color font-color-32))
    (format (clear *mp-lobby-line*) "~S: ~S"
            (lookup-text! *common-text* (text-id progress-mp-mode) #f)
            (lookup-text! *common-text* (if (mp-lobby-coop?) (text-id progress-mp-mode-coop) (text-id progress-mp-mode-free)) #f)
            )
    (mp-lobby-print font-ctx *mp-lobby-line* left (+ top 17.0) width 0.45 (font-color font-color-32))
    ;; the players: color, name and status, the selected one highlighted
    (set-flags! font-ctx (font-flags kerning large))
    (dotimes (row rows)
      (let* ((slot (mp-lobby-slot row))
             (st (mp-slot-state slot))
             (y (+ row-top (* row-h (the float row))))
             (color (if (= row sel) (font-color font-color-33) (font-color font-color-32)))
             )
        (when st
          (mp-lobby-draw-square (the int (+ left 14.0)) (the int (+ y 3.0)) (-> st color))
          (string<-charp *mp-lobby-line* (-> st name))
          (mp-lobby-print font-ctx *mp-lobby-line* (+ left 28.0) y (* 0.4 width) 0.45 color)
          (mp-lobby-print font-ctx (lookup-text! *common-text* (mp-lobby-status-id st slot) #f)
                          (+ left (* 0.42 width)) (+ y 2.0) (* 0.17 width) 0.35 color
                          )
          )
        )
      )
    ;; the selected player: name, character, ping, status
    (let* ((slot (mp-lobby-slot sel))
           (st (mp-slot-state slot))
           )
      (when st
        (string<-charp *mp-lobby-line* (-> st name))
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x row-top detail-w 0.55 (font-color font-color-33))
        (format (clear *mp-lobby-line*) "~S: ~S"
                (lookup-text! *common-text* (text-id progress-mp-character) #f)
                (lookup-text! *common-text* (if (= (logand (-> st character) 15) 1) (text-id progress-mp-daxter) (text-id progress-mp-jak)) #f)
                )
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x (+ row-top 24.0) detail-w 0.42 (font-color font-color-32))
        (let ((ping (pc-mp-player-ping slot)))
          (if (< ping 0)
              (format (clear *mp-lobby-line*) "~S: --" (lookup-text! *common-text* (text-id progress-mp-col-ping) #f))
              (format (clear *mp-lobby-line*) "~S: ~D ms" (lookup-text! *common-text* (text-id progress-mp-col-ping) #f) ping)
              )
          )
        (mp-lobby-print font-ctx *mp-lobby-line* detail-x (+ row-top 42.0) detail-w 0.42 (font-color font-color-32))
        (mp-lobby-print font-ctx (lookup-text! *common-text* (mp-lobby-status-id st slot) #f)
                        detail-x (+ row-top 60.0) detail-w 0.42 (font-color font-color-32)
                        )
        )
      )
    ;; a hint: the co-op duo for a guest with the host's character, then what everyone waits for
    (cond
      ((and (not host?) host-st (mp-lobby-coop?)
            (= (logand (-> host-st character) 15) (logand (-> *mp-local* character) 15))
            )
       (set! hint (text-id progress-mp-coop-offer))
       )
      ((and (not host?) *mp-lobby-ready*)
       (set! hint (text-id progress-mp-lobby-wait))
       )
      ((and host? (not (mp-lobby-all-ready?)))
       (set! hint (text-id progress-mp-lobby-not-ready))
       )
      )
    (set-flags! font-ctx (font-flags kerning middle large))
    (if (nonzero? hint)
        (mp-lobby-print font-ctx (lookup-text! *common-text* hint #f) left (- bottom 66.0) width 0.4 (font-color font-color-33))
        )
    (mp-lobby-print font-ctx
                    (lookup-text! *common-text* (if host? (text-id progress-mp-lobby-keys-host) (text-id progress-mp-lobby-keys-guest)) #f)
                    left (- bottom 46.0) width 0.4 (font-color font-color-32)
                    )
    (mp-lobby-print font-ctx (lookup-text! *common-text* (text-id progress-mp-lobby-keys-2) #f)
                    left (- bottom 28.0) width 0.4 (font-color font-color-32)
                    )
    )
  (none)
  )

(defmethod respond-progress ((this menu-mp-lobby-option) (progress progress) (selected? symbol))
  "The lobby keys: up / down choose the player detailed, X ready (guest) or start (host, once every
   guest is ready), L1 / R1 character, square game mode (host), circle multiplayer options, triangle
   leave (the stock respond-to-cpad then goes back a page)."
  (let ((host? (!= *mp-mode* (mp-mode client))))
    (cond
      ((cpad-pressed? 0 up l-analog-up)
       (cpad-clear! 0 up l-analog-up)
       (set! (-> this selected) (max 0 (+ (-> this selected) -1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 down l-analog-down)
       (cpad-clear! 0 down l-analog-down)
       (set! (-> this selected) (min (mp-player-count) (+ (-> this selected) 1)))
       (sound-play "roll-over")
       )
      ((cpad-pressed? 0 confirm)
       (cpad-clear! 0 confirm)
       (cond
         ((= *mp-mode* (mp-mode client))
          (set! *mp-lobby-ready* (not *mp-lobby-ready*))
          (sound-play "generic-beep")
          )
         ((and (= *mp-mode* (mp-mode host)) (mp-lobby-all-ready?))
          (sound-play "window-expand")
          (push-state progress)
          (set-next-state progress *mp-lobby-start* 0)
          )
         (else
           (sound-play "roll-over")
           )
         )
       )
      ((cpad-pressed? 0 l1 r1)
       (cpad-clear! 0 l1 r1)
       (cond
         ((and (not host?) *mp-lobby-ready*)
          (sound-play "roll-over")
          )
         (else
           (set! (-> *mp-config* character) (if (= (-> *mp-config* character) 1) 0 1))
           (mp-config-save!)
           (sound-play "generic-beep")
           )
         )
       )
      ((and host? (cpad-pressed? 0 square))
       (cpad-clear! 0 square)
       (set! (-> *mp-config* mode) (if (= (-> *mp-config* mode) 1) 0 1))
       (mp-config-save!)
       (mp-apply-mode!)
       (sound-play "generic-beep")
       )
      ((cpad-pressed? 0 circle)
       (cpad-clear! 0 circle)
       (sound-play "window-expand")
       (push-state progress)
       (set-next-state progress 'multiplayer 0)
       )
      ((cpad-pressed? 0 triangle)
       (mp-leave!)
       )
      )
    )
  0
  )

;; MOD multiplayer -- route the multiplayer pages (START > Options > Multiplayer, the title screen's
;; Host Game and Join Game, the lobby) and let every other page through the stock method
;; (pc/progress/progress-pc.gc). define-perm keeps the stock method when this file is reloaded in a
;; REPL session.
(define-perm *mp-stock-set-menu-options* (function progress symbol int)
  (the-as (function progress symbol int) (method-of-type progress set-menu-options))
  )

(defmethod set-menu-options ((this progress) (arg0 symbol))
  "Stock behavior, plus the multiplayer pages."
  (case arg0
    (('multiplayer)
     (set! (-> this current-options) *mp-menu-options*)
     0
     )
    (('mp-host-game)
     (set! (-> this current-options) *mp-host-game-options*)
     0
     )
    (('mp-join-game)
     ;; on the address, nothing left selected from the last visit
     (set! (-> (the-as menu-generic-scrolling-page (-> *mp-join-game-options* options 0)) selected-option-index) -1)
     (set! (-> *progress-pc-generic-store* current-menu-hover-index) 0)
     (set! (-> this current-options) *mp-join-game-options*)
     0
     )
    (('mp-lobby-new 'mp-lobby-load 'mp-lobby-join)
     ;; a host's server starts with its lobby (mp-host! does nothing once hosting)
     (when (!= arg0 'mp-lobby-join)
       (set! *mp-lobby-start* (if (= arg0 'mp-lobby-new) 'select-save-title 'select-load))
       (mp-host!)
       )
     (set! (-> this current-options) *mp-lobby-options*)
     0
     )
    (else
      (if (= arg0 'title)
          (mp-update-title)
          )
      (*mp-stock-set-menu-options* this arg0)
      )
    )
  )

;; The Options page entry, added to the stock list while the mod is enabled. The page places its
;; entries at fractions of its height (offset-y), so the entries are spread again to make room.
(define *mp-options-entry*
  (new 'static 'menu-sub-menu-option :name (text-id progress-mp-multiplayer) :offset-y 0.8 :next-state 'multiplayer)
  )

(define-perm *mp-stock-options* (array menu-option) (-> *options-options-pc* options))

;; The stock entries' offsets, captured once (a REPL reload must not capture the spread ones).
(define-perm *mp-stock-offsets* (array float)
  (let ((offsets (new 'global 'boxed-array float (-> *mp-stock-options* length))))
    (dotimes (i (-> *mp-stock-options* length))
      (set! (-> offsets i) (-> *mp-stock-options* i offset-y))
      )
    offsets
    )
  )

(define *mp-options-with-entry* (new 'global 'boxed-array menu-option (+ (-> *mp-stock-options* length) 1)))

(dotimes (i (-> *mp-stock-options* length))
  (set! (-> *mp-options-with-entry* i) (-> *mp-stock-options* i))
  )

(set! (-> *mp-options-with-entry* (-> *mp-stock-options* length)) *mp-options-entry*)

(defun mp-update-options-entry ()
  "Show the Multiplayer entry in START > Options only while the mod is enabled."
  (let ((n (-> *mp-stock-options* length)))
    (cond
      ((mp-enabled?)
       ;; n + 1 entries over the stock span (first to last offset)
       (let* ((first (-> *mp-stock-offsets* 0))
              (step (/ (- (-> *mp-stock-offsets* (+ n -1)) first) (the float n)))
              )
         (dotimes (i (+ n 1))
           (set! (-> *mp-options-with-entry* i offset-y) (+ first (* step (the float i))))
           )
         )
       (set! (-> *options-options-pc* options) *mp-options-with-entry*)
       )
      (else
        (dotimes (i n)
          (set! (-> *mp-stock-options* i offset-y) (-> *mp-stock-offsets* i))
          )
        (set! (-> *options-options-pc* options) *mp-stock-options*)
        )
      )
    )
  (none)
  )

(mp-update-options-entry)

;; ------------------------------------------------------------------------------------------------
;; Cheats and teleports (Mods menu)
;; ------------------------------------------------------------------------------------------------

(defun mp-set-enabled! ((on? symbol))
  "Turn the mod on or off, remember it between boots."
  (set! (-> *mp-config* enabled) (if on? 1 0))
  (mp-config-save!)
  (mp-update-options-entry)
  (mp-update-title)
  (none)
  )

(defun mp-cheat-ammo ()
  "Refill every gun's ammo to its current maximum."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* gun-ammo 0) (get-max-ammo-for-gun *game-info* (pickup-type ammo-yellow)))
    (set! (-> *game-info* gun-ammo 1) (get-max-ammo-for-gun *game-info* (pickup-type ammo-red)))
    (set! (-> *game-info* gun-ammo 2) (get-max-ammo-for-gun *game-info* (pickup-type ammo-blue)))
    (set! (-> *game-info* gun-ammo 3) (get-max-ammo-for-gun *game-info* (pickup-type ammo-dark)))
    (mp-show-message "Ammo refilled")
    )
  (none)
  )

(defun mp-cheat-health ()
  "Restore full health."
  (when (and (mp-cheats-allowed?) *target*)
    (set! (-> *target* fact health) (-> *target* fact health-max))
    (mp-show-message "Health restored")
    )
  (none)
  )

(defun mp-cheat-dark-eco ()
  "Fill the dark eco meter."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* eco-pill-dark) (-> *FACT-bank* eco-pill-dark-max-default))
    (mp-show-message "Dark eco restored")
    )
  (none)
  )

(defun mp-cheat-light-eco ()
  "Fill the light eco meter."
  (when (mp-cheats-allowed?)
    (set! (-> *game-info* eco-pill-light) (-> *FACT-bank* eco-pill-light-max-default))
    (mp-show-message "Light eco restored")
    )
  (none)
  )

(defun mp-teleport-zone ((index int))
  "Go to zone `index` of *mp-zones* (through its continue point)."
  (when (and (mp-cheats-allowed?) *target* (>= index 0) (< (* 2 index) (-> *mp-zones* length)))
    (let ((cp (get-continue-by-name *game-info* (-> *mp-zones* (+ (* 2 index) 1)))))
      (if cp
          (send-event *target* 'continue cp)
          (mp-show-message "Unknown zone")
          )
      )
    )
  (none)
  )

(defun mp-teleport-player ((index int))
  "Go to the index-th connected player (applied by the manager on its next frame)."
  (when (and (mp-cheats-allowed?) (>= (mp-nth-player-slot index) 0))
    (set! *mp-request-teleport* (mp-nth-player-slot index))
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Mods menu
;; ------------------------------------------------------------------------------------------------

(define *mod-multiplayer-menu*
  (new 'static 'popup-menu-submenu :label "multiplayer"
    :entries (new 'static 'boxed-array :type popup-menu-entry
      (new 'static 'popup-menu-flag :label "Enable multiplayer (START > Options)"
           :is-toggled? (lambda () (mp-enabled?))
           :on-confirm (lambda () (mp-set-enabled! (not (mp-enabled?))) (none))
           )
      (new 'static 'popup-menu-button :label "Refill ammo"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-ammo) (none))
           )
      (new 'static 'popup-menu-button :label "Restore health"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-health) (none))
           )
      (new 'static 'popup-menu-button :label "Restore dark eco"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-dark-eco) (none))
           )
      (new 'static 'popup-menu-button :label "Restore light eco"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :on-confirm (lambda () (mp-cheat-light-eco) (none))
           )
      (new 'static 'popup-menu-flag :label "Invincible"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :is-toggled? (lambda () *mp-invulnerable*)
           :on-confirm (lambda () (set! *mp-invulnerable* (and (not *mp-invulnerable*) (mp-cheats-allowed?))) (none))
           )
      (new 'static 'popup-menu-dynamic-submenu :label "Teleport to a zone"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :get-length (lambda () (/ (-> *mp-zones* length) 2))
           :get-entry-label (lambda ((index int) (dst string)) (copy-string<-string dst (-> *mp-zones* (* 2 index))) (none))
           :on-entry-confirm (lambda ((index int)) (mp-teleport-zone index) (none))
           :entry-selected? (lambda ((index int)) #f)
           :on-reset (lambda () (none))
           )
      (new 'static 'popup-menu-dynamic-submenu :label "Teleport to a player"
           :entry-disabled? (lambda () (not (mp-cheats-allowed?)))
           :get-length (lambda () (mp-player-count))
           :get-entry-label (lambda ((index int) (dst string)) (mp-player-label index dst) (none))
           :on-entry-confirm (lambda ((index int)) (mp-teleport-player index) (none))
           :entry-selected? (lambda ((index int)) #f)
           :on-reset (lambda () (none))
           )
      )
    )
  )

(defun mod-multiplayer-build-menu ()
  "Return this mod's entry for the Mods menu (pure: the menu is static)."
  (the-as popup-menu-entry *mod-multiplayer-menu*)
  )

(mods-menu-register "multiplayer" mod-multiplayer-build-menu)
