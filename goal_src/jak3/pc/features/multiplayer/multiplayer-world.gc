;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer-world.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- shared world. Objects are replicated 15 times a second (position,
;; orientation, animation, body variant) from the player who simulates them to the others, who draw
;; them as replicas built from the same skeleton, interpolated 100 ms in the past by the runtime
;; (game/kernel/jak3/kmultiplayer.cpp) with the owner's clock, like the owner's own puppet:
;;   - the NPCs: every character (the `enemy` family: citizens, guards, monsters, marauders...),
;;     vehicle and wheel simulated near a player by that player's authority. The host is the
;;     authority of everyone near it; a guest farther than 90 m from every authority simulates
;;     its own world and becomes the authority of the guests near it (mp-update-authority).
;;     A player who is not an authority does not simulate its own NPCs (ambient traffic off,
;;     its own actors asleep, hidden and intangible);
;;   - every player's props: Daxter on the shoulder, the gun, the vehicle driven and its wheels.
;;
;; With each batch go the full poses of the player, of its props and of every NPC sent (every bone,
;; so blends, streamed animations, joint mods and ragdolls look the same everywhere), and the
;; particle emitters and sounds each of them used (see "Poses and emitters" below).
;;
;; A blow or shot on a replica is sent to its owner, which applies it to the real object with the
;; attacker's puppet as the attacker; the reaction and the death come back as its state. A guest
;; who presses triangle next to one of the host's NPC vehicles gets the same vehicle, and the host
;; removes its own.
;;
;; Called from the manager (multiplayer.gc) every unpaused frame.

;; ------------------------------------------------------------------------------------------------
;; Types (mp-actor-state mirrors mp::ActorState)
;; ------------------------------------------------------------------------------------------------

(defconstant MP_MAX_ACTORS 64)    ;; NPCs the host sends per batch
(defconstant MP_MAX_REPLICAS 128) ;; NPCs a guest draws (a batch, plus the ones fading out)

(defenum mp-actor-flag
  :type uint16
  :bitfield #t
  (hidden 0)  ;; not drawn on the host
  (dead 1)    ;; dying on the host
  (vehicle 2) ;; a vehicle (else a character)
  (prop 3)    ;; a player's prop (Daxter, gun): drawn, not solid
  (owned 4)   ;; belongs to a player (prop, driven vehicle and wheels), never an NPC
  )

(deftype mp-actor-state (structure)
  ((trans      vector     :inline) ;; w = uniform scale
   (quat       quaternion :inline)
   (id         uint32)             ;; owner slot << 24 | owner process pid
   (anim-index int16)
   (flags      mp-actor-flag)
   (anim-frame float)
   (seg-mask   uint32)             ;; body variant (low half of the draw-control seg-mask)
   (skel       uint8 32)           ;; skeleton-group name
   )
  :size-assert #x50
  )

(deftype mp-actor-table (structure)
  ((count int32)
   (pad   int32 3)
   (state mp-actor-state MP_MAX_REPLICAS :inline)
   )
  )

(define-extern pc-mp-send-actors (function (inline-array mp-actor-state) int none))
(define-extern pc-mp-add-pose (function uint matrix (inline-array matrix) int none))
(define-extern pc-mp-add-emitter (function int int int matrix none))
(define-extern pc-mp-send-poses (function none))
(define-extern pc-mp-get-pose (function uint matrix (inline-array matrix) int int))
(define-extern pc-mp-get-actors (function (inline-array mp-actor-state) int int))
(define-extern mp-player-count (function int)) ;; multiplayer-menu.gc

;; World-sync state that does not fit in 32-bit globals (handles, times).
(deftype mp-world-state (structure)
  ((last-send      time-frame) ;; host: last batch sent (real clock)
   (last-suppress  time-frame) ;; guest: last scan for local NPCs to put to sleep
   (cache-time     time-frame) ;; host: last reset of the skeleton cache
   (traffic-off?   symbol)     ;; guest: ambient traffic turned off by us
   (replica-count  int32)
   (replica-id     uint32 MP_MAX_REPLICAS)
   (replica        handle MP_MAX_REPLICAS)
   (suppressed-count int32)
   (suppressed     handle 256)
   (skel-count     int32)
   (skel-jgeo      art-joint-geo 128)
   (skel-group     skeleton-group 128)
   (level-box      level 1)
   (authority-want  symbol)     ;; role the situation asks for, applied after 2 s
   (authority-since time-frame)
   (served-count   int32)       ;; players whose NPCs we simulate, for the batch being built
   (served-pos     vector 8 :inline)
   (forced-count   int32)       ;; NPCs whose force-math we set (mp-force-math)
   (forced         handle 128)
   )
  )

(define *mp-world-state* (new 'global 'mp-world-state))
(define *mp-actors-out* (new 'global 'mp-actor-table))
(define *mp-actors-in* (new 'global 'mp-actor-table))
(set! (-> *mp-world-state* traffic-off?) #f)

;; Attack modes a guest can deal to an NPC, sent as their index (symbols are not sent).
(define *mp-attack-modes*
  (new 'static 'boxed-array :type symbol
    'generic 'punch 'spin 'uppercut 'flop 'dark-punch 'dark-smack 'lunge 'roll 'bonk 'board
    'eco-yellow 'eco-red 'eco-blue 'eco-dark 'explode 'mech-punch 'flut-attack 'tube
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Which processes are NPCs
;; ------------------------------------------------------------------------------------------------

(defun mp-actor-kind ((proc process))
  "1 for a character (the enemy family), 2 for a vehicle, 3 for a vehicle wheel, 0 otherwise."
  (let ((typ (-> proc type)))
    (dotimes (i 14)
      (let ((name (-> typ symbol)))
        (cond
          ((= name 'enemy) (return 1))
          ((= name 'vehicle) (return 2))
          ((= name 'vehicle-wheel) (return 3))
          ((or (= name 'process-drawable) (= name 'process)) (return 0))
          )
        )
      (set! typ (-> typ parent))
      )
    )
  0
  )

(defun mp-driven-vehicle? ((proc process))
  "#t for the vehicle the local player drives, or one of its wheels (they are the player's props)."
  (when (and *target* (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
    (let ((veh (handle->process (-> *target* pilot vehicle))))
      (and veh (or (= veh proc) (= (ppointer->process (-> proc parent)) veh)))
      )
    )
  )

(defun mp-player-pos ((slot int))
  "Where player `slot` stands (this player included), #f when unknown."
  (if (= slot *mp-local-slot*)
      (if *target*
          (-> *mp-local* trans)
          (the-as vector #f)
          )
      (let ((st (mp-remote-state slot)))
        (if st
            (-> st trans)
            (the-as vector #f)
            )
        )
      )
  )

(defun mp-authority-flag? ((slot int))
  "#t when player `slot` simulates its own NPCs (for this player: its current role)."
  (if (= slot *mp-local-slot*)
      *mp-authority*
      (let ((st (mp-remote-state slot)))
        (and st (logtest? (-> st flags) (mp-flag authority)))
        )
      )
  )

(defun mp-provider-of ((slot int))
  "Slot of the player whose NPCs player `slot` sees: itself when it is an authority, else the first
   authority within 90 m, else the host."
  (if (mp-authority-flag? slot)
      (return slot)
      )
  (let ((pos (mp-player-pos slot)))
    (when pos
      (dotimes (q MP_MAX_PLAYERS)
        (let ((other (mp-player-pos q)))
          (if (and (!= q slot) other (mp-authority-flag? q) (< (vector-vector-distance pos other) (meters 90)))
              (return q)
              )
          )
        )
      )
    )
  0
  )

(defun mp-update-authority ()
  "Pick this player's role. The host always simulates its NPCs. A guest shows the NPCs of a
   lower-slot authority within 60 m, and simulates its own once farther than 90 m from all of them,
   after 2 s in the new situation (a player on the border does not flip every frame)."
  (let* ((ws *mp-world-state*)
         (want (cond
                 ((= *mp-mode* (mp-mode host))
                  #t
                  )
                 ((< *mp-local-slot* 0)
                  #f
                  )
                 (else
                   (let ((me (mp-player-pos *mp-local-slot*))
                         (nearest (meters 1000000))
                         )
                     (when me
                       (dotimes (q *mp-local-slot*)
                         (let ((other (mp-player-pos q)))
                           (if (and other (mp-authority-flag? q))
                               (set! nearest (fmin nearest (vector-vector-distance me other)))
                               )
                           )
                         )
                       )
                     (cond
                       ((< nearest (meters 60)) #f)
                       ((< (meters 90) nearest) #t)
                       (else *mp-authority*)
                       )
                     )
                   )
                 )
               )
         )
    (when (!= want (-> ws authority-want))
      (set! (-> ws authority-want) want)
      (set! (-> ws authority-since) (mp-now))
      )
    (when (and (!= want *mp-authority*)
               (or (= *mp-mode* (mp-mode host)) (>= (- (mp-now) (-> ws authority-since)) (seconds 2)))
               )
      (set! *mp-authority* want)
      (format 0 "[multiplayer] ~S~%" (if want
                                         "this player now simulates the NPCs around it"
                                         "this player now shows another player's NPCs"
                                         )
              )
      )
    )
  (none)
  )

(defun mp-collect-served ()
  "Note where the players whose NPCs we simulate stand, for the batch being built."
  (let ((ws *mp-world-state*))
    (set! (-> ws served-count) 0)
    (when *mp-authority*
      (dotimes (i MP_MAX_PLAYERS)
        (let ((pos (mp-player-pos i)))
          (when (and pos (= (mp-provider-of i) *mp-local-slot*))
            (vector-copy! (-> ws served-pos (-> ws served-count)) pos)
            (+! (-> ws served-count) 1)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-served-distance ((pos vector))
  "Distance from `pos` to the nearest player whose NPCs we simulate."
  (let ((ws *mp-world-state*)
        (best (meters 1000000))
        )
    (dotimes (i (-> ws served-count))
      (set! best (fmin best (vector-vector-distance pos (-> ws served-pos i))))
      )
    best
    )
  )

(defun mp-near-a-player? ((pos vector))
  "Within 100 m of the local player or of a remote player."
  (if (and *target* (< (vector-vector-distance pos (-> *target* control trans)) (meters 100)))
      (return #t)
      )
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i)))
      (if (and st (< (vector-vector-distance pos (-> st trans)) (meters 100)))
          (return #t)
          )
      )
    )
  #f
  )

(defun mp-skel-of ((proc process-drawable))
  "The skeleton-group `proc` was built from. A process keeps only its art group and joint geometry,
   so the active levels' art-group arrays (where defskelgroup registers every skeleton-group) are
   searched for a skeleton-group with that art group and that geometry. Cached per geometry; the
   cache is reset whenever a level loads (see mp-world-send). #f when not found."
  (let ((ws *mp-world-state*)
        (jgeo (-> proc draw jgeo))
        (ag (-> proc draw art-group))
        )
    (dotimes (i (-> ws skel-count))
      (if (= (-> ws skel-jgeo i) jgeo)
          (return (-> ws skel-group i))
          )
      )
    (let ((found (the-as skeleton-group #f)))
      (countdown (li 11)
        (let ((lev (-> *level* level li)))
          (when (and (not found) (or (= (-> lev status) 'active) (= (-> lev status) 'reserved)))
            (let ((arr (-> lev art-group art-group-array)))
              (dotimes (ai (-> arr length))
                (let ((sg (the-as skeleton-group (-> arr ai))))
                  (when (and (not found)
                             sg
                             (type? sg skeleton-group)
                             (string= (-> sg art-group-name) (-> ag name))
                             (>= (-> sg jgeo) 0)
                             (< (-> sg jgeo) (-> ag length))
                             (= (-> ag data (-> sg jgeo)) jgeo)
                             )
                    (set! found sg)
                    )
                  )
                )
              )
            )
          )
        )
      (when (< (-> ws skel-count) 128)
        (set! (-> ws skel-jgeo (-> ws skel-count)) jgeo)
        (set! (-> ws skel-group (-> ws skel-count)) found)
        (+! (-> ws skel-count) 1)
        )
      found
      )
    )
  )

(defun mp-anim-index ((proc process-drawable))
  "Index of the animation `proc` plays on channel 0 in its art group, -1 when none."
  (let ((skel (-> proc skel))
        (ag (-> proc draw art-group))
        )
    (when (> (-> skel active-channels) 0)
      (let ((fg (-> skel root-channel 0 frame-group)))
        (when fg
          (dotimes (i (-> ag length))
            (if (= (-> ag data i) fg)
                (return i)
                )
            )
          )
        )
      )
    )
  -1
  )

;; ------------------------------------------------------------------------------------------------
;; Host: collect and send
;; ------------------------------------------------------------------------------------------------

(define *mp-collect-count* 0)

;; ------------------------------------------------------------------------------------------------
;; Poses and emitters: types (the code is after the replicas)
;; ------------------------------------------------------------------------------------------------

(defconstant MP_MAX_POSE_JOINTS 256)

;; One emitter to draw on a copy, in world space. 80 bytes, mirrors mp::EmitterOut.
(deftype mp-emitter (structure)
  ((kind  int32)  ;; 0 particle group, 1 single launcher (2d system), 2 single launcher (3d)
   (index int32)  ;; in *part-group-id-table* or *part-id-table*
   (count int32)  ;; single launcher: launches to replay now
   (home  int32)  ;; single launcher: hash of the level holding it, 0 = global (mp-level-hash)
   (mat   matrix :inline)
   )
  :size-assert #x50
  )

;; One sound sent with an object (world position), or to play on its copy (position on the copy).
;; 64 bytes, mirrors mp::SoundIO.
(deftype mp-sound (structure)
  ((name  sound-name)
   (id    sound-id) ;; the owner's sound id: the same id over several batches is one lasting sound
   (vol   int32)
   (pitch int32)
   (bend  int32)
   (flags int32)  ;; 1 positional, 2 stopped
   (pad   int32 3)
   (pos   vector :inline)
   )
  :size-assert #x40
  )

(deftype mp-pose-state (structure)
  ((bones       matrix MP_MAX_POSE_JOINTS :inline) ;; scratch: bones sent or received
   (frame       matrix :inline)
   (emitters    mp-emitter 16 :inline)
   ;; objects of the batch being built (same order as *mp-actors-out*)
   (proc        process-drawable MP_MAX_ACTORS)
   ;; emitters used since the last batch by the objects we send (mp-note-emitter)
   (emit-count  int32)
   (emit-pid    int32 32)
   (emit-kind   int32 32)
   (emit-ptr    basic 32)
   (emit-calls  int32 32)
   (emit-origin matrix 32 :inline)
   ;; launcher -> *part-id-table* index, reset with the skeleton cache
   (part-ptr    basic 16)
   (part-index  int32 16)
   (part-next   int32)
   ;; counters for the test log
   (poses-sent     int32)
   (poses-skipped  int32)  ;; poses left out of drawn objects (bones not all fresh): the copy plays
                           ;; the animation
   (poses-hidden   int32)  ;; objects their owner does not draw (hidden, or a moment while teleporting)
   (poses-applied  int32)
   (emitters-sent  int32)
   (emitters-shown int32)
   (emitters-received int32)
   (last-kind      int32)  ;; last emitter received, for the test log
   (last-index     int32)
   (last-home      int32)
   ;; sounds played since the last batch by the objects we send (mp-note-sound), latest call per
   ;; sound id
   (snd-count      int32)
   (snd-pid        int32 24)
   (snd-out        mp-sound 24 :inline)
   ;; recent sound ids of those objects, so a sound-stop on one reaches the others
   (known-pid      int32 32)
   (known-id       sound-id 32)
   (known-next     int32)
   ;; sounds received, and the copies' sounds playing here: copy id, owner's sound id, our id
   (sounds         mp-sound 16 :inline)
   (rsnd-copy      uint32 48)
   (rsnd-remote    sound-id 48)
   (rsnd-local     sound-id 48)
   (rsnd-batches   int32 48)
   (rsnd-time      time-frame 48)
   (sounds-sent    int32)
   (sounds-played  int32)
   )
  )

(define *mp-pose* (new 'global 'mp-pose-state))

(define-extern pc-mp-get-emitters (function uint matrix (inline-array mp-emitter) int int))
(define-extern pc-mp-add-sound (function mp-sound none))
(define-extern pc-mp-get-sounds (function uint matrix (inline-array mp-sound) int int))

(defun mp-add-actor ((proc process-drawable) (flags mp-actor-flag))
  "Add `proc` to the batch being built. #f when it cannot be drawn elsewhere (no skeleton found)."
  (when (and (< *mp-collect-count* MP_MAX_ACTORS)
             (nonzero? (-> proc root))
             (nonzero? (-> proc draw))
             (nonzero? (-> proc skel))
             (nonzero? (-> proc draw jgeo))
             (nonzero? (-> proc draw art-group))
             )
    (let ((sg (mp-skel-of proc)))
      (when sg
        (let ((st (-> *mp-actors-out* state *mp-collect-count*)))
          (vector-copy! (-> st trans) (-> proc root trans))
          (set! (-> st trans w) (-> proc root scale x))
          (quaternion-copy! (-> st quat) (-> proc root quat))
          ;; the runtime puts the owner's slot in the top byte
          (set! (-> st id) (the-as uint (logand (-> proc pid) #xffffff)))
          (set! (-> st anim-index) (mp-anim-index proc))
          (set! (-> st anim-frame) (if (>= (-> st anim-index) 0)
                                       (-> proc skel root-channel 0 frame-num)
                                       0.0
                                       )
                )
          (set! (-> st flags) flags)
          (if (logtest? (-> proc draw status) (draw-control-status no-draw))
              (logior! (-> st flags) (mp-actor-flag hidden))
              )
          (if (and (type? proc process-focusable) (focus-test? (the-as process-focusable proc) dead))
              (logior! (-> st flags) (mp-actor-flag dead))
              )
          (set! (-> st seg-mask) (the-as uint (-> proc draw seg-mask)))
          (copyn-charp<-string (-> st skel) (-> sg name) 32)
          (set! (-> *mp-pose* proc *mp-collect-count*) proc)
          (+! *mp-collect-count* 1)
          (return #t)
          )
        )
      )
    )
  #f
  )

(defun mp-force-math ((proc process-drawable))
  "Have `proc` compute every bone each frame, whatever its level of detail on this screen: the
   players who see its copy up close need its whole pose. Undone by mp-release-math once it is no
   longer sent."
  (let ((ws *mp-world-state*))
    (when (and (nonzero? (-> proc skel))
               (not (logtest? (-> proc skel status) (joint-control-status force-math)))
               (< (-> ws forced-count) 128)
               )
      (logior! (-> proc skel status) (joint-control-status force-math))
      (set! (-> ws forced (-> ws forced-count)) (process->handle proc))
      (+! (-> ws forced-count) 1)
      )
    )
  (none)
  )

(defun mp-release-math ((all? symbol))
  "Clear the force-math we set on NPCs that are no longer in the batch (on every one when `all?`)."
  (let ((ws *mp-world-state*)
        (n 0)
        )
    (dotimes (i (-> ws forced-count))
      (let ((proc (the-as process-drawable (handle->process (-> ws forced i))))
            (keep? #f)
            )
        (when (and proc (not all?))
          (dotimes (j *mp-collect-count*)
            (if (= (logand (-> proc pid) #xffffff) (the-as int (-> *mp-actors-out* state j id)))
                (set! keep? #t)
                )
            )
          )
        (cond
          (keep?
            (set! (-> ws forced n) (-> ws forced i))
            (+! n 1)
            )
          (proc
            (logclear! (-> proc skel status) (joint-control-status force-math))
            )
          )
        )
      )
    (set! (-> ws forced-count) n)
    )
  (none)
  )

(defun mp-collect-actor ((proc process-drawable))
  "iterate-process-tree callback (authority): add `proc` when it is an NPC within 100 m of a player
   whose NPCs we simulate."
  (when (type? proc process-drawable)
    (let ((kind (mp-actor-kind proc)))
      (when (and (> kind 0)
                 (not (mp-driven-vehicle? proc))
                 (< (mp-served-distance (-> proc root trans)) (meters 100))
                 )
        (if (mp-add-actor proc (if (= kind 1)
                                   (mp-actor-flag)
                                   (mp-actor-flag vehicle)
                                   )
                          )
            (mp-force-math proc)
            )
        )
      )
    )
  #f
  )

(defun mp-add-prop ((proc process-drawable))
  "Add a prop attached to the player. Daxter and the gun keep their root still: their root joint is
   computed from one of Jak's joints each frame, so that joint's world transform is sent instead."
  (when (and (mp-add-actor proc (mp-actor-flag prop owned)) (nonzero? (-> proc node-list)))
    (let ((st (-> *mp-actors-out* state (+ *mp-collect-count* -1)))
          (mat (-> proc node-list data 0 bone transform))
          )
      (vector-copy! (-> st trans) (-> mat trans))
      (set! (-> st trans w) 1.0)
      (matrix->quaternion (-> st quat) mat)
      (quaternion-normalize! (-> st quat))
      )
    )
  (none)
  )

(defun mp-collect-props ()
  "Add the local player's props: Daxter on the shoulder, the gun, the vehicle driven and its wheels."
  (when *target*
    (let ((dax (ppointer->process (-> *target* sidekick))))
      (if (and dax (not (focus-test? *target* indax)))
          (mp-add-prop (the-as process-drawable dax))
          )
      )
    (when (nonzero? (-> *target* gun))
      (let ((gun (ppointer->process (-> *target* gun gun))))
        (if gun
            (mp-add-prop (the-as process-drawable gun))
            )
        )
      )
    (when (and (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
      (let ((veh (handle->process (-> *target* pilot vehicle))))
        (when (and veh (type? veh process-drawable))
          (mp-add-actor (the-as process-drawable veh) (mp-actor-flag vehicle owned))
          (let ((child (-> veh child)))
            (while child
              (let ((node (ppointer->process child)))
                (when (and node (type? node process) (= (mp-actor-kind (the-as process node)) 3))
                  (mp-add-actor (the-as process-drawable node) (mp-actor-flag vehicle owned))
                  )
                (set! child (if node
                                (-> node brother)
                                (the-as (pointer process-tree) #f)
                                )
                      )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(define-extern mp-send-poses (function none))

(defun mp-world-send ()
  "Send what this player simulates, 15 times a second: its props, and the NPCs near the players it
   is the authority of; then their poses and emitters."
  (let ((ws *mp-world-state*))
    ;; level art moves when a level loads: forget the cached skeletons then, and every 4 s
    (when (or (-> *level* loading-level) (>= (- (mp-now) (-> ws cache-time)) (seconds 4)))
      (set! (-> ws skel-count) 0)
      (set! (-> ws cache-time) (mp-now))
      (dotimes (i 16)
        (set! (-> *mp-pose* part-ptr i) #f)
        )
      )
    (when (and (> (mp-player-count) 0) (>= (- (mp-now) (-> ws last-send)) (seconds 0.066)))
      (set! (-> ws last-send) (mp-now))
      (set! *mp-collect-count* 0)
      (mp-collect-served)
      (mp-collect-props)
      (if *mp-authority*
          (iterate-process-tree
            *active-pool*
            (the-as (function object object) mp-collect-actor)
            *null-kernel-context*
            )
          )
      (mp-release-math #f)
      (set! (-> *mp-actors-out* count) *mp-collect-count*)
      (pc-mp-send-actors (-> *mp-actors-out* state) *mp-collect-count*)
      (mp-send-poses)
      )
    )
  (none)
  )

(define *mp-search-pid* 0)

(defun mp-process-by-pid ((pid int))
  "The live process with this pid, or #f."
  (set! *mp-search-pid* pid)
  (the-as
    process
    (search-process-tree
      *active-pool*
      (lambda ((p process-tree)) (and (type? p process) (= (-> (the-as process p) pid) *mp-search-pid*)))
      )
    )
  )

(defbehavior mp-on-actor-hit mp-manager ((ev mp-event))
  "Another player hit the replica of one of our objects (an NPC, our vehicle). Apply it to the real
   one, from that player's puppet, so it turns to that player and reacts as if hit here."
  (let ((proc (mp-process-by-pid (-> ev iarg 0)))
        (attacker (handle->process (-> self puppets (max 0 (min (-> ev from) (+ MP_MAX_PLAYERS -1))))))
        (mode (-> *mp-attack-modes* (max 0 (min (-> ev iarg 1) (+ (-> *mp-attack-modes* length) -1)))))
        )
    (when (and proc attacker)
      (format 0 "[multiplayer] player ~D hit ~A (~A, ~f)~%" (-> ev from) proc mode (-> ev fvec w))
      (send-event
        proc
        'attack
        :from attacker
        #f
        (static-attack-info
          :mask (vehicle-impulse-factor)
          ((id (new-attack-id))
           (mode mode)
           (damage (-> ev fvec w))
           (penetrate-using (the-as penetrate (logior (shl (the-as uint (-> ev iarg 3)) 32)
                                                      (logand (the-as uint (-> ev iarg 2)) #xffffffff)
                                                      )
                                    )
                            )
           (attacker (process->handle attacker))
           (vehicle-damage-factor 1.0)
           (vehicle-impulse-factor 1.0)
           )
          )
        )
      )
    )
  (none)
  )

(defbehavior mp-on-vehicle-taken mp-manager ((ev mp-event))
  "A guest took one of our NPC vehicles (it drives its own copy): remove ours."
  (let ((proc (mp-process-by-pid (-> ev iarg 0))))
    (if (and proc (= (mp-actor-kind proc) 2) (not (mp-driven-vehicle? proc)))
        (send-event proc 'go-die)
        )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Guest: replicas
;; ------------------------------------------------------------------------------------------------

;; One NPC of the host, drawn here. It plays the host's animation (and with it the effects the
;; animation carries: footsteps, sounds), takes the host's body variant, and is solid and hittable
;; like the real one. Hits go to the host.
(deftype mp-replica (process-drawable)
  ((root   collide-shape :override)
   (id     uint32)
   (dying? symbol)
   (last-attack uint32)            ;; id of the last attack sent, so one blow counts once
   (fx-group   int32 4)            ;; particle groups the owner's object emits (mp-play-emitters)
   (fx-tracker handle 4)
   (pose-count int32)              ;; poses laid on this copy, and the last count received
   (pose-last  int32)
   (net    mp-actor-state :inline) ;; latest state from the owner
   )
  )

(defun mp-attack-mode-index ((mode symbol))
  "Index of an attack mode in *mp-attack-modes* (0, generic, when unknown)."
  (dotimes (i (-> *mp-attack-modes* length))
    (if (= (-> *mp-attack-modes* i) mode)
        (return i)
        )
    )
  0
  )

(defbehavior mp-replica-hit mp-replica ((attacker process) (info attack-info))
  "The local player hit this replica: send the blow to its owner (the host for an NPC)."
  (when (and (mp-from-local-player? attacker)
             *target*
             (not (and info
                       (logtest? (attack-mask id) (-> info mask))
                       (= (-> info id) (-> self last-attack))
                       )
                  )
             )
    (if (and info (logtest? (attack-mask id) (-> info mask)))
        (set! (-> self last-attack) (-> info id))
        )
    (let ((ev (new 'stack 'mp-event))
          (pen (if (and info (logtest? (attack-mask penetrate-using) (-> info mask)))
                   (the-as uint (-> info penetrate-using))
                   (the-as uint 0)
                   )
               )
          )
      (set! (-> ev kind) (mp-event-kind actor-hit))
      ;; to the object's owner, with the pid it knows
      (set! (-> ev to) (the-as int (shr (-> self id) 24)))
      (set! (-> ev iarg 0) (the-as int (logand (-> self id) #xffffff)))
      (set! (-> ev iarg 1) (if (and info (logtest? (attack-mask mode) (-> info mask)))
                               (mp-attack-mode-index (-> info mode))
                               0
                               )
            )
      (set! (-> ev iarg 2) (the-as int (logand pen #xffffffff)))
      (set! (-> ev iarg 3) (the-as int (shr pen 32)))
      (vector-copy! (-> ev fvec) (-> *target* control trans))
      (set! (-> ev fvec w) (if (and info (logtest? (attack-mask damage) (-> info mask)))
                               (-> info damage)
                               1.0
                               )
            )
      (pc-mp-send-event ev)
      )
    )
  (none)
  )

(defbehavior mp-replica-update mp-replica ()
  "Apply the host's latest state: place, scale, visibility, body variant, animation, death."
  (let ((st (-> self net)))
    (move-to-point! (-> self root) (-> st trans))
    (quaternion-copy! (-> self root quat) (-> st quat))
    (let ((scale (if (< 0.01 (-> st trans w))
                     (-> st trans w)
                     1.0
                     )
                 )
          )
      (set-vector! (-> self root scale) scale scale scale 1.0)
      )
    (cond
      ((logtest? (-> st flags) (mp-actor-flag hidden))
       (logior! (-> self draw status) (draw-control-status no-draw))
       (set! (-> self root root-prim prim-core collide-as) (collide-spec))
       )
      (else
        (logclear! (-> self draw status) (draw-control-status no-draw))
        (set! (-> self root root-prim prim-core collide-as) (-> self root backup-collide-as))
        )
      )
    ;; 0 means the host's NPC does not use body segments: keep the default
    (if (and (nonzero? (-> st seg-mask)) (!= (the-as uint (-> self draw seg-mask)) (-> st seg-mask)))
        (setup-masks (-> self draw) -1 (the-as int (-> st seg-mask)))
        )
    (let* ((ag (-> self draw art-group))
           (idx (-> st anim-index))
           (anim (if (and (>= idx 0) (< idx (-> ag length)))
                     (-> ag data idx)
                     (the-as art-element #f)
                     )
                 )
           )
      (when (and anim (type? anim art-joint-anim))
        (let ((ja-anim (the-as art-joint-anim anim)))
          (ja :group! ja-anim
              :num! (identity (fmax 0.0 (fmin (-> st anim-frame) (the float (+ (-> ja-anim frames num-frames) -1)))))
              )
          )
        )
      )
    ;; the host's NPC died: the stock death dissolve, once
    (when (and (logtest? (-> st flags) (mp-actor-flag dead)) (not (-> self dying?)))
      (set! (-> self dying?) #t)
      (set! (-> self root root-prim prim-core collide-as) (collide-spec))
      (when (nonzero? (-> self skel effect))
        (logior! (-> self skel effect flags) (effect-control-flag ecf1))
        (do-effect (-> self skel effect) "death-default" 0.0 -1)
        )
      )
    )
  (none)
  )

(defstate mp-replica-idle (mp-replica)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (mp-replica-hit proc (the-as attack-info (-> block param 1)))
       #t
       )
      )
    )
  :code (behavior ()
    (loop
      (suspend)
      )
    )
  :post (behavior ()
    (mp-replica-update)
    (mp-play-emitters self (-> self id) (-> self fx-group) (-> self fx-tracker))
    (ja-post)
    )
  )

(defbehavior mp-replica-init-by-other mp-replica ((st mp-actor-state) (sg skeleton-group) (lev level))
  "A replica of the host's NPC `st`, drawn with `sg`, whose art lives in `lev`."
  ;; the art lookup of initialize-skeleton goes through the process's level
  (set! (-> self level) lev)
  (set! (-> self id) (-> st id))
  (set! (-> self dying?) #f)
  (mem-copy! (the-as pointer (-> self net)) (the-as pointer st) (size-of mp-actor-state))
  (let ((vehicle? (logtest? (-> st flags) (mp-actor-flag vehicle)))
        (cshape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player)))
        )
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      ;; props (Daxter, a gun) are only drawn
      (set! (-> prim prim-core collide-as) (cond
                                                ((logtest? (-> st flags) (mp-actor-flag prop)) (collide-spec))
                                                (vehicle? (collide-spec obstacle))
                                                (else (collide-spec enemy))
                                                )
            )
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set! (-> prim prim-core action) (collide-action solid))
      ;; a vehicle's sphere is centered low: the underside of a sphere standing above the ground
      ;; is a ceiling that makes a player next to it crouch
      (if vehicle?
          (set-vector! (-> prim local-sphere) 0.0 (meters -0.5) 0.0 (meters 2.2))
          (set-vector! (-> prim local-sphere) 0.0 (meters 1) 0.0 (meters 0.8))
          )
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) prim)
      )
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> self root) cshape)
    )
  (vector-copy! (-> self root trans) (-> st trans))
  (quaternion-copy! (-> self root quat) (-> st quat))
  (initialize-skeleton self sg (the-as pair 0))
  (ja-channel-set! 1)
  ;; the bones take the owner's pose once computed (mp-pose-postbind)
  (set! (-> self skel postbind-function) mp-pose-postbind)
  (dotimes (i 4)
    (set! (-> self fx-group i) -1)
    (set! (-> self fx-tracker i) (the-as handle #f))
    )
  (go mp-replica-idle)
  )

(defun mp-replica-index ((id uint))
  "Index of the replica of NPC `id` in the table, -1 when none."
  (let ((ws *mp-world-state*))
    (dotimes (i (-> ws replica-count))
      (if (= (-> ws replica-id i) id)
          (return i)
          )
      )
    )
  -1
  )

(defun mp-replica-remove ((i int))
  "Remove entry `i` of the replica table (and its process)."
  (let* ((ws *mp-world-state*)
         (proc (handle->process (-> ws replica i)))
         (last (+ (-> ws replica-count) -1))
         )
    (if proc
        (deactivate proc)
        )
    (set! (-> ws replica-id i) (-> ws replica-id last))
    (set! (-> ws replica i) (-> ws replica last))
    (set! (-> ws replica-count) last)
    )
  (none)
  )

(defun mp-replicas-clear ()
  "Remove every replica."
  (while (> (-> *mp-world-state* replica-count) 0)
    (mp-replica-remove 0)
    )
  (none)
  )

(defbehavior mp-replica-spawn mp-manager ((st mp-actor-state))
  "Spawn a replica of `st` if its skeleton is loaded here. #t when spawned."
  (let ((ws *mp-world-state*))
    (when (< (-> ws replica-count) MP_MAX_REPLICAS)
      (string<-charp *mp-temp-string* (-> st skel))
      (set! (-> ws level-box 0) #f)
      (let ((sg (the-as skeleton-group (art-group-get-by-name *level* *mp-temp-string* (the-as (pointer level) #f))))
            (lev (the-as level #f))
            )
        ;; the level that registered the skeleton is not always the one that holds its art
        ;; (dogat: skeleton in WASALL code, art elsewhere): initialize-skeleton needs the latter
        (when (and sg (type? sg skeleton-group))
          (art-group-get-by-name *level* (-> sg art-group-name) (the-as (pointer level) (-> ws level-box)))
          (set! lev (-> ws level-box 0))
          )
        (when (and sg lev (type? sg skeleton-group))
          (let ((proc (process-spawn mp-replica st sg lev :name "mp-replica" :to self :stack-size #x20000)))
            (when proc
              (set! (-> ws replica-id (-> ws replica-count)) (-> st id))
              (set! (-> ws replica (-> ws replica-count)) (ppointer->handle proc))
              (+! (-> ws replica-count) 1)
              (return #t)
              )
            )
          )
        )
      )
    )
  #f
  )

(defun mp-nearest-replica-vehicle ((pos vector))
  "Replica table index of another player's NPC vehicle within 4.5 m of `pos`, -1 when none."
  (let ((ws *mp-world-state*)
        (best -1)
        (best-dist (meters 4.5))
        )
    (dotimes (i (-> ws replica-count))
      (let ((proc (the-as mp-replica (handle->process (-> ws replica i)))))
        (when (and proc
                   (not (logtest? (-> proc net flags) (mp-actor-flag owned)))
                   (logtest? (-> proc net flags) (mp-actor-flag vehicle))
                   (not (logtest? (-> proc net flags) (mp-actor-flag hidden dead)))
                   )
          (let ((d (vector-vector-distance pos (-> proc root trans))))
            (when (< d best-dist)
              (set! best i)
              (set! best-dist d)
              )
            )
          )
        )
      )
    best
    )
  )

(defun mp-vehicle-type-of-skel ((skel (pointer uint8)))
  "vehicle-type of a vehicle skeleton name (skel-<type>), -1 when it is not one."
  (dotimes (i (-> *mp-vehicle-types* length))
    (format (clear *mp-temp-string*) "skel-~S" (symbol->string (-> *mp-vehicle-types* i)))
    (if (string-charp= *mp-temp-string* skel)
        (return i)
        )
    )
  -1
  )

(defbehavior mp-take-replica-vehicle mp-manager ((index int))
  "Get in a copy of the NPC vehicle at replica `index`; the player who simulates it then removes its
   own."
  (let ((proc (the-as mp-replica (handle->process (-> *mp-world-state* replica index)))))
    (when proc
      (let ((id (-> proc id)))
        (when (mp-get-vehicle-at (mp-vehicle-type-of-skel (-> proc net skel)) (-> proc root trans) (-> proc root quat))
          (mp-send-event (mp-event-kind vehicle-taken) (the-as int (shr id 24)) (the-as int (logand id #xffffff)) 0.0)
          (mp-replica-remove index)
          (return #t)
          )
        )
      )
    )
  #f
  )

;; ------------------------------------------------------------------------------------------------
;; Not an authority: our own NPCs sleep while another player's are shown
;; ------------------------------------------------------------------------------------------------

(defun mp-suppress-actor ((proc process-drawable))
  "iterate-process-tree callback: put one of our NPCs to sleep (no logic, not drawn, intangible)."
  (when (and (type? proc process-drawable)
             (not (type? proc mp-replica))
             (nonzero? (-> proc root))
             (> (mp-actor-kind proc) 0)
             (not (mp-driven-vehicle? proc))
             (not (logtest? (-> proc mask) (process-mask sleep)))
             (< (-> *mp-world-state* suppressed-count) 256)
             )
    (logior! (-> proc mask) (process-mask sleep))
    (if (nonzero? (-> proc draw))
        (logior! (-> proc draw status) (draw-control-status no-draw))
        )
    (when (type? (-> proc root) collide-shape)
      (let ((prim (-> (the-as collide-shape (-> proc root)) root-prim)))
        (set! (-> prim prim-core collide-as) (collide-spec))
        (set! (-> prim prim-core collide-with) (collide-spec))
        )
      )
    (let ((ws *mp-world-state*))
      (set! (-> ws suppressed (-> ws suppressed-count)) (process->handle proc))
      (+! (-> ws suppressed-count) 1)
      )
    )
  #f
  )

(defun mp-unsuppress-all ()
  "Wake every NPC we put to sleep (end of a session)."
  (let ((ws *mp-world-state*))
    (dotimes (i (-> ws suppressed-count))
      (let ((proc (the-as process-drawable (handle->process (-> ws suppressed i)))))
        (when proc
          (logclear! (-> proc mask) (process-mask sleep))
          (if (nonzero? (-> proc draw))
              (logclear! (-> proc draw status) (draw-control-status no-draw))
              )
          (when (type? (-> proc root) collide-shape)
            (let ((cshape (the-as collide-shape (-> proc root))))
              (set! (-> cshape root-prim prim-core collide-as) (-> cshape backup-collide-as))
              (set! (-> cshape root-prim prim-core collide-with) (-> cshape backup-collide-with))
              )
            )
          )
        )
      )
    (set! (-> ws suppressed-count) 0)
    )
  (none)
  )

(defbehavior mp-world-suppress mp-manager ()
  "Keep our NPCs asleep and our traffic off (another player's are shown instead)."
  (let ((ws *mp-world-state*))
    (when (not (-> ws traffic-off?))
      ;; settings belong to the process that sets them: the manager lives as long as the session
      (set-setting! 'traffic-spawn #f 0.0 0)
      (set! (-> ws traffic-off?) #t)
      )
    (when (>= (- (mp-now) (-> ws last-suppress)) (seconds 0.25))
      (set! (-> ws last-suppress) (mp-now))
      ;; forget entries of NPCs that died meanwhile, then catch the new ones
      (let ((n 0))
        (dotimes (i (-> ws suppressed-count))
          (when (handle->process (-> ws suppressed i))
            (set! (-> ws suppressed n) (-> ws suppressed i))
            (+! n 1)
            )
          )
        (set! (-> ws suppressed-count) n)
        )
      (iterate-process-tree *active-pool* (the-as (function object object) mp-suppress-actor) *null-kernel-context*)
      )
    )
  (none)
  )

(defun mp-replica-wanted? ((st mp-actor-state))
  "#f for an NPC of another authority standing nearer to us than to that player: our own world
   covers that place, so its copy would be a double."
  (or (not *mp-authority*)
      (logtest? (-> st flags) (mp-actor-flag owned))
      (let ((me (mp-player-pos *mp-local-slot*))
            (owner (mp-player-pos (the-as int (shr (-> st id) 24))))
            )
        (or (not me)
            (not owner)
            (< (vector-vector-distance (-> st trans) owner) (vector-vector-distance (-> st trans) me))
            )
        )
      )
  )

(defbehavior mp-world-receive mp-manager ()
  "Draw the other players' objects (the NPCs of their authority, everyone's props) as replicas."
  (let ((ws *mp-world-state*))
    (let ((count (pc-mp-get-actors (-> *mp-actors-in* state) MP_MAX_REPLICAS))
          (spawned 0)
          )
      (set! (-> *mp-actors-in* count) count)
      (dotimes (i count)
        (let* ((st (-> *mp-actors-in* state i))
               (index (mp-replica-index (-> st id)))
               )
          (cond
            ((not (mp-replica-wanted? st))
             ;; dropped below with the replicas no longer sent
             (set! (-> st id) (the-as uint 0))
             )
            ((>= index 0)
             (let ((proc (the-as mp-replica (handle->process (-> ws replica index)))))
               (if proc
                   (mem-copy! (the-as pointer (-> proc net)) (the-as pointer st) (size-of mp-actor-state))
                   (mp-replica-remove index)
                   )
               )
             )
            ;; a few spawns per frame at most, so a crowd appearing does not stall a frame
            ((< spawned 4)
             (if (mp-replica-spawn st)
                 (+! spawned 1)
                 )
             )
            )
          )
        )
      ;; replicas of NPCs the host no longer sends, or whose art left with its level
      (let ((i 0))
        (while (< i (-> ws replica-count))
          (let ((proc (the-as mp-replica (handle->process (-> ws replica i))))
                (seen? #f)
                )
            (dotimes (j count)
              (if (= (-> *mp-actors-in* state j id) (-> ws replica-id i))
                  (set! seen? #t)
                  )
              )
            (if (or (not proc)
                    (not seen?)
                    (not (-> proc level))
                    (not (or (= (-> proc level status) 'active) (= (-> proc level status) 'reserved)))
                    )
                (mp-replica-remove i)
                (+! i 1)
                )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior mp-world-wake mp-manager ()
  "Our NPCs and traffic back (we simulate our world again)."
  (let ((ws *mp-world-state*))
    (if (> (-> ws suppressed-count) 0)
        (mp-unsuppress-all)
        )
    (when (-> ws traffic-off?)
      (remove-setting! 'traffic-spawn)
      (set! (-> ws traffic-off?) #f)
      )
    )
  (none)
  )

(define-extern mp-sounds-housekeeping (function symbol none))

(defbehavior mp-world-client-stop mp-manager ()
  "Back to a normal world: replicas gone (and their sounds), our NPCs and traffic back, their
   joint math as stock."
  (mp-sounds-housekeeping #t)
  (mp-release-math #t)
  (mp-replicas-clear)
  (mp-world-wake)
  (none)
  )

(defbehavior mp-world-update mp-manager ()
  "Shared world, once per unpaused frame."
  (cond
    ((mp-online?)
     (mp-update-authority)
     (mp-world-send)
     (if *mp-authority*
         (mp-world-wake)
         (mp-world-suppress)
         )
     (mp-world-receive)
     (mp-sounds-housekeeping #f)
     )
    (else
      (set! *mp-authority* #f)
      (if (or (> (-> *mp-world-state* replica-count) 0)
              (> (-> *mp-world-state* suppressed-count) 0)
              (> (-> *mp-world-state* forced-count) 0)
              (-> *mp-world-state* traffic-off?)
              )
          (mp-world-client-stop)
          )
      )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Effects and projectiles
;; ------------------------------------------------------------------------------------------------

;; Every one-shot particle effect goes through part-tracker-init-base (generic-obs.gc), and every
;; projectile through projectile-init-by-other (projectile.gc): both are wrapped to tell the other
;; players, who start the same effect or fire the same projectile type. Each machine applies the
;; damage of shots only to its own player (with its own copy of an NPC's shot), and the shooter's
;; machine sends hits on other players' puppets and on replicas: copies of a player's shots are
;; drawn only (they collide with the background alone).

(deftype mp-fx-state (structure)
  ((replaying?   symbol)     ;; spawning a copy: do not send it back
   (frame        int64)      ;; frame of the counts below
   (effects-sent int32)
   (shots-sent   int32)
   (recent-group sparticle-launch-group 8) ;; local effects just started, to skip duplicate copies
   (recent-pos   vector 8 :inline)
   (recent-time  time-frame 8)
   (recent-next  int32)
   (total-effects-sent int32)  ;; counters for the test log
   (total-effects-shown int32)
   (total-shots-sent int32)
   (total-shots-shown int32)
   )
  )

(define *mp-fx* (new 'global 'mp-fx-state))
(set! (-> *mp-fx* replaying?) #f)

(defun mp-fx-budget ((effect? symbol))
  "At most 8 effects and 8 shots sent per frame."
  (let ((fx *mp-fx*)
        (frame (-> *display* real-frame-clock frame-counter))
        )
    (when (!= frame (-> fx frame))
      (set! (-> fx frame) frame)
      (set! (-> fx effects-sent) 0)
      (set! (-> fx shots-sent) 0)
      )
    (cond
      (effect?
        (+! (-> fx effects-sent) 1)
        (<= (-> fx effects-sent) 8)
        )
      (else
        (+! (-> fx shots-sent) 1)
        (<= (-> fx shots-sent) 8)
        )
      )
    )
  )

(defun mp-under-replica? ((proc process-tree))
  "#t when `proc` is a replica or puppet, or below one (their effects are replays already)."
  (dotimes (i 6)
    (cond
      ((not proc)
       (return #f)
       )
      ((or (type? proc mp-replica) (type? proc mp-puppet))
       (return #t)
       )
      (else
        (set! proc (ppointer->process (-> proc parent)))
        )
      )
    )
  #f
  )

(defun mp-part-group-index ((group sparticle-launch-group))
  "Index of `group` in *part-group-id-table*, -1 when absent."
  (dotimes (i (-> *part-group-id-table* length))
    (if (= (-> *part-group-id-table* i) group)
        (return i)
        )
    )
  -1
  )

(defbehavior mp-effect-started part-tracker ((group sparticle-launch-group) (target process-drawable) (duration time-frame))
  "A one-shot effect started here: remember it, and send it unless it is a copy or a replica's."
  (let ((fx *mp-fx*)
        (pos (if (and target (nonzero? (-> target root)))
                 (-> target root trans)
                 (-> self root trans)
                 )
             )
        )
    (when (not (-> fx replaying?))
      (let ((i (-> fx recent-next)))
        (set! (-> fx recent-group i) group)
        (vector-copy! (-> fx recent-pos i) pos)
        (set! (-> fx recent-time i) (mp-now))
        (set! (-> fx recent-next) (logand (+ i 1) 7))
        )
      (when (and (mp-online?)
                 (not (mp-under-replica? self))
                 (not (and target (mp-under-replica? target)))
                 (mp-near-a-player? pos)
                 (mp-fx-budget #t)
                 )
        (let ((index (mp-part-group-index group)))
          (when (>= index 0)
            (let ((ev (new 'stack 'mp-event)))
              (set! (-> ev kind) (mp-event-kind effect))
              (set! (-> ev to) -1)
              (set! (-> ev iarg 0) index)
              (set! (-> ev iarg 1) (the-as int duration))
              (vector-copy! (-> ev fvec) pos)
              (pc-mp-send-event ev)
              (+! (-> fx total-effects-sent) 1)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-replay-effect ((ev mp-event))
  "Start an effect another player saw start, unless an identical one just started here (the copy
   of a shot makes its own impact)."
  (let ((index (-> ev iarg 0))
        (fx *mp-fx*)
        )
    (when (and (>= index 0) (< index (-> *part-group-id-table* length)))
      (let ((group (-> *part-group-id-table* index)))
        ;; a level's groups are empty while that level is not loaded here
        (when (and (nonzero? group) (type? group sparticle-launch-group))
          (dotimes (i 8)
            (if (and (= (-> fx recent-group i) group)
                     (< (- (mp-now) (-> fx recent-time i)) (seconds 0.5))
                     (< (vector-vector-distance (-> fx recent-pos i) (-> ev fvec)) (meters 3))
                     )
                (return #f)
                )
            )
          (set! (-> fx replaying?) #t)
          (+! (-> fx total-effects-shown) 1)
          (vector-copy! (-> *launch-matrix* trans) (-> ev fvec))
          (if (logtest? (-> group flags) (sp-group-flag sp13))
              (part-tracker-spawn part-tracker-subsampler :to *entity-pool* :group group :duration (the-as time-frame (-> ev iarg 1)))
              (part-tracker-spawn part-tracker :to *entity-pool* :group group :duration (the-as time-frame (-> ev iarg 1)))
              )
          (set! (-> fx replaying?) #f)
          )
        )
      )
    )
  (none)
  )

(defun mp-projectile-fired ((proj projectile) (params projectile-init-by-other-params))
  "A projectile was fired here: send it when it is the local player's, or an NPC's on the host."
  (when (and (mp-online?) (not (-> *mp-fx* replaying?)))
    (let* ((owner (handle->process (-> params owner-handle)))
           (shooter (if owner
                        owner
                        (ppointer->process (-> proj parent))
                        )
                    )
           (mine? (mp-from-local-player? (the-as process shooter)))
           )
      (when (and (or mine?
                     (and *mp-authority* shooter (type? shooter process) (> (mp-actor-kind (the-as process shooter)) 0))
                     )
                 (mp-near-a-player? (-> params pos))
                 (mp-fx-budget #f)
                 )
        (let ((ev (new 'stack 'mp-event)))
          (set! (-> ev kind) (mp-event-kind projectile))
          (set! (-> ev to) -1)
          (vector-copy! (-> ev fvec) (-> params pos))
          (set! (-> ev iarg 0) (the-as int (-> params vel x)))
          (set! (-> ev iarg 1) (the-as int (-> params vel y)))
          (set! (-> ev iarg 2) (the-as int (-> params vel z)))
          (set! (-> ev iarg 3) (if mine?
                                   -1
                                   (logand (-> (the-as process shooter) pid) #xffffff)
                                   )
                )
          (copyn-charp<-string (-> ev text) (symbol->string (-> proj type symbol)) 32)
          (pc-mp-send-event ev)
          (+! (-> *mp-fx* total-shots-sent) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-replay-projectile ((ev mp-event))
  "Fire the copy of another player's projectile, from that player's puppet or from the replica of
   the NPC that fired it."
  (let* ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
         (from (-> ev from))
         (parent (cond
                   ((not manager)
                    #f
                    )
                   ((< (-> ev iarg 3) 0)
                    (handle->process (-> manager puppets (max 0 (min from (+ MP_MAX_PLAYERS -1)))))
                    )
                   (else
                     (let ((index (mp-replica-index (the-as uint (logior (shl from 24) (-> ev iarg 3))))))
                       (if (>= index 0)
                           (handle->process (-> *mp-world-state* replica index))
                           )
                       )
                     )
                   )
                 )
         )
    (when parent
      (string<-charp *mp-temp-string* (-> ev text))
      (let ((typ (-> (string->symbol *mp-temp-string*) value)))
        ;; the type is level code: it exists only when its level is loaded here
        (when (and typ (type? typ type) (mp-inherits? (the-as type typ) 'projectile))
          (let ((params (new 'stack 'projectile-init-by-other-params)))
            (vector-copy! (-> params pos) (-> ev fvec))
            (set! (-> params pos w) 1.0)
            (set-vector!
              (-> params vel)
              (the-as float (-> ev iarg 0))
              (the-as float (-> ev iarg 1))
              (the-as float (-> ev iarg 2))
              0.0
              )
            (set! (-> params target-handle) (the-as handle #f))
            (set! (-> params ent) #f)
            (set! (-> params charge) 1.0)
            (set! (-> params attack-id) (new-attack-id))
            (set! (-> params options) (projectile-options))
            (set! (-> params notify-handle) (the-as handle #f))
            (set! (-> params owner-handle) (process->handle (the-as process parent)))
            (set! (-> params ignore-handle) (process->handle (the-as process parent)))
            (set! (-> params timeout) (seconds 4))
            (set! (-> params damage) 1.0)
            (set! (-> params vehicle-damage-factor) 1.0)
            (set! (-> params vehicle-impulse-factor) 1.0)
            (set! (-> *mp-fx* replaying?) #t)
            (+! (-> *mp-fx* total-shots-shown) 1)
            (let ((proj (the-as projectile (ppointer->process (spawn-projectile (the-as type typ) params (the-as process-tree parent) *default-dead-pool*)))))
              ;; a player's shot is only drawn: the shooter's machine sends its hits
              (if (and proj (< (-> ev iarg 3) 0) (nonzero? (-> proj root)))
                  (set! (-> proj root root-prim prim-core collide-with) (collide-spec backgnd))
                  )
              )
            (set! (-> *mp-fx* replaying?) #f)
            )
          )
        )
      )
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock entry points of effects and projectiles. define-perm keeps the
;; stock function when this file is reloaded in a REPL session.
(define-perm *mp-stock-part-tracker-init-base*
             (function sparticle-launch-group time-frame (function part-tracker vector) uint process-drawable object none :behavior part-tracker)
  part-tracker-init-base
  )

(defbehavior part-tracker-init-base part-tracker ((arg0 sparticle-launch-group)
                                        (arg1 time-frame)
                                        (arg2 (function part-tracker vector))
                                        (arg3 uint)
                                        (arg4 process-drawable)
                                        (arg5 object)
                                        )
  "Stock behavior, then the other players see the effect too (multiplayer mod, no-op offline)."
  (*mp-stock-part-tracker-init-base* arg0 arg1 arg2 arg3 arg4 arg5)
  (if (nonzero? arg0)
      (mp-effect-started arg0 arg4 arg1)
      )
  (none)
  )

(define-perm *mp-stock-projectile-init-by-other* (function projectile-init-by-other-params object :behavior projectile)
  projectile-init-by-other
  )

(defbehavior projectile-init-by-other projectile ((arg0 projectile-init-by-other-params))
  "The other players fire the same projectile (multiplayer mod, no-op offline), then the stock init,
   which never returns (it goes to the projectile's first state)."
  (mp-projectile-fired self arg0)
  (*mp-stock-projectile-init-by-other* arg0)
  )

;; ------------------------------------------------------------------------------------------------
;; Poses and emitters
;; ------------------------------------------------------------------------------------------------

;; A copy plays the owner's animation by index, which misses blended channels, animations streamed
;; on the owner's machine (vehicle seats, scripted moves), joint mods (look-at, aiming) and
;; ragdolls. So each batch also carries the owner's bones, relative to the object's frame (its
;; root position and orientation, as sent in its state): the player's, its props', and every NPC's
;; sent (whose joint math runs in full while it is sent, mp-force-math). The copy computes its own bones from
;; its animation, then mp-pose-postbind (its joint-control postbind-function) lays the owner's on
;; its frame, interpolated by the runtime like the rest of its state. The animation still runs: it
;; plays the animation's effects (footsteps, sounds) and stands in until a pose arrives.
;;
;; Particle emitters are noted where they are used: launch-control `spawn` (groups that run every
;; frame: engine flames, trails, auras) and direct launches (sp-launch-particles-var without a
;; launch control: dust, glows). An object's batch entry lists the emitters it used since the
;; previous batch; the copy keeps a part-tracker per group while the owner keeps it running, and
;; replays single launches as many times as the owner made them.
;;
;; Sounds the same way: sound-play-by-name and sound-play-by-spec (every sound a process plays)
;; and sound-stop are noted for those objects, the latest call per sound id. The copy plays each
;; with an id of its own per owner's id, so a lasting sound (an engine, updated every frame on the
;; owner's machine) stays one sound, updated each batch, and stops when the owner stops it.

(defun mp-frame-of ((out matrix) (trans vector) (quat quaternion))
  "The rigid frame (no scale) poses and emitters are expressed in: `quat` then `trans`."
  (quaternion->matrix out quat)
  (vector-copy! (-> out trans) trans)
  (set! (-> out trans w) 1.0)
  out
  )

(defun mp-level-hash ((lev level))
  "16-bit hash of a level's name, never 0 (0 means global data)."
  (let ((str (symbol->string (-> lev name)))
        (h 0)
        )
    (dotimes (i (length str))
      (set! h (logand (+ (* h 31) (-> str data i)) #xffff))
      )
    (logior h 1)
    )
  )

(defun mp-heap-level ((addr uint))
  "The level whose heap holds `addr`, #f for global data."
  (countdown (li 11)
    (let ((lev (-> *level* level li)))
      (if (and (>= addr (the-as uint (-> lev heap base))) (< addr (the-as uint (-> lev heap top-base))))
          (return lev)
          )
      )
    )
  (the-as level #f)
  )

(defun mp-part-index ((launcher sparticle-launcher))
  "Index of a single launcher in *part-id-table*, -1 when absent. Cached (reset when levels move)."
  (let ((ps *mp-pose*))
    (dotimes (i 16)
      (if (= (-> ps part-ptr i) launcher)
          (return (-> ps part-index i))
          )
      )
    (dotimes (i (-> *part-id-table* length))
      (when (= (-> *part-id-table* i) launcher)
        (let ((k (-> ps part-next)))
          (set! (-> ps part-ptr k) launcher)
          (set! (-> ps part-index k) i)
          (set! (-> ps part-next) (logand (+ k 1) 15))
          )
        (return i)
        )
      )
    )
  -1
  )

(defun mp-launcher-usable? ((index int) (home int))
  "#t when entry `index` of *part-id-table* is the launcher the owner meant. The table keeps the
   entries of unloaded levels (only groups are unlinked), so the launcher must be global data when
   `home` is 0, else in the heap of a loaded level whose name hashes to `home`."
  (when (and (>= index 0) (< index (-> *part-id-table* length)))
    (let ((launcher (-> *part-id-table* index)))
      (when (nonzero? launcher)
        (let ((lev (mp-heap-level (the-as uint launcher))))
          (if (zero? home)
              (not lev)
              (and lev
                   (= (mp-level-hash lev) home)
                   (or (= (-> lev status) 'active) (= (-> lev status) 'alive) (= (-> lev status) 'loaded))
                   )
              )
          )
        )
      )
    )
  )

(defun mp-emitter-owner? ((proc process))
  "#t when the others draw `proc` from this machine: the player, Daxter, the gun, the vehicle driven
   (and its wheels), or an NPC while we simulate the NPCs around us."
  (and proc
       (nonzero? proc)
       (or (= proc *target*)
           (and *target*
                (or (= proc (ppointer->process (-> *target* sidekick)))
                    (and (nonzero? (-> *target* gun)) (= proc (ppointer->process (-> *target* gun gun))))
                    )
                )
           (mp-driven-vehicle? proc)
           (and *mp-authority* (> (mp-actor-kind proc) 0))
           )
       )
  )

(defun mp-note-emitter ((proc process) (kind int) (ptr basic) (origin matrix))
  "`proc` used emitter `ptr` (a group for kind 0, a single launcher else) at `origin`: remember it
   for the next batch, once per object and emitter, with the number of uses."
  (when (and (not (-> *mp-fx* replaying?)) (mp-emitter-owner? proc))
    (let ((ps *mp-pose*)
          (pid (-> proc pid))
          (slot -1)
          )
      (dotimes (i (-> ps emit-count))
        (when (and (= (-> ps emit-pid i) pid) (= (-> ps emit-ptr i) ptr))
          (set! slot i)
          (set! i (-> ps emit-count))
          )
        )
      (when (and (< slot 0) (< (-> ps emit-count) 32))
        (set! slot (-> ps emit-count))
        (+! (-> ps emit-count) 1)
        (set! (-> ps emit-pid slot) pid)
        (set! (-> ps emit-kind slot) kind)
        (set! (-> ps emit-ptr slot) ptr)
        (set! (-> ps emit-calls slot) 0)
        )
      (when (>= slot 0)
        (+! (-> ps emit-calls slot) 1)
        (matrix-copy! (-> ps emit-origin slot) origin)
        )
      )
    )
  (none)
  )

(defun mp-note-sound ((proc process) (name sound-name) (id sound-id) (vol int) (pitch int) (bend int) (trans object))
  "`proc` played sound `name` as `id`: remember the call for the next batch (the latest one per id)
   when the others draw `proc`. `trans` is a position, #t for the process's root, #f for a sound
   without position (the others hear it at the copy)."
  (when (and (not (-> *mp-fx* replaying?)) (nonzero? id) (mp-emitter-owner? proc))
    (let ((ps *mp-pose*)
          (pid (-> proc pid))
          (slot -1)
          )
      (dotimes (i (-> ps snd-count))
        (if (and (= (-> ps snd-pid i) pid) (= (-> ps snd-out i id) id))
            (set! slot i)
            )
        )
      (when (and (< slot 0) (< (-> ps snd-count) 24))
        (set! slot (-> ps snd-count))
        (+! (-> ps snd-count) 1)
        (set! (-> ps snd-pid slot) pid)
        (let ((k (-> ps known-next)))
          (set! (-> ps known-pid k) pid)
          (set! (-> ps known-id k) id)
          (set! (-> ps known-next) (logand (+ k 1) 31))
          )
        )
      (when (>= slot 0)
        (let ((snd (-> ps snd-out slot)))
          (set! (-> snd name) name)
          (set! (-> snd id) id)
          (set! (-> snd vol) vol)
          (set! (-> snd pitch) pitch)
          (set! (-> snd bend) bend)
          (set! (-> snd flags) 1)
          (cond
            ((and trans (!= trans #t))
             (vector-copy! (-> snd pos) (the-as vector trans))
             )
            ((and (type? proc process-drawable) (nonzero? (-> (the-as process-drawable proc) root)))
             (vector-copy! (-> snd pos) (-> (the-as process-drawable proc) root trans))
             )
            (else
              (set! (-> snd flags) 0)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-note-sound-stop ((id sound-id))
  "Sound `id` was stopped: when an object we send played it, the others stop their copy of it."
  (when (and (nonzero? id) (not (-> *mp-fx* replaying?)))
    (let ((ps *mp-pose*))
      (dotimes (k 32)
        (when (= (-> ps known-id k) id)
          (let ((pid (-> ps known-pid k))
                (slot -1)
                )
            (dotimes (i (-> ps snd-count))
              (if (and (= (-> ps snd-pid i) pid) (= (-> ps snd-out i id) id))
                  (set! slot i)
                  )
              )
            (when (and (< slot 0) (< (-> ps snd-count) 24))
              (set! slot (-> ps snd-count))
              (+! (-> ps snd-count) 1)
              (set! (-> ps snd-pid slot) pid)
              (set! (-> ps snd-out slot id) id)
              (vector-reset! (-> ps snd-out slot pos))
              )
            (if (>= slot 0)
                (set! (-> ps snd-out slot flags) 2)
                )
            )
          (set! (-> ps known-id k) (the-as sound-id 0))
          (return #f)
          )
        )
      )
    )
  (none)
  )

(defun mp-pose-ready? ((proc process-drawable) (npc? symbol))
  "#t when every bone of `proc` came out of its last joint math: drawn, at a level of detail that
   animates every joint, and, for an NPC, not skipping its joint math (bone 0 still at its root)."
  (let ((nodes (-> proc node-list))
        (draw (-> proc draw))
        )
    (and (nonzero? nodes)
         (nonzero? draw)
         (nonzero? (-> proc skel))
         (<= (-> nodes length) MP_MAX_POSE_JOINTS)
         (not (logtest? (-> draw status) (draw-control-status no-draw no-draw-temp uninited)))
         (or (logtest? (-> proc skel status) (joint-control-status force-math))
             (and (nonzero? (-> draw mgeo)) (-> draw mgeo) (>= (+ (-> draw mgeo num-joints) 3) (-> nodes length)))
             )
         (or (not npc?)
             (< (vector-vector-distance (-> nodes data 0 bone transform trans) (-> proc root trans)) (meters 0.5))
             )
         )
    )
  )

(defun mp-send-pose ((id uint) (proc process-drawable) (trans vector) (quat quaternion) (npc? symbol) (pose? symbol))
  "Queue object `proc` in the pose batch: its bones relative to its frame (`trans` `quat`, as sent
   in its state) when `pose?` and they are complete, and the emitters it used since the last batch.
   Nothing is queued when there is neither."
  (let ((ps *mp-pose*)
        (pid (-> proc pid))
        (count 0)
        (emitters 0)
        )
    (dotimes (i (-> ps emit-count))
      (if (= (-> ps emit-pid i) pid)
          (+! emitters 1)
          )
      )
    (dotimes (i (-> ps snd-count))
      (if (= (-> ps snd-pid i) pid)
          (+! emitters 1)
          )
      )
    (when (and pose? (not (mp-pose-ready? proc npc?)))
      ;; not drawn by its owner, for good or for a moment (a teleport): nothing to copy
      (if (and (nonzero? (-> proc draw)) (logtest? (-> proc draw status) (draw-control-status no-draw no-draw-temp)))
          (+! (-> ps poses-hidden) 1)
          (+! (-> ps poses-skipped) 1)
          )
      )
    (when (and pose? (mp-pose-ready? proc npc?))
      (let ((nodes (-> proc node-list)))
        (dotimes (i (-> nodes length))
          (matrix-copy! (-> ps bones i) (-> nodes data i bone transform))
          )
        (set! count (-> nodes length))
        )
      )
    (when (or (> count 0) (> emitters 0))
      (pc-mp-add-pose id (mp-frame-of (-> ps frame) trans quat) (-> ps bones) count)
      (if (> count 0)
          (+! (-> ps poses-sent) 1)
          )
      (dotimes (i (-> ps emit-count))
        (when (= (-> ps emit-pid i) pid)
          (let* ((group? (zero? (-> ps emit-kind i)))
                 (index (if group?
                            (mp-part-group-index (the-as sparticle-launch-group (-> ps emit-ptr i)))
                            (mp-part-index (the-as sparticle-launcher (-> ps emit-ptr i)))
                            )
                        )
                 (lev (if group?
                          (the-as level #f)
                          (mp-heap-level (the-as uint (-> ps emit-ptr i)))
                          )
                      )
                 )
            (when (>= index 0)
              ;; the kind carries the hash of the launcher's level in its upper bits
              (pc-mp-add-emitter
                (logior (-> ps emit-kind i) (shl (if lev (mp-level-hash lev) 0) 8))
                index
                (-> ps emit-calls i)
                (-> ps emit-origin i)
                )
              (+! (-> ps emitters-sent) 1)
              )
            )
          )
        )
      (dotimes (i (-> ps snd-count))
        (when (= (-> ps snd-pid i) pid)
          (pc-mp-add-sound (-> ps snd-out i))
          (+! (-> ps sounds-sent) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-send-poses ()
  "Queue and send the poses of this batch: the player, its props and every NPC sent, each with the
   emitters and sounds it used; then forget the emitters and sounds noted since the last batch."
  (let* ((ps *mp-pose*)
         (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
         ;; a passenger's own model is hidden: the model this player sees in the seat is sent instead
         (seated (if (and manager (>= *mp-ride-slot* 0))
                     (the-as process-drawable (handle->process (-> manager self-puppet)))
                     )
                 )
         )
    (cond
      (seated
        (mp-send-pose (the-as uint #xffffff) seated (-> seated root trans) (-> seated root quat) #f #t)
        )
      (*target*
        (mp-send-pose (the-as uint #xffffff) *target* (-> *target* control trans) (-> *target* control quat) #f #t)
        )
      )
    (dotimes (i *mp-collect-count*)
      (let ((st (-> *mp-actors-out* state i)))
        (mp-send-pose
          (-> st id)
          (-> ps proc i)
          (-> st trans)
          (-> st quat)
          (not (logtest? (-> st flags) (mp-actor-flag owned)))
          #t
          )
        )
      )
    (pc-mp-send-poses)
    (set! (-> ps emit-count) 0)
    (set! (-> ps snd-count) 0)
    )
  (none)
  )

(defun mp-pose-postbind ((draw draw-control) (nodes cspace-array) (jc joint-control))
  "postbind-function of puppets and replicas, called by do-joint-math with pp the copy: replace the
   bones computed from the local animation by the owner's pose laid on the copy's frame, when one
   arrived for this skeleton (same bone count)."
  (with-pp
    (let ((id (cond
                ((type? pp mp-replica)
                 (-> (the-as mp-replica pp) id)
                 )
                ((and (type? pp mp-puppet) (not (-> (the-as mp-puppet pp) local?)))
                 (mp-puppet-pose-id (-> (the-as mp-puppet pp) slot))
                 )
                (else
                  (the-as uint 0)
                  )
                )
              )
          )
      (when (nonzero? id)
        (let* ((ps *mp-pose*)
               (proc (the-as process-drawable pp))
               (count (pc-mp-get-pose
                        id
                        (mp-frame-of (-> ps frame) (-> proc root trans) (-> proc root quat))
                        (-> ps bones)
                        MP_MAX_POSE_JOINTS
                        )
                      )
               )
          (if (type? pp mp-replica)
              (set! (-> (the-as mp-replica pp) pose-last) count)
              )
          (when (and (> count 0) (= count (-> nodes length)))
            (dotimes (i count)
              (matrix-copy! (-> nodes data i bone transform) (-> ps bones i))
              )
            (+! (-> ps poses-applied) 1)
            (if (type? pp mp-replica)
                (+! (-> (the-as mp-replica pp) pose-count) 1)
                )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-sound-stop-copy ((i int))
  "Stop the copy's sound in entry `i` of the table and free the entry."
  (let ((ps *mp-pose*))
    (set! (-> *mp-fx* replaying?) #t)
    (sound-stop (-> ps rsnd-local i))
    (set! (-> *mp-fx* replaying?) #f)
    (set! (-> ps rsnd-copy i) (the-as uint 0))
    )
  (none)
  )

(defun mp-play-sounds ((copy uint) (frame matrix))
  "Play on copy `copy` (placed at `frame`) the sounds its owner made: one sound id of ours per
   owner's sound id, so a lasting sound stays one sound, updated each batch."
  (let* ((ps *mp-pose*)
         (count (pc-mp-get-sounds copy frame (-> ps sounds) 16))
         )
    (dotimes (i count)
      (let* ((snd (-> ps sounds i))
             (slot -1)
             )
        (dotimes (k 48)
          (if (and (= (-> ps rsnd-copy k) copy) (= (-> ps rsnd-remote k) (-> snd id)))
              (set! slot k)
              )
          )
        (cond
          ((logtest? (-> snd flags) 2)
           (if (>= slot 0)
               (mp-sound-stop-copy slot)
               )
           )
          (else
            (when (< slot 0)
              ;; a free entry, else the oldest one (stopped first)
              (set! slot 0)
              (dotimes (k 48)
                (cond
                  ((zero? (-> ps rsnd-copy k))
                   (set! slot k)
                   (set! k 48)
                   )
                  ((< (-> ps rsnd-time k) (-> ps rsnd-time slot))
                   (set! slot k)
                   )
                  )
                )
              (if (nonzero? (-> ps rsnd-copy slot))
                  (mp-sound-stop-copy slot)
                  )
              (set! (-> ps rsnd-copy slot) copy)
              (set! (-> ps rsnd-remote slot) (-> snd id))
              (set! (-> ps rsnd-local slot) (new-sound-id))
              (set! (-> ps rsnd-batches slot) 0)
              )
            (+! (-> ps rsnd-batches slot) 1)
            (set! (-> ps rsnd-time slot) (mp-now))
            (set! (-> *mp-fx* replaying?) #t)
            (sound-play-by-name
              (-> snd name)
              (-> ps rsnd-local slot)
              (-> snd vol)
              (-> snd pitch)
              (-> snd bend)
              (sound-group sfx)
              (-> snd pos)
              )
            (set! (-> *mp-fx* replaying?) #f)
            (+! (-> ps sounds-played) 1)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-sounds-housekeeping ((all? symbol))
  "Stop the copies' lasting sounds the owner no longer updates (0.4 s), forget the others after
   10 s; every one when `all?`."
  (let ((ps *mp-pose*))
    (dotimes (i 48)
      (when (nonzero? (-> ps rsnd-copy i))
        (let ((age (- (mp-now) (-> ps rsnd-time i))))
          (if (or all? (and (>= (-> ps rsnd-batches i) 2) (< (seconds 0.4) age)) (< (seconds 10) age))
              (mp-sound-stop-copy i)
              )
          )
        )
      )
    )
  (none)
  )

(defun mp-play-emitters ((proc process-drawable) (id uint) (groups (pointer int32)) (trackers (pointer handle)))
  "Draw on copy `proc` the emitters its owner uses (object `id`): one part-tracker per particle
   group, kept alive and moved while the owner keeps the group running (at most 4), and the single
   launches replayed as many times as the owner made them; then play its sounds. `groups` and
   `trackers` are the copy's 4 tracker slots."
  (let* ((ps *mp-pose*)
         (frame (mp-frame-of (-> ps frame) (-> proc root trans) (-> proc root quat)))
         (count (pc-mp-get-emitters id frame (-> ps emitters) 16))
         (kept 0)
         )
    (mp-play-sounds id frame)
    (set! (-> *mp-fx* replaying?) #t)
    (dotimes (i count)
      (let ((em (-> ps emitters i)))
        (+! (-> ps emitters-received) 1)
        (set! (-> ps last-kind) (-> em kind))
        (set! (-> ps last-index) (-> em index))
        (set! (-> ps last-home) (-> em home))
        (cond
          ((zero? (-> em kind))
           (when (and (>= (-> em index) 0) (< (-> em index) (-> *part-group-id-table* length)))
             (let ((group (-> *part-group-id-table* (-> em index)))
                   (slot -1)
                   )
               ;; a level's groups are unlinked (0) while that level is not loaded here
               (when (and (nonzero? group) (type? group sparticle-launch-group))
                 (dotimes (k 4)
                   (if (and (= (-> groups k) (-> em index)) (handle->process (-> trackers k)))
                       (set! slot k)
                       )
                   )
                 (when (< slot 0)
                   (dotimes (k 4)
                     (if (and (< slot 0) (not (logtest? kept (ash 1 k))) (not (handle->process (-> trackers k))))
                         (set! slot k)
                         )
                     )
                   (when (>= slot 0)
                     (matrix-copy! *launch-matrix* (-> em mat))
                     (let ((tracker (the-as
                                      (pointer process)
                                      (if (logtest? (-> group flags) (sp-group-flag sp13))
                                          (part-tracker-spawn part-tracker-subsampler :to proc :group group :duration (seconds 0.25))
                                          (part-tracker-spawn part-tracker :to proc :group group :duration (seconds 0.25))
                                          )
                                      )
                                    )
                           )
                       (set! (-> trackers slot) (if tracker
                                                    (ppointer->handle tracker)
                                                    (the-as handle #f)
                                                    )
                             )
                       (set! (-> groups slot) (-> em index))
                       )
                     )
                   )
                 (when (>= slot 0)
                   (let ((tracker (the-as part-tracker (handle->process (-> trackers slot)))))
                     (when tracker
                       (set! kept (logior kept (ash 1 slot)))
                       (matrix-copy! (-> tracker mat) (-> em mat))
                       (vector-copy! (-> tracker root trans) (-> em mat trans))
                       (set! (-> tracker state-time) (-> tracker clock frame-counter))
                       (+! (-> ps emitters-shown) 1)
                       )
                     )
                   )
                 )
               )
             )
           )
          ((and (> (-> em count) 0) (mp-launcher-usable? (-> em index) (-> em home)))
           (let ((launcher (-> *part-id-table* (-> em index))))
             (dotimes (k (min 4 (-> em count)))
               (if (= (-> em kind) 2)
                   (launch-particles :system *sp-particle-system-3d* launcher (-> em mat) :origin-is-matrix #t)
                   (launch-particles launcher (-> em mat) :origin-is-matrix #t)
                   )
               )
             (+! (-> ps emitters-shown) 1)
             )
           )
          )
        )
      )
    ;; groups the owner stopped: their tracker runs out by itself, its slot is free again
    (dotimes (k 4)
      (if (not (logtest? kept (ash 1 k)))
          (set! (-> groups k) -1)
          )
      )
    (set! (-> *mp-fx* replaying?) #f)
    )
  (none)
  )

;; MOD multiplayer -- wrap the two ways particles are launched, to note the emitters of the objects
;; the others draw (no-op offline). define-perm keeps the stock code on a REPL reload.
(define-perm *mp-stock-launch-spawn* (function sparticle-launch-control vector object)
  (the-as (function sparticle-launch-control vector object) (method-of-type sparticle-launch-control spawn))
  )

(defmethod spawn ((this sparticle-launch-control) (arg0 vector))
  "Stock behavior; the other players see this group on their copy of its process too."
  (when (mp-online?)
    ;; the stock method starts with the same copy; the origin is then complete for the note
    (vector-copy! (-> this origin trans) arg0)
    (mp-note-emitter (-> this proc) 0 (-> this group) (-> this origin))
    )
  (*mp-stock-launch-spawn* this arg0)
  )

(define-perm *mp-stock-sp-launch-particles-var*
             (function sparticle-system sparticle-launcher matrix sparticle-launch-state sparticle-launch-control float none)
  sp-launch-particles-var
  )

(defun sp-launch-particles-var ((arg0 sparticle-system)
                                (arg1 sparticle-launcher)
                                (arg2 matrix)
                                (arg3 sparticle-launch-state)
                                (arg4 sparticle-launch-control)
                                (arg5 float)
                                )
  "Stock launch; a launch made directly by a process the others draw (not by a launch control,
   noted in spawn) is replayed on their copy."
  (when (and (not arg4) (mp-online?))
    (with-pp
      (mp-note-emitter pp (if (= arg0 *sp-particle-system-3d*) 2 1) arg1 arg2)
      )
    )
  (*mp-stock-sp-launch-particles-var* arg0 arg1 arg2 arg3 arg4 arg5)
  (none)
  )

;; MOD multiplayer -- wrap the sound entry points (engine/sound/gsound.gc) to note the sounds of
;; the objects the others draw (no-op offline).
(define-perm *mp-stock-sound-play-by-name*
             (function sound-name sound-id int int int sound-group object sound-id :behavior process-drawable)
  sound-play-by-name
  )

(defbehavior sound-play-by-name process-drawable ((arg0 sound-name)
                                                  (arg1 sound-id)
                                                  (arg2 int)
                                                  (arg3 int)
                                                  (arg4 int)
                                                  (arg5 sound-group)
                                                  (arg6 object)
                                                  )
  "Stock behavior; the other players hear this sound on their copy of the process too."
  (if (mp-online?)
      (mp-note-sound self arg0 arg1 arg2 arg3 arg4 arg6)
      )
  (*mp-stock-sound-play-by-name* arg0 arg1 arg2 arg3 arg4 arg5 arg6)
  )

(define-perm *mp-stock-sound-play-by-spec* (function sound-spec sound-id vector sound-id :behavior process-drawable)
  sound-play-by-spec
  )

(defbehavior sound-play-by-spec process-drawable ((arg0 sound-spec) (arg1 sound-id) (arg2 vector))
  "Stock behavior; the other players hear this sound on their copy of the process too."
  (if (mp-online?)
      (mp-note-sound self (-> arg0 sound-name) arg1 (-> arg0 volume) (-> arg0 pitch-mod) (-> arg0 bend) arg2)
      )
  (*mp-stock-sound-play-by-spec* arg0 arg1 arg2)
  )

(define-perm *mp-stock-sound-stop* (function sound-id int)
  sound-stop
  )

(defun sound-stop ((arg0 sound-id))
  "Stock behavior; a sound the others hear on a copy stops there too."
  (if (mp-online?)
      (mp-note-sound-stop arg0)
      )
  (*mp-stock-sound-stop* arg0)
  )

;; ------------------------------------------------------------------------------------------------
;; Crates and pickups
;; ------------------------------------------------------------------------------------------------

(defun mp-on-entity-dead ((proc process))
  "An entity was marked dead here: when it is a crate or a pickup, the other players remove theirs
   (enemies go through mark-as-dead instead, see multiplayer.gc)."
  (when (and (mp-online?)
             (or (type? proc crate) (type? proc collectable))
             (-> proc entity)
             (nonzero? (-> proc entity aid))
             (not (mp-remote-kill? (-> proc entity aid)))
             )
    (mp-send-event (mp-event-kind kill-entity) -1 (the-as int (-> proc entity aid)) 0.0)
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock entity status setter (engine/entity/entity.gc): every broken
;; crate and taken pickup marks its entity dead through it.
(define-perm *mp-stock-process-entity-status!* (function process entity-perm-status symbol entity-perm-status)
  process-entity-status!
  )

(defun process-entity-status! ((arg0 process) (arg1 entity-perm-status) (arg2 symbol))
  "Stock behavior; a crate or pickup marked dead here is removed on the other machines too
   (multiplayer mod, no-op offline)."
  (let ((result (*mp-stock-process-entity-status!* arg0 arg1 arg2)))
    (if (and arg2 (logtest? arg1 (entity-perm-status dead)))
        (mp-on-entity-dead arg0)
        )
    result
    )
  )
