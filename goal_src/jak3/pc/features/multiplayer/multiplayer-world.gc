;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer-world.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- shared world. Objects are replicated 15 times a second (position,
;; orientation, animation, body variant) from the player who simulates them to the others, who draw
;; them as replicas built from the same skeleton, interpolated 100 ms in the past by the runtime
;; (game/kernel/jak3/kmultiplayer.cpp) with the owner's clock, like the owner's own puppet:
;;   - the NPCs: every character (the `enemy` family: citizens, guards, monsters, marauders...),
;;     vehicle and wheel simulated near a player by that player's authority. The host is the
;;     authority of everyone near it; a guest farther than 90 m from every authority simulates
;;     its own world and becomes the authority of the guests near it (mp-update-authority).
;;     A player who is not an authority does not simulate its own NPCs (ambient traffic off,
;;     its own actors asleep, hidden and intangible);
;;   - every player's props: Daxter on the shoulder, the gun, the vehicle driven and its wheels.
;;
;; With each batch go the full poses of the player, of its props and of every NPC sent (every bone,
;; so blends, streamed animations, joint mods and ragdolls look the same everywhere), and the
;; particle emitters and sounds each of them used (see "Poses and emitters" below).
;;
;; World objects run on every machine, each for its own player, and are kept alike: cyclic objects
;; follow the host's clocks, doors open for any player in front of them, and an elevator trip that
;; starts on one machine starts on the others (see "World objects" below).
;;
;; A blow or shot on a replica is sent to its owner, which applies it to the real object with the
;; attacker's puppet as the attacker; the reaction and the death come back as its state. A guest
;; who presses triangle next to one of the host's NPC vehicles gets the same vehicle, and the host
;; removes its own.
;;
;; Called from the manager (multiplayer.gc) every unpaused frame.

;; ------------------------------------------------------------------------------------------------
;; Types (mp-actor-state mirrors mp::ActorState)
;; ------------------------------------------------------------------------------------------------

(defconstant MP_MAX_ACTORS 128)   ;; objects one player sends per batch (more than the game spawns)
(defconstant MP_MAX_REPLICAS 256) ;; copies one player draws (every other player's batch)

(defenum mp-actor-flag
  :type uint16
  :bitfield #t
  (hidden 0)  ;; not drawn on the host
  (dead 1)    ;; dying on the host
  (vehicle 2) ;; a vehicle (else a character)
  (prop 3)    ;; a player's prop (Daxter, gun): drawn, not solid
  (owned 4)   ;; belongs to a player (prop, driven vehicle and wheels), never an NPC
  (world 5)   ;; a physics object of the level (id: mp-world-object-id): no copy, ours follows it
  (shot 6)    ;; a player's shot in flight: drawn (model, trail, sounds), not solid, no code run
  (laser 7)   ;; the gun's laser sight is on (mp-draw-laser)
  ;; what weapons may aim at: the object's search-info-flag bits 1-6 (process-focusable.gc), and its
  ;; kind; its copy answers the same (mp-replica get-search-info-flag, mask)
  (aim-crate 8)
  (aim-guard 9)
  (aim-attackable 10)
  (aim-enemy 11)
  (aim-priority 12)
  (aim-high-priority 13)
  (aim-civilian 14)
  (aim-hostile 15)  ;; an enemy, metalhead or KG robot
  )

(deftype mp-actor-state (structure)
  ((trans      vector     :inline) ;; w = uniform scale
   (quat       quaternion :inline)
   (id         uint32)             ;; owner slot << 24 | owner process pid
   (anim-index int16)
   (flags      mp-actor-flag)
   (anim-frame float)
   (seg-mask   uint32)             ;; body variant (low half of the draw-control seg-mask)
   (skel       uint8 32)           ;; skeleton-group name
   )
  :size-assert #x50
  )

(deftype mp-actor-table (structure)
  ((count int32)
   (pad   int32 3)
   (state mp-actor-state MP_MAX_REPLICAS :inline)
   )
  )

(define-extern pc-mp-send-actors (function (inline-array mp-actor-state) int none))
(define-extern pc-mp-add-pose (function uint matrix (inline-array matrix) int none))
(define-extern pc-mp-add-emitter (function int int int matrix none))
(define-extern pc-mp-send-poses (function none))
(define-extern pc-mp-get-pose (function uint matrix (inline-array matrix) int int))
(define-extern pc-mp-clock (function int int))
(define-extern pc-mp-sandbox-begin (function none))
(define-extern pc-mp-sandbox-watch (function pointer int int none))
(define-extern pc-mp-sandbox-restore (function int))
(define-extern pc-mp-sandbox-end (function none))
(define-extern pc-mp-render-level (function string symbol none))
(define-extern pc-mp-art-file-size (function string int))
(define-extern mp-note-art (function skeleton-group process-drawable none))
(define-extern mp-skel-def-get (function string skeleton-group))
(define-extern mp-send-skel-def (function skeleton-group none))
(define-extern *mp-synth-skels* symbol) ;; test switch (synth-skels)
(define-extern pc-mp-get-actors (function (inline-array mp-actor-state) int int))
(define-extern mp-player-count (function int)) ;; multiplayer-menu.gc

;; World-sync state that does not fit in 32-bit globals (handles, times).
(deftype mp-world-state (structure)
  ((last-send      time-frame) ;; host: last batch sent (real clock)
   (last-suppress  time-frame) ;; guest: last scan for local NPCs to put to sleep
   (cache-time     time-frame) ;; host: last reset of the skeleton cache
   (traffic-off?   symbol)     ;; guest: ambient traffic turned off by us
   (replica-count  int32)
   (replica-id     uint32 MP_MAX_REPLICAS)
   (replica        handle MP_MAX_REPLICAS)
   (vanished-near  int32)        ;; what vanished on our screen within 40 m, alive (test log)
   (faded-near     int32)        ;; copies that faded out on our screen within 40 m instead (test log)
   (suppressed-count int32)
   (suppressed     handle 256)
   (skel-count     int32)
   (skel-jgeo      art-joint-geo 128)
   (skel-group     skeleton-group 128)
   (level-box      level 1)
   (authority-want  symbol)     ;; role the situation asks for, applied after 2 s
   (authority-since time-frame)
   (served-count   int32)       ;; players whose NPCs we simulate, for the batch being built
   (served-pos     vector 8 :inline)
   (forced-count   int32)       ;; NPCs whose force-math we set (mp-force-math)
   (forced         handle 128)
   (elev-count     int32)       ;; elevators seen: entity aid, and whether a trip is under way
   (elev-aid       uint32 64)
   (elev-trip      symbol 64)
   (elev-muted     symbol 64)   ;; its scripts are set aside for a trip started by another player
   (elev-local     symbol 64)   ;; the trip under way was started here: its state goes to the others
   (elev-driven    time-frame 64) ;; last state of another player's trip applied here
   (elev-scripts   pair 448)    ;; those scripts, 7 per elevator (mp-elevator-mute)
   (elevator-trips-sent  int32) ;; counters for the test log
   (elevator-trips-shown int32)
   (elevator-states int32)      ;; states of another player's trip applied here
   (world-driven  int32)        ;; physics object updates applied from the authority
   (shot-copies   int32)        ;; copies of other players' shots drawn here (test log)
   (gone-near     int32)        ;; NPCs we sent shown that left the game or were hidden within 40 m
                                ;; of another player, not dying (test log: gone under its eyes)
   (hit-remote    uint32 16)    ;; recent blows from other players: sender slot << 28 | its attack id
   (hit-local     uint32 16)    ;; and the attack id each got here
   (hit-next      int32)
   )
  )

(define *mp-world-state* (new 'global 'mp-world-state))
(define *mp-actors-out* (new 'global 'mp-actor-table))
(define *mp-actors-in* (new 'global 'mp-actor-table))
(set! (-> *mp-world-state* traffic-off?) #f)

;; Attack modes a guest can deal to an NPC, sent as their index (symbols are not sent).
(define *mp-attack-modes*
  (new 'static 'boxed-array :type symbol
    'generic 'punch 'spin 'uppercut 'flop 'dark-punch 'dark-smack 'lunge 'roll 'bonk 'board
    'eco-yellow 'eco-red 'eco-blue 'eco-dark 'explode 'mech-punch 'flut-attack 'tube
    'eco-red-shove 'gravity-end 'flut 'mech 'turret 'ice
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Which processes are NPCs
;; ------------------------------------------------------------------------------------------------

(defun mp-actor-kind ((proc process))
  "1 for a character (the enemy family), 2 for a vehicle, 3 for a vehicle wheel, 0 otherwise."
  (let ((typ (-> proc type)))
    (dotimes (i 14)
      (let ((name (-> typ symbol)))
        (cond
          ((= name 'enemy) (return 1))
          ((= name 'vehicle) (return 2))
          ((= name 'vehicle-wheel) (return 3))
          ((or (= name 'process-drawable) (= name 'process)) (return 0))
          )
        )
      (set! typ (-> typ parent))
      )
    )
  0
  )

(defun mp-driven-vehicle? ((proc process))
  "#t for the vehicle the local player drives, or one of its wheels (they are the player's props)."
  (when (and *target* (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
    (let ((veh (handle->process (-> *target* pilot vehicle))))
      (and veh (or (= veh proc) (= (ppointer->process (-> proc parent)) veh)))
      )
    )
  )

(defun mp-player-pos ((slot int))
  "Where player `slot` stands (this player included), #f when unknown."
  (if (= slot *mp-local-slot*)
      (if *target*
          (-> *mp-local* trans)
          (the-as vector #f)
          )
      (let ((st (mp-remote-state slot)))
        (if st
            (-> st trans)
            (the-as vector #f)
            )
        )
      )
  )

(defun mp-authority-flag? ((slot int))
  "#t when player `slot` simulates its own NPCs (for this player: its current role)."
  (if (= slot *mp-local-slot*)
      *mp-authority*
      (let ((st (mp-remote-state slot)))
        (and st (logtest? (-> st flags) (mp-flag authority)))
        )
      )
  )

(defun mp-provider-of ((slot int))
  "Slot of the player whose NPCs player `slot` sees: itself when it is an authority, else the first
   authority within 90 m, else the host."
  (if (mp-authority-flag? slot)
      (return slot)
      )
  (let ((pos (mp-player-pos slot)))
    (when pos
      (dotimes (q MP_MAX_PLAYERS)
        (let ((other (mp-player-pos q)))
          (if (and (!= q slot) other (mp-authority-flag? q) (< (vector-vector-distance pos other) (meters 90)))
              (return q)
              )
          )
        )
      )
    )
  0
  )

(defun mp-update-authority ()
  "Pick this player's role. The host always simulates its NPCs. A guest shows the NPCs of a
   lower-slot authority within 60 m, and simulates its own once farther than 90 m from all of them,
   after 2 s in the new situation (a player on the border does not flip every frame)."
  (let* ((ws *mp-world-state*)
         (want (cond
                 ((= *mp-mode* (mp-mode host))
                  #t
                  )
                 ((< *mp-local-slot* 0)
                  #f
                  )
                 ;; co-op: the host's NPCs everywhere (a guest stays near the host)
                 ((mp-coop?)
                  #f
                  )
                 (else
                   (let ((me (mp-player-pos *mp-local-slot*))
                         (nearest (meters 1000000))
                         )
                     (when me
                       (dotimes (q *mp-local-slot*)
                         (let ((other (mp-player-pos q)))
                           (if (and other (mp-authority-flag? q))
                               (set! nearest (fmin nearest (vector-vector-distance me other)))
                               )
                           )
                         )
                       )
                     (cond
                       ((< nearest (meters 60)) #f)
                       ((< (meters 90) nearest) #t)
                       (else *mp-authority*)
                       )
                     )
                   )
                 )
               )
         )
    (when (!= want (-> ws authority-want))
      (set! (-> ws authority-want) want)
      (set! (-> ws authority-since) (mp-now))
      )
    (when (and (!= want *mp-authority*)
               (or (= *mp-mode* (mp-mode host)) (>= (- (mp-now) (-> ws authority-since)) (seconds 2)))
               )
      (set! *mp-authority* want)
      (format 0 "[multiplayer] ~S~%" (if want
                                         "this player now simulates the NPCs around it"
                                         "this player now shows another player's NPCs"
                                         )
              )
      )
    )
  (none)
  )

(defun mp-collect-served ()
  "Note where the players whose NPCs we simulate stand, for the batch being built."
  (let ((ws *mp-world-state*))
    (set! (-> ws served-count) 0)
    (when *mp-authority*
      (dotimes (i MP_MAX_PLAYERS)
        (let ((pos (mp-player-pos i)))
          (when (and pos (= (mp-provider-of i) *mp-local-slot*))
            (vector-copy! (-> ws served-pos (-> ws served-count)) pos)
            (+! (-> ws served-count) 1)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-served-distance ((pos vector))
  "Distance from `pos` to the nearest player whose NPCs we simulate."
  (let ((ws *mp-world-state*)
        (best (meters 1000000))
        )
    (dotimes (i (-> ws served-count))
      (set! best (fmin best (vector-vector-distance pos (-> ws served-pos i))))
      )
    best
    )
  )

(defun mp-near-a-player? ((pos vector))
  "Within 100 m of the local player or of a remote player."
  (if (and *target* (< (vector-vector-distance pos (-> *target* control trans)) (meters 100)))
      (return #t)
      )
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i)))
      (if (and st (< (vector-vector-distance pos (-> st trans)) (meters 100)))
          (return #t)
          )
      )
    )
  #f
  )

(defun mp-skel-of ((proc process-drawable))
  "The skeleton-group `proc` was built from. A process keeps only its art group and joint geometry,
   so the active levels' art-group arrays (where defskelgroup registers every skeleton-group) are
   searched for a skeleton-group with that art group and that geometry. Cached per geometry; the
   cache is reset whenever a level loads (see mp-world-send). #f when not found."
  (let ((ws *mp-world-state*)
        (jgeo (-> proc draw jgeo))
        (ag (-> proc draw art-group))
        )
    (dotimes (i (-> ws skel-count))
      (if (= (-> ws skel-jgeo i) jgeo)
          (return (-> ws skel-group i))
          )
      )
    (let ((found (the-as skeleton-group #f)))
      (countdown (li 11)
        (let ((lev (-> *level* level li)))
          (when (and (not found) (or (= (-> lev status) 'active) (= (-> lev status) 'reserved)))
            (let ((arr (-> lev art-group art-group-array)))
              (dotimes (ai (-> arr length))
                (let ((sg (the-as skeleton-group (-> arr ai))))
                  (when (and (not found)
                             sg
                             (type? sg skeleton-group)
                             (string= (-> sg art-group-name) (-> ag name))
                             (>= (-> sg jgeo) 0)
                             (< (-> sg jgeo) (-> ag length))
                             (= (-> ag data (-> sg jgeo)) jgeo)
                             )
                    (set! found sg)
                    )
                  )
                )
              )
            )
          )
        )
      (when (< (-> ws skel-count) 128)
        (set! (-> ws skel-jgeo (-> ws skel-count)) jgeo)
        (set! (-> ws skel-group (-> ws skel-count)) found)
        (+! (-> ws skel-count) 1)
        )
      found
      )
    )
  )

(defun mp-anim-index ((proc process-drawable))
  "Index of the animation `proc` plays on channel 0 in its art group, -1 when none."
  (let ((skel (-> proc skel))
        (ag (-> proc draw art-group))
        )
    (when (> (-> skel active-channels) 0)
      (let ((fg (-> skel root-channel 0 frame-group)))
        (when fg
          (dotimes (i (-> ag length))
            (if (= (-> ag data i) fg)
                (return i)
                )
            )
          )
        )
      )
    )
  -1
  )

;; ------------------------------------------------------------------------------------------------
;; Host: collect and send
;; ------------------------------------------------------------------------------------------------

(define *mp-collect-count* 0)

;; ------------------------------------------------------------------------------------------------
;; Poses and emitters: types (the code is after the replicas)
;; ------------------------------------------------------------------------------------------------

(defconstant MP_MAX_POSE_JOINTS 256)

;; One emitter to draw on a copy, in world space. 80 bytes, mirrors mp::EmitterOut.
(deftype mp-emitter (structure)
  ((kind  int32)  ;; 0 particle group, 1 single launcher (2d system), 2 single launcher (3d)
   (index int32)  ;; in *part-group-id-table* or *part-id-table*
   (count int32)  ;; single launcher: launches to replay now
   (home  int32)  ;; single launcher: hash of the level holding it, 0 = global (mp-level-hash)
   (mat   matrix :inline)
   )
  :size-assert #x50
  )

;; One sound sent with an object (world position), or to play on its copy (position on the copy).
;; 64 bytes, mirrors mp::SoundIO.
(deftype mp-sound (structure)
  ((name  sound-name)
   (id    sound-id) ;; the owner's sound id: the same id over several batches is one lasting sound
   (vol   int32)
   (pitch int32)
   (bend  int32)
   (flags int32)  ;; 1 positional, 2 stopped
   (pad   int32 3)
   (pos   vector :inline)
   )
  :size-assert #x40
  )

(deftype mp-pose-state (structure)
  ((bones       matrix MP_MAX_POSE_JOINTS :inline) ;; scratch: bones sent or received
   (frame       matrix :inline)
   (emitters    mp-emitter 32 :inline)
   ;; objects of the last batch (same order as *mp-actors-out*), and whether another player is
   ;; near enough to get their bones every frame (mp-send-near-poses)
   (obj         handle MP_MAX_ACTORS)
   (near        symbol MP_MAX_ACTORS)
   ;; emitters used since the last batch by the objects we send (mp-note-emitter)
   (emit-count  int32)
   (emit-pid    int32 64)
   (emit-kind   int32 64)
   (emit-ptr    basic 64)
   (emit-calls  int32 64)
   (emit-origin matrix 64 :inline)
   ;; launcher -> *part-id-table* index, reset with the skeleton cache
   (part-ptr    basic 16)
   (part-index  int32 16)
   (part-next   int32)
   ;; counters for the test log
   (poses-sent     int32)
   (poses-skipped  int32)  ;; poses left out of drawn objects (bones not all fresh): the copy plays
                           ;; the animation
   (poses-hidden   int32)  ;; objects their owner does not draw (hidden, or for a moment)
   (poses-applied  int32)
   (emitters-sent  int32)
   (emitters-shown int32)
   (emitters-received int32)
   (last-kind      int32)  ;; last emitter received, for the test log
   (last-index     int32)
   (last-home      int32)
   ;; sounds played since the last batch by the objects we send (mp-note-sound), latest call per
   ;; sound id
   (snd-count      int32)
   (snd-pid        int32 24)
   (snd-out        mp-sound 48 :inline)
   ;; recent sound ids of those objects, so a sound-stop on one reaches the others
   (known-pid      int32 32)
   (known-id       sound-id 32)
   (known-next     int32)
   ;; sounds received, and the copies' sounds playing here: copy id, owner's sound id, our id
   (sounds         mp-sound 32 :inline)
   (rsnd-copy      uint32 96)
   (rsnd-remote    sound-id 96)
   (rsnd-local     sound-id 96)
   (rsnd-batches   int32 96)
   (rsnd-time      time-frame 96)
   (sounds-sent    int32)
   (sounds-played  int32)
   )
  )

(define *mp-pose* (new 'global 'mp-pose-state))

(define-extern pc-mp-get-emitters (function uint matrix (inline-array mp-emitter) int int))
(define-extern pc-mp-add-sound (function mp-sound none))
(define-extern pc-mp-get-sounds (function uint matrix (inline-array mp-sound) int int))

(defun mp-add-actor ((proc process-drawable) (flags mp-actor-flag))
  "Add `proc` to the batch being built. #f when it cannot be drawn elsewhere (no skeleton found)."
  (when (and (< *mp-collect-count* MP_MAX_ACTORS)
             (nonzero? (-> proc root))
             (nonzero? (-> proc draw))
             (nonzero? (-> proc skel))
             (nonzero? (-> proc draw jgeo))
             (nonzero? (-> proc draw art-group))
             )
    (let ((sg (mp-skel-of proc)))
      (when sg
        (let ((st (-> *mp-actors-out* state *mp-collect-count*)))
          (vector-copy! (-> st trans) (-> proc root trans))
          (set! (-> st trans w) (-> proc root scale x))
          (quaternion-copy! (-> st quat) (-> proc root quat))
          ;; the runtime puts the owner's slot in the top byte
          (set! (-> st id) (the-as uint (logand (-> proc pid) #xffffff)))
          (set! (-> st anim-index) (mp-anim-index proc))
          (set! (-> st anim-frame) (if (>= (-> st anim-index) 0)
                                       (-> proc skel root-channel 0 frame-num)
                                       0.0
                                       )
                )
          (set! (-> st flags) flags)
          (if (logtest? (-> proc draw status) (draw-control-status no-draw))
              (logior! (-> st flags) (mp-actor-flag hidden))
              )
          (if (and (type? proc process-focusable) (focus-test? (the-as process-focusable proc) dead))
              (logior! (-> st flags) (mp-actor-flag dead))
              )
          ;; what the other players' weapons may aim at on its copy
          (when (type? proc process-focusable)
            (logior! (-> st flags)
                     (the-as mp-actor-flag (shl (logand (the-as int (get-search-info-flag (the-as process-focusable proc))) #x7e) 7))
                     )
            (if (logtest? (process-mask civilian) (-> proc mask))
                (logior! (-> st flags) (mp-actor-flag aim-civilian))
                )
            (if (logtest? (process-mask enemy metalhead kg-robot) (-> proc mask))
                (logior! (-> st flags) (mp-actor-flag aim-hostile))
                )
            )
          (set! (-> st seg-mask) (the-as uint (-> proc draw seg-mask)))
          (copyn-charp<-string (-> st skel) (-> sg name) 32)
          (mp-note-art sg proc)
          (set! (-> *mp-pose* obj *mp-collect-count*) (process->handle proc))
          (+! *mp-collect-count* 1)
          (return #t)
          )
        )
      )
    )
  #f
  )

(defun mp-force-math ((proc process-drawable))
  "Have `proc` compute every bone each frame, whatever its level of detail on this screen: the
   players who see its copy up close need its whole pose. Undone by mp-release-math once it is no
   longer sent."
  (let ((ws *mp-world-state*))
    (when (and (nonzero? (-> proc skel))
               (not (logtest? (-> proc skel status) (joint-control-status force-math)))
               (< (-> ws forced-count) 128)
               )
      (logior! (-> proc skel status) (joint-control-status force-math))
      (set! (-> ws forced (-> ws forced-count)) (process->handle proc))
      (+! (-> ws forced-count) 1)
      )
    )
  (none)
  )

(defun mp-release-math ((all? symbol))
  "Clear the force-math we set on NPCs that are no longer in the batch (on every one when `all?`)."
  (let ((ws *mp-world-state*)
        (n 0)
        )
    (dotimes (i (-> ws forced-count))
      (let ((proc (the-as process-drawable (handle->process (-> ws forced i))))
            (keep? #f)
            )
        (when (and proc (not all?))
          (dotimes (j *mp-collect-count*)
            (if (= (logand (-> proc pid) #xffffff) (the-as int (-> *mp-actors-out* state j id)))
                (set! keep? #t)
                )
            )
          )
        (cond
          (keep?
            (set! (-> ws forced n) (-> ws forced i))
            (+! n 1)
            )
          (proc
            (logclear! (-> proc skel status) (joint-control-status force-math))
            )
          )
        )
      )
    (set! (-> ws forced-count) n)
    )
  (none)
  )

(defun mp-world-object-id ((proc process))
  "Id of a physics object the same on every machine: its entity's aid, and in bits 20-23 its rank
   among the objects that entity's process spawned (5 lava platforms share their spawner's
   entity), 0 for the entity's own process. -1 when it cannot be named."
  (let* ((ent (-> proc entity))
         (aid (the-as int (-> ent aid)))
         (owner (-> ent extra process))
         (rank 0)
         )
    (when (and owner (!= owner proc))
      (let ((child (-> owner child))
            (i 1)
            )
        (while (and child (zero? rank))
          (let ((node (ppointer->process child)))
            (when (and node (type? node rigid-body-object))
              (if (= node proc)
                  (set! rank i)
                  )
              (+! i 1)
              )
            (set! child (if node
                            (-> node brother)
                            (the-as (pointer process-tree) #f)
                            )
                  )
            )
          )
        (if (zero? rank)
            (return -1)
            )
        )
      )
    (if (or (>= aid #x100000) (>= rank 16))
        -1
        (logior aid (shl rank 20))
        )
    )
  )

(defun mp-world-object-by-id ((id int))
  "Our physics object named `id` (mp-world-object-id), or #f."
  (let ((ent (entity-by-aid (the-as uint (logand id #xfffff))))
        (rank (logand (shr id 20) 15))
        )
    (when ent
      (let ((owner (-> (the-as entity-actor ent) extra process)))
        (cond
          ((not owner)
           (the-as process #f)
           )
          ((zero? rank)
           owner
           )
          (else
            (let ((child (-> owner child))
                  (i 1)
                  )
              (while child
                (let ((node (ppointer->process child)))
                  (when (and node (type? node rigid-body-object))
                    (if (= i rank)
                        (return (the-as process node))
                        )
                    (+! i 1)
                    )
                  (set! child (if node
                                  (-> node brother)
                                  (the-as (pointer process-tree) #f)
                                  )
                        )
                  )
                )
              )
            (the-as process #f)
            )
          )
        )
      )
    )
  )

(defun mp-add-world-object ((proc rigid-body-object))
  "Add physics object `proc` (a floating platform, a crate on physics...) to the batch, named by
   its entity (mp-world-object-id): the others move their own object of that name to where ours is."
  (when (and (< *mp-collect-count* MP_MAX_ACTORS) (>= (mp-world-object-id proc) 0))
    (let ((st (-> *mp-actors-out* state *mp-collect-count*)))
      (vector-copy! (-> st trans) (-> proc root trans))
      (set! (-> st trans w) 1.0)
      (quaternion-copy! (-> st quat) (-> proc root quat))
      (set! (-> st id) (the-as uint (mp-world-object-id proc)))
      (set! (-> st anim-index) -1)
      (set! (-> st anim-frame) 0.0)
      (set! (-> st flags) (mp-actor-flag world))
      (set! (-> st seg-mask) (the-as uint 0))
      (set! (-> st skel 0) (the-as uint 0))
      (set! (-> *mp-pose* obj *mp-collect-count*) (process->handle proc))
      (+! *mp-collect-count* 1)
      )
    )
  (none)
  )

(defun mp-collect-actor ((proc process-drawable))
  "iterate-process-tree callback (authority): add `proc` when it is an NPC within 100 m of a player
   whose NPCs we simulate."
  (when (type? proc process-drawable)
    (let ((kind (mp-actor-kind proc)))
      ;; physics objects of the level (not vehicles): their place only, as far as they can be seen
      (if (and (zero? kind)
               (type? proc rigid-body-object)
               (-> proc entity)
               (nonzero? (-> proc root))
               (< (mp-served-distance (-> proc root trans)) (meters 300))
               )
          (mp-add-world-object (the-as rigid-body-object proc))
          )
      (when (and (> kind 0)
                 (not (mp-driven-vehicle? proc))
                 (< (mp-served-distance (-> proc root trans)) (meters 100))
                 )
        (if (mp-add-actor proc (if (= kind 1)
                                   (mp-actor-flag)
                                   (mp-actor-flag vehicle)
                                   )
                          )
            (mp-force-math proc)
            )
        )
      )
    )
  #f
  )

(defun mp-add-prop ((proc process-drawable))
  "Add a prop attached to the player. Daxter and the gun keep their root still: their root joint is
   computed from one of Jak's joints each frame, so that joint's world transform is sent instead."
  (when (and (mp-add-actor proc (mp-actor-flag prop owned)) (nonzero? (-> proc node-list)))
    (let ((st (-> *mp-actors-out* state (+ *mp-collect-count* -1)))
          (mat (-> proc node-list data 0 bone transform))
          )
      (vector-copy! (-> st trans) (-> mat trans))
      (set! (-> st trans w) 1.0)
      (matrix->quaternion (-> st quat) mat)
      (quaternion-normalize! (-> st quat))
      )
    )
  (none)
  )

(defun mp-add-shot ((proc process-drawable))
  "Add a shot without a model to the batch: its place only (its trail is its emitters)."
  (when (< *mp-collect-count* MP_MAX_ACTORS)
    (let ((st (-> *mp-actors-out* state *mp-collect-count*)))
      (vector-copy! (-> st trans) (-> proc root trans))
      (set! (-> st trans w) 1.0)
      (quaternion-copy! (-> st quat) (-> proc root quat))
      (set! (-> st id) (the-as uint (logand (-> proc pid) #xffffff)))
      (set! (-> st anim-index) -1)
      (set! (-> st anim-frame) 0.0)
      (set! (-> st flags) (mp-actor-flag owned shot))
      (set! (-> st seg-mask) (the-as uint 0))
      (set! (-> st skel 0) (the-as uint 0))
      ;; its type after the empty name: its copy draws what the shot carries along (a light trail)
      (copyn-charp<-string (&-> st skel 1) (symbol->string (-> proc type symbol)) 30)
      (set! (-> *mp-pose* obj *mp-collect-count*) (process->handle proc))
      (+! *mp-collect-count* 1)
      )
    )
  (none)
  )

(defun mp-collect-shot ((proc process-drawable))
  "iterate-process-tree callback, under the player: add a shot of the player in flight, with its
   model when it has one. The others draw it from its state, no projectile code runs there: a
   shot's code reads the local player (*target*'s gun, its pad, its ammo), so a copy of the shot ran
   on another machine charged, aimed and vanished with that machine's player."
  (when (and (type? proc projectile) (nonzero? (-> proc root)))
    (if (not (mp-add-actor proc (mp-actor-flag owned shot)))
        (mp-add-shot proc)
        )
    )
  #f
  )

(define-extern mp-collect-weapon (function process object))

(defun mp-pack-laser ((st mp-actor-state))
  "Our gun's state `st`: the laser sight as our gun draws it (gun-info-method-9), where it starts
   from the gun's root (the state's trans) in mm and its direction in 1/32767, after the skeleton
   name (\"skel-gun\", bytes 16 to 27 of skel): the aim, not the barrel (mp-draw-laser)."
  (let ((v (the-as (pointer int16) (&-> st skel 16)))
        (off (vector-! (new 'stack-no-clear 'vector) (-> *target* gun laser-point) (-> st trans)))
        (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> *target* gun laser-dir) 1.0))
        )
    (dotimes (k 3)
      (set! (-> v k) (the int (fmax -32767.0 (fmin 32767.0 (/ (-> off data k) 4.096)))))
      (set! (-> v (+ k 3)) (the int (* 32767.0 (-> dir data k))))
      )
    )
  (none)
  )

(defun mp-collect-props ()
  "Add the local player's props: Daxter on the shoulder, the gun (with its laser sight on or off),
   the hoverboard, the vehicle driven and its wheels, and its shots in flight."
  (when *target*
    (let ((dax (ppointer->process (-> *target* sidekick))))
      (if (and dax (not (mp-playing-daxter? *target*)))
          (mp-add-prop (the-as process-drawable dax))
          )
      )
    (when (nonzero? (-> *target* gun))
      (let ((gun (ppointer->process (-> *target* gun gun))))
        (when gun
          (mp-add-prop (the-as process-drawable gun))
          (let ((st (-> *mp-actors-out* state (max 0 (+ *mp-collect-count* -1)))))
            (when (and (= (-> st id) (the-as uint (logand (-> gun pid) #xffffff)))
                       (-> *target* gun laser-active?)
                       (-> *target* gun active?)
                       )
              (logior! (-> st flags) (mp-actor-flag laser))
              (mp-pack-laser st)
              )
            )
          )
        )
      )
    (when (nonzero? (-> *target* board))
      (let ((board (ppointer->process (-> *target* board board))))
        (if board
            (mp-add-prop (the-as process-drawable board))
            )
        )
      )
    (iterate-process-tree *target* (the-as (function object object) mp-collect-shot) *null-kernel-context*)
    (iterate-process-tree *target* (the-as (function object object) mp-collect-weapon) *null-kernel-context*)
    (when (and (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
      (let ((veh (handle->process (-> *target* pilot vehicle))))
        ;; not a vehicle another player took from us (its own stands there now)
        (when (and veh (type? veh process-drawable) (!= veh (handle->process *mp-stolen-vehicle*)))
          (mp-add-actor (the-as process-drawable veh) (mp-actor-flag vehicle owned))
          (let ((child (-> veh child)))
            (while child
              (let ((node (ppointer->process child)))
                (when (and node (type? node process) (= (mp-actor-kind (the-as process node)) 3))
                  (mp-add-actor (the-as process-drawable node) (mp-actor-flag vehicle owned))
                  )
                (set! child (if node
                                (-> node brother)
                                (the-as (pointer process-tree) #f)
                                )
                      )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(define-extern mp-remote-distance (function vector float))
(define-extern mp-send-poses (function none))
(define-extern mp-send-near-poses (function none))
(define-extern mp-send-art (function none))
(define-extern mp-far-fetch-art (function none))
(define-extern mp-art-heap-close (function none))
(define-extern mp-elevators-unmute (function symbol none))
(define-extern mp-test-note-path (function symbol mp-actor-state none)) ;; multiplayer-test.gc
(define-extern mp-test-note-gone (function mp-actor-state process-drawable none)) ;; multiplayer-test.gc
(define-extern mp-test-note-laser (function process-drawable vector vector none)) ;; multiplayer-test.gc
(define-extern mp-poll-elevator (function process object))
(define-extern mp-drive-elevator (function mp-actor-state none))
(define-extern mp-update-remote-riders (function none))


(defun mp-world-send ()
  "Send what this player simulates, 15 times a second: its props, and the NPCs near the players it
   is the authority of; then their poses and emitters."
  (let ((ws *mp-world-state*))
    ;; level art moves when a level loads: forget the cached skeletons then, and every 4 s
    (when (or (-> *level* loading-level) (>= (- (mp-now) (-> ws cache-time)) (seconds 4)))
      (set! (-> ws skel-count) 0)
      (set! (-> ws cache-time) (mp-now))
      (dotimes (i 16)
        (set! (-> *mp-pose* part-ptr i) #f)
        )
      )
    (when (and (> (mp-player-count) 0) (>= (- (mp-now) (-> ws last-send)) (seconds 0.066)))
      (set! (-> ws last-send) (mp-now))
      ;; the NPCs of the last batch shown that left meanwhile, or were hidden (citizen go-inactive,
      ;; traffic sent back to its pool: no-draw, the copy hidden), alive, near another player (test
      ;; log: what vanished under its eyes)
      (dotimes (i (-> *mp-actors-out* count))
        (let ((st (-> *mp-actors-out* state i))
              (proc (the-as process-drawable (handle->process (-> *mp-pose* obj i))))
              )
          (when (and (not (logtest? (-> st flags) (mp-actor-flag owned world dead hidden)))
                     (< (mp-remote-distance (-> st trans)) (meters 40))
                     (or (not proc)
                         (and (not (and (type? proc process-focusable) (focus-test? (the-as process-focusable proc) dead)))
                              (or (and (type? proc process-focusable) (focus-test? (the-as process-focusable proc) inactive))
                                  (and (nonzero? (-> proc draw)) (logtest? (-> proc draw status) (draw-control-status no-draw)))
                                  )
                              )
                         )
                     )
            (+! (-> ws gone-near) 1)
            (mp-test-note-gone st proc)
            )
          )
        )
      (set! *mp-collect-count* 0)
      (mp-collect-served)
      (mp-collect-props)
      (if *mp-authority*
          (iterate-process-tree
            *active-pool*
            (the-as (function object object) mp-collect-actor)
            *null-kernel-context*
            )
          )
      (mp-release-math #f)
      (iterate-process-tree *active-pool* (the-as (function object object) mp-poll-elevator) *null-kernel-context*)
      (set! (-> *mp-actors-out* count) *mp-collect-count*)
      (dotimes (i *mp-collect-count*)
        (mp-test-note-path #t (-> *mp-actors-out* state i))
        )
      (pc-mp-send-actors (-> *mp-actors-out* state) *mp-collect-count*)
      (mp-send-poses)
      )
    ;; between batches, the bones of what another player sees up close, every frame
    (if (and (> (mp-player-count) 0) (!= (-> ws last-send) (mp-now)))
        (mp-send-near-poses)
        )
    ;; the art of what we send, for the others' copies
    (if (> (mp-player-count) 0)
        (mp-send-art)
        )
    )
  (none)
  )

(define *mp-search-pid* 0)

(defun mp-process-by-pid ((pid int))
  "The live process with this pid, or #f."
  (set! *mp-search-pid* pid)
  (the-as
    process
    (search-process-tree
      *active-pool*
      (lambda ((p process-tree)) (and (type? p process) (= (-> (the-as process p) pid) *mp-search-pid*)))
      )
    )
  )

(defun mp-local-attack-id ((from int) (remote uint))
  "The attack id here of blow `remote` of player `from` (its machine's attack id, 0 when it had
   none): the same one each time it arrives (a zap touches every part of a vehicle several frames),
   so the victim counts it once, as stock code does with one attack id."
  (let ((ws *mp-world-state*)
        (key (logior (shl from 28) (logand remote #xfffffff)))
        )
    (when (nonzero? remote)
      (dotimes (i 16)
        (if (= (-> ws hit-remote i) key)
            (return (-> ws hit-local i))
            )
        )
      )
    (let ((id (new-attack-id))
          (i (-> ws hit-next))
          )
      (when (nonzero? remote)
        (set! (-> ws hit-remote i) key)
        (set! (-> ws hit-local i) id)
        (set! (-> ws hit-next) (logand (+ i 1) 15))
        )
      id
      )
    )
  )

(defbehavior mp-on-actor-hit mp-manager ((ev mp-event))
  "Another player hit the replica of one of our objects (an NPC, our vehicle). Apply it to the real
   one, from that player's puppet, so it turns to that player and reacts as if hit here; one blow
   once (mp-local-attack-id)."
  (let ((proc (mp-process-by-pid (-> ev iarg 0)))
        (attacker (handle->process (-> self puppets (max 0 (min (-> ev from) (+ MP_MAX_PLAYERS -1))))))
        (mode (-> *mp-attack-modes* (max 0 (min (-> ev iarg 1) (+ (-> *mp-attack-modes* length) -1)))))
        )
    (when (and proc attacker)
      (format 0 "[multiplayer] player ~D hit ~A (~A, ~f)~%" (-> ev from) proc mode (-> ev fvec w))
      ;; the object's answer and the state it goes to: its reaction (log)
      (let ((took (send-event
                    proc
                    'attack
                    :from attacker
                    #f
                    (static-attack-info
                      :mask (vehicle-impulse-factor)
                      ((id (mp-local-attack-id (-> ev from) (the-as uint (-> ev pad))))
                       (mode mode)
                       (damage (-> ev fvec w))
                       (penetrate-using (the-as penetrate (logior (shl (the-as uint (-> ev iarg 3)) 32)
                                                                  (logand (the-as uint (-> ev iarg 2)) #xffffffff)
                                                                  )
                                                )
                                        )
                       (attacker (process->handle attacker))
                       (vehicle-damage-factor 1.0)
                       (vehicle-impulse-factor 1.0)
                       )
                      )
                    )
                  )
            )
        (format 0 "[multiplayer]   taken ~A, then ~A~%" (if took #t #f) (if (-> proc next-state)
                                                                            (-> proc next-state name)
                                                                            'none
                                                                            )
                )
        )
      )
    )
  (none)
  )

(defbehavior mp-on-vehicle-taken mp-manager ((ev mp-event))
  "A guest took one of our NPC vehicles (it drives its own copy): remove ours."
  (let ((proc (mp-process-by-pid (-> ev iarg 0))))
    (if (and proc (= (mp-actor-kind proc) 2) (not (mp-driven-vehicle? proc)))
        (send-event proc 'go-die)
        )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Guest: replicas
;; ------------------------------------------------------------------------------------------------

(define-extern mp-replica-vanished (function process-drawable string none))

(define *mp-test-hide-copies* #f) ;; test switch (hide-copies): every copy hidden
(define *mp-trace-vanish* #f) ;; trace-vanish: log each copy that vanished, faded or died near us

(defconstant MP_LINGER_HOLD (seconds 3)) ;; a copy left in our view holds this long (a late state)
(defconstant MP_LINGER_TIME (seconds 4)) ;; then fades out until this, as debris do

(defun mp-in-our-view? ((proc process-drawable))
  "#t when `proc` is drawn on our screen within 60 m of our player: whatever it does there, our
   player sees it."
  (and *target*
       (nonzero? (-> proc draw))
       (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
       (logtest? (-> proc draw status) (draw-control-status on-screen))
       (< (vector-vector-distance (-> proc root trans) (-> *target* control trans)) (meters 60))
       )
  )

;; One NPC of the host, drawn here. It plays the host's animation (and with it the effects the
;; animation carries: footsteps, sounds), takes the host's body variant, and is solid and hittable
;; like the real one. Hits go to the host. It is a process-focusable of the original's kind (process
;; mask, search-info flags, sent in its state): auto-aim, homing shots and blasts (gyro burster,
;; peace maker, wave concussor) only consider focusables of those kinds.
(deftype mp-replica (process-focusable)
  ((id     uint32)
   (dying? symbol)
   (linger-since time-frame)       ;; when it began to stay in our view after its owner hid it or
                                   ;; stopped sending it (0: not lingering): it holds, then fades out
   (last-attack uint32)            ;; id of the last attack sent, so one blow counts once
   (fx-group   int32 MP_FX_TRACKERS) ;; particle groups the owner's object emits (mp-play-emitters)
   (fx-tracker handle MP_FX_TRACKERS)
   (pose-count int32)              ;; poses laid on this copy, and the last count received
   (pose-last  int32)
   (pose-time  int32)              ;; owner's time (tenths of a ms) of the pose laid last (test logs)
   (net    mp-actor-state :inline) ;; latest state from the owner
   )
  )

(defmethod get-search-info-flag ((this mp-replica))
  "What the original answers (its state's aim bits): the local player's weapons pick the copy as
   they would the original. Nothing for props, shots, hidden or dying copies."
  (if (logtest? (-> this net flags) (mp-actor-flag prop owned shot hidden dead))
      (the-as search-info-flag 0)
      (the-as search-info-flag (shr (logand (the-as int (-> this net flags)) #x3f00) 7))
      )
  )

(defun mp-attack-mode-index ((mode symbol))
  "Index of an attack mode in *mp-attack-modes* (0, generic, when unknown)."
  (dotimes (i (-> *mp-attack-modes* length))
    (if (= (-> *mp-attack-modes* i) mode)
        (return i)
        )
    )
  0
  )

(defbehavior mp-replica-hit mp-replica ((attacker process) (info attack-info))
  "The local player hit this replica: send the blow to its owner (the host for an NPC)."
  (when (and (mp-from-local-player? attacker)
             *target*
             (not (and info
                       (logtest? (attack-mask id) (-> info mask))
                       (= (-> info id) (-> self last-attack))
                       )
                  )
             )
    (if (and info (logtest? (attack-mask id) (-> info mask)))
        (set! (-> self last-attack) (-> info id))
        )
    (let ((ev (new 'stack 'mp-event))
          (pen (if (and info (logtest? (attack-mask penetrate-using) (-> info mask)))
                   (the-as uint (-> info penetrate-using))
                   (the-as uint 0)
                   )
               )
          )
      (set! (-> ev kind) (mp-event-kind actor-hit))
      ;; to the object's owner, with the pid it knows
      (set! (-> ev to) (the-as int (shr (-> self id) 24)))
      (set! (-> ev iarg 0) (the-as int (logand (-> self id) #xffffff)))
      (set! (-> ev iarg 1) (if (and info (logtest? (attack-mask mode) (-> info mask)))
                               (mp-attack-mode-index (-> info mode))
                               0
                               )
            )
      (set! (-> ev iarg 2) (the-as int (logand pen #xffffffff)))
      (set! (-> ev iarg 3) (the-as int (shr pen 32)))
      ;; its attack id: the owner counts one blow once
      (set! (-> ev pad) (if (and info (logtest? (attack-mask id) (-> info mask)))
                            (the-as int (-> info id))
                            0
                            )
            )
      (vector-copy! (-> ev fvec) (-> *target* control trans))
      (set! (-> ev fvec w) (if (and info (logtest? (attack-mask damage) (-> info mask)))
                               (-> info damage)
                               1.0
                               )
            )
      (pc-mp-send-event ev)
      )
    )
  (none)
  )

(defbehavior mp-replica-fade mp-replica ()
  "A copy lingering in our view (linger-since) fades out after MP_LINGER_HOLD, down to nothing at
   MP_LINGER_TIME (force-fade, as debris fade); a copy shown again is drawn whole."
  (cond
    ((nonzero? (-> self linger-since))
     (let ((fade (- 128 (/ (* (- (- (mp-now) (-> self linger-since)) MP_LINGER_HOLD) 128) (- MP_LINGER_TIME MP_LINGER_HOLD)))))
       (when (< fade 128)
         (logior! (-> self draw status) (draw-control-status force-fade))
         (set! (-> self draw force-fade) (the-as uint (max 0 fade)))
         )
       )
     )
    (else
      (logclear! (-> self draw status) (draw-control-status force-fade))
      )
    )
  (none)
  )

(defbehavior mp-replica-update mp-replica ()
  "Apply the host's latest state: place, scale, visibility, body variant, animation, death, and the
   kind weapons see (process mask, dead)."
  (let ((st (-> self net)))
    (let ((f (-> st flags)))
      (logclear! (-> self mask) (process-mask enemy guard civilian crate vehicle))
      (when (not (logtest? f (mp-actor-flag prop owned shot hidden dead)))
        (if (logtest? f (mp-actor-flag aim-crate))
            (logior! (-> self mask) (process-mask crate))
            )
        (if (logtest? f (mp-actor-flag aim-guard))
            (logior! (-> self mask) (process-mask guard))
            )
        (if (logtest? f (mp-actor-flag aim-enemy aim-hostile))
            (logior! (-> self mask) (process-mask enemy))
            )
        (if (logtest? f (mp-actor-flag aim-civilian))
            (logior! (-> self mask) (process-mask civilian))
            )
        (if (logtest? f (mp-actor-flag vehicle))
            (logior! (-> self mask) (process-mask vehicle))
            )
        )
      (if (logtest? f (mp-actor-flag dead))
          (logior! (-> self focus-status) (focus-status dead))
          (logclear! (-> self focus-status) (focus-status dead))
          )
      )
    (let ((was (vector-copy! (new 'stack-no-clear 'vector) (-> self root trans))))
      (move-to-point! (-> self root) (-> st trans))
      ;; its cloth, if it has one: reset after a jump, hidden while the copy is off screen
      (mp-cloth-follow self (< (meters 10) (vector-vector-distance was (-> self root trans))))
      )
    (quaternion-copy! (-> self root quat) (-> st quat))
    (let ((scale (if (< 0.01 (-> st trans w))
                     (-> st trans w)
                     1.0
                     )
                 )
          )
      (set-vector! (-> self root scale) scale scale scale 1.0)
      )
    (cond
      ;; hidden by its owner (back to the traffic pool, gone inactive) while in our view: it stays,
      ;; intangible, then fades out (mp-replica-fade) unless our player looks away first, instead of
      ;; vanishing under its eyes
      ((and (logtest? (-> st flags) (mp-actor-flag hidden))
            (not (logtest? (-> st flags) (mp-actor-flag dead)))
            (mp-in-our-view? self)
            (or (zero? (-> self linger-since)) (< (- (mp-now) (-> self linger-since)) MP_LINGER_TIME))
            )
       (if (zero? (-> self linger-since))
           (set! (-> self linger-since) (mp-now))
           )
       (set! (-> self root root-prim prim-core collide-as) (collide-spec))
       )
      ((logtest? (-> st flags) (mp-actor-flag hidden))
       (if (not (logtest? (-> self draw status) (draw-control-status no-draw)))
           (mp-replica-vanished self "hidden")
           )
       (logior! (-> self draw status) (draw-control-status no-draw))
       (set! (-> self root root-prim prim-core collide-as) (collide-spec))
       )
      (else
        (logclear! (-> self draw status) (draw-control-status no-draw))
        (if (zero? (-> self linger-since))
            (set! (-> self root root-prim prim-core collide-as) (-> self root backup-collide-as))
            )
        )
      )
    (mp-replica-fade)
    (if *mp-test-hide-copies*
        (logior! (-> self draw status) (draw-control-status no-draw))
        )
    ;; 0 means the host's NPC does not use body segments: keep the default
    (if (and (nonzero? (-> st seg-mask)) (!= (the-as uint (-> self draw seg-mask)) (-> st seg-mask)))
        (setup-masks (-> self draw) -1 (the-as int (-> st seg-mask)))
        )
    (let* ((ag (-> self draw art-group))
           (idx (-> st anim-index))
           (anim (if (and (>= idx 0) (< idx (-> ag length)))
                     (-> ag data idx)
                     (the-as art-element #f)
                     )
                 )
           )
      (when (and anim (type? anim art-joint-anim))
        (let ((ja-anim (the-as art-joint-anim anim)))
          (ja :group! ja-anim
              :num! (identity (fmax 0.0 (fmin (-> st anim-frame) (the float (+ (-> ja-anim frames num-frames) -1)))))
              )
          )
        )
      )
    ;; the host's NPC died: the stock death dissolve of characters, once. Not for a vehicle: its art
    ;; has no "death-default" (do-effect then called address 0, a crash when a zapped buggy blew
    ;; up); its explosion comes with the effects replayed, its parts with its state.
    (when (and (logtest? (-> st flags) (mp-actor-flag dead)) (not (-> self dying?)))
      (set! (-> self dying?) #t)
      (if *mp-trace-vanish*
          (format 0 "[mp-test] copy died ~S~S~%" (string<-charp *mp-temp-string* (-> st skel))
                  (if (logtest? (-> st flags) (mp-actor-flag vehicle)) " vehicle" "")
                  )
          )
      (set! (-> self root root-prim prim-core collide-as) (collide-spec))
      (when (and (nonzero? (-> self skel effect)) (not (logtest? (-> st flags) (mp-actor-flag vehicle))))
        (logior! (-> self skel effect flags) (effect-control-flag ecf1))
        (do-effect (-> self skel effect) "death-default" 0.0 -1)
        )
      )
    )
  (none)
  )

(defun mp-draw-laser ((proc process-drawable))
  "The laser sight of the copy of another player's gun, drawn as the owner's gun draws it
   (gun-info-method-9, engine/target/gun/gun-util.gc): from where the owner's starts, along the
   owner's aim (both sent with the gun's state), ending on what it meets; from the laser joint (14)
   along the barrel (joint 13) when they did not come.
   The owner's own laser particles are not replayed (mp-play-emitters): they take their direction
   from the drawing machine's globals."
  (when (and (nonzero? (-> proc node-list))
             (> (-> proc node-list length) 14)
             (nonzero? (-> proc draw))
             (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
             )
    (let ((from (vector<-cspace! (new 'stack-no-clear 'vector) (-> proc node-list data 14)))
          (dir (vector-normalize-copy! (new 'stack-no-clear 'vector) (-> proc node-list data 13 bone transform fvec) 1.0))
          (cq (new 'stack-no-clear 'collide-query))
          (sent (the-as (pointer int16) (&-> (the-as mp-replica proc) net skel 16)))
          )
      ;; the owner's own sight when it sent it (mp-collect-props): its start from the gun's root and
      ;; its direction (the aim, auto-aim included); else the barrel
      (when (or (nonzero? (-> sent 3)) (nonzero? (-> sent 4)) (nonzero? (-> sent 5)))
        (set-vector!
          from
          (+ (-> proc root trans x) (* 4.096 (the float (-> sent 0))))
          (+ (-> proc root trans y) (* 4.096 (the float (-> sent 1))))
          (+ (-> proc root trans z) (* 4.096 (the float (-> sent 2))))
          1.0
          )
        (set-vector! dir (the float (-> sent 3)) (the float (-> sent 4)) (the float (-> sent 5)) 0.0)
        (vector-normalize! dir 1.0)
        )
      (vector+float*! (-> cq start-pos) from dir -8192.0)
      (vector-float*! (-> cq move-dist) dir 163840.0)
      (let ((v1-13 cq))
        (set! (-> v1-13 radius) 819.2)
        (set! (-> v1-13 collide-with)
              (collide-spec backgnd bot crate civilian enemy obstacle vehicle-sphere hit-by-others-list pusher shield)
              )
        ;; the owner's sight passes through its own player (gun-info-method-9 ignores it): ours
        ;; through that player's puppet and hurtbox (the gun's copy has no collision)
        (set! (-> v1-13 ignore-process0) proc)
        (set! (-> v1-13 ignore-process1) #f)
        (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
              (slot (the-as int (shr (-> (the-as mp-replica proc) id) 24)))
              )
          (when (and manager (< slot MP_MAX_PLAYERS))
            (let ((puppet (the-as mp-puppet (handle->process (-> manager puppets slot)))))
              (when puppet
                (set! (-> v1-13 ignore-process0) puppet)
                (set! (-> v1-13 ignore-process1) (handle->process (-> puppet hurtbox)))
                )
              )
            )
          )
        (set! (-> v1-13 ignore-pat)
              (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noproj #x1 :noendlessfall #x1 :board #x1)
              )
        (set! (-> v1-13 action-mask) (collide-action solid semi-solid))
        )
      (let ((f0-3 (fill-and-probe-using-line-sphere *collide-cache* cq)))
        (cond
          ((>= f0-3 0.0)
           (vector+float*! (-> cq start-pos) (-> cq start-pos) (-> cq move-dist) f0-3)
           ;; the spot where it ends
           (let ((spot (vector-normalize! (vector-! (new 'stack-no-clear 'vector) from (-> cq start-pos)) 1638.4)))
             (vector+! spot spot (-> cq start-pos))
             (launch-particles (-> *part-id-table* 212) spot)
             )
           )
          (else
            (vector+! (-> cq start-pos) (-> cq start-pos) (-> cq move-dist))
            )
          )
        )
      (mp-test-note-laser proc from (-> cq start-pos))
      ;; the beam: thinner as the camera comes close, as the owner's
      (let* ((beam (-> *part-id-table* 207))
             (timer (get-field-spec-by-id beam (sp-field-id spt-timer)))
             (scale (get-field-spec-by-id beam (sp-field-id spt-scale-x)))
             (old-timer (-> timer initial-valuef))
             (old-scale (-> scale initial-valuef))
             (old-range (-> scale random-rangef))
             (cam (vector-vector-distance (camera-pos) from))
             (f (cond
                  ((< cam 122.88)
                   0.0
                   )
                  ((< 65536.0 cam)
                   1.0
                   )
                  (else
                    (* 0.000015287453 (+ -122.88 cam))
                    )
                  )
                )
             )
        (set! (-> scale initial-valuef) (* old-scale f))
        (set! (-> scale random-rangef) (* old-range f))
        (set! (-> timer initial-valuef) 1.0)
        (draw-beam beam from (vector-! (new 'stack-no-clear 'vector) (-> cq start-pos) from) #t)
        (set! (-> timer initial-valuef) old-timer)
        (set! (-> scale initial-valuef) old-scale)
        (set! (-> scale random-rangef) old-range)
        )
      )
    )
  (none)
  )

(defstate mp-replica-idle (mp-replica)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       (mp-replica-hit proc (the-as attack-info (-> block param 1)))
       #t
       )
      )
    )
  :code (behavior ()
    (loop
      (suspend)
      )
    )
  :post (behavior ()
    (mp-replica-update)
    (mp-play-emitters self (-> self id) (-> self fx-group) (-> self fx-tracker))
    (ja-post)
    (if (logtest? (-> self net flags) (mp-actor-flag laser))
        (mp-draw-laser self)
        )
    )
  )

(defbehavior mp-replica-init-by-other mp-replica ((st mp-actor-state) (sg skeleton-group) (lev level))
  "A replica of the host's NPC `st`, drawn with `sg`, whose art lives in `lev`."
  ;; the art lookup of initialize-skeleton goes through the process's level
  (set! (-> self level) lev)
  (set! (-> self id) (-> st id))
  (set! (-> self dying?) #f)
  (set! (-> self linger-since) 0)
  (set! (-> self focus-status) (focus-status))
  (mem-copy! (the-as pointer (-> self net)) (the-as pointer st) (size-of mp-actor-state))
  (let ((vehicle? (logtest? (-> st flags) (mp-actor-flag vehicle)))
        (cshape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player)))
        )
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      ;; props (Daxter, a gun) are only drawn
      (set! (-> prim prim-core collide-as) (cond
                                                ((logtest? (-> st flags) (mp-actor-flag prop shot)) (collide-spec))
                                                (vehicle? (collide-spec obstacle))
                                                (else (collide-spec enemy))
                                                )
            )
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set! (-> prim prim-core action) (collide-action solid))
      ;; a vehicle's sphere is centered low: the underside of a sphere standing above the ground
      ;; is a ceiling that makes a player next to it crouch
      (if vehicle?
          (set-vector! (-> prim local-sphere) 0.0 (meters -0.5) 0.0 (meters 2.2))
          (set-vector! (-> prim local-sphere) 0.0 (meters 1) 0.0 (meters 0.8))
          )
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) prim)
      )
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> self root) cshape)
    )
  (vector-copy! (-> self root trans) (-> st trans))
  (quaternion-copy! (-> self root quat) (-> st quat))
  (initialize-skeleton self sg (the-as pair 0))
  ;; art of a level only loaded: that level has no draw slot nor lighting of its own, the default
  ;; level's are used (draw-index-map, mood-context in engine/draw/drawable.gc)
  (if (!= (-> lev status) 'active)
      (set! (-> self draw level-index) (the-as uint 10))
      )
  (ja-channel-set! 1)
  ;; the bones take the owner's pose once computed (mp-pose-postbind)
  (set! (-> self skel postbind-function) mp-pose-postbind)
  (dotimes (i MP_FX_TRACKERS)
    (set! (-> self fx-group i) -1)
    (set! (-> self fx-tracker i) (the-as handle #f))
    )
  (go mp-replica-idle)
  )

(defun mp-replica-index ((id uint))
  "Index of the replica of NPC `id` in the table, -1 when none."
  (let ((ws *mp-world-state*))
    (dotimes (i (-> ws replica-count))
      (if (= (-> ws replica-id i) id)
          (return i)
          )
      )
    )
  -1
  )


(defun mp-replica-vanished ((proc process-drawable) (why string))
  "Test log: copy `proc` is removed or hidden: count it when it was on our screen within 40 m of our
   player and its owner's object did not die (what our player sees vanish)."
  (let ((rep (the-as mp-replica proc)))
    ;; a copy of a shot without a model (mp-fx-copy) has no draw
    (when (and *target*
               (nonzero? (-> rep draw))
               (not (-> rep dying?))
               (not (logtest? (-> rep net flags) (mp-actor-flag dead)))
               (not (logtest? (-> rep draw status) (draw-control-status no-draw)))
               (logtest? (-> rep draw status) (draw-control-status on-screen))
               (< (vector-vector-distance (-> rep root trans) (-> *target* control trans)) (meters 40))
               )
      (let ((faded? (and (logtest? (-> rep draw status) (draw-control-status force-fade))
                         (< (-> rep draw force-fade) (the-as uint 8))
                         )
                    )
            )
        (if faded?
            (+! (-> *mp-world-state* faded-near) 1)
            (+! (-> *mp-world-state* vanished-near) 1)
            )
        (if *mp-trace-vanish*
            (format
              0
              "[mp-test] ~S ~S ~S ~,,1m~%"
              (if faded? "faded" "vanished")
              (string<-charp *mp-temp-string* (-> rep net skel))
              why
              (vector-vector-distance (-> rep root trans) (-> *target* control trans))
              )
            )
        )
      )
    )
  (none)
  )

(defun mp-replica-remove ((i int))
  "Remove entry `i` of the replica table (and its process)."
  (let* ((ws *mp-world-state*)
         (proc (handle->process (-> ws replica i)))
         (last (+ (-> ws replica-count) -1))
         )
    (when proc
      (mp-replica-vanished (the-as process-drawable proc) "removed")
      (deactivate proc)
      )
    (set! (-> ws replica-id i) (-> ws replica-id last))
    (set! (-> ws replica i) (-> ws replica last))
    (set! (-> ws replica-count) last)
    )
  (none)
  )

(defun mp-replicas-clear ()
  "Remove every replica."
  (while (> (-> *mp-world-state* replica-count) 0)
    (mp-replica-remove 0)
    )
  (none)
  )

(defun mp-art-group-get ((name string) (box (pointer level)))
  "art-group-get-by-name, also in the levels only loaded (a distant player's level, a level our own
   place keeps ready): a copy can be drawn from their art. The level holding it goes in `box`."
  ;; test switch: a skeleton-group rebuilt from its sender's description wins (exercises the path
  ;; of a group whose code is in no level here)
  (when *mp-synth-skels*
    (let ((sg (mp-skel-def-get name)))
      (if sg
          (return sg)
          )
      )
    )
  (let ((found (art-group-get-by-name *level* name box)))
    (when (not found)
      (countdown (i 11)
        (let ((lev (-> *level* level i)))
          (when (or (= (-> lev status) 'loaded) (= (-> lev status) 'alive))
            (countdown (j (-> lev art-group art-group-array length))
              (when (name= (-> lev art-group art-group-array j name) name)
                (if box
                    (set! (-> box 0) lev)
                    )
                (return (-> lev art-group art-group-array j))
                )
              )
            )
          )
        )
      )
    ;; a skeleton-group whose code is in no level here: rebuilt from the sender's description
    (if (not found)
        (set! found (mp-skel-def-get name))
        )
    found
    )
  )

;; The copy of a shot without a model: its place, its trail (the owner's emitters) and sounds.
(deftype mp-fx-copy (mp-replica)
  ()
  )

(defstate mp-fx-copy-idle (mp-fx-copy)
  :code (behavior ()
    (loop
      (suspend)
      )
    )
  :post (behavior ()
    (move-to-point! (-> self root) (-> self net trans))
    (quaternion-copy! (-> self root quat) (-> self net quat))
    (mp-play-emitters self (-> self id) (-> self fx-group) (-> self fx-tracker))
    )
  )

;; test log (log-weapons): wave concussor and mass inverter copies drawn here, arc frames drawn,
;; needle lazer trails
(define *mp-weapons-shown* (new 'static 'boxed-array :type int32 0 0 0 0))

(defbehavior mp-fx-copy-init-by-other mp-fx-copy ((st mp-actor-state))
  "A copy of shot `st`: an intangible point that plays the owner's emitters and sounds."
  (set! (-> self id) (-> st id))
  (set! (-> self dying?) #f)
  (set! (-> self linger-since) 0)
  (set! (-> self focus-status) (focus-status))
  (mem-copy! (the-as pointer (-> self net)) (the-as pointer st) (size-of mp-actor-state))
  (let ((cshape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-spec))
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set-vector! (-> prim local-sphere) 0.0 0.0 0.0 (meters 0.5))
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) prim)
      )
    (set! (-> self root) cshape)
    )
  (vector-copy! (-> self root trans) (-> st trans))
  (quaternion-copy! (-> self root quat) (-> st quat))
  (dotimes (i MP_FX_TRACKERS)
    (set! (-> self fx-group i) -1)
    (set! (-> self fx-tracker i) (the-as handle #f))
    )
  ;; the needle lazer's shot draws a light trail where it flies (its type follows the empty name,
  ;; mp-add-shot): a stock trail that follows this copy, dying with it
  (when (string-charp= "gun-blue-shot-3" (&-> st skel 1))
    (+! (-> *mp-weapons-shown* 3) 1)
    (light-trail-tracker-spawn
      light-trail-tracker-projectile
      :to self
      :param-list ((tracked-obj (process->handle self))
       (appearance *blue-shot-trail*)
       (max-num-crumbs (the int (* 0.2 (the float (-> *blue-shot-trail* max-age)))))
       (track-immediately? #t)
       )
      )
    )
  (go mp-fx-copy-idle)
  )

(defbehavior mp-replica-spawn mp-manager ((st mp-actor-state))
  "Spawn a replica of `st` if its skeleton is loaded here (a shot without a model gets an
   mp-fx-copy). #t when spawned."
  (let ((ws *mp-world-state*))
    (when (and (< (-> ws replica-count) MP_MAX_REPLICAS)
               (logtest? (-> st flags) (mp-actor-flag shot))
               (zero? (-> st skel 0))
               )
      (let ((proc (process-spawn mp-fx-copy st :name "mp-fx-copy" :to self)))
        (when proc
          (+! (-> ws shot-copies) 1)
          (set! (-> ws replica-id (-> ws replica-count)) (-> st id))
          (set! (-> ws replica (-> ws replica-count)) (ppointer->handle proc))
          (+! (-> ws replica-count) 1)
          (return #t)
          )
        )
      (return #f)
      )
    (when (< (-> ws replica-count) MP_MAX_REPLICAS)
      (string<-charp *mp-temp-string* (-> st skel))
      (set! (-> ws level-box 0) #f)
      (let ((sg (the-as skeleton-group (mp-art-group-get *mp-temp-string* (the-as (pointer level) #f))))
            (lev (the-as level #f))
            )
        ;; the level that registered the skeleton is not always the one that holds its art
        ;; (dogat: skeleton in WASALL code, art elsewhere): initialize-skeleton needs the latter
        (when (and sg (type? sg skeleton-group))
          (mp-art-group-get (-> sg art-group-name) (the-as (pointer level) (-> ws level-box)))
          (set! lev (-> ws level-box 0))
          )
        (when (and sg lev (type? sg skeleton-group))
          (let ((proc (process-spawn mp-replica st sg lev :name "mp-replica" :to self :stack-size #x20000)))
            (when proc
              (if (logtest? (-> st flags) (mp-actor-flag shot))
                  (+! (-> ws shot-copies) 1)
                  )
              (set! (-> ws replica-id (-> ws replica-count)) (-> st id))
              (set! (-> ws replica (-> ws replica-count)) (ppointer->handle proc))
              (+! (-> ws replica-count) 1)
              (return #t)
              )
            )
          )
        )
      )
    )
  #f
  )

(define-extern mp-vehicle-type-of-skel (function (pointer uint8) int))

(defun mp-nearest-replica-vehicle ((pos vector))
  "Replica table index of another player's NPC vehicle near `pos` (within its size and 1.5 m) that
   can be taken here (mp-get-vehicle-at: a city bike or car, a Spargus buggy, its model loaded),
   -1 when none. Wheels and the vehicles that cannot be taken never prompt."
  (let ((ws *mp-world-state*)
        (best -1)
        (best-dist (meters 6))
        )
    (dotimes (i (-> ws replica-count))
      (let ((proc (the-as mp-replica (handle->process (-> ws replica i)))))
        (when (and proc
                   (nonzero? (-> proc draw))
                   (not (logtest? (-> proc net flags) (mp-actor-flag owned)))
                   (logtest? (-> proc net flags) (mp-actor-flag vehicle))
                   (not (logtest? (-> proc net flags) (mp-actor-flag hidden dead)))
                   )
          (let ((d (vector-vector-distance pos (-> proc root trans))))
            (when (and (< d best-dist) (< d (+ (fmin (-> proc draw bounds w) (meters 4.5)) (meters 1.5))))
              (let ((vtype (mp-vehicle-type-of-skel (-> proc net skel))))
                (when (and (or (and (>= vtype 0) (<= vtype 6)) (and (>= vtype 12) (<= vtype 19))) (mp-vehicle-skel vtype))
                  (set! best i)
                  (set! best-dist d)
                  )
                )
              )
            )
          )
        )
      )
    best
    )
  )

(defun mp-vehicle-type-of-skel ((skel (pointer uint8)))
  "vehicle-type of a vehicle skeleton name (skel-<type>), -1 when it is not one."
  (dotimes (i (-> *mp-vehicle-types* length))
    (format (clear *mp-temp-string*) "skel-~S" (symbol->string (-> *mp-vehicle-types* i)))
    (if (string-charp= *mp-temp-string* skel)
        (return i)
        )
    )
  -1
  )

(defun mp-replica-id-at ((index int))
  "Id of the copy at replica `index` (its owner slot and pid), 0 when none."
  (let ((proc (the-as mp-replica (handle->process (-> *mp-world-state* replica index)))))
    (if proc
        (-> proc id)
        (the-as uint 0)
        )
    )
  )

(define *mp-own-vehicle-best* (the-as process #f))
(define *mp-own-vehicle-dist* 0.0)
(define *mp-own-vehicle-from* (new 'global 'vector))

(defun mp-own-vehicle-scan ((proc process-drawable))
  "iterate-process-tree callback (mp-nearest-own-vehicle)."
  (when (and (type? proc process-drawable)
             (not (type? proc mp-replica))
             (mp-inherits? (-> proc type) 'vehicle)
             (nonzero? (-> proc root))
             (nonzero? (-> proc draw))
             (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
             )
    (let ((d (vector-vector-distance (-> proc root trans) *mp-own-vehicle-from*)))
      ;; within its size and 1.5 m, as a copy's prompt (mp-nearest-replica-vehicle)
      (when (and (< d *mp-own-vehicle-dist*) (< d (+ (fmin (-> proc draw bounds w) (meters 4.5)) (meters 1.5))))
        (set! *mp-own-vehicle-dist* d)
        (set! *mp-own-vehicle-best* proc)
        )
      )
    )
  #f
  )

(defun mp-nearest-own-vehicle ((pos vector))
  "The vehicle of our world nearest to `pos`, within its size and 1.5 m, #f."
  (set! *mp-own-vehicle-best* #f)
  (set! *mp-own-vehicle-dist* (meters 8))
  (vector-copy! *mp-own-vehicle-from* pos)
  (iterate-process-tree *active-pool* (the-as (function object object) mp-own-vehicle-scan) *null-kernel-context*)
  *mp-own-vehicle-best*
  )

(defbehavior mp-take-replica-vehicle mp-manager ((index int))
  "Get in a copy of the NPC vehicle at replica `index`; the player who simulates it then removes its
   own."
  (let ((proc (the-as mp-replica (handle->process (-> *mp-world-state* replica index)))))
    (when proc
      (let ((id (-> proc id)))
        (when (mp-get-vehicle-at (mp-vehicle-type-of-skel (-> proc net skel)) (-> proc root trans) (-> proc root quat))
          (mp-send-event (mp-event-kind vehicle-taken) (the-as int (shr id 24)) (the-as int (logand id #xffffff)) 0.0)
          (mp-replica-remove index)
          (return #t)
          )
        )
      )
    )
  #f
  )

;; ------------------------------------------------------------------------------------------------
;; Not an authority: our own NPCs sleep while another player's are shown
;; ------------------------------------------------------------------------------------------------

(defun mp-own-npc-slept ((proc process-drawable))
  "Test log: our NPC `proc` is put to sleep: count it in vanished-near when it was on our screen
   within 40 m of our player (it vanishes under our eyes)."
  (when (and *target*
             (nonzero? (-> proc draw))
             (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
             (logtest? (-> proc draw status) (draw-control-status on-screen))
             (< (vector-vector-distance (-> proc root trans) (-> *target* control trans)) (meters 40))
             )
    (+! (-> *mp-world-state* vanished-near) 1)
    (if *mp-trace-vanish*
        (format 0 "[mp-test] vanished ~A slept ~,,1m~%" (-> proc type)
                (vector-vector-distance (-> proc root trans) (-> *target* control trans))
                )
        )
    )
  (none)
  )

(defun mp-suppress-actor ((proc process-drawable))
  "iterate-process-tree callback: put one of our NPCs to sleep (no logic, not drawn, intangible)."
  (when (and (type? proc process-drawable)
             (not (type? proc mp-replica))
             (nonzero? (-> proc root))
             (> (mp-actor-kind proc) 0)
             (not (mp-driven-vehicle? proc))
             (not (logtest? (-> proc mask) (process-mask sleep)))
             (< (-> *mp-world-state* suppressed-count) 256)
             ;; one our player is looking at sleeps once it looks away: it does not vanish under its
             ;; eyes when another player's NPCs take over (60 s at most)
             (not (and (mp-in-our-view? proc)
                       (< (- (mp-now) (-> *mp-world-state* authority-since)) (seconds 60))
                       )
                  )
             )
    (mp-own-npc-slept proc)
    (logior! (-> proc mask) (process-mask sleep))
    (if (nonzero? (-> proc draw))
        (logior! (-> proc draw status) (draw-control-status no-draw))
        )
    (when (type? (-> proc root) collide-shape)
      (let ((prim (-> (the-as collide-shape (-> proc root)) root-prim)))
        (set! (-> prim prim-core collide-as) (collide-spec))
        (set! (-> prim prim-core collide-with) (collide-spec))
        )
      )
    (let ((ws *mp-world-state*))
      (set! (-> ws suppressed (-> ws suppressed-count)) (process->handle proc))
      (+! (-> ws suppressed-count) 1)
      )
    )
  #f
  )

(defun mp-unsuppress-all ()
  "Wake every NPC we put to sleep (end of a session)."
  (let ((ws *mp-world-state*))
    (dotimes (i (-> ws suppressed-count))
      (let ((proc (the-as process-drawable (handle->process (-> ws suppressed i)))))
        (when proc
          (logclear! (-> proc mask) (process-mask sleep))
          (if (nonzero? (-> proc draw))
              (logclear! (-> proc draw status) (draw-control-status no-draw))
              )
          (when (type? (-> proc root) collide-shape)
            (let ((cshape (the-as collide-shape (-> proc root))))
              (set! (-> cshape root-prim prim-core collide-as) (-> cshape backup-collide-as))
              (set! (-> cshape root-prim prim-core collide-with) (-> cshape backup-collide-with))
              )
            )
          )
        )
      )
    (set! (-> ws suppressed-count) 0)
    )
  (none)
  )

(defbehavior mp-world-suppress mp-manager ()
  "Keep our NPCs asleep and our traffic off (another player's are shown instead)."
  (let ((ws *mp-world-state*))
    (when (not (-> ws traffic-off?))
      ;; settings belong to the process that sets them: the manager lives as long as the session
      (set-setting! 'traffic-spawn #f 0.0 0)
      (set! (-> ws traffic-off?) #t)
      )
    (when (>= (- (mp-now) (-> ws last-suppress)) (seconds 0.25))
      (set! (-> ws last-suppress) (mp-now))
      ;; forget entries of NPCs that died meanwhile, then catch the new ones
      (let ((n 0))
        (dotimes (i (-> ws suppressed-count))
          (when (handle->process (-> ws suppressed i))
            (set! (-> ws suppressed n) (-> ws suppressed i))
            (+! n 1)
            )
          )
        (set! (-> ws suppressed-count) n)
        )
      (iterate-process-tree *active-pool* (the-as (function object object) mp-suppress-actor) *null-kernel-context*)
      )
    )
  (none)
  )

(defun mp-drive-world-object ((st mp-actor-state))
  "Our physics object of the entity in `st` goes where its authority has it (when that authority
   provides our NPCs): its rigid body is set there at rest, so its own physics only moves it for
   the frame until the next state, and it still carries the player standing on it."
  (when (and (not *mp-authority*) (= (the-as int (shr (-> st id) 24)) (mp-provider-of *mp-local-slot*)))
    (let ((proc (mp-world-object-by-id (the-as int (logand (-> st id) #xffffff)))))
      (when (and proc (type? proc rigid-body-object) (nonzero? (-> (the-as rigid-body-object proc) rbody)))
        (let ((rbody (-> (the-as rigid-body-object proc) rbody)))
          (rigid-body-control-method-28 rbody (-> st trans) (-> st quat))
          (reset-momentum! rbody)
          (init-velocities! rbody)
          (+! (-> *mp-world-state* world-driven) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-stolen-copy? ((id uint) (flags mp-actor-flag))
  "#t for a copy of the vehicle we just took from its player (body or wheel): dropped at once."
  (and (>= *mp-stolen-from* 0)
       (< (mp-now) *mp-stolen-until*)
       (= (the-as int (shr id 24)) *mp-stolen-from*)
       (= (logand flags (mp-actor-flag vehicle owned)) (mp-actor-flag vehicle owned))
       )
  )

(defun mp-replica-wanted? ((st mp-actor-state))
  "#f for an NPC of another authority standing nearer to us than to that player: our own world
   covers that place, so its copy would be a double; and for a copy of a vehicle we just took."
  (and (not (mp-stolen-copy? (-> st id) (-> st flags))) (or (not *mp-authority*)
      (logtest? (-> st flags) (mp-actor-flag owned))
      (let ((me (mp-player-pos *mp-local-slot*))
            (owner (mp-player-pos (the-as int (shr (-> st id) 24))))
            )
        (or (not me)
            (not owner)
            (< (vector-vector-distance (-> st trans) owner) (vector-vector-distance (-> st trans) me))
            )
        )
      ))
  )

(defbehavior mp-world-receive mp-manager ()
  "Draw the other players' objects (the NPCs of their authority, everyone's props) as replicas."
  (let ((ws *mp-world-state*))
    (let ((count (pc-mp-get-actors (-> *mp-actors-in* state) MP_MAX_REPLICAS))
          (spawned 0)
          )
      (set! (-> *mp-actors-in* count) count)
      (dotimes (i count)
        (mp-test-note-path #f (-> *mp-actors-in* state i))
        )
      (dotimes (i count)
        (let* ((st (-> *mp-actors-in* state i))
               (index (mp-replica-index (-> st id)))
               )
          (cond
            ((logtest? (-> st flags) (mp-actor-flag world))
             (if (= (-> st anim-index) 1)
                 (mp-drive-elevator st)
                 (mp-drive-world-object st)
                 )
             (set! (-> st id) (the-as uint 0))
             )
            ((not (mp-replica-wanted? st))
             ;; dropped below with the replicas no longer sent
             (set! (-> st id) (the-as uint 0))
             )
            ((>= index 0)
             (let ((proc (the-as mp-replica (handle->process (-> ws replica index)))))
               (if proc
                   (mem-copy! (the-as pointer (-> proc net)) (the-as pointer st) (size-of mp-actor-state))
                   (mp-replica-remove index)
                   )
               )
             )
            ;; a few spawns per frame at most, so a crowd appearing does not stall a frame
            ((< spawned 4)
             (if (mp-replica-spawn st)
                 (+! spawned 1)
                 )
             )
            )
          )
        )
      ;; replicas of NPCs the host no longer sends, or whose art left with its level
      (let ((i 0))
        (while (< i (-> ws replica-count))
          (let ((proc (the-as mp-replica (handle->process (-> ws replica i))))
                (seen? #f)
                )
            (dotimes (j count)
              (when (= (-> *mp-actors-in* state j id) (-> ws replica-id i))
                (set! seen? #t)
                ;; shown again by its owner: no longer lingering
                (if (and proc (not (logtest? (-> *mp-actors-in* state j flags) (mp-actor-flag hidden))))
                    (set! (-> proc linger-since) 0)
                    )
                )
              )
            (cond
              ((or (not proc)
                   (not (-> proc level))
                   (not (or (= (-> proc level status) 'active)
                            (= (-> proc level status) 'reserved)
                            (= (-> proc level status) 'loaded)
                            (= (-> proc level status) 'alive)
                            )
                        )
                   )
               (mp-replica-remove i)
               )
              (seen?
               (+! i 1)
               )
              ;; a vehicle we took: gone with no lingering, ours stands there
              ((mp-stolen-copy? (-> ws replica-id i) (-> proc net flags))
               (mp-replica-remove i)
               )
              ;; its owner no longer sends it (it left, or the owner went away) while it is in
              ;; our view: it stays where it was, intangible, then fades out (mp-replica-fade)
              ;; unless our player looks away first
              ((and (not (-> proc dying?))
                    (not (logtest? (-> proc net flags) (mp-actor-flag dead)))
                    (mp-in-our-view? proc)
                    (or (zero? (-> proc linger-since)) (< (- (mp-now) (-> proc linger-since)) MP_LINGER_TIME))
                    )
               (when (zero? (-> proc linger-since))
                 (set! (-> proc linger-since) (mp-now))
                 (set! (-> proc root root-prim prim-core collide-as) (collide-spec))
                 )
               (+! i 1)
               )
              (else
                (mp-replica-remove i)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )


;; MOD multiplayer -- an object this machine simulates runs as near another player as near our camera.
;; The stock run-logic? pauses an actor-pause process farther than *ACTOR-bank* pause-dist (50 m) from
;; the camera, and an idle enemy off screen (engine/entity/entity.gc, engine/ai/enemy.gc): the NPCs
;; near another player but far from our camera stood frozen on that player's screen. define-perm
;; keeps the stock methods when this file is reloaded in a REPL session.
(define *mp-run-near-others* #t) ;; test switch (run-near-others): #f for the counter-test

(define-perm *mp-stock-pd-run-logic?* (function process-drawable symbol)
  (the-as (function process-drawable symbol) (method-of-type process-drawable run-logic?))
  )

(define-perm *mp-stock-enemy-run-logic?* (function enemy symbol)
  (the-as (function enemy symbol) (method-of-type enemy run-logic?))
  )

(defun mp-near-other-player? ((proc process-drawable))
  "#t when another player stands within pause distance of `proc` (the distance the stock pause
   allows from our camera), while online."
  (and *mp-run-near-others*
       (mp-online?)
       (> (mp-player-count) 0)
       (nonzero? (-> proc root))
       (< (mp-remote-distance (-> proc root trans)) (+ (-> *ACTOR-bank* pause-dist) (-> proc root pause-adjust-distance)))
       )
  )

(defmethod run-logic? ((this process-drawable))
  "Stock answer, or #t near another player (multiplayer mod, the stock answer offline)."
  (or (*mp-stock-pd-run-logic?* this) (mp-near-other-player? this))
  )

(defmethod run-logic? ((this enemy))
  "Stock answer, or #t near another player (multiplayer mod, the stock answer offline)."
  (or (*mp-stock-enemy-run-logic?* this) (mp-near-other-player? this))
  )

(defun mp-keep-seen-npcs ()
  "Authority, after the frame's draw (per-frame hook): the NPCs we send within 60 m of another
   player are marked on screen for the next frame's logic. Citizens, guards and traffic leave when
   off our screen a while (citizen enemy-common-post, crimson-guard-method-270, vehicle
   offscreen-time), while another player may be looking at them: they vanished under its eyes."
  (when (and *mp-authority* (mp-online?) (> (mp-player-count) 0))
    (dotimes (i (-> *mp-actors-out* count))
      (let ((st (-> *mp-actors-out* state i)))
        (when (and (not (logtest? (-> st flags) (mp-actor-flag owned world)))
                   (< (mp-remote-distance (-> st trans)) (meters 60))
                   )
          (let ((proc (the-as process-drawable (handle->process (-> *mp-pose* obj i)))))
            (if (and proc (nonzero? (-> proc draw)))
                (logior! (-> proc draw status) (draw-control-status on-screen))
                )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior mp-world-wake mp-manager ()
  "Our NPCs and traffic back (we simulate our world again)."
  (let ((ws *mp-world-state*))
    (if (> (-> ws suppressed-count) 0)
        (mp-unsuppress-all)
        )
    (when (-> ws traffic-off?)
      (remove-setting! 'traffic-spawn)
      (set! (-> ws traffic-off?) #f)
      )
    )
  (none)
  )

(define-extern mp-sounds-housekeeping (function symbol none))

(defbehavior mp-world-client-stop mp-manager ()
  "Back to a normal world: replicas gone (and their sounds), our NPCs and traffic back, their
   joint math as stock."
  (mp-sounds-housekeeping #t)
  (mp-release-math #t)
  (mp-replicas-clear)
  (mp-world-wake)
  (none)
  )

(defbehavior mp-world-update mp-manager ()
  "Shared world, once per unpaused frame."
  (cond
    ((mp-online?)
     (mp-update-authority)
     (mp-world-send)
     (if *mp-authority*
         (mp-world-wake)
         (mp-world-suppress)
         )
     (mp-world-receive)
     (mp-elevators-unmute #f)
     (mp-far-fetch-art)
     (mp-sounds-housekeeping #f)
     (mp-update-remote-riders)
     )
    (else
      (set! *mp-authority* #f)
      (set! (-> *mp-clock-sync* known?) #f)
      (mp-art-heap-close)
      (mp-elevators-unmute #t)
      (if (or (> (-> *mp-world-state* replica-count) 0)
              (> (-> *mp-world-state* suppressed-count) 0)
              (> (-> *mp-world-state* forced-count) 0)
              (-> *mp-world-state* traffic-off?)
              )
          (mp-world-client-stop)
          )
      )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Weapons that are not shots
;; ------------------------------------------------------------------------------------------------

;; The wave concussor (red 2), the mass inverter (dark 2) and the arc wielder (blue 2) are not
;; projectiles: a shockwave process, a gravity field and a lightning tracker under the gun or the
;; player. The player's machine tells the others when one goes off (weapon event); they draw it
;; with the stock visual pieces, their damage code left out: the owner's applies the blows, to
;; copies and to other players' puppets. The needle lazer's (blue 3) shots are sent as shots: their
;; light trail is drawn on their copies (mp-fx-copy-init-by-other).

;; A copy of the wave concussor's explosion: the stock shockwave from its explosion on, hurting
;; nobody, without the shooter's pad buzz.
(deftype mp-red2-copy (gun-red-2-shockwave)
  ()
  )

(defmethod find-targets-and-attack! ((this mp-red2-copy))
  "A copy hurts nobody: the owner's wave applies the blows."
  (none)
  )

(defstate explode (mp-red2-copy)
  :virtual #t
  :enter (behavior ()
    ;; the stock enter (engine/target/gun/gun-red-shot.gc), without the pad buzz, the sound placed
    (sound-play "red2-shot" :position (-> self origin))
    (set-time! (-> self state-time))
    (set! (-> self max-radius) (lerp (-> self min-charge-radius) (-> self max-charge-radius) (-> self strength)))
    (let ((f0-15 (/ (-> self max-radius) (meters 20))))
      (let ((f1-5 (/ (* 2.0 (- (* 163840.0 f0-15) (-> self max-radius))) (square f0-15))))
        (set! (-> *part-id-table* 353 init-specs 9 initial-valuef) (* 1.2 f1-5))
        )
      (let ((v1-15 (the int (* 150.0 f0-15))))
        (set! (-> *part-id-table* 354 init-specs 3 initial-valuef) (the-as float (+ v1-15 -25)))
        (set! (-> *part-id-table* 354 init-specs 3 random-rangef) (the-as float (+ v1-15 -5)))
        )
      )
    (adjust-height-and-radius self)
    (set! (-> self current-intensity) (-> self strength))
    (spawn-ring self)
    (set! (-> self num-collision-pts-to-generate)
          (the int (fmax 6.0 (fmin 64.0 (* 64.0 (/ (-> self max-ground-radius) (-> self max-charge-radius))))))
          )
    (generate-order-array self)
    (set! (-> self current-ring-alpha) 1.0)
    (set! (-> self current-burst-alpha) 1.0)
    (set! (-> self current-warp-alpha) 1.0)
    )
  )

(defbehavior mp-red2-copy-init-by-other mp-red2-copy ((pos vector) (strength float))
  "The stock init (gun-red-2-shockwave-init-by-other) at `pos` with `strength`, straight to its
   explosion: no charge (its particles follow our own player's gun)."
  (set! (-> self current-intensity) 0.0)
  (set! (-> self current-radius) 0.0)
  (set! (-> self current-warp-radius) 0.0)
  (set! (-> self current-burst-radius) 0.0)
  (set! (-> self height-off-ground) 0.0)
  (set! (-> self current-ring-radius) 0.0)
  (set! (-> self current-ring-alpha) 0.0)
  (set! (-> self total-explode-time) (seconds 0.7))
  (set! (-> self min-charge-radius) 12288.0)
  (set! (-> self max-charge-radius) 73728.0)
  (set! (-> self total-charge-time) (seconds 1))
  (set! (-> self base-damage) 5.0)
  (set! (-> self ring-expansion-time) (seconds 0.35))
  (set! (-> self burst-expansion-time) (seconds 0.3))
  (set! (-> self warp-expansion-time) (seconds 0.4))
  (set! (-> self explosion-0) (the-as handle #f))
  (set! (-> self explosion-1) (the-as handle #f))
  (set! (-> self ammo-drained) 0.0)
  (set! (-> self snd-charge) (new-sound-id))
  (set! (-> self num-previously-attacked-targets) 0)
  (set! (-> self start-pilot?) #f)
  (set! (-> self charge-part-tracker) (the-as handle #f))
  (dotimes (v1-49 64)
    (set! (-> self eventual-collision-points v1-49 found?) #f)
    )
  (set! (-> self next-computed-collision-point) 0)
  (set! (-> self show-scorch-marks?) #f)
  (set! (-> self generating-marks?) #f)
  (set! (-> self generated-particles?) #f)
  (vector-copy! (-> self origin) pos)
  (set! (-> self strength) (fmax 0.0 (fmin 1.0 strength)))
  (go-virtual explode)
  )

;; A copy of the mass inverter's field: the stock field (rings, rising particles), lifting nobody.
(deftype mp-dark2-copy (gun-gravity)
  ()
  )

(defmethod gun-gravity-method-22 ((this mp-dark2-copy) (arg0 symbol))
  "A copy lifts nobody (the stock one spawns gravity-spinners on what it finds): only the radius
   its rising particles follow, from its rings once they spread (as the stock)."
  (when arg0
    (let ((closest (handle->process (-> this ring-closest)))
          (furthest (handle->process (-> this ring-furthest)))
          (near 0.0)
          (far (-> this current-radius))
          )
      (if closest
          (set! near (* (-> (the-as gravity-ring closest) max-radius) (-> (the-as gravity-ring closest) ring-scale-t)))
          )
      (if furthest
          (set! far (* (-> (the-as gravity-ring furthest) max-radius) (-> (the-as gravity-ring furthest) ring-scale-t)))
          )
      (set! (-> this current-radius) (* 0.5 (+ (* 0.85 near) (* 0.85 far))))
      )
    )
  (none)
  )

(defbehavior mp-dark2-copy-init-by-other mp-dark2-copy ((pos vector) (total float))
  "The stock init (gun-gravity-init-by-other) at `pos`, for `total` seconds of spread (the owner's,
   longer with its upgrade), without the shooter's pad buzz."
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) pos)
  (let ((cq (new 'stack-no-clear 'collide-query)))
    (vector+float*! (-> cq start-pos) (-> self root trans) *up-vector* 24576.0)
    (set! (-> cq move-dist quad) (the-as uint128 0))
    (set! (-> cq move-dist y) -81920.0)
    (set! (-> cq radius) 40.96)
    (set! (-> cq collide-with) (collide-spec backgnd pusher))
    (set! (-> cq ignore-process0) #f)
    (set! (-> cq ignore-process1) #f)
    (set! (-> cq ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1 :board #x1))
    (set! (-> cq action-mask) (collide-action solid))
    (if (>= (fill-and-probe-using-line-sphere *collide-cache* cq) 0.0)
        (set! (-> self root trans y) (-> cq best-other-tri intersect y))
        )
    )
  (set! (-> self max-radius) 122880.0)
  (set! (-> self total-time) (if (< 0.0 total) total 1.0))
  (vector-copy! (-> self start-pos) pos)
  (set! (-> self ring-closest) (the-as handle #f))
  (set! (-> self ring-furthest) (the-as handle #f))
  (set! (-> self part) (create-launch-control group-gravity-gun-rise self))
  (set! (-> self gravity-sound) (new-sound-id))
  (go-virtual expand)
  )

;; The arc wielder: its arc as each player's machine draws it (the points of setup-draw!), sent every
;; frame it is drawn; one tracker per player draws it here.
(deftype mp-arc (structure)
  ((time  time-frame)
   (info  gun-blue-2-lightning-info :inline)
   (proc  handle)
   )
  )

(deftype mp-arcs (structure)
  ((arc mp-arc 8 :inline)
   )
  )

(define *mp-arcs* (new 'global 'mp-arcs))

(dotimes (i 8)
  (set! (-> *mp-arcs* arc i proc) (the-as handle #f))
  )

(defun mp-send-arc ((info gun-blue-2-lightning-info))
  "Our arc of this frame: its first point (fvec) and up to five more, spread along it, in 2 cm from
   the first (text, int16: 5 points of 6 bytes fill 30 of its 32), and whether it ends in sparks."
  (let ((ev (new 'stack 'mp-event))
        (n (max 1 (min 32 (-> info num-pts))))
        )
    (set! (-> ev kind) (mp-event-kind weapon))
    (set! (-> ev to) -1)
    (set! (-> ev iarg 0) 33)
    (vector-copy! (-> ev fvec) (-> info pts 0))
    (let ((sent (min 5 (+ n -1)))
          (v (the-as (pointer int16) (-> ev text)))
          )
      (set! (-> ev iarg 1) (+ sent 1))
      (set! (-> ev iarg 2) (if (-> info should-draw-terminal-sparks?) 1 0))
      ;; points 1 .. n-1, evenly spread, the last one always
      (let ((step (/ (the float (+ n -2)) (the float (max 1 (+ sent -1))))))
      (dotimes (k sent)
        (let ((p (-> info pts (+ 1 (the int (* step (the float k)))))))
          (dotimes (c 3)
            (set! (-> v (+ (* k 3) c)) (the int (fmax -32767.0 (fmin 32767.0 (/ (- (-> p data c) (-> info pts 0 data c)) 81.92)))))
            )
          )
        )
        )
      )
    (pc-mp-send-event ev)
    )
  (none)
  )

;; MOD multiplayer -- our player's arc goes to the others. define-perm keeps the stock method when
;; this file is reloaded in a REPL session.
(define-perm *mp-stock-arc-setup-draw!* (function gun-blue-2-lightning-tracker gun-blue-2-lightning-info none)
  (the-as (function gun-blue-2-lightning-tracker gun-blue-2-lightning-info none)
          (method-of-type gun-blue-2-lightning-tracker setup-draw!)
          )
  )

(defmethod setup-draw! ((this gun-blue-2-lightning-tracker) (arg0 gun-blue-2-lightning-info))
  "Stock method, then our player's arc goes to the others (multiplayer mod, no-op offline)."
  (*mp-stock-arc-setup-draw!* this arg0)
  (if (and (mp-online?) *target* (= (ppointer->process (-> this parent)) *target*))
      (mp-send-arc arg0)
      )
  (none)
  )

(defstate mp-arc-shown (gun-blue-2-lightning-tracker)
  :trans (behavior ()
    (let ((arc (-> *mp-arcs* arc (max 0 (min 7 (-> self last-probe-index))))))
      (cond
        ((< (- (mp-now) (-> arc time)) (seconds 0.1))
         ;; drawn as its player's machine draws it (the bolts' own inner points at random), the
         ;; bolts switched on as the stock active state's enter does (faded or new ones draw nothing)
         (dotimes (i (-> self lt-array length))
           (if (nonzero? (lightning-bolt-method-14 (-> self lt-array i)))
               (lightning-bolt-method-13 (-> self lt-array i) 0)
               )
           )
         (set! (-> self should-draw-this-frame?) #t)
         (setup-draw! self (-> arc info))
         (spawn (-> self part) (-> arc info pts 0))
         )
        (else
          ;; it stopped: the bolts fade out, as the stock tracker's
          (dotimes (i (-> self lt-array length))
            (let ((bolt (-> self lt-array i)))
              (if (zero? (lightning-bolt-method-14 bolt))
                  (lightning-bolt-method-13 bolt 2)
                  )
              (lightning-bolt-method-11 bolt)
              (lightning-bolt-method-12 bolt)
              )
            )
          )
        )
      )
    )
  :code (behavior ()
    ;; ends 3 s after the last arc: the next one starts a new tracker
    (until (< (seconds 3) (- (mp-now) (-> *mp-arcs* arc (max 0 (min 7 (-> self last-probe-index))) time)))
      (suspend)
      )
    )
  )

(defbehavior mp-arc-init-by-other gun-blue-2-lightning-tracker ((slot int))
  "The stock tracker's init (gun-blue-2-lightning-init-by-other), drawing player `slot`'s arc: its
   six bolts and muzzle flare, none of its own logic (the arc, its damage and the ammo it uses are
   the owner's)."
  (set! (-> self root) (new 'process 'trsqv))
  ;; no skeleton: the bolts are drawn without one, and its art is loaded only with this machine's
  ;; own arc wielder (missing, it sends the process to process-drawable-art-error)
  (set! (-> self lt-array) (new 'process 'boxed-array lightning-bolt 6))
  (dotimes (i 4)
    (set! (-> self lt-array i) (new 'process 'lightning-bolt))
    (init! (-> self lt-array i) 12 6 *blue-light-test*)
    )
  (set! (-> self lt-array 4) (new 'process 'lightning-bolt))
  (init! (-> self lt-array 4) 12 5 *blue-light-test-big*)
  (set! (-> self lt-array 5) (new 'process 'lightning-bolt))
  (init! (-> self lt-array 5) 12 5 *blue-light-test-big*)
  (set! (-> self revolve-angle) 0.0)
  (set! (-> self sway-angle) 0.0)
  (set! (-> self part) (create-launch-control group-gun-blue-2-muzzle-flare self))
  (set! (-> self last-spark-time) 0)
  (set! (-> self spark-time-interval) 0)
  (set! (-> self snd-lightning) (new-sound-id))
  (set! (-> self snd-spin) (new-sound-id))
  (set! (-> self should-draw-this-frame?) #f)
  (set! (-> self last-probe-index) slot)
  (go mp-arc-shown)
  )

(defun mp-receive-arc ((ev mp-event))
  "Another player's arc of this frame: keep its points, start the tracker that draws it."
  (let* ((slot (max 0 (min 7 (-> ev from))))
         (arc (-> *mp-arcs* arc slot))
         (info (-> arc info))
         (n (max 1 (min 6 (-> ev iarg 1))))
         (v (the-as (pointer int16) (-> ev text)))
         )
    (vector-copy! (-> info pts 0) (-> ev fvec))
    (set! (-> info pts 0 w) 1.0)
    (dotimes (k (+ n -1))
      (let ((p (-> info pts (+ k 1))))
        (dotimes (c 3)
          (set! (-> p data c) (+ (-> ev fvec data c) (* 81.92 (the float (-> v (+ (* k 3) c))))))
          )
        (set! (-> p w) 1.0)
        )
      )
    (set! (-> info num-pts) n)
    (set! (-> info should-draw-terminal-sparks?) (= (-> ev iarg 2) 1))
    (set! (-> info should-draw-extension?) #f)
    (set! (-> arc time) (mp-now))
    (when (not (handle->process (-> arc proc)))
      (let ((proc (process-spawn
                    gun-blue-2-lightning-tracker
                    :init mp-arc-init-by-other
                    slot
                    :name "mp-arc"
                    :to *entity-pool*
                    ;; the stock tracker's size (create-lightning-tracker-if-necessary): its six bolts
                    ;; fill most of it, a smaller heap ends in process-drawable-art-error "memory"
                    :stack-size #x29400
                    )
                  )
            )
        (if proc
            (set! (-> arc proc) (ppointer->handle proc))
            )
        )
      )
    )
  (none)
  )

;; Our wave concussor and mass inverter go off: tell the others once (they draw their copies).
(deftype mp-weapons-seen (structure)
  ((proc  handle 8)
   (next  int32)
   )
  )

(define *mp-weapons-seen* (new 'global 'mp-weapons-seen))

(defun mp-weapon-new? ((proc process))
  "#t the first time `proc` is seen here (then remembered)."
  (let ((ws *mp-weapons-seen*)
        (h (process->handle proc))
        )
    (dotimes (i 8)
      (if (= (-> ws proc i) h)
          (return #f)
          )
      )
    (set! (-> ws proc (-> ws next)) h)
    (set! (-> ws next) (logand (+ (-> ws next) 1) 7))
    #t
    )
  )

(defun mp-send-weapon ((gun int) (pos vector) (a float))
  "A weapon effect of ours went off at `pos` (parameter `a`): to everyone."
  (let ((ev (new 'stack 'mp-event)))
    (set! (-> ev kind) (mp-event-kind weapon))
    (set! (-> ev to) -1)
    (set! (-> ev iarg 0) gun)
    (vector-copy! (-> ev fvec) pos)
    (set! (-> ev iarg 1) (the-as int a))
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-collect-weapon ((proc process))
  "iterate-process-tree callback, under our player: a wave concussor's shockwave that exploded, a
   mass inverter's field, each told once."
  (cond
    ((and (type? proc gun-red-2-shockwave)
          (not (type? proc mp-red2-copy))
          (-> proc next-state)
          (= (-> proc next-state name) 'explode)
          (mp-weapon-new? proc)
          )
     (mp-send-weapon 27 (-> (the-as gun-red-2-shockwave proc) origin) (-> (the-as gun-red-2-shockwave proc) strength))
     )
    ((and (type? proc gun-gravity) (not (type? proc mp-dark2-copy)) (mp-weapon-new? proc))
     (mp-send-weapon 36 (-> (the-as gun-gravity proc) start-pos) (-> (the-as gun-gravity proc) total-time))
     )
    )
  #f
  )

(defun mp-replay-weapon ((ev mp-event))
  "Another player's weapon effect: draw its copy here (no damage: the owner's applies it)."
  (case (-> ev iarg 0)
    ((27)
     (+! (-> *mp-weapons-shown* 0) 1)
     (format 0 "[multiplayer] wave concussor of player ~D at ~,,1m ~,,1m ~,,1m~%" (-> ev from) (-> ev fvec x) (-> ev fvec y) (-> ev fvec z))
     (process-spawn
       mp-red2-copy
       :init mp-red2-copy-init-by-other
       (-> ev fvec)
       (the-as float (-> ev iarg 1))
       :name "mp-red2-copy"
       :to *entity-pool*
       :stack *kernel-dram-stack*
       )
     )
    ((36)
     (+! (-> *mp-weapons-shown* 1) 1)
     (format 0 "[multiplayer] mass inverter of player ~D at ~,,1m ~,,1m ~,,1m~%" (-> ev from) (-> ev fvec x) (-> ev fvec y) (-> ev fvec z))
     (process-spawn
       mp-dark2-copy
       :init mp-dark2-copy-init-by-other
       (-> ev fvec)
       (the-as float (-> ev iarg 1))
       :name "mp-dark2-copy"
       :to *entity-pool*
       )
     )
    ((33)
     (+! (-> *mp-weapons-shown* 2) 1)
     (mp-receive-arc ev)
     )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Effects and projectiles
;; ------------------------------------------------------------------------------------------------

;; Every one-shot particle effect goes through part-tracker-init-base (generic-obs.gc), and every
;; projectile through projectile-init-by-other (projectile.gc): both are wrapped to tell the other
;; players, who start the same effect or fire the same projectile type. Each machine applies the
;; damage of shots only to its own player (with its own copy of an NPC's shot), and the shooter's
;; machine sends hits on other players' puppets and on replicas: copies of a player's shots are
;; drawn only (they collide with the background alone).

(deftype mp-fx-state (structure)
  ((replaying?   symbol)     ;; spawning a copy: do not send it back
   (frame        int64)      ;; frame of the counts below
   (effects-sent int32)
   (shots-sent   int32)
   (recent-group sparticle-launch-group 8) ;; local effects just started, to skip duplicate copies
   (recent-pos   vector 8 :inline)
   (recent-time  time-frame 8)
   (recent-next  int32)
   (total-effects-sent int32)  ;; counters for the test log
   (total-effects-shown int32)
   (total-shots-sent int32)
   (total-shots-shown int32)
   )
  )

(define *mp-fx* (new 'global 'mp-fx-state))
(set! (-> *mp-fx* replaying?) #f)

(defun mp-fx-budget ((effect? symbol))
  "At most 8 effects and 8 shots sent per frame."
  (let ((fx *mp-fx*)
        (frame (-> *display* real-frame-clock frame-counter))
        )
    (when (!= frame (-> fx frame))
      (set! (-> fx frame) frame)
      (set! (-> fx effects-sent) 0)
      (set! (-> fx shots-sent) 0)
      )
    (cond
      (effect?
        (+! (-> fx effects-sent) 1)
        (<= (-> fx effects-sent) 8)
        )
      (else
        (+! (-> fx shots-sent) 1)
        (<= (-> fx shots-sent) 8)
        )
      )
    )
  )

(defun mp-under-replica? ((proc process-tree))
  "#t when `proc` is a replica or puppet, or below one (their effects are replays already)."
  (dotimes (i 6)
    (cond
      ((not proc)
       (return #f)
       )
      ((or (type? proc mp-replica) (type? proc mp-puppet))
       (return #t)
       )
      (else
        (set! proc (ppointer->process (-> proc parent)))
        )
      )
    )
  #f
  )

(defun mp-part-group-index ((group sparticle-launch-group))
  "Index of `group` in *part-group-id-table*, -1 when absent."
  (dotimes (i (-> *part-group-id-table* length))
    (if (= (-> *part-group-id-table* i) group)
        (return i)
        )
    )
  -1
  )

;; Particle callbacks a copy cannot run. A copy of a group plays on a part-tracker (mp-replay-effect,
;; mp-play-emitters), where these read what that process has not (a collide-shape root, joints, a
;; darkjak-ball), or the local player (*target*'s gun or joints): a crash (board-zap-track read the
;; joints of *entity-pool* on the host, in testing) or an effect on the wrong player.
(define *mp-unsafe-part-funcs*
  (new 'static 'boxed-array :type symbol
    'sparticle-track-root-prim 'eco-track-root-prim-fadeout 'sparticle-track-joint-glider
    'sparticle-track-joint-xz 'crowd-dude-func 'fruit-check-ground-bounce 'sparticle-track-hadouken
    'sparticle-track-gun-joint 'sparticle-track-gun-joint-player-y 'part-tracker-track-target-joint
    'board-charge-track 'sparticle-red-2-converge
    )
  )

(defun mp-launcher-replayable? ((launcher sparticle-launcher) (parent process))
  "#t when a copy of particle `launcher` can play under `parent` (#f: in the world or a direct
   launch): no callback of *mp-unsafe-part-funcs*, and board-zap-track (the joints of the tracker's
   parent) only with a parent that has joints."
  (let ((spec (get-field-spec-by-id launcher (sp-field-id spt-func))))
    (when spec
      (let ((fn (-> spec sym)))
        (dotimes (k (-> *mp-unsafe-part-funcs* length))
          (if (= fn (-> *mp-unsafe-part-funcs* k))
              (return #f)
              )
          )
        (if (and (= fn 'board-zap-track) (not (and parent (type? parent process-drawable))))
            (return #f)
            )
        )
      )
    )
  #t
  )

(defun mp-group-replayable? ((group sparticle-launch-group) (parent process))
  "#t when a copy of particle group `group` can play on a part-tracker under `parent` (#f: in the
   world): every particle of it can (mp-launcher-replayable?)."
  (dotimes (i (-> group length))
    (let ((launcher (-> *part-id-table* (-> group launcher i launcher))))
      (if (and (nonzero? launcher) launcher (type? launcher sparticle-launcher) (not (mp-launcher-replayable? launcher parent)))
          (return #f)
          )
      )
    )
  #t
  )

(defun mp-effect-owner ((proc process))
  "What another machine attaches the copy of an effect of `proc` to: -2 our player (its puppet
   there), the pid of an object we send (its copy there), -1 nothing (the world)."
  (cond
    ((not proc)
     -1
     )
    ((= proc *target*)
     -2
     )
    (else
      (let ((pid (-> proc pid)))
        (dotimes (i (-> *mp-actors-out* count))
          (if (= (logand (-> *mp-actors-out* state i id) #xffffff) pid)
              (return pid)
              )
          )
        )
      -1
      )
    )
  )

(defun mp-effect-parent ((from int) (owner int))
  "The copy here of what owns another player's effect (mp-effect-owner): the puppet of player
   `from`, or the replica of its object; #f when it has none here (or for the world)."
  (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
    (cond
      ((not manager)
       (the-as process #f)
       )
      ((= owner -2)
       (handle->process (-> manager puppets (max 0 (min from (+ MP_MAX_PLAYERS -1)))))
       )
      ((>= owner 0)
       (let ((index (mp-replica-index (the-as uint (logior (shl from 24) owner)))))
         (if (>= index 0)
             (handle->process (-> *mp-world-state* replica index))
             (the-as process #f)
             )
         )
       )
      (else
        (the-as process #f)
        )
      )
    )
  )

(defbehavior mp-effect-started part-tracker ((group sparticle-launch-group) (target process-drawable) (duration time-frame) (joint object))
  "A one-shot effect started here: remember it, and send it unless it is a copy or a replica's,
   with what it belongs to (mp-effect-owner) and the joint it follows."
  (let ((fx *mp-fx*)
        (pos (if (and target (nonzero? (-> target root)))
                 (-> target root trans)
                 (-> self root trans)
                 )
             )
        )
    (when (not (-> fx replaying?))
      (let ((i (-> fx recent-next)))
        (set! (-> fx recent-group i) group)
        (vector-copy! (-> fx recent-pos i) pos)
        (set! (-> fx recent-time i) (mp-now))
        (set! (-> fx recent-next) (logand (+ i 1) 7))
        )
      (when (and (mp-online?)
                 (not (mp-under-replica? self))
                 (not (and target (mp-under-replica? target)))
                 (mp-near-a-player? pos)
                 (mp-fx-budget #t)
                 )
        (let ((index (mp-part-group-index group)))
          (when (>= index 0)
            (let ((ev (new 'stack 'mp-event)))
              (set! (-> ev kind) (mp-event-kind effect))
              (set! (-> ev to) -1)
              (set! (-> ev iarg 0) index)
              (set! (-> ev iarg 1) (the-as int duration))
              (set! (-> ev iarg 2) (mp-effect-owner (if target
                                                        target
                                                        (ppointer->process (-> self parent))
                                                        )
                                                    )
                    )
              (set! (-> ev iarg 3) (if target
                                       (the-as int joint)
                                       -1
                                       )
                    )
              (vector-copy! (-> ev fvec) pos)
              (pc-mp-send-event ev)
              (+! (-> fx total-effects-sent) 1)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-replay-effect ((ev mp-event))
  "Start an effect another player saw start, unless an identical one just started here: on the copy
   of what it belongs to (following the same joint), else in the world; never for a player whose
   puppet is not here, nor a group that cannot play there (mp-group-replayable?)."
  (let ((index (-> ev iarg 0))
        (fx *mp-fx*)
        (owner (-> ev iarg 2))
        (joint (-> ev iarg 3))
        )
    (when (and (>= index 0) (< index (-> *part-group-id-table* length)))
      (let ((group (-> *part-group-id-table* index)))
        ;; a level's groups are empty while that level is not loaded here
        (when (and (nonzero? group) (type? group sparticle-launch-group))
          (dotimes (i 8)
            (if (and (= (-> fx recent-group i) group)
                     (< (- (mp-now) (-> fx recent-time i)) (seconds 0.5))
                     (< (vector-vector-distance (-> fx recent-pos i) (-> ev fvec)) (meters 3))
                     )
                (return #f)
                )
            )
          (let ((parent (mp-effect-parent (-> ev from) owner)))
            ;; a shot's effect (its impact) plays in the world when it can: the shot's copy goes
            ;; 250 ms after the shot, and its effects with it
            (if (and parent
                     (type? parent mp-replica)
                     (logtest? (-> (the-as mp-replica parent) net flags) (mp-actor-flag shot))
                     (mp-group-replayable? group (the-as process #f))
                     )
                (set! parent (the-as process #f))
                )
            (when (and (or parent (= owner -1) (>= owner 0)) (mp-group-replayable? group parent))
              (set! (-> fx replaying?) #t)
              (+! (-> fx total-effects-shown) 1)
              (vector-copy! (-> *launch-matrix* trans) (-> ev fvec))
              (let ((to (the-as process-tree (if parent
                                                 parent
                                                 *entity-pool*
                                                 )
                                )
                        )
                    (tgt (the-as process-drawable (if (and parent (>= joint 0))
                                                      parent
                                                      )
                                 )
                         )
                    (mat-joint (if (and parent (>= joint 0))
                                   joint
                                   *launch-matrix*
                                   )
                               )
                    )
                (if (logtest? (-> group flags) (sp-group-flag sp13))
                    (part-tracker-spawn
                      part-tracker-subsampler
                      :to to
                      :group group
                      :duration (the-as time-frame (-> ev iarg 1))
                      :target tgt
                      :mat-joint mat-joint
                      )
                    (part-tracker-spawn
                      part-tracker
                      :to to
                      :group group
                      :duration (the-as time-frame (-> ev iarg 1))
                      :target tgt
                      :mat-joint mat-joint
                      )
                    )
                )
              (set! (-> fx replaying?) #f)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-projectile-fired ((proj projectile) (params projectile-init-by-other-params))
  "A projectile was fired here: send it when it is an NPC's and we simulate the NPCs (every machine
   fires its copy, which may hit its player). A player's shots are not fired elsewhere: they go in
   the batches as objects (mp-collect-shot)."
  (when (and (mp-online?) (not (-> *mp-fx* replaying?)))
    (let* ((owner (handle->process (-> params owner-handle)))
           (shooter (if owner
                        owner
                        (ppointer->process (-> proj parent))
                        )
                    )
           )
      (when (and *mp-authority*
                 shooter
                 (type? shooter process)
                 (> (mp-actor-kind (the-as process shooter)) 0)
                 (mp-near-a-player? (-> params pos))
                 (mp-fx-budget #f)
                 )
        (let ((ev (new 'stack 'mp-event)))
          (set! (-> ev kind) (mp-event-kind projectile))
          (set! (-> ev to) -1)
          (vector-copy! (-> ev fvec) (-> params pos))
          (set! (-> ev iarg 0) (the-as int (-> params vel x)))
          (set! (-> ev iarg 1) (the-as int (-> params vel y)))
          (set! (-> ev iarg 2) (the-as int (-> params vel z)))
          (set! (-> ev iarg 3) (logand (-> (the-as process shooter) pid) #xffffff))
          (copyn-charp<-string (-> ev text) (symbol->string (-> proj type symbol)) 32)
          (pc-mp-send-event ev)
          (+! (-> *mp-fx* total-shots-sent) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-replay-projectile ((ev mp-event))
  "Fire the copy of an NPC's projectile from the replica of the NPC that fired it."
  (let* ((from (-> ev from))
         (parent (let ((index (mp-replica-index (the-as uint (logior (shl from 24) (-> ev iarg 3))))))
                   (if (>= index 0)
                       (handle->process (-> *mp-world-state* replica index))
                       )
                   )
                 )
         )
    (when parent
      (string<-charp *mp-temp-string* (-> ev text))
      (let ((typ (-> (string->symbol *mp-temp-string*) value)))
        ;; the type is level code: it exists only when its level is loaded here
        (when (and typ (type? typ type) (mp-inherits? (the-as type typ) 'projectile))
          (let ((params (new 'stack 'projectile-init-by-other-params)))
            (vector-copy! (-> params pos) (-> ev fvec))
            (set! (-> params pos w) 1.0)
            (set-vector!
              (-> params vel)
              (the-as float (-> ev iarg 0))
              (the-as float (-> ev iarg 1))
              (the-as float (-> ev iarg 2))
              0.0
              )
            (set! (-> params target-handle) (the-as handle #f))
            (set! (-> params ent) #f)
            (set! (-> params charge) 1.0)
            (set! (-> params attack-id) (new-attack-id))
            (set! (-> params options) (projectile-options))
            (set! (-> params notify-handle) (the-as handle #f))
            (set! (-> params owner-handle) (process->handle (the-as process parent)))
            (set! (-> params ignore-handle) (process->handle (the-as process parent)))
            (set! (-> params timeout) (seconds 4))
            (set! (-> params damage) 1.0)
            (set! (-> params vehicle-damage-factor) 1.0)
            (set! (-> params vehicle-impulse-factor) 1.0)
            (set! (-> *mp-fx* replaying?) #t)
            (+! (-> *mp-fx* total-shots-shown) 1)
            (spawn-projectile (the-as type typ) params (the-as process-tree parent) *default-dead-pool*)
            (set! (-> *mp-fx* replaying?) #f)
            )
          )
        )
      )
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock entry points of effects and projectiles. define-perm keeps the
;; stock function when this file is reloaded in a REPL session.
(define-perm *mp-stock-part-tracker-init-base*
             (function sparticle-launch-group time-frame (function part-tracker vector) uint process-drawable object none :behavior part-tracker)
  part-tracker-init-base
  )

(defbehavior part-tracker-init-base part-tracker ((arg0 sparticle-launch-group)
                                        (arg1 time-frame)
                                        (arg2 (function part-tracker vector))
                                        (arg3 uint)
                                        (arg4 process-drawable)
                                        (arg5 object)
                                        )
  "Stock behavior, then the other players see the effect too (multiplayer mod, no-op offline)."
  (*mp-stock-part-tracker-init-base* arg0 arg1 arg2 arg3 arg4 arg5)
  (if (nonzero? arg0)
      (mp-effect-started arg0 arg4 arg1 arg5)
      )
  (none)
  )

(define-perm *mp-stock-projectile-init-by-other* (function projectile-init-by-other-params object :behavior projectile)
  projectile-init-by-other
  )

(defbehavior projectile-init-by-other projectile ((arg0 projectile-init-by-other-params))
  "The other players fire the same projectile (multiplayer mod, no-op offline), then the stock init,
   which never returns (it goes to the projectile's first state)."
  (mp-projectile-fired self arg0)
  (*mp-stock-projectile-init-by-other* arg0)
  )

;; ------------------------------------------------------------------------------------------------
;; Poses and emitters
;; ------------------------------------------------------------------------------------------------

;; A copy plays the owner's animation by index, which misses blended channels, animations streamed
;; on the owner's machine (vehicle seats, scripted moves), joint mods (look-at, aiming) and
;; ragdolls. So each batch also carries the owner's bones, relative to the object's frame (its
;; root position and orientation, as sent in its state): the player's, its props', and every NPC's
;; sent (whose joint math runs in full while it is sent, mp-force-math). The copy computes its own bones from
;; its animation, then mp-pose-postbind (its joint-control postbind-function) lays the owner's on
;; its frame, interpolated by the runtime like the rest of its state. The animation still runs: it
;; plays the animation's effects (footsteps, sounds) and stands in until a pose arrives.
;;
;; Particle emitters are noted where they are used: launch-control `spawn` (groups that run every
;; frame: engine flames, trails, auras) and direct launches (sp-launch-particles-var without a
;; launch control: dust, glows). An object's batch entry lists the emitters it used since the
;; previous batch; the copy keeps a part-tracker per group while the owner keeps it running, and
;; replays single launches as many times as the owner made them.
;;
;; Sounds the same way: sound-play-by-name and sound-play-by-spec (every sound a process plays)
;; and sound-stop are noted for those objects, the latest call per sound id. The copy plays each
;; with an id of its own per owner's id, so a lasting sound (an engine, updated every frame on the
;; owner's machine) stays one sound, updated each batch, and stops when the owner stops it.

(defun mp-frame-of ((out matrix) (trans vector) (quat quaternion))
  "The rigid frame (no scale) poses and emitters are expressed in: `quat` then `trans`."
  (quaternion->matrix out quat)
  (vector-copy! (-> out trans) trans)
  (set! (-> out trans w) 1.0)
  out
  )

(defun mp-level-hash ((lev level))
  "16-bit hash of a level's name, never 0 (0 means global data)."
  (let ((str (symbol->string (-> lev name)))
        (h 0)
        )
    (dotimes (i (length str))
      (set! h (logand (+ (* h 31) (-> str data i)) #xffff))
      )
    (logior h 1)
    )
  )

(defun mp-heap-level ((addr uint))
  "The level whose heap holds `addr`, #f for global data."
  (countdown (li 11)
    (let ((lev (-> *level* level li)))
      (if (and (>= addr (the-as uint (-> lev heap base))) (< addr (the-as uint (-> lev heap top-base))))
          (return lev)
          )
      )
    )
  (the-as level #f)
  )

(defun mp-part-index ((launcher sparticle-launcher))
  "Index of a single launcher in *part-id-table*, -1 when absent. Cached (reset when levels move)."
  (let ((ps *mp-pose*))
    (dotimes (i 16)
      (if (= (-> ps part-ptr i) launcher)
          (return (-> ps part-index i))
          )
      )
    (dotimes (i (-> *part-id-table* length))
      (when (= (-> *part-id-table* i) launcher)
        (let ((k (-> ps part-next)))
          (set! (-> ps part-ptr k) launcher)
          (set! (-> ps part-index k) i)
          (set! (-> ps part-next) (logand (+ k 1) 15))
          )
        (return i)
        )
      )
    )
  -1
  )

(defun mp-launcher-usable? ((index int) (home int))
  "#t when entry `index` of *part-id-table* is the launcher the owner meant. The table keeps the
   entries of unloaded levels (only groups are unlinked), so the launcher must be global data when
   `home` is 0, else in the heap of a loaded level whose name hashes to `home`."
  (when (and (>= index 0) (< index (-> *part-id-table* length)))
    (let ((launcher (-> *part-id-table* index)))
      (when (nonzero? launcher)
        (let ((lev (mp-heap-level (the-as uint launcher))))
          (if (zero? home)
              (not lev)
              (and lev
                   (= (mp-level-hash lev) home)
                   (or (= (-> lev status) 'active) (= (-> lev status) 'alive) (= (-> lev status) 'loaded))
                   )
              )
          )
        )
      )
    )
  )

(defun mp-emitter-owner? ((proc process))
  "#t when the others draw `proc` from this machine: the player, Daxter, the gun, the hoverboard,
   the player's shots, the vehicle driven (and its wheels), or an NPC while we simulate the NPCs
   around us."
  (and proc
       (nonzero? proc)
       (or (= proc *target*)
           (and *target*
                (or (= proc (ppointer->process (-> *target* sidekick)))
                    (and (nonzero? (-> *target* gun)) (= proc (ppointer->process (-> *target* gun gun))))
                    (and (nonzero? (-> *target* board)) (= proc (ppointer->process (-> *target* board board))))
                    (and (type? proc projectile) (mp-from-local-player? proc))
                    )
                )
           (mp-driven-vehicle? proc)
           (and *mp-authority* (> (mp-actor-kind proc) 0))
           )
       )
  )

(defun mp-note-emitter ((proc process) (kind int) (ptr basic) (origin matrix))
  "`proc` used emitter `ptr` (a group for kind 0, a single launcher else) at `origin`: remember it
   for the next batch, once per object and emitter, with the number of uses."
  (when (and (not (-> *mp-fx* replaying?)) (mp-emitter-owner? proc))
    (let ((ps *mp-pose*)
          (pid (-> proc pid))
          (slot -1)
          )
      (dotimes (i (-> ps emit-count))
        (when (and (= (-> ps emit-pid i) pid) (= (-> ps emit-ptr i) ptr))
          (set! slot i)
          (set! i (-> ps emit-count))
          )
        )
      (when (and (< slot 0) (< (-> ps emit-count) 64))
        (set! slot (-> ps emit-count))
        (+! (-> ps emit-count) 1)
        (set! (-> ps emit-pid slot) pid)
        (set! (-> ps emit-kind slot) kind)
        (set! (-> ps emit-ptr slot) ptr)
        (set! (-> ps emit-calls slot) 0)
        )
      (when (>= slot 0)
        (+! (-> ps emit-calls slot) 1)
        (matrix-copy! (-> ps emit-origin slot) origin)
        )
      )
    )
  (none)
  )

(defun mp-note-sound ((proc process) (name sound-name) (id sound-id) (vol int) (pitch int) (bend int) (trans object))
  "`proc` played sound `name` as `id`: remember the call for the next batch (the latest one per id)
   when the others draw `proc`. `trans` is a position, #t for the process's root, #f for a sound
   without position (the others hear it at the copy)."
  (when (and (not (-> *mp-fx* replaying?)) (nonzero? id) (mp-emitter-owner? proc))
    (let ((ps *mp-pose*)
          (pid (-> proc pid))
          (slot -1)
          )
      (dotimes (i (-> ps snd-count))
        (if (and (= (-> ps snd-pid i) pid) (= (-> ps snd-out i id) id))
            (set! slot i)
            )
        )
      (when (and (< slot 0) (< (-> ps snd-count) 48))
        (set! slot (-> ps snd-count))
        (+! (-> ps snd-count) 1)
        (set! (-> ps snd-pid slot) pid)
        (let ((k (-> ps known-next)))
          (set! (-> ps known-pid k) pid)
          (set! (-> ps known-id k) id)
          (set! (-> ps known-next) (logand (+ k 1) 31))
          )
        )
      (when (>= slot 0)
        (let ((snd (-> ps snd-out slot)))
          (set! (-> snd name) name)
          (set! (-> snd id) id)
          (set! (-> snd vol) vol)
          (set! (-> snd pitch) pitch)
          (set! (-> snd bend) bend)
          (set! (-> snd flags) 1)
          (cond
            ((and trans (!= trans #t))
             (vector-copy! (-> snd pos) (the-as vector trans))
             )
            ((and (type? proc process-drawable) (nonzero? (-> (the-as process-drawable proc) root)))
             (vector-copy! (-> snd pos) (-> (the-as process-drawable proc) root trans))
             )
            (else
              (set! (-> snd flags) 0)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-note-sound-stop ((id sound-id))
  "Sound `id` was stopped: when an object we send played it, the others stop their copy of it."
  (when (and (nonzero? id) (not (-> *mp-fx* replaying?)))
    (let ((ps *mp-pose*))
      (dotimes (k 32)
        (when (= (-> ps known-id k) id)
          (let ((pid (-> ps known-pid k))
                (slot -1)
                )
            (dotimes (i (-> ps snd-count))
              (if (and (= (-> ps snd-pid i) pid) (= (-> ps snd-out i id) id))
                  (set! slot i)
                  )
              )
            (when (and (< slot 0) (< (-> ps snd-count) 48))
              (set! slot (-> ps snd-count))
              (+! (-> ps snd-count) 1)
              (set! (-> ps snd-pid slot) pid)
              (set! (-> ps snd-out slot id) id)
              (vector-reset! (-> ps snd-out slot pos))
              )
            (if (>= slot 0)
                (set! (-> ps snd-out slot flags) 2)
                )
            )
          (set! (-> ps known-id k) (the-as sound-id 0))
          (return #f)
          )
        )
      )
    )
  (none)
  )

(defun mp-pose-ready? ((proc process-drawable) (npc? symbol))
  "#t when every bone of `proc` came out of its last joint math: drawn, at a level of detail that
   animates every joint, and, for an NPC, not skipping its joint math (bone 0 still at its root)."
  (let ((nodes (-> proc node-list))
        (draw (-> proc draw))
        )
    (and (nonzero? nodes)
         (nonzero? draw)
         (nonzero? (-> proc skel))
         (<= (-> nodes length) MP_MAX_POSE_JOINTS)
         (not (logtest? (-> draw status) (draw-control-status no-draw no-draw-temp uninited)))
         (or (logtest? (-> proc skel status) (joint-control-status force-math))
             (and (nonzero? (-> draw mgeo)) (-> draw mgeo) (>= (+ (-> draw mgeo num-joints) 3) (-> nodes length)))
             )
         (or (not npc?)
             (< (vector-vector-distance (-> nodes data 0 bone transform trans) (-> proc root trans)) (meters 0.5))
             )
         )
    )
  )

(defun mp-send-pose ((id uint) (proc process-drawable) (trans vector) (quat quaternion) (npc? symbol) (pose? symbol) (effects? symbol))
  "Queue object `proc` in the pose batch: its bones relative to its frame (`trans` `quat`, as sent
   in its state) when `pose?` and they are complete, and with `effects?` (the 15 Hz batch) the
   emitters and sounds it used since the last batch (none is news too: its emitters stopped)."
  (let ((ps *mp-pose*)
        (pid (-> proc pid))
        (count 0)
        (emitters 0)
        )
    (dotimes (i (-> ps emit-count))
      (if (= (-> ps emit-pid i) pid)
          (+! emitters 1)
          )
      )
    (dotimes (i (-> ps snd-count))
      (if (= (-> ps snd-pid i) pid)
          (+! emitters 1)
          )
      )
    ;; an NPC whose joint math did not run lately (frozen by a cutscene, off the owner's screen):
    ;; its bones are computed now from its animation, as the owner's would be
    (when (and pose? npc? (not (mp-pose-ready? proc npc?)) (nonzero? (-> proc draw)) (nonzero? (-> proc skel))
               (not (logtest? (-> proc draw status) (draw-control-status no-draw no-draw-temp uninited)))
               )
      (do-joint-math (-> proc draw) (-> proc node-list) (-> proc skel))
      )
    (when (and pose? (not (mp-pose-ready? proc npc?)))
      ;; not drawn by its owner, for good or for a moment (a teleport, a model set up again and
      ;; not computed yet): nothing to copy
      (if (and (nonzero? (-> proc draw)) (logtest? (-> proc draw status) (draw-control-status no-draw no-draw-temp uninited)))
          (+! (-> ps poses-hidden) 1)
          (+! (-> ps poses-skipped) 1)
          )
      )
    (when (and pose? (mp-pose-ready? proc npc?))
      (let ((nodes (-> proc node-list)))
        (dotimes (i (-> nodes length))
          (matrix-copy! (-> ps bones i) (-> nodes data i bone transform))
          )
        (set! count (-> nodes length))
        )
      )
    (when (or (> count 0) effects?)
      (pc-mp-add-pose id (mp-frame-of (-> ps frame) trans quat) (-> ps bones) (if effects?
                                                                                    (logior count #x8000)
                                                                                    count
                                                                                    )
                      )
      (if (> count 0)
          (+! (-> ps poses-sent) 1)
          )
      (dotimes (i (if effects?
                      (-> ps emit-count)
                      0
                      )
                  )
        (when (= (-> ps emit-pid i) pid)
          (let* ((group? (zero? (-> ps emit-kind i)))
                 (index (if group?
                            (mp-part-group-index (the-as sparticle-launch-group (-> ps emit-ptr i)))
                            (mp-part-index (the-as sparticle-launcher (-> ps emit-ptr i)))
                            )
                        )
                 (lev (if group?
                          (the-as level #f)
                          (mp-heap-level (the-as uint (-> ps emit-ptr i)))
                          )
                      )
                 )
            (when (>= index 0)
              ;; the kind carries the hash of the launcher's level in its upper bits
              (pc-mp-add-emitter
                (logior (-> ps emit-kind i) (shl (if lev (mp-level-hash lev) 0) 8))
                index
                (-> ps emit-calls i)
                (-> ps emit-origin i)
                )
              (+! (-> ps emitters-sent) 1)
              )
            )
          )
        )
      (dotimes (i (if effects?
                      (-> ps snd-count)
                      0
                      )
                  )
        (when (= (-> ps snd-pid i) pid)
          (pc-mp-add-sound (-> ps snd-out i))
          (+! (-> ps sounds-sent) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-remote-distance ((pos vector))
  "Distance from `pos` to the nearest other player."
  (let ((best (meters 1000000)))
    (dotimes (i MP_MAX_PLAYERS)
      (let ((st (mp-remote-state i)))
        (if st
            (set! best (fmin best (vector-vector-distance pos (-> st trans))))
            )
        )
      )
    best
    )
  )

(defun mp-send-poses ()
  "Queue and send the poses of this batch: the player, its props and every NPC sent, each with the
   emitters and sounds it used; then forget the emitters and sounds noted since the last batch."
  (let* ((ps *mp-pose*)
         (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
         ;; a passenger's own model is hidden: the model this player sees in the seat is sent instead
         (seated (if (and manager (>= *mp-ride-slot* 0))
                     (the-as process-drawable (handle->process (-> manager self-puppet)))
                     )
                 )
         )
    (cond
      (seated
        (mp-send-pose (the-as uint #xffffff) seated (-> seated root trans) (-> seated root quat) #f #t #t)
        )
      (*target*
        (mp-send-pose (the-as uint #xffffff) *target* (-> *target* control trans) (-> *target* control quat) #f #t #t)
        )
      )
    (dotimes (i *mp-collect-count*)
      (let ((st (-> *mp-actors-out* state i))
            (proc (the-as process-drawable (handle->process (-> ps obj i))))
            )
        ;; the props, and the NPCs within 40 m of another player, get their bones every frame
        (set! (-> ps near i) (or (logtest? (-> st flags) (mp-actor-flag owned))
                                 (< (mp-remote-distance (-> st trans)) (meters 40))
                                 )
              )
        ;; physics objects of the level have no copy, so no pose; a shot without a model has its
        ;; effects only
        (if (and proc (not (logtest? (-> st flags) (mp-actor-flag world))))
            (mp-send-pose
              (-> st id)
              proc
              (-> st trans)
              (-> st quat)
              (not (logtest? (-> st flags) (mp-actor-flag owned)))
              (nonzero? (-> st skel 0))
              #t
              )
            )
        )
      )
    (pc-mp-send-poses)
    (set! (-> ps emit-count) 0)
    (set! (-> ps snd-count) 0)
    )
  (none)
  )

(define *mp-owned-out* (new 'global 'mp-actor-table))

(defun mp-send-near-poses ()
  "Between two batches, every frame: the bones of the player, of its props and of the NPCs near
   another player, without effects, so their copies are drawn from every frame of the owner's
   (the batch's 15 Hz would leave the copy a straight blend between poses 66 ms apart); and the
   state of what the player owns (props, the vehicle driven and its wheels, shots), so their copies
   move from every frame too: a vehicle blended between states 66 ms apart jerked at speed."
  (let* ((ps *mp-pose*)
         (own *mp-owned-out*)
         (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
         (seated (if (and manager (>= *mp-ride-slot* 0))
                     (the-as process-drawable (handle->process (-> manager self-puppet)))
                     )
                 )
         (trans (new 'stack-no-clear 'vector))
         (quat (new 'stack-no-clear 'quaternion))
         )
    (cond
      (seated
        (mp-send-pose (the-as uint #xffffff) seated (-> seated root trans) (-> seated root quat) #f #t #f)
        )
      (*target*
        (mp-send-pose (the-as uint #xffffff) *target* (-> *target* control trans) (-> *target* control quat) #f #t #f)
        )
      )
    (set! (-> own count) 0)
    (dotimes (i *mp-collect-count*)
      (let ((st (-> *mp-actors-out* state i))
            (proc (the-as process-drawable (handle->process (-> ps obj i))))
            )
        (when (and proc (-> ps near i) (not (logtest? (-> st flags) (mp-actor-flag world))) (nonzero? (-> proc root)))
          ;; its frame now, computed as its state's (mp-add-actor, mp-add-prop)
          (cond
            ((and (logtest? (-> st flags) (mp-actor-flag prop)) (nonzero? (-> proc node-list)))
             (let ((mat (-> proc node-list data 0 bone transform)))
               (vector-copy! trans (-> mat trans))
               (matrix->quaternion quat mat)
               (quaternion-normalize! quat)
               )
             )
            (else
              (vector-copy! trans (-> proc root trans))
              (quaternion-copy! quat (-> proc root quat))
              )
            )
          (if (nonzero? (-> st skel 0))
              (mp-send-pose (-> st id) proc trans quat (not (logtest? (-> st flags) (mp-actor-flag owned))) #t #f)
              )
          (when (logtest? (-> st flags) (mp-actor-flag owned))
            (let ((out (-> own state (-> own count))))
              (mem-copy! (the-as pointer out) (the-as pointer st) (size-of mp-actor-state))
              (vector-copy! (-> out trans) trans)
              (set! (-> out trans w) (-> st trans w))
              (quaternion-copy! (-> out quat) quat)
              ;; our gun's laser sight of this frame, as its place
              (if (and *target* (logtest? (-> out flags) (mp-actor-flag laser)) (nonzero? (-> *target* gun)))
                  (mp-pack-laser out)
                  )
              (+! (-> own count) 1)
              )
            )
          )
        )
      )
    (pc-mp-send-poses)
    (dotimes (i (-> own count))
      (mp-test-note-path #t (-> own state i))
      )
    (if (> (-> own count) 0)
        (pc-mp-send-actors (-> own state) (-> own count))
        )
    )
  (none)
  )

(defun mp-pose-postbind ((draw draw-control) (nodes cspace-array) (jc joint-control))
  "postbind-function of puppets and replicas, called by do-joint-math with pp the copy: replace the
   bones computed from the local animation by the owner's pose laid on the copy's frame, when one
   arrived for this skeleton (same bone count)."
  (with-pp
    (let ((id (cond
                ((type? pp mp-replica)
                 (-> (the-as mp-replica pp) id)
                 )
                ((and (type? pp mp-puppet) (not (-> (the-as mp-puppet pp) local?)))
                 (mp-puppet-pose-id (-> (the-as mp-puppet pp) slot))
                 )
                (else
                  (the-as uint 0)
                  )
                )
              )
          )
      (when (nonzero? id)
        (let* ((ps *mp-pose*)
               (proc (the-as process-drawable pp))
               (count (pc-mp-get-pose
                        id
                        (mp-frame-of (-> ps frame) (-> proc root trans) (-> proc root quat))
                        (-> ps bones)
                        MP_MAX_POSE_JOINTS
                        )
                      )
               )
          (if (type? pp mp-replica)
              (set! (-> (the-as mp-replica pp) pose-last) count)
              )
          (when (and (> count 0) (= count (-> nodes length)))
            (dotimes (i count)
              (matrix-copy! (-> nodes data i bone transform) (-> ps bones i))
              )
            (+! (-> ps poses-applied) 1)
            (when (type? pp mp-replica)
              (+! (-> (the-as mp-replica pp) pose-count) 1)
              (set! (-> (the-as mp-replica pp) pose-time) (pc-mp-clock (the-as int (shr id 24))))
              )
            (if (type? pp mp-puppet)
                (set! (-> (the-as mp-puppet pp) pose-time) (pc-mp-clock (the-as int (shr id 24))))
                )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-sound-stop-copy ((i int))
  "Stop the copy's sound in entry `i` of the table and free the entry."
  (let ((ps *mp-pose*))
    (set! (-> *mp-fx* replaying?) #t)
    (sound-stop (-> ps rsnd-local i))
    (set! (-> *mp-fx* replaying?) #f)
    (set! (-> ps rsnd-copy i) (the-as uint 0))
    )
  (none)
  )

(defun mp-play-sounds ((copy uint) (frame matrix))
  "Play on copy `copy` (placed at `frame`) the sounds its owner made: one sound id of ours per
   owner's sound id, so a lasting sound stays one sound, updated each batch."
  (let* ((ps *mp-pose*)
         (count (pc-mp-get-sounds copy frame (-> ps sounds) 32))
         )
    (dotimes (i count)
      (let* ((snd (-> ps sounds i))
             (slot -1)
             )
        (dotimes (k 96)
          (if (and (= (-> ps rsnd-copy k) copy) (= (-> ps rsnd-remote k) (-> snd id)))
              (set! slot k)
              )
          )
        (cond
          ((logtest? (-> snd flags) 2)
           (if (>= slot 0)
               (mp-sound-stop-copy slot)
               )
           )
          (else
            (when (< slot 0)
              ;; a free entry, else the oldest one (stopped first)
              (set! slot 0)
              (dotimes (k 96)
                (cond
                  ((zero? (-> ps rsnd-copy k))
                   (set! slot k)
                   (set! k 96)
                   )
                  ((< (-> ps rsnd-time k) (-> ps rsnd-time slot))
                   (set! slot k)
                   )
                  )
                )
              (if (nonzero? (-> ps rsnd-copy slot))
                  (mp-sound-stop-copy slot)
                  )
              (set! (-> ps rsnd-copy slot) copy)
              (set! (-> ps rsnd-remote slot) (-> snd id))
              (set! (-> ps rsnd-local slot) (new-sound-id))
              (set! (-> ps rsnd-batches slot) 0)
              )
            (+! (-> ps rsnd-batches slot) 1)
            (set! (-> ps rsnd-time slot) (mp-now))
            (set! (-> *mp-fx* replaying?) #t)
            (sound-play-by-name
              (-> snd name)
              (-> ps rsnd-local slot)
              (-> snd vol)
              (-> snd pitch)
              (-> snd bend)
              (sound-group sfx)
              (-> snd pos)
              )
            (set! (-> *mp-fx* replaying?) #f)
            (+! (-> ps sounds-played) 1)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-sounds-housekeeping ((all? symbol))
  "Stop the copies' lasting sounds the owner no longer updates (0.4 s), forget the others after
   10 s; every one when `all?`."
  (let ((ps *mp-pose*))
    (dotimes (i 96)
      (when (nonzero? (-> ps rsnd-copy i))
        (let ((age (- (mp-now) (-> ps rsnd-time i))))
          (if (or all? (and (>= (-> ps rsnd-batches i) 2) (< (seconds 0.4) age)) (< (seconds 10) age))
              (mp-sound-stop-copy i)
              )
          )
        )
      )
    )
  (none)
  )

(defun mp-play-emitters ((proc process-drawable) (id uint) (groups (pointer int32)) (trackers (pointer handle)))
  "Draw on copy `proc` the emitters its owner uses (object `id`): one part-tracker per particle
   group, kept alive and moved while the owner keeps the group running (MP_FX_TRACKERS), and the single
   launches replayed as many times as the owner made them; then play its sounds. `groups` and
   `trackers` are the copy's tracker slots."
  (let* ((ps *mp-pose*)
         (frame (mp-frame-of (-> ps frame) (-> proc root trans) (-> proc root quat)))
         (count (pc-mp-get-emitters id frame (-> ps emitters) 32))
         (kept 0)
         )
    (mp-play-sounds id frame)
    (set! (-> *mp-fx* replaying?) #t)
    (dotimes (i count)
      (let ((em (-> ps emitters i)))
        (+! (-> ps emitters-received) 1)
        (set! (-> ps last-kind) (-> em kind))
        (set! (-> ps last-index) (-> em index))
        (set! (-> ps last-home) (-> em home))
        (cond
          ((zero? (-> em kind))
           (when (and (>= (-> em index) 0) (< (-> em index) (-> *part-group-id-table* length)))
             (let ((group (-> *part-group-id-table* (-> em index)))
                   (slot -1)
                   )
               ;; a level's groups are unlinked (0) while that level is not loaded here
               (when (and (nonzero? group) (type? group sparticle-launch-group) (mp-group-replayable? group proc))
                 (dotimes (k MP_FX_TRACKERS)
                   (if (and (= (-> groups k) (-> em index)) (handle->process (-> trackers k)))
                       (set! slot k)
                       )
                   )
                 (when (< slot 0)
                   (dotimes (k MP_FX_TRACKERS)
                     (if (and (< slot 0) (not (logtest? kept (ash 1 k))) (not (handle->process (-> trackers k))))
                         (set! slot k)
                         )
                     )
                   (when (>= slot 0)
                     (matrix-copy! *launch-matrix* (-> em mat))
                     (let ((tracker (the-as
                                      (pointer process)
                                      (if (logtest? (-> group flags) (sp-group-flag sp13))
                                          (part-tracker-spawn part-tracker-subsampler :to proc :group group :duration (seconds 0.25))
                                          (part-tracker-spawn part-tracker :to proc :group group :duration (seconds 0.25))
                                          )
                                      )
                                    )
                           )
                       (set! (-> trackers slot) (if tracker
                                                    (ppointer->handle tracker)
                                                    (the-as handle #f)
                                                    )
                             )
                       (set! (-> groups slot) (-> em index))
                       )
                     )
                   )
                 (when (>= slot 0)
                   (let ((tracker (the-as part-tracker (handle->process (-> trackers slot)))))
                     (when tracker
                       (set! kept (logior kept (ash 1 slot)))
                       (matrix-copy! (-> tracker mat) (-> em mat))
                       (vector-copy! (-> tracker root trans) (-> em mat trans))
                       (set! (-> tracker state-time) (-> tracker clock frame-counter))
                       (+! (-> ps emitters-shown) 1)
                       )
                     )
                   )
                 )
               )
             )
           )
          ;; the gun's laser particles (207-212) take their direction from globals of the machine that
          ;; draws them: the gun's copy draws its laser itself (mp-draw-laser)
          ;; Dark and Light Jak's auras (173, 187, 623): a puppet draws them on its own body
          ;; (mp-puppet-apply-powers); replayed, every launch of a frame came from one place
          ((and (> (-> em count) 0)
                (not (and (>= (-> em index) 207) (<= (-> em index) 212)))
                (not (and (type? proc mp-puppet) (or (= (-> em index) 173) (= (-> em index) 187) (= (-> em index) 623))))
                (mp-launcher-usable? (-> em index) (-> em home))
                (mp-launcher-replayable? (-> *part-id-table* (-> em index)) (the-as process #f))
                )
           (let ((launcher (-> *part-id-table* (-> em index))))
             (dotimes (k (min 4 (-> em count)))
               (if (= (-> em kind) 2)
                   (launch-particles :system *sp-particle-system-3d* launcher (-> em mat) :origin-is-matrix #t)
                   (launch-particles launcher (-> em mat) :origin-is-matrix #t)
                   )
               )
             (+! (-> ps emitters-shown) 1)
             )
           )
          )
        )
      )
    ;; groups the owner stopped: their tracker runs out by itself, its slot is free again
    (dotimes (k MP_FX_TRACKERS)
      (if (not (logtest? kept (ash 1 k)))
          (set! (-> groups k) -1)
          )
      )
    (set! (-> *mp-fx* replaying?) #f)
    )
  (none)
  )

;; MOD multiplayer -- wrap the two ways particles are launched, to note the emitters of the objects
;; the others draw (no-op offline). define-perm keeps the stock code on a REPL reload.
(define-perm *mp-stock-launch-spawn* (function sparticle-launch-control vector object)
  (the-as (function sparticle-launch-control vector object) (method-of-type sparticle-launch-control spawn))
  )

(defmethod spawn ((this sparticle-launch-control) (arg0 vector))
  "Stock behavior; the other players see this group on their copy of its process too."
  (when (mp-online?)
    ;; the stock method starts with the same copy; the origin is then complete for the note
    (vector-copy! (-> this origin trans) arg0)
    (mp-note-emitter (-> this proc) 0 (-> this group) (-> this origin))
    )
  (*mp-stock-launch-spawn* this arg0)
  )

(define-perm *mp-stock-sp-launch-particles-var*
             (function sparticle-system sparticle-launcher matrix sparticle-launch-state sparticle-launch-control float none)
  sp-launch-particles-var
  )

(defun sp-launch-particles-var ((arg0 sparticle-system)
                                (arg1 sparticle-launcher)
                                (arg2 matrix)
                                (arg3 sparticle-launch-state)
                                (arg4 sparticle-launch-control)
                                (arg5 float)
                                )
  "Stock launch; a launch made directly by a process the others draw (not by a launch control,
   noted in spawn) is replayed on their copy."
  (when (and (not arg4) (mp-online?))
    (with-pp
      (mp-note-emitter pp (if (= arg0 *sp-particle-system-3d*) 2 1) arg1 arg2)
      )
    )
  (*mp-stock-sp-launch-particles-var* arg0 arg1 arg2 arg3 arg4 arg5)
  (none)
  )

;; MOD multiplayer -- wrap the sound entry points (engine/sound/gsound.gc) to note the sounds of
;; the objects the others draw (no-op offline).
(define-perm *mp-stock-sound-play-by-name*
             (function sound-name sound-id int int int sound-group object sound-id :behavior process-drawable)
  sound-play-by-name
  )

(defbehavior sound-play-by-name process-drawable ((arg0 sound-name)
                                                  (arg1 sound-id)
                                                  (arg2 int)
                                                  (arg3 int)
                                                  (arg4 int)
                                                  (arg5 sound-group)
                                                  (arg6 object)
                                                  )
  "Stock behavior; the other players hear this sound on their copy of the process too."
  (if (mp-online?)
      (mp-note-sound self arg0 arg1 arg2 arg3 arg4 arg6)
      )
  (*mp-stock-sound-play-by-name* arg0 arg1 arg2 arg3 arg4 arg5 arg6)
  )

(define-perm *mp-stock-sound-play-by-spec* (function sound-spec sound-id vector sound-id :behavior process-drawable)
  sound-play-by-spec
  )

(defbehavior sound-play-by-spec process-drawable ((arg0 sound-spec) (arg1 sound-id) (arg2 vector))
  "Stock behavior; the other players hear this sound on their copy of the process too."
  (if (mp-online?)
      (mp-note-sound self (-> arg0 sound-name) arg1 (-> arg0 volume) (-> arg0 pitch-mod) (-> arg0 bend) arg2)
      )
  (*mp-stock-sound-play-by-spec* arg0 arg1 arg2)
  )

(define-perm *mp-stock-sound-stop* (function sound-id int)
  sound-stop
  )

(defun sound-stop ((arg0 sound-id))
  "Stock behavior; a sound the others hear on a copy stops there too."
  (if (mp-online?)
      (mp-note-sound-stop arg0)
      )
  (*mp-stock-sound-stop* arg0)
  )

;; ------------------------------------------------------------------------------------------------
;; World objects
;; ------------------------------------------------------------------------------------------------

;; Lifts, doors and platforms carry or block the player, so each machine keeps running its own
;; for its own player; they are kept alike instead of copied:
;;   - cyclic objects (moving platforms, wheels, lights...) compute their phase from their
;;     process's clock with sync-info. On a guest, every sync-info method sees the clock shifted by
;;     the host's lead (*mp-clock-sync*, multiplayer.gc), through the object's offset field, put
;;     back after the call: the phase follows the host and no timer of the game moves;
;;   - doors (com-airlock) open for a remote player in front of them as for the local one;
;;   - an elevator trip that starts on one machine (its player rode it) starts on the others, with
;;     the elevator's own 'move-to message.

(defun mp-sync-shift ((this sync-info))
  "Frames to add to the phase of cycle `this` so that it shows the host's (0 offline, on the host,
   before the host's clocks arrived, or for a clock that is not shared)."
  (with-pp
    (let ((cs *mp-clock-sync*)
          (period (the-as int (-> this period)))
          )
      (when (and (-> cs known?) pp (> period 0) (= *mp-mode* (mp-mode client)))
        (let ((clk (-> pp clock)))
          (dotimes (i 22)
            (if (= clk (-> *display* clock i))
                (return (mod (+ (mod (-> cs shift i) period) period) period))
                )
            )
          )
        )
      )
    )
  0
  )

;; MOD multiplayer -- cycle phase of a sync-linear
(define-perm *mp-stock-sync-linear-get-norm!* (function sync-linear int float)
  (the-as (function sync-linear int float) (method-of-type sync-linear get-norm!))
  )

(defmethod get-norm! ((this sync-linear) (arg0 int))
  "Stock method, with the phase shifted to the host's (mp-sync-shift; no-op offline)."
  (let ((shift (mp-sync-shift this)))
    (if (zero? shift)
        (*mp-stock-sync-linear-get-norm!* this arg0)
        (let ((saved (-> this offset)))
          (+! (-> this offset) (the float shift))
          (let ((result (*mp-stock-sync-linear-get-norm!* this arg0)))
            (set! (-> this offset) saved)
            result
            )
          )
        )
    )
  )

;; MOD multiplayer -- cycle phase of a sync-eased
(define-perm *mp-stock-sync-eased-get-norm!* (function sync-eased int float)
  (the-as (function sync-eased int float) (method-of-type sync-eased get-norm!))
  )

(defmethod get-norm! ((this sync-eased) (arg0 int))
  "Stock method, with the phase shifted to the host's (mp-sync-shift; no-op offline)."
  (let ((shift (mp-sync-shift this)))
    (if (zero? shift)
        (*mp-stock-sync-eased-get-norm!* this arg0)
        (let ((saved (-> this offset)))
          (+! (-> this offset) (the float shift))
          (let ((result (*mp-stock-sync-eased-get-norm!* this arg0)))
            (set! (-> this offset) saved)
            result
            )
          )
        )
    )
  )

;; MOD multiplayer -- cycle phase of a sync-paused
(define-perm *mp-stock-sync-paused-get-norm!* (function sync-paused int float)
  (the-as (function sync-paused int float) (method-of-type sync-paused get-norm!))
  )

(defmethod get-norm! ((this sync-paused) (arg0 int))
  "Stock method, with the phase shifted to the host's (mp-sync-shift; no-op offline)."
  (let ((shift (mp-sync-shift this)))
    (if (zero? shift)
        (*mp-stock-sync-paused-get-norm!* this arg0)
        (let ((saved (-> this offset)))
          (+! (-> this offset) (the float shift))
          (let ((result (*mp-stock-sync-paused-get-norm!* this arg0)))
            (set! (-> this offset) saved)
            result
            )
          )
        )
    )
  )

;; MOD multiplayer -- time until the next cycle
(define-perm *mp-stock-sync-get-timeframe-offset!* (function sync-info time-frame time-frame)
  (the-as (function sync-info time-frame time-frame) (method-of-type sync-info get-timeframe-offset!))
  )

(defmethod get-timeframe-offset! ((this sync-info) (arg0 time-frame))
  "Stock method, with the phase shifted to the host's (mp-sync-shift; no-op offline)."
  (let ((shift (mp-sync-shift this)))
    (if (zero? shift)
        (*mp-stock-sync-get-timeframe-offset!* this arg0)
        (let ((saved (-> this offset)))
          (+! (-> this offset) (the float shift))
          (let ((result (*mp-stock-sync-get-timeframe-offset!* this arg0)))
            (set! (-> this offset) saved)
            result
            )
          )
        )
    )
  )

;; MOD multiplayer -- raw cycle phase
(define-perm *mp-stock-sync-get-current-phase-no-mod* (function sync-info float)
  (the-as (function sync-info float) (method-of-type sync-info get-current-phase-no-mod))
  )

(defmethod get-current-phase-no-mod ((this sync-info))
  "Stock method, with the phase shifted to the host's (mp-sync-shift; no-op offline)."
  (let ((shift (mp-sync-shift this)))
    (if (zero? shift)
        (*mp-stock-sync-get-current-phase-no-mod* this)
        (let ((saved (-> this offset)))
          (+! (-> this offset) (the float shift))
          (let ((result (*mp-stock-sync-get-current-phase-no-mod* this)))
            (set! (-> this offset) saved)
            result
            )
          )
        )
    )
  )

;; MOD multiplayer -- "start the cycle at this phase now"
(define-perm *mp-stock-sync-now!* (function sync-info float none)
  (the-as (function sync-info float none) (method-of-type sync-info sync-now!))
  )

(defmethod sync-now! ((this sync-info) (arg0 float))
  "Stock method; the offset it sets is taken back by the shift the other methods add, so the cycle
   still starts at `arg0` now."
  (*mp-stock-sync-now!* this arg0)
  (let ((shift (mp-sync-shift this)))
    (if (nonzero? shift)
        (set! (-> this offset) (- (-> this offset) (the float shift)))
        )
    )
  (none)
  )

(defun mp-remote-wants-airlock? ((this com-airlock))
  "#t when a remote player stands where the local player would open door `this`: in front of it,
   within its distances and heights, the door allowed to open (its script test, the airlock
   setting, no close command)."
  (let ((cmd (airlock-command-lookup (the-as pair (-> this name)))))
    (when (and (< (-> this latch-closed-time) (current-time))
               (!= cmd 'close)
               (-> *setting-control* user-current airlock)
               )
      (dotimes (i MP_MAX_PLAYERS)
        (let ((st (mp-remote-state i)))
          (when (and st (not (logtest? (-> st flags) (mp-flag hidden))))
            (let* ((pos (-> st trans))
                   (cross (check-crossing-distance this pos #t))
                   (dist (vector-vector-xz-distance (-> this root trans) pos))
                   )
              (if (and (< dist (if (>= cross 0.0)
                                   (-> this active-distance 0)
                                   (-> this active-distance 1)
                                   )
                          )
                       (< cross (-> this open-distance 0))
                       (or (not (-> this y-height))
                           (and (>= (-> pos y) (- (-> this root trans y) (-> this y-height y)))
                                (< (-> pos y) (+ (-> this root trans y) (-> this y-height x)))
                                )
                           )
                       (script-eval (-> this open-test))
                       )
                  (return #t)
                  )
              )
            )
          )
        )
      )
    )
  #f
  )

;; MOD multiplayer -- doors open for every player (engine/common-obs/airlock.gc)
(define-perm *mp-stock-want-cross-airlock?* (function com-airlock object)
  (the-as (function com-airlock object) (method-of-type com-airlock want-cross-airlock?))
  )

(defmethod want-cross-airlock? ((this com-airlock))
  "Stock decision for the local player; online, a remote player in front of the door opens it too,
   so the doors are the same on every machine."
  (or (*mp-stock-want-cross-airlock?* this) (and (mp-online?) (mp-remote-wants-airlock? this)))
  )

;; Floating platforms (rigid-body-platform, level code of the volcano) take the weight of whoever
;; stands on them from the 'ridden message their collision gets from a rider. A remote player
;; standing on one here sends it the same message from its puppet, with the target mask the
;; handler looks for set for the duration of the call.
(deftype mp-rider-state (structure)
  ((typ     type)   ;; rigid-body-platform once its level is loaded, else #f
   (sent    int32)  ;; counter for the test log
   )
  )

(define *mp-riders* (new 'global 'mp-rider-state))

(defun mp-push-remote-riders ((proc process-tree))
  "iterate-process-tree callback: a floating platform under a remote player gets its weight."
  (when (and (type? proc (-> *mp-riders* typ)) (nonzero? (-> (the-as process-drawable proc) root)))
    (let* ((plat (the-as process-drawable proc))
           (sphere (-> (the-as collide-shape (-> plat root)) root-prim prim-core world-sphere))
           (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
           )
      (when manager
        (dotimes (i MP_MAX_PLAYERS)
          (let ((st (mp-remote-state i))
                (puppet (the-as process-focusable (handle->process (-> manager puppets i))))
                )
            (when (and st
                       puppet
                       (not (logtest? (-> st flags) (mp-flag hidden driving riding)))
                       (< (vector-vector-xz-distance (-> st trans) sphere) (-> sphere w))
                       (< (- (-> plat root trans y) (meters 1)) (-> st trans y))
                       (< (-> st trans y) (+ (-> plat root trans y) (meters 3)))
                       )
              (let ((rider (new 'stack-no-clear 'collide-rider))
                    (had-mask? (logtest? (-> puppet mask) (process-mask target)))
                    )
                (set! (-> rider rider-handle) (process->handle puppet))
                (set! (-> rider sticky-prim) #f)
                (logior! (-> puppet mask) (process-mask target))
                (send-event plat 'ridden rider)
                (if (not had-mask?)
                    (logclear! (-> puppet mask) (process-mask target))
                    )
                (+! (-> *mp-riders* sent) 1)
                )
              )
            )
          )
        )
      )
    )
  #f
  )

(defun mp-update-remote-riders ()
  "Every frame: floating platforms under remote players get their weight (when such platforms exist)."
  (let ((typ (-> (the-as symbol 'rigid-body-platform) value)))
    (set! (-> *mp-riders* typ) (if (and typ (nonzero? typ) (type? typ type))
                                   (the-as type typ)
                                   (the-as type #f)
                                   )
          )
    (if (-> *mp-riders* typ)
        (iterate-process-tree *active-pool* (the-as (function object object) mp-push-remote-riders) *null-kernel-context*)
        )
    )
  (none)
  )

(defun mp-elevator-slot ((aid uint))
  "Entry of elevator `aid` in the elevator table (added when new), -1 when the table is full."
  (let ((ws *mp-world-state*))
    (dotimes (i (-> ws elev-count))
      (if (= (-> ws elev-aid i) aid)
          (return i)
          )
      )
    (when (< (-> ws elev-count) 64)
      (let ((i (-> ws elev-count)))
        (set! (-> ws elev-aid i) aid)
        (set! (-> ws elev-trip i) #f)
        (set! (-> ws elev-muted i) #f)
        (set! (-> ws elev-local i) #f)
        (set! (-> ws elev-driven i) 0)
        (+! (-> ws elev-count) 1)
        (return i)
        )
      )
    )
  -1
  )

;; An elevator's scripts (entity res: on-activate, on-deactivate...) load levels, change the
;; continue point, the camera and the player's settings, and some guard them with player-ridden?
;; while others do not: Spargus' palace elevator runs (want-vis 'waspala) (want-continue
;; "waspala-start") on arrival. A trip started on another player's word runs them on a machine whose
;; player is elsewhere: its levels and continue point change under it (too many levels loading, a
;; crash). While the local player is not on it, such a trip runs without them.

(defun mp-elevator-mute ((elev elevator) (slot int))
  "Set aside the scripts of `elev` (table entry `slot`) for a trip of another player."
  (let ((ws *mp-world-state*)
        (k (* slot 7))
        )
    (when (not (-> ws elev-muted slot))
      (set! (-> ws elev-scripts (+ k 0)) (-> elev on-activate))
      (set! (-> ws elev-scripts (+ k 1)) (-> elev on-deactivate))
      (set! (-> ws elev-scripts (+ k 2)) (-> elev on-up))
      (set! (-> ws elev-scripts (+ k 3)) (-> elev on-down))
      (set! (-> ws elev-scripts (+ k 4)) (-> elev on-running))
      (set! (-> ws elev-scripts (+ k 5)) (-> elev on-notice))
      (set! (-> ws elev-scripts (+ k 6)) (-> elev on-wait))
      (set! (-> elev on-activate) #f)
      (set! (-> elev on-deactivate) #f)
      (set! (-> elev on-up) #f)
      (set! (-> elev on-down) #f)
      (set! (-> elev on-running) #f)
      (set! (-> elev on-notice) #f)
      (set! (-> elev on-wait) #f)
      (set! (-> ws elev-muted slot) #t)
      )
    )
  (none)
  )

(defun mp-elevator-unmute ((elev elevator) (slot int))
  "Give `elev` its scripts back."
  (let ((ws *mp-world-state*)
        (k (* slot 7))
        )
    (when (-> ws elev-muted slot)
      (set! (-> elev on-activate) (-> ws elev-scripts (+ k 0)))
      (set! (-> elev on-deactivate) (-> ws elev-scripts (+ k 1)))
      (set! (-> elev on-up) (-> ws elev-scripts (+ k 2)))
      (set! (-> elev on-down) (-> ws elev-scripts (+ k 3)))
      (set! (-> elev on-running) (-> ws elev-scripts (+ k 4)))
      (set! (-> elev on-notice) (-> ws elev-scripts (+ k 5)))
      (set! (-> elev on-wait) (-> ws elev-scripts (+ k 6)))
      (set! (-> ws elev-muted slot) #f)
      )
    )
  (none)
  )

(defun mp-elevators-unmute ((all? symbol))
  "Each frame: a trip driven by another player's states arrives once they stop (theirs arrived);
   an elevator whose scripts are set aside gets them back once the trip is over (it waits at a stop)
   or our player rides it; every one with `all?` (the session ended)."
  (let ((ws *mp-world-state*))
    (dotimes (slot (-> ws elev-count))
      (when (or (-> ws elev-muted slot) (nonzero? (-> ws elev-driven slot)))
        (let* ((ent (entity-by-aid (-> ws elev-aid slot)))
               (proc (if ent
                         (-> (the-as entity-actor ent) extra process)
                         )
                     )
               )
          (cond
            ((not (and proc (type? proc elevator)))
             ;; gone: a new one reads its scripts from its entity again
             (set! (-> ws elev-muted slot) #f)
             (set! (-> ws elev-driven slot) 0)
             )
            (else
              (when (and (nonzero? (-> ws elev-driven slot))
                         (or all? (time-elapsed? (-> ws elev-driven slot) (seconds 0.3)))
                         )
                (set! (-> ws elev-driven slot) 0)
                (if (and (-> proc next-state) (= (-> proc next-state name) 'running))
                    (set! (-> (the-as elevator proc) path-pos) 1.0)
                    )
                )
              (if (and (-> ws elev-muted slot)
                       (or all?
                           (and (-> proc next-state) (= (-> proc next-state name) 'waiting))
                           (< (- (current-time) (-> (the-as elevator proc) sticky-player-last-ride-time)) (seconds 0.5))
                           )
                       )
                  (mp-elevator-unmute (the-as elevator proc) slot)
                  )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-add-elevator ((elev elevator))
  "Add the place of `elev` on its trip to the batch (a world entry, anim-index 1): stops in
   trans w and seg-mask, how far along in anim-frame (interpolated by the runtime like an
   animation frame)."
  (when (< *mp-collect-count* MP_MAX_ACTORS)
    (let ((st (-> *mp-actors-out* state *mp-collect-count*)))
      (vector-copy! (-> st trans) (-> elev root trans))
      (set! (-> st trans w) (-> elev move-pos 0))
      (quaternion-copy! (-> st quat) (-> elev root quat))
      (set! (-> st id) (-> elev entity aid))
      (set! (-> st anim-index) 1)
      (set! (-> st anim-frame) (-> elev path-pos))
      (set! (-> st flags) (mp-actor-flag world))
      (set! (-> st seg-mask) (the-as uint (-> elev move-pos 1)))
      (set! (-> st skel 0) (the-as uint 0))
      (set! (-> *mp-pose* obj *mp-collect-count*) (process->handle elev))
      (+! *mp-collect-count* 1)
      )
    )
  (none)
  )

(defun mp-drive-elevator ((st mp-actor-state))
  "Another player's elevator trip (mp-add-elevator): ours starts the same trip, without its scripts
   unless our player is on it, and is placed where theirs is, every frame. Its own post no longer
   moves it (waiting-to-ascend cleared): its platform, and whoever stands on it, follow theirs."
  (let ((ent (entity-by-aid (logand (-> st id) #xffffff))))
    (when ent
      (let ((proc (-> (the-as entity-actor ent) extra process))
            (ws *mp-world-state*)
            )
        (when (and proc (type? proc elevator) (nonzero? (-> (the-as elevator proc) path)))
          (let ((elev (the-as elevator proc))
                (slot (mp-elevator-slot (logand (-> st id) #xffffff)))
                (from (-> st trans w))
                (to (the-as float (-> st seg-mask)))
                )
            (when (and (>= slot 0) (not (-> ws elev-local slot)))
              ;; the trip starts here as there
              (when (and (-> proc next-state)
                         (or (= (-> proc next-state name) 'waiting) (= (-> proc next-state name) 'arrived))
                         (!= to (-> elev move-pos 1))
                         )
                (set! (-> ws elev-trip slot) #t)
                (if (not (send-event proc 'query 'player-standing-on?))
                    (mp-elevator-mute elev slot)
                    )
                ;; waiting, it pauses out of view (actor-pause): its trip would never start
                (logclear! (-> proc mask) (process-mask actor-pause))
                (send-event proc 'move-to to)
                (+! (-> ws elevator-trips-shown) 1)
                )
              (when (and (-> proc next-state) (= (-> proc next-state name) 'running))
                (set! (-> ws elev-driven slot) (current-time))
                (+! (-> ws elevator-states) 1)
                (logclear! (-> elev elevator-status) (elevator-status waiting-to-ascend))
                (set! (-> elev move-pos 0) from)
                (set! (-> elev move-pos 1) to)
                (set! (-> elev path-pos) (fmax 0.0 (fmin 1.0 (-> st anim-frame))))
                (get-point-in-path!
                  (-> elev path)
                  (-> elev basetrans)
                  (+ from (* (ease-value-in-out (-> elev path-pos) 0.08) (- to from)))
                  'interp
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-poll-elevator ((proc process))
  "iterate-process-tree callback: an elevator near a player that started a trip here, not on
   another player's word, is announced to the others."
  (when (and (type? proc elevator) (-> proc entity) (mp-near-a-player? (-> (the-as elevator proc) root trans)))
    (let* ((elev (the-as elevator proc))
           (slot (mp-elevator-slot (-> proc entity aid)))
           (running? (and (-> proc next-state) (= (-> proc next-state name) 'running)))
           )
      (when (>= slot 0)
        (cond
          ((not running?)
           (set! (-> *mp-world-state* elev-trip slot) #f)
           (set! (-> *mp-world-state* elev-local slot) #f)
           )
          ((not (-> *mp-world-state* elev-trip slot))
           (set! (-> *mp-world-state* elev-trip slot) #t)
           (set! (-> *mp-world-state* elev-local slot) #t)
           (mp-send-event (mp-event-kind elevator) -1 (the-as int (-> proc entity aid)) (-> elev move-pos 1))
           (+! (-> *mp-world-state* elevator-trips-sent) 1)
           )
          )
        ;; one elevator for everyone: the trip's place goes in the batch, the others put theirs there
        (if (and running? (-> *mp-world-state* elev-local slot))
            (mp-add-elevator elev)
            )
        )
      )
    )
  #f
  )

(defun mp-apply-elevator ((ev mp-event))
  "Another player's elevator started a trip: start the same trip here, when ours waits at a stop
   (its 'move-to message takes the top or the bottom)."
  (let ((ent (entity-by-aid (the-as uint (-> ev iarg 0)))))
    (when ent
      (let ((proc (-> (the-as entity-actor ent) extra process)))
        (when (and proc (type? proc elevator))
          (let ((elev (the-as elevator proc))
                (slot (mp-elevator-slot (the-as uint (-> ev iarg 0))))
                (target (-> ev fvec x))
                )
            (when (and (-> proc next-state)
                       (or (= (-> proc next-state name) 'waiting) (= (-> proc next-state name) 'arrived))
                       (!= target (-> elev move-pos 1))
                       )
              ;; noted first: the trip it starts is the other player's, not to be sent back; without
              ;; its scripts unless our player stands on it
              (when (>= slot 0)
                (set! (-> *mp-world-state* elev-trip slot) #t)
                (if (not (send-event proc 'query 'player-standing-on?))
                    (mp-elevator-mute elev slot)
                    )
                )
              ;; waiting, it pauses out of view (actor-pause): its trip would never start
              (logclear! (-> proc mask) (process-mask actor-pause))
              (cond
                ((= target (-> elev bottom-top 1))
                 (send-event proc 'move-to 'top)
                 (+! (-> *mp-world-state* elevator-trips-shown) 1)
                 )
                ((= target (-> elev bottom-top 0))
                 (send-event proc 'move-to 'bottom)
                 (+! (-> *mp-world-state* elevator-trips-shown) 1)
                 )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Levels leaving
;; ------------------------------------------------------------------------------------------------

;; A level that leaves kills its entities and their effects (deactivate, engine/level/level.gc),
;; then its memory is reused. What this mod made from it outlives that: the copies drawn with its
;; art, part-trackers on copies playing its particle groups, the skeleton cache. They go first.

(deftype mp-leaving-state (structure)
  ((base  uint32)       ;; heap of the leaving level
   (top   uint32)
   (count int32)        ;; part-trackers to kill once the process tree walk is over
   (kill  handle 128)
   )
  )

(define *mp-leaving* (new 'global 'mp-leaving-state))

(defun mp-find-leaving-tracker ((proc process-tree))
  "iterate-process-tree callback: note a part-tracker playing a group of the leaving level."
  (let ((lv *mp-leaving*))
    (when (and (type? proc part-tracker) (nonzero? (-> (the-as part-tracker proc) part)) (< (-> lv count) 128))
      (let ((group (the-as uint (-> (the-as part-tracker proc) part group))))
        (when (and (>= group (-> lv base)) (< group (-> lv top)))
          (set! (-> lv kill (-> lv count)) (process->handle (the-as process proc)))
          (+! (-> lv count) 1)
          )
        )
      )
    )
  #f
  )

(defun mp-on-level-leaving ((lev level))
  "Level `lev` is going away: remove the copies drawn with its art, the part-trackers playing its
   particle groups, and forget the skeletons found in it."
  (let ((ws *mp-world-state*)
        (i 0)
        )
    (while (< i (-> ws replica-count))
      (let ((proc (the-as mp-replica (handle->process (-> ws replica i)))))
        (if (and proc (= (-> proc level) lev))
            (mp-replica-remove i)
            (+! i 1)
            )
        )
      )
    (set! (-> ws skel-count) 0)
    )
  (dotimes (k 16)
    (set! (-> *mp-pose* part-ptr k) #f)
    )
  (let ((lv *mp-leaving*))
    (set! (-> lv base) (the-as uint (-> lev heap base)))
    (set! (-> lv top) (the-as uint (-> lev heap top-base)))
    (set! (-> lv count) 0)
    (iterate-process-tree *active-pool* (the-as (function object object) mp-find-leaving-tracker) *null-kernel-context*)
    (dotimes (k (-> lv count))
      (let ((proc (handle->process (-> lv kill k))))
        (if proc
            (deactivate proc)
            )
        )
      )
    )
  (none)
  )

(define-extern mp-far-leaving (function level none)) ;; Distant players' levels, below

;; MOD multiplayer -- clean up before a level goes away (engine/level/level.gc)
(define-perm *mp-stock-level-deactivate* (function level level)
  (the-as (function level level) (method-of-type level deactivate))
  )

(defmethod deactivate ((this level))
  "What this mod made from the level goes first (always: copies can remain after a session), then
   the stock deactivation. unload! calls it too, also for a level only loaded (not active), whose
   art and particle groups copies may use as well."
  (when (!= (-> this status) 'inactive)
    (mp-on-level-leaving this)
    (mp-far-leaving this)
    )
  (*mp-stock-level-deactivate* this)
  )

;; ------------------------------------------------------------------------------------------------
;; Art of distant players' objects
;; ------------------------------------------------------------------------------------------------

;; A copy runs none of its object's code: it needs the skeleton-group (ours, or rebuilt from the
;; description its sender sends, below) and the art group. The art group of an object no level of
;; ours holds (a distant player's guards, cars, boats) is loaded alone by name (loado,
;; out/jak3/obj/<name>-ag.go: data, no code) into the art heap, and listed in the art directory of
;; the level whose memory holds that heap, where initialize-skeleton looks for it. The renderer
;; keeps the data of the level its model comes from (pc-mp-render-level), which the sender names
;; (art-level event). Only for objects within MP_ART_RANGE of our player: nobody here sees farther
;; ones.
;;
;; The art heap is carved from the free top of the heap of one of our active levels (its host), like
;; the game's borrow heaps, below 256 MB: adgif shader links keep an address in 24 bits of
;; address/16 (shader-ptr, engine/gfx/texture/texture-h.gc), a texture above it breaks the links (a
;; crash when the level unloads, seen in testing). It goes when its host level leaves or the session
;; ends.
;;
;; The levels of another place are never loaded here: their code would link into the running game,
;; and a level's top-level code resets our globals (Haven's traffic-manager.gc runs
;; (define *traffic-engine* #f): Spargus' traffic then crashed a guest in testing).

(defconstant MP_FAR_LIMIT #x10000000)          ;; shader links reach 256 MB
(defconstant MP_FAR_MARGIN (* 4 1024 1024))    ;; left free above what the host uses
(defconstant MP_ART_HEAP_MAX (* 32 1024 1024)) ;; art heap size when the host has room
(defconstant MP_ART_HEAP_MIN (* 8 1024 1024))
(defconstant MP_ART_RANGE (meters 400))        ;; copies farther from our player get no art

(deftype mp-far-state (structure)
  ((host      level)          ;; the level whose heap top holds the art heap, or #f
   (host-top  pointer)        ;; top and top-base of the host heap before
   (host-base pointer)
   (heap      kheap :inline)  ;; the art heap
   (text      string)         ;; a name read from an event
   (opened    int32)          ;; counters for the test log
   (closed    int32)
   (restored  int32)          ;; table entries the sandbox put back after an art load
   )
  )

(define *mp-far-enabled* #t) ;; test switch (far-levels): load the art of distant players' objects
(define *mp-art-range* MP_ART_RANGE) ;; test switch (art-range): how far from our player art loads

(define *mp-far* (new 'global 'mp-far-state))
(set! (-> *mp-far* text) (new 'global 'string 32 (the-as string #f)))
(set! (-> *mp-far* host) #f)

(defun mp-far-room ((host level))
  "Free bytes at the top of the heap of `host` below 256 MB."
  (- (min (the-as int (-> host heap top)) MP_FAR_LIMIT) (the-as int (-> host heap current)))
  )

(defun mp-far-host ((size int))
  "Our active level (not a borrow level) with the most free memory below 256 MB, when that holds
   `size` bytes and a margin; or #f."
  (let ((best (the-as level #f))
        (best-room 0)
        )
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (and (= (-> lev status) 'active) (not (-> lev borrow-from-level)))
          (let ((room (mp-far-room lev)))
            (when (and (> room best-room) (>= room (+ size MP_FAR_MARGIN)))
              (set! best lev)
              (set! best-room room)
              )
            )
          )
        )
      )
    best
    )
  )

(defun mp-art-ours? ((ptr object))
  "#t when `ptr` points into the art heap."
  (and (-> *mp-far* host)
       (>= (the-as uint ptr) (the-as uint (-> *mp-far* heap base)))
       (< (the-as uint ptr) (the-as uint (-> *mp-far* heap top-base)))
       )
  )

(defun mp-far-sandbox-begin ()
  "Note the global tables an art load may take (pc-mp-sandbox-*): particle, lightning and texture
   page entries."
  (pc-mp-sandbox-begin)
  (pc-mp-sandbox-watch (the-as pointer (&-> *part-id-table* data 0)) (-> *part-id-table* length) 4)
  (pc-mp-sandbox-watch (the-as pointer (&-> *part-group-id-table* data 0)) (-> *part-group-id-table* length) 4)
  (pc-mp-sandbox-watch
    (the-as pointer (&-> *lightning-spec-id-table* data 0))
    (-> *lightning-spec-id-table* length)
    4
    )
  (pc-mp-sandbox-watch
    (the-as pointer (&-> *texture-page-dir* entries 0 page))
    (-> *texture-page-dir* length)
    (&- (the-as pointer (-> *texture-page-dir* entries 1)) (the-as uint (-> *texture-page-dir* entries 0)))
    )
  (none)
  )

(defun mp-far-unlink-textures ((lo uint) (hi uint))
  "The far level leaves (its memory is [lo, hi)): no list of the texture page dir may keep one of its
   shaders or a link array in its memory. Link arrays are allocated in the loading level's heap
   (link-texture-by-id), and unlink-shaders-in-heap walks the pages loaded only: the list of a page
   it used without loading it would keep pointing at its memory, which the next level loaded there
   overwrites (a shader list looping forever in testing)."
  (let ((dir *texture-page-dir*))
    (dotimes (i (-> dir length))
      (let* ((e (-> dir entries i))
             (link (the-as uint (-> e link)))
             )
        ;; a page loaded in its memory (an art group loaded alone logs its pages in there)
        (if (and (-> e page) (>= (the-as uint (-> e page)) lo) (< (the-as uint (-> e page)) hi))
            (set! (-> e page) #f)
            )
        (cond
          ((or (not (-> e link)) (zero? link))
           )
          ((and (>= link lo) (< link hi))
           (set! (-> e link) #f)
           )
          (else
            (dotimes (k (-> e length))
              (let ((prev (the-as adgif-shader #f))
                    (node (* (-> e link next k shader) 16))
                    (steps 0)
                    )
                ;; bounded: a broken list must not hang nor read the protected low memory
                (while (and (>= node (the-as uint #x84000)) (< steps 4096))
                  (+! steps 1)
                  (let ((next (* (-> (the-as adgif-shader node) next shader) 16)))
                    (cond
                      ((and (>= node lo) (< node hi))
                       (if prev
                           (set! (-> prev next shader) (shr next 4))
                           (set! (-> e link next k shader) (shr next 4))
                           )
                       )
                      (else
                        (set! prev (the-as adgif-shader node))
                        )
                      )
                    (set! node next)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(deftype mp-art-table (structure)
  ((count       int32)
   (skel        symbol 160) ;; skeleton name, interned
   (level       symbol 160) ;; the level whose art array holds its art group
   (sent        symbol 160)
   (time        time-frame)
   (tried       symbol 32)  ;; receiver: art groups loaded or tried in this art heap
   (tried-count int32)
   (fetch-time  time-frame)
   (loaded      int32)      ;; counters for the test log
   (failed      int32)
   )
  )

(define *mp-art-out* (new 'global 'mp-art-table))
(define *mp-art-in* (new 'global 'mp-art-table))

(defun mp-level-of-art ((ag art-group))
  "The loaded level whose art array holds `ag`, or #f (#f for the art heap's: not our place's)."
  (if (mp-art-ours? ag)
      (return (the-as level #f))
      )
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (when (!= (-> lev status) 'inactive)
        (let ((arr (-> lev art-group art-group-array)))
          (dotimes (k (-> arr length))
            (if (= (-> arr k) ag)
                (return lev)
                )
            )
          )
        )
      )
    )
  (the-as level #f)
  )

(defun mp-note-art ((sg skeleton-group) (proc process-drawable))
  "Sender: note the level holding the art of skeleton `sg` (sent by mp-send-art), once per skeleton."
  (let ((tbl *mp-art-out*)
        (name (string->symbol (-> sg name)))
        )
    (dotimes (i (-> tbl count))
      (if (= (-> tbl skel i) name)
          (return 0)
          )
      )
    (when (< (-> tbl count) 160)
      (let ((lev (mp-level-of-art (-> proc draw art-group))))
        (when lev
          (set! (-> tbl skel (-> tbl count)) name)
          (set! (-> tbl level (-> tbl count)) (-> lev name))
          (set! (-> tbl sent (-> tbl count)) #f)
          (+! (-> tbl count) 1)
          )
        )
      )
    )
  (none)
  )

(defun mp-note-all-kinds ()
  "Note every skeleton-group of the levels of our place (not the art heap's) for mp-send-art: the
   others then know every kind of object this place can send, not only those sent so far."
  (let ((tbl *mp-art-out*))
    (dotimes (i (-> *level* length))
      (let ((lev (-> *level* level i)))
        (when (or (= (-> lev status) 'loaded) (= (-> lev status) 'alive) (= (-> lev status) 'active))
          (let ((arr (-> lev art-group art-group-array)))
            (dotimes (k (-> arr length))
              (let ((sg (-> arr k)))
                ;; a kind whose art is loaded here: one this place can show (a skeleton-group whose art
                ;; the game never ships, defined in code all the same, is not one)
                (when (and sg
                           (type? sg skeleton-group)
                           (not (mp-art-ours? sg))
                           (< (-> tbl count) 160)
                           (mp-art-group-get (-> (the-as skeleton-group sg) art-group-name) (the-as (pointer level) #f))
                           )
                  (let ((name (string->symbol (-> sg name)))
                        (known? #f)
                        )
                    (dotimes (j (-> tbl count))
                      (if (= (-> tbl skel j) name)
                          (set! known? #t)
                          )
                      )
                    (when (not known?)
                      (set! (-> tbl skel (-> tbl count)) name)
                      ;; its art group's level (a borrow level may hold the art of its host's group)
                      (let* ((ag (mp-art-group-get (-> (the-as skeleton-group sg) art-group-name) (the-as (pointer level) #f)))
                             (art-lev (if ag
                                          (mp-level-of-art ag)
                                          )
                                      )
                             )
                        (set! (-> tbl level (-> tbl count)) (if art-lev
                                                                (-> art-lev name)
                                                                (-> lev name)
                                                                )
                              )
                        )
                      (set! (-> tbl sent (-> tbl count)) #f)
                      (+! (-> tbl count) 1)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-send-art ()
  "Sender: the levels of the skeletons noted and not sent yet, and all of them every 10 seconds for
   players who join (art-level event)."
  (let ((tbl *mp-art-out*))
    (when (time-elapsed? (-> tbl time) (seconds 10))
      (set-time! (-> tbl time))
      (dotimes (i (-> tbl count))
        (set! (-> tbl sent i) #f)
        )
      )
    (let ((ev (new 'stack 'mp-event))
          (n 0)
          )
      (dotimes (i (-> tbl count))
        (when (and (not (-> tbl sent i)) (< n 4))
          (set! (-> tbl sent i) #t)
          (+! n 1)
          (set! (-> ev kind) (mp-event-kind art-level))
          (set! (-> ev to) -1)
          (copyn-charp<-string (-> ev text) (symbol->string (-> tbl skel i)) 32)
          (dotimes (k 4)
            (set! (-> ev iarg k) 0)
            )
          (copyn-charp<-string (the-as (pointer uint8) (&-> ev iarg 0)) (symbol->string (-> tbl level i)) 16)
          (pc-mp-send-event ev)
          ;; the group is looked up again: the level that held it may have gone since it was noted
          ;; (its memory reused)
          (let ((sg (the-as skeleton-group (mp-art-group-get (symbol->string (-> tbl skel i)) (the-as (pointer level) #f)))))
            (if (and sg (type? sg skeleton-group))
                (mp-send-skel-def sg)
                )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-apply-art-level ((ev mp-event))
  "Receiver: skeleton (text) has its art in level (iarg bytes) on the sender's side."
  (let ((tbl *mp-art-in*))
    (string<-charp (-> *mp-far* text) (-> ev text))
    (let ((skel (string->symbol (-> *mp-far* text))))
      (string<-charp (-> *mp-far* text) (the-as (pointer uint8) (&-> ev iarg 0)))
      (let ((lvl (string->symbol (-> *mp-far* text)))
            (slot -1)
            )
        (dotimes (i (-> tbl count))
          (if (= (-> tbl skel i) skel)
              (set! slot i)
              )
          )
        (when (and (< slot 0) (< (-> tbl count) 160))
          (set! slot (-> tbl count))
          (+! (-> tbl count) 1)
          )
        (when (>= slot 0)
          (set! (-> tbl skel slot) skel)
          (set! (-> tbl level slot) lvl)
          )
        )
      )
    )
  (none)
  )

(defun mp-art-heap-open ()
  "Carve the art heap from the free top of a host level (mp-far-host). The host when there is one."
  (when (not (-> *mp-far* host))
    (let ((host (mp-far-host MP_ART_HEAP_MIN)))
      (when host
        (let* ((top (logand (min (the-as int (-> host heap top)) MP_FAR_LIMIT) -64))
               (size (min MP_ART_HEAP_MAX (- (mp-far-room host) MP_FAR_MARGIN)))
               (heap (-> *mp-far* heap))
               )
          (set! (-> heap base) (the-as pointer (logand (- top size) -64)))
          (set! (-> heap current) (-> heap base))
          (set! (-> heap top-base) (the-as pointer top))
          (set! (-> heap top) (-> heap top-base))
          (set! (-> *mp-far* host) host)
          ;; the host heap ends below it, as for the game's borrow heaps (level-update-after-load): an
          ;; address is found in one level only (get-level-by-heap-ptr-and-status, art login)
          (set! (-> *mp-far* host-top) (-> host heap top))
          (set! (-> *mp-far* host-base) (-> host heap top-base))
          (set! (-> host heap top-base) (-> heap base))
          (set! (-> host heap top) (-> heap base))
          (+! (-> *mp-far* opened) 1)
          (format
            0
            "[multiplayer] art heap for distant players' objects in the heap of ~A (#x~X-#x~X)~%"
            (-> host name)
            (-> heap base)
            (-> heap top-base)
            )
          )
        )
      )
    )
  (-> *mp-far* host)
  )

(defun mp-art-heap-close ()
  "The art heap goes: the copies drawn from its art, the texture pages and links in it, its art in
   the host's directory, the renderer data kept for it; the host gets its memory back."
  (let ((host (-> *mp-far* host)))
    (when host
      (let ((ws *mp-world-state*)
            (i 0)
            )
        (while (< i (-> ws replica-count))
          (let ((proc (the-as mp-replica (handle->process (-> ws replica i)))))
            (if (and proc (nonzero? (-> proc draw)) (mp-art-ours? (-> proc draw art-group)))
                (mp-replica-remove i)
                (+! i 1)
                )
            )
          )
        (set! (-> ws skel-count) 0)
        )
      (mp-far-unlink-textures (the-as uint (-> *mp-far* heap base)) (the-as uint (-> *mp-far* heap top-base)))
      ;; its art groups were appended last to the host's directory
      (let* ((dir (-> host art-group))
             (arr (-> dir art-group-array))
             )
        (while (and (> (-> arr length) 0) (mp-art-ours? (-> arr (+ (-> arr length) -1))))
          (+! (-> arr length) -1)
          (+! (-> dir string-array length) -1)
          )
        )
      (pc-mp-render-level "" #f)
      (set! (-> host heap top-base) (-> *mp-far* host-base))
      (set! (-> host heap top) (-> *mp-far* host-top))
      (set! (-> *mp-far* host) #f)
      (set! (-> *mp-art-in* tried-count) 0)
      (+! (-> *mp-far* closed) 1)
      (format 0 "[multiplayer] art heap for distant players' objects closed~%")
      )
    )
  (none)
  )

(defun mp-far-leaving ((lev level))
  "Level `lev` unloads (deactivate, called first by unload!): when its heap holds the art heap, that
   goes first."
  (if (= lev (-> *mp-far* host))
      (mp-art-heap-close)
      )
  (none)
  )

(defun mp-far-load-art ((name string))
  "Load art group `name` alone into the art heap and list it in the host's art directory. Its load
   may log texture pages and particle entries: the sandbox puts back the entries it changed
   (loading-level points at the art heap for the links). #t when loaded."
  (let* ((host (-> *mp-far* host))
         (heap (-> *mp-far* heap))
         (dir (-> host art-group))
         (arr (-> dir art-group-array))
         (size (pc-mp-art-file-size name))
         (old-heap loading-level)
         (old-print *print-login*)
         (ag (the-as object #f))
         )
    (cond
      ((or (zero? size)
           (>= (-> arr length) (-> arr allocated-length))
           (>= (-> dir string-array length) (-> dir string-array allocated-length))
           ;; the file, the link arrays of its textures and a margin
           (< (the-as int (&- (-> heap top) (the-as uint (-> heap current)))) (+ size (/ size 4) (* 64 1024)))
           )
       (+! (-> *mp-art-in* failed) 1)
       (format 0 "[multiplayer] art group ~S does not fit in the art heap (~D bytes)~%" name size)
       #f
       )
      (else
        (mp-far-sandbox-begin)
        (set! loading-level heap)
        ;; an art group loaded outside a level load logs itself in (joint.gc), which needs this
        (set! *print-login* #t)
        ;; the file of art group "barge" is out/jak3/obj/barge-ag.go
        (format (clear (-> *mp-far* text)) "~S-ag" name)
        (set! ag (loado (-> *mp-far* text) heap))
        (set! loading-level old-heap)
        (set! *print-login* old-print)
        (+! (-> *mp-far* restored) (pc-mp-sandbox-restore))
        (pc-mp-sandbox-end)
        (cond
          ((and ag (type? ag art-group))
           (set! (-> arr (-> arr length)) (the-as art-group ag))
           (+! (-> arr length) 1)
           (set! (-> dir string-array (-> dir string-array length)) (-> (the-as art-group ag) name))
           (+! (-> dir string-array length) 1)
           (+! (-> *mp-art-in* loaded) 1)
           (format 0 "[multiplayer] art group ~S loaded alone for a distant player~%" name)
           #t
           )
          (else
            (+! (-> *mp-art-in* failed) 1)
            (format 0 "[multiplayer] art group ~S could not be loaded~%" name)
            #f
            )
          )
        )
      )
    )
  )

(defun mp-far-fetch-art ()
  "For one object another player sends within MP_ART_RANGE of our player, whose skeleton is known
   here (ours or rebuilt) but whose art group is in no level loaded here: open the art heap, keep the
   renderer data of the level its sender names, load the art group alone. One every half second,
   never while our own place loads a level."
  (let ((tbl *mp-art-in*))
    (when (and *mp-far-enabled*
               *target*
               (> (mp-player-count) 0)
               (not (load-in-progress? *level*))
               (time-elapsed? (-> tbl fetch-time) (seconds 0.5))
               )
      (set-time! (-> tbl fetch-time))
      (dotimes (i (-> *mp-actors-in* count))
        (let ((st (-> *mp-actors-in* state i)))
          (when (and (nonzero? (-> st id))
                     (< (mp-replica-index (-> st id)) 0)
                     (< (vector-vector-distance (-> st trans) (-> *target* control trans)) *mp-art-range*)
                     )
            (string<-charp *mp-temp-string* (-> st skel))
            (let ((skel (string->symbol *mp-temp-string*))
                  (sg (the-as skeleton-group (mp-art-group-get *mp-temp-string* (the-as (pointer level) #f))))
                  )
              (when (and sg (type? sg skeleton-group) (not (mp-art-group-get (-> sg art-group-name) (the-as (pointer level) #f))))
                (let ((ag-name (string->symbol (-> sg art-group-name)))
                      (tried? #f)
                      )
                  (dotimes (k (-> tbl tried-count))
                    (if (= (-> tbl tried k) ag-name)
                        (set! tried? #t)
                        )
                    )
                  (when (and (not tried?) (< (-> tbl tried-count) 32) (mp-art-heap-open))
                    (set! (-> tbl tried (-> tbl tried-count)) ag-name)
                    (+! (-> tbl tried-count) 1)
                    ;; the renderer data of the level the sender has this art in
                    (dotimes (k (-> tbl count))
                      (if (= (-> tbl skel k) skel)
                          (pc-mp-render-level (symbol->string (-> tbl level k)) #t)
                          )
                      )
                    (mp-far-load-art (-> sg art-group-name))
                    (return 0)
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

;; A copy runs none of its object's code: it only needs the skeleton-group (data a defskelgroup
;; fills) and the art group. When the code that defines a skeleton-group is in no level here, the
;; group is rebuilt from the description its sender sends (skel-def event), so the copy can be
;; built from the art group loaded alone.

(define *mp-synth-skels* #f) ;; test switch (synth-skels): use the rebuilt groups even when ours exist

(deftype mp-skel-defs (structure)
  ((count    int32)
   (name     symbol 160)
   (sg       skeleton-group 160) ;; rebuilt groups, allocated once each
   (complete symbol 160)
   (current  int32)             ;; entry the parts being received fill
   (rebuilt  int32)             ;; counter for the test log
   )
  )

(define *mp-skel-defs* (new 'global 'mp-skel-defs))
(set! (-> *mp-skel-defs* current) -1)

(defun mp-send-skel-def ((sg skeleton-group))
  "Sender: the description of skeleton-group `sg`, in three skel-def events."
  (let ((ev (new 'stack 'mp-event)))
    (set! (-> ev kind) (mp-event-kind skel-def))
    (set! (-> ev to) -1)
    ;; part 0: name, jgeo janim, max-lod, longest edge, bytes, bounds
    (set! (-> ev iarg 0) 0)
    (copyn-charp<-string (-> ev text) (-> sg name) 32)
    (set! (-> ev iarg 1) (logior (logand (-> sg jgeo) #xffff) (shl (-> sg janim) 16)))
    (set! (-> ev iarg 2) (-> sg max-lod))
    (set! (-> ev iarg 3) (the-as int (-> sg longest-edge)))
    (set! (-> ev pad) (logior (logand (-> sg texture-level) #xff)
                              (shl (logand (-> sg version) #xff) 8)
                              (shl (logand (-> sg sort) #xff) 16)
                              (shl (the-as int (-> sg light-index)) 24)
                              )
          )
    (vector-copy! (-> ev fvec) (-> sg bounds))
    (pc-mp-send-event ev)
    ;; part 1: art group name, mgeo, shadow and joints, lod distances 0-3
    (set! (-> ev iarg 0) 1)
    (copyn-charp<-string (-> ev text) (-> sg art-group-name) 32)
    (set! (-> ev iarg 1) (logior (logand (-> sg mgeo 0) #xffff) (shl (-> sg mgeo 1) 16)))
    (set! (-> ev iarg 2) (logior (logand (-> sg mgeo 2) #xffff) (shl (-> sg mgeo 3) 16)))
    (set! (-> ev iarg 3) (logior (logand (-> sg mgeo 4) #xffff) (shl (-> sg mgeo 5) 16)))
    (set! (-> ev pad) (logior (logand (-> sg shadow) #xffff)
                              (shl (logand (-> sg shadow-joint-index) #xff) 16)
                              (shl (logand (-> sg origin-joint-index) #xff) 24)
                              )
          )
    (set-vector! (-> ev fvec) (-> sg lod-dist 0) (-> sg lod-dist 1) (-> sg lod-dist 2) (-> sg lod-dist 3))
    (pc-mp-send-event ev)
    ;; part 2: lod distances 4-5, global effects
    (set! (-> ev iarg 0) 2)
    (set! (-> ev iarg 1) (the-as int (-> sg global-effects)))
    (set-vector! (-> ev fvec) (-> sg lod-dist 4) (-> sg lod-dist 5) 0.0 0.0)
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-low16 ((v int))
  "The signed low 16 bits of `v`."
  (let ((x (logand v #xffff)))
    (if (>= x #x8000)
        (- x #x10000)
        x
        )
    )
  )

(defun mp-apply-skel-def ((ev mp-event))
  "Receiver: a part of a skeleton-group description (mp-send-skel-def); the parts of one group
   come in order from its sender. The group is rebuilt in its entry (allocated once)."
  (let ((defs *mp-skel-defs*)
        (part (-> ev iarg 0))
        )
    (cond
      ((zero? part)
       (string<-charp (-> *mp-far* text) (-> ev text))
       (let ((name (string->symbol (-> *mp-far* text)))
             (slot -1)
             )
         (dotimes (i (-> defs count))
           (if (= (-> defs name i) name)
               (set! slot i)
               )
           )
         (when (and (< slot 0) (< (-> defs count) 160))
           (set! slot (-> defs count))
           (set! (-> defs name slot) name)
           (set! (-> defs complete slot) #f)
           (let ((sg (the-as skeleton-group (new 'global 'skeleton-group))))
             (set! (-> sg name) (new 'global 'string 32 (the-as string #f)))
             (set! (-> sg art-group-name) (new 'global 'string 32 (the-as string #f)))
             (set! (-> sg extra) #f)
             (set! (-> sg info) #f)
             (set! (-> sg clothing) #f)
             (set! (-> sg length) 0)
             (set! (-> defs sg slot) sg)
             )
           (+! (-> defs count) 1)
           )
         (set! (-> defs current) slot)
         (when (>= slot 0)
           (let ((sg (-> defs sg slot)))
             (copy-string<-string (-> sg name) (-> *mp-far* text))
             (set! (-> sg jgeo) (mp-low16 (-> ev iarg 1)))
             (set! (-> sg janim) (sar (-> ev iarg 1) 16))
             (set! (-> sg max-lod) (-> ev iarg 2))
             (set! (-> sg longest-edge) (the-as float (-> ev iarg 3)))
             (set! (-> sg texture-level) (logand (-> ev pad) #xff))
             (set! (-> sg version) (logand (shr (-> ev pad) 8) #xff))
             (set! (-> sg sort) (logand (shr (-> ev pad) 16) #xff))
             (set! (-> sg light-index) (logand (shr (-> ev pad) 24) #xff))
             (vector-copy! (-> sg bounds) (-> ev fvec))
             )
           )
         )
       )
      ((>= (-> defs current) 0)
       (let ((sg (-> defs sg (-> defs current))))
         (cond
           ((= part 1)
            (string<-charp (-> sg art-group-name) (-> ev text))
            (set! (-> sg mgeo 0) (mp-low16 (-> ev iarg 1)))
            (set! (-> sg mgeo 1) (sar (-> ev iarg 1) 16))
            (set! (-> sg mgeo 2) (mp-low16 (-> ev iarg 2)))
            (set! (-> sg mgeo 3) (sar (-> ev iarg 2) 16))
            (set! (-> sg mgeo 4) (mp-low16 (-> ev iarg 3)))
            (set! (-> sg mgeo 5) (sar (-> ev iarg 3) 16))
            (set! (-> sg shadow) (mp-low16 (-> ev pad)))
            (set! (-> sg shadow-joint-index) (logand (shr (-> ev pad) 16) #xff))
            (set! (-> sg origin-joint-index) (logand (shr (-> ev pad) 24) #xff))
            (set! (-> sg lod-dist 0) (-> ev fvec x))
            (set! (-> sg lod-dist 1) (-> ev fvec y))
            (set! (-> sg lod-dist 2) (-> ev fvec z))
            (set! (-> sg lod-dist 3) (-> ev fvec w))
            )
           ((= part 2)
            (set! (-> sg lod-dist 4) (-> ev fvec x))
            (set! (-> sg lod-dist 5) (-> ev fvec y))
            (set! (-> sg global-effects) (the-as uint (-> ev iarg 1)))
            (when (not (-> defs complete (-> defs current)))
              (set! (-> defs complete (-> defs current)) #t)
              (+! (-> defs rebuilt) 1)
              )
            (set! (-> defs current) -1)
            )
           )
         )
       )
      )
    )
  (none)
  )

(defun mp-skel-def-get ((name string))
  "The skeleton-group rebuilt from a sender's description named `name`, or #f; with the test
   switch *mp-synth-skels*, ours is not looked for first (mp-art-group-get calls this last)."
  (let ((defs *mp-skel-defs*))
    (dotimes (i (-> defs count))
      (if (and (-> defs complete i) (string= (-> defs sg i name) name))
          (return (-> defs sg i))
          )
      )
    )
  (the-as skeleton-group #f)
  )

;; ------------------------------------------------------------------------------------------------
;; Shared cutscenes
;; ------------------------------------------------------------------------------------------------

;; A cutscene (scene-player) that starts on one machine starts on the machines of the players who
;; share its region (same NPC authority), so they watch it together and get its commands (task
;; nodes, continue points). Gated by the host's "Share story progress".
;;
;; Players in one region stand in the same levels; a distant player's level is loaded here without
;; being displayed (Distant players' levels above).

(deftype mp-scene-state (structure)
  ((replaying? symbol)      ;; starting another player's scene: do not send it back
   (total      int32)       ;; scenes of the cutscene being received
   (wait       symbol)
   (names      string 8)
   (continue   string)
   (sent       int32)       ;; counters for the test log
   (shown      int32)
   )
  )

(define *mp-scene* (new 'global 'mp-scene-state))
(set! (-> *mp-scene* replaying?) #f)
(dotimes (i 8)
  (set! (-> *mp-scene* names i) (new 'global 'string 32 (the-as string #f)))
  )
(set! (-> *mp-scene* continue) (new 'global 'string 32 (the-as string #f)))

(defun mp-scene-name ((obj object))
  "The name of a scene argument (a name, or a scene), #f otherwise."
  (cond
    ((type? obj string) (the-as string obj))
    ((type? obj scene) (-> (the-as scene obj) name))
    (else (the-as string #f))
    )
  )

(defun mp-send-scene-part ((index int) (total int) (wait symbol) (name string))
  "One message of a cutscene: scene `index` of `total` (-1: the continue point, last)."
  (let ((ev (new 'stack 'mp-event)))
    (set! (-> ev kind) (mp-event-kind scene))
    (set! (-> ev to) -1)
    (set! (-> ev iarg 0) index)
    (set! (-> ev iarg 1) total)
    (set! (-> ev iarg 2) (if wait 1 0))
    (if name
        (copyn-charp<-string (-> ev text) name 32)
        (set! (-> ev text 0) (the-as uint 0))
        )
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-send-scene ((scenes object) (wait symbol) (continue string))
  "A cutscene starts here: send its scenes (a name, a scene, or a list or array of them) and its
   continue point to the others."
  (let ((total 0))
    (cond
      ((type? scenes pair)
       (let ((p (the-as pair scenes)))
         (while (and (not (null? p)) (< total 8))
           (mp-send-scene-part total -1 wait (mp-scene-name (car p)))
           (+! total 1)
           (set! p (the-as pair (cdr p)))
           )
         )
       )
      ((type? scenes array)
       (let ((arr (the-as (array object) scenes)))
         (dotimes (i (min 8 (-> arr length)))
           (mp-send-scene-part i -1 wait (mp-scene-name (-> arr i)))
           (+! total 1)
           )
         )
       )
      (else
        (mp-send-scene-part 0 -1 wait (mp-scene-name scenes))
        (set! total 1)
        )
      )
    (mp-send-scene-part -1 total wait continue)
    (+! (-> *mp-scene* sent) 1)
    )
  (none)
  )

(defbehavior mp-apply-scene mp-manager ((ev mp-event))
  "Part of another player's cutscene; on its last part, start the same cutscene here when that
   player shares our region and no cutscene plays here."
  (let ((sc *mp-scene*)
        (index (-> ev iarg 0))
        )
    (cond
      ((and (>= index 0) (< index 8))
       (string<-charp (-> sc names index) (-> ev text))
       )
      ((and (= index -1)
            (logtest? *mp-world* (mp-world-flag progress))
            *target*
            (>= *mp-local-slot* 0)
            (= (mp-provider-of *mp-local-slot*) (mp-provider-of (-> ev from)))
            (not (process-by-name "scene-player" *active-pool*))
            )
       (string<-charp (-> sc continue) (-> ev text))
       (let* ((total (max 1 (min 8 (-> ev iarg 1))))
              (scenes (if (= total 1)
                          (the-as object (-> sc names 0))
                          (let ((lst '()))
                            (countdown (i total)
                              (set! lst (cons (-> sc names i) lst))
                              )
                            lst
                            )
                          )
                      )
              )
         (format 0 "[multiplayer] cutscene ~S of player ~D starts here too~%" (-> sc names 0) (-> ev from))
         (set! (-> sc replaying?) #t)
         (process-spawn
           scene-player
           :init scene-player-init
           scenes
           (nonzero? (-> ev iarg 2))
           (if (nonzero? (length (-> sc continue)))
               (-> sc continue)
               (the-as string #f)
               )
           :name "scene-player"
           )
         (set! (-> sc replaying?) #f)
         (+! (-> sc shown) 1)
         )
       )
      )
    )
  (none)
  )

;; MOD multiplayer -- every cutscene starts here (engine/scene/scene.gc)
(define-perm *mp-stock-scene-player-init* (function object symbol string none :behavior scene-player)
  scene-player-init
  )

(defbehavior scene-player-init scene-player ((arg0 object) (arg1 symbol) (arg2 string))
  "The others in our region play this cutscene too (multiplayer mod, no-op offline), then the stock
   init, which goes on to the scene."
  (if (and (mp-online?) (logtest? *mp-world* (mp-world-flag progress)) (not (-> *mp-scene* replaying?)))
      (mp-send-scene arg0 arg1 arg2)
      )
  (*mp-stock-scene-player-init* arg0 arg1 arg2)
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Crates and pickups
;; ------------------------------------------------------------------------------------------------

(defun mp-on-entity-dead ((proc process))
  "An entity was marked dead here: when it is a crate or a pickup, the other players remove theirs
   (enemies go through mark-as-dead instead, see multiplayer.gc)."
  (when (and (mp-online?)
             (or (type? proc crate) (type? proc collectable))
             (-> proc entity)
             (nonzero? (-> proc entity aid))
             (not (mp-remote-kill? (-> proc entity aid)))
             )
    (mp-send-event (mp-event-kind kill-entity) -1 (the-as int (-> proc entity aid)) 0.0)
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock entity status setter (engine/entity/entity.gc): every broken
;; crate and taken pickup marks its entity dead through it.
(define-perm *mp-stock-process-entity-status!* (function process entity-perm-status symbol entity-perm-status)
  process-entity-status!
  )

(defun process-entity-status! ((arg0 process) (arg1 entity-perm-status) (arg2 symbol))
  "Stock behavior; a crate or pickup marked dead here is removed on the other machines too
   (multiplayer mod, no-op offline)."
  (let ((result (*mp-stock-process-entity-status!* arg0 arg1 arg2)))
    (if (and arg2 (logtest? arg1 (entity-perm-status dead)))
        (mp-on-entity-dead arg0)
        )
    result
    )
  )
