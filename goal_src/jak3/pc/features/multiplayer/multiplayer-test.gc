;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer-test.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- automated test commands. Inert unless the game was started with the
;; MP_TEST_SCRIPT environment variable (scripts/mp-test/run_mp_test.py does it): the runtime then
;; hands out one script line per due time (game/kernel/jak3/kmultiplayer.cpp), and
;; `mp-test-update`, called every frame from the multiplayer hook, runs it.
;;
;; Commands (one per line, after the time in seconds):
;;   enable | name <word> | color <n> | character <n>       mod settings, in memory and saved
;;   host <ip:port> | join <ip:port> | leave                 session
;;   address <ip:port> | log-lobby                           server address field only; menu page, title entries, lobby
;;   wait-menu <page>                                        the script waits: the menu shows that page (title...)
;;   wait-countdown                                          the script waits: the lobby's start countdown runs
;;   wait-pause <0|1> | wait-resume                          the script waits: the game paused by the host (or not); its resume countdown
;;   wait-driving <slot>                                     the script waits: that player drives a vehicle (for 2 s)
;;   wait-scene | log-skip                                   the script waits: a cutscene plays here; the vote to skip it
;;   beam-at-host <dx> <dz> | goto-beam | log-beams          a test waypoint near the host; stand at it; waypoints held
;;   race-gate | log-race                                    a race start of a test (waits for every player aboard); races
;;   continue <continue-point>                               go to a continue point
;;   press <button> <ms> [lx ly] | stick <lx> <ly> <ms>      force pad 0 (0-255, 128 = center)
;;   stick-r <rx> <ry> <ms>                                  the right stick (camera)
;;   goto-player <slot> [x z] | face-player <slot>           stand next to / face a remote player
;;   look-player <slot>                                      face a remote player, camera behind us at once
;;   goto-behind <slot> <meters>                             stand behind a remote player, out of its view
;;   goto-own <prefix> | kill-own <prefix>                   stand 8 m from one of our NPCs we send; destroy that vehicle
;;   cheat <ammo|health|dark|light|invuln|weapons> | zone <n> Mods menu actions
;;   gun [pickup-type] | board | vehicle <type>              every gun mod (26-37 picks one); hoverboard; a vehicle
;;   daxter-mod <pickup-type> | log-daxter-gun              the mod Daxter fires (as the D-pad); his gun's state
;;   screenshot <name> | log                                 evidence: <config>/screenshots, log
;;   log-pose [slot] | log-me                                bones of a player's model; own position
;;   log-pose-own <player|npc|daxter|gun|vehicle|wheel> [frames] bones of our model or object, each frame
;;   log-pose-copy <slot> <skeleton name|*>                  bones of the copies of player slot's objects
;;   log-tasks | close-task [n]                              story progress; close the first open node(s)
;;   log-path <skeleton|shot> <frames>                       an object's (every shot's) root each frame, owner and viewer
;;   log-laser <frames>                                      the gun's laser sight each frame, owner and viewer
;;   wait-joined | wait-player <slot>                        the script waits: in the host's world; player in game
;;   mode <0|1> | title                                      game mode when hosting (free roam, co-op); title screen
;;   log-join | try-save                                     joining the host's world; an auto-save (refused there)
;;   log-coop | log-weather                                  co-op state (held steps, leash); the weather
;;   log-sync                                                phase of a test cycle (host clock sync)
;;   goto-door | log-door | goto-elevator | log-elevator     doors and elevators near player 0 / us
;;   goto-door-at <meters>                                   stand that far in front of the nearest door (negative: behind)
;;   ride-shown-elevator                                     once a trip of player 0 was shown here: stand by it
;;   scene <name> | log-levels                               start a cutscene; levels and cutscenes
;;   far-levels <0|1>                                        load the art of distant players' objects (default 1)
;;   art-range <meters>                                      how far from us that art loads (default 400)
;;   log-weapons                                             other players' non-shot weapons drawn here
;;   log-aimable                                             what the area weapons find within 20 m of us
;;   log-vehicles                                            every vehicle within 30 m of us, ours and copies
;;   log-ping                                                players' round trip to the host and health, list shown, paused
;;   log-pause                                               the host's pause for everyone, the START menu over the world
;;   skin <group> <rrggbb> <percent> | skin-page | log-skin  our outfit's part (saved, sent); the Appearance page; outfits
;;   log-name | log-session                                  name and keyboard; game started (free roam, campaign), unlocks
;;   log-anim <daxter|jak> <index>                           the art group entry there (a clip is loaded when shown)
;;   log-seat                                                our model as a passenger: root and bones from the seat
;;   log-joints                                              Daxter's joints, index and name
;;   coop-start <0|1|2> [n]                                  co-op starts a new campaign, continues it, or the n-th mission
;;   coop-mission <name>                                     co-op starts at the mission of that play-list name
;;   go-state <type> <state>                                 the first process of that type goes to that virtual state
;;   log-state <type>                                        the state of the first process of that type
;;   log-end                                                 a session ended without us: the note, where we are
;;   log-scene-skins                                         the cutscene's Jak and Daxter actors and their outfit tints
;;   log-econ | goto-merchant | goto-orb                     balances; stand at Kleiver's shop; take the nearest orb
;;   merchant-spot <i>                                       host: the merchant at spot i, sent to everyone
;;   econ-claim <aid> | shop-buy <item>                      claim an orb not taken (0: the nearest; refused); buy a shop item
;;   econ-grant <slot> <orbs>                                the host credits a player (test of the server's accounts)
;;   kill-mh <slot>                                          host: a lethal blow from player slot to the nearest Metal Head
;;   die | log-respawn                                       kill our player; co-op respawns next to a teammate
;;   net <ms> <jitter> <loss %> | log-net                    the test network from now on; each peer's network pressure
;;   open-menu <page> | econ-grant-self <0|1>                a START page; the host's +100 orbs / trophies
;;   log-eyes                                                the remote puppets' eye slots and their last writer
;;   eye-fix-off                                             the eye fix undone (before / after screenshots)
;;   ride-flut | end-flut                                    ride a lizard where we stand (a level with lizards); off it
;;   respawn-manager <type>                                  kill that mission's task manager, which starts again
;;   goto-type <type>                                        stand in front of the first process of that type (a mission giver)
;;   goto-own-vehicle                                        stand beside the vehicle we drove last (and left)
;;   race-autopilot                                          a running race: our vehicle driven by the racers' AI
;;   race-stop-racers                                        every vehicle of ours but our player's removed
;;   goto-flut | log-fldax                                   stand 2 m from the nearest lizard waiting, facing it; Daxter on it
;;   dark-bomb                                               the dark blast ready (after power dark): jump, square
;;   restart | log-restart                                   START > Restart; restarts done, mode, master mode
;;   log-outline                                             outlined players drawn through walls (renderer count, table)
;;   spawn-vehicle <type>                                    an empty vehicle 3 m in front of us
;;   power <dark|light> | log-power                          Dark / Light Jak on; ours and what puppets show
;;   run-near-others <0|1>                                   our NPCs near another player run (default 1)
;;   log-motion                                              NPCs drawn within 60 m (ours, copies), how many moved since
;;   log-gone | trace-gone                                   NPCs we sent that vanished near another player (count, each)
;;   log-vanished | trace-vanish                             what vanished on our screen within 40 m, alive (count, each)
;;   synth-skels <0|1>                                       copies use the skeleton-groups rebuilt from descriptions
;;   log-art-kinds                                           every skeleton another player announced: drawable here?
;;   announce-all-kinds | log-kinds-coverage                 describe every kind of our place; check those described
;;   log-shaders                                             texture shader lists intact, level heaps
;;   log-look <slot>                                         a player's color: model untinted, minimap, name marker
;;   log-copies <slot>                                       every object of a player received here, drawn or not
;;   goto-float | log-float                                  floating platforms (volcano)
;;   log-play | trace-play                                   our player's state, modes, task managers; each new state
;;   pickup-turret                                           the idle turret within 20 m takes us (as a mission's arrival)
;;   choose-character <0|1> | log-role                       in-game character choice (co-op: swap); roles, minimap icons
;; Every command and every `log` line is printed with the prefix "[mp-test]".

(define-extern pc-mp-test-active? (function symbol))
(define-extern pc-mp-test-poll (function string symbol))
(define-extern pc-mp-test-screenshot (function string none))
(define-extern pc-mp-test-pad (function int int int int int none))
(define-extern pc-mp-test-pause (function symbol none))
(define-extern pc-mp-outlines-drawn (function int))
(define-extern pc-mp-outline-pixels (function int))
(define-extern pc-mp-dark-skin-draws (function int))
(define-extern pc-mp-skin-draws (function int))
(define-extern pc-mp-player-delay (function int int)) ;; the delay player n is drawn with (ms)
(define-extern pc-mp-log-net (function none))
(define-extern pc-mp-test-network (function int int int none))

;; wait-joined / wait-player / wait-menu: the script clock stops until the wait is over
;; (mp-test-update).
(deftype mp-test-waiting (structure)
  ((kind  symbol)     ;; 'joined, 'player, 'menu, 'countdown or #f
   (slot  int32)
   (menu  symbol)     ;; the menu page waited for
   (since time-frame)
   (tapped time-frame) ;; wait-menu title: last X tapped to open the title screen's menu
   )
  )

(define *mp-test-wait* (new 'global 'mp-test-waiting))
(set! (-> *mp-test-wait* kind) #f)

;; Test runner state (in a structure: a time-frame is 64 bits, a global symbol holds 32).
(deftype mp-test-state (structure)
  ((pad-until time-frame) ;; real-clock time the forced input is released, 0 = none
   (line      string)     ;; command being run, consumed word by word
   (word      string)     ;; last word read
   )
  )

(define *mp-test* (new 'global 'mp-test-state))

;; One-shot test steps.
(deftype mp-test-misc (structure)
  ((rode? symbol)  ;; ride-shown-elevator done
   )
  )

(define *mp-test-misc* (new 'global 'mp-test-misc))
(set! (-> *mp-test-misc* rode?) #f)
(set! (-> *mp-test* line) (new 'global 'string 128 (the-as string #f)))
(set! (-> *mp-test* word) (new 'global 'string 64 (the-as string #f)))

(defun mp-test-word ()
  "Pop the next word of the command into (-> *mp-test* word). #f when none is left."
  (string-get-arg!! (-> *mp-test* word) (-> *mp-test* line))
  )

;; A race start of a test (race-gate): forbids leaving the vehicle and waits as the races' task
;; managers do (course-race.gc), then logs the start.
(deftype mp-test-race-gate (process)
  ()
  )

(defstate mp-test-race-gate-active (mp-test-race-gate)
  :code (behavior ()
    (set-setting! 'pilot-exit #f 0.0 0)
    (suspend)
    (while (mp-race-hold?)
      (suspend)
      )
    (format 0 "[mp-test] race gate open~%")
    (deactivate self)
    )
  )

(defbehavior mp-test-race-gate-init-by-other mp-test-race-gate ()
  (go mp-test-race-gate-active)
  )

;; A waypoint of a test mission (beam-at-host): its beam, and its own check that we reached it
;; with (target-pos 0) within 3 m, as missions do (the multiplayer mod holds it in co-op).
(define *mp-test-beams-reached* 0)

;; The process type go-state looks for (its lambda reads it: GOAL lambdas capture nothing).
(define *mp-test-type-name* (the-as symbol #f))

(deftype mp-test-beam (process)
  ((arrow    handle)
   (pos      vector :inline)
   (reached? symbol)
   )
  )

(defstate mp-test-beam-active (mp-test-beam)
  :code (behavior ()
    (loop
      (when (and (not (-> self reached?)) (< (vector-vector-xz-distance (target-pos 0) (-> self pos)) (meters 3)))
        (set! (-> self reached?) #t)
        (+! *mp-test-beams-reached* 1)
        (format 0 "[mp-test] beam reached~%")
        (send-event (handle->process (-> self arrow)) 'leave)
        )
      (suspend)
      )
    )
  )

(defbehavior mp-test-beam-init-by-other mp-test-beam ((pos vector))
  "A beam at `pos`, which this process checks."
  (vector-copy! (-> self pos) pos)
  (set! (-> self reached?) #f)
  (let ((params (new 'stack-no-clear 'task-arrow-params)))
    (set! (-> params flags) (task-arrow-flags))
    (set! (-> params map-icon) (the-as uint 12))
    (vector-copy! (-> params pos) pos)
    (quaternion-identity! (-> params quat))
    (let ((arrow (task-arrow-spawn params self)))
      (set! (-> self arrow) (if arrow (process->handle arrow) (the-as handle #f)))
      )
    )
  (go mp-test-beam-active)
  )

(defun mp-test-hex ((str string))
  "A hexadecimal number (rrggbb)."
  (let ((v 0))
    (dotimes (i (length str))
      (let ((c (the-as int (-> str data i))))
        (set! v (+ (* v 16) (cond
                              ((and (>= c 48) (<= c 57)) (+ c -48))
                              ((and (>= c 97) (<= c 102)) (+ c -87))
                              ((and (>= c 65) (<= c 70)) (+ c -55))
                              (else 0)
                              )
                   )
              )
        )
      )
    v
    )
  )

(defun mp-test-int ()
  "Pop the next word as an integer (0 when missing)."
  (if (mp-test-word)
      (string->int (-> *mp-test* word))
      0
      )
  )

(defun mp-test-button ((name string))
  "pad-buttons bit for a button name (the order of the PS2 pad, select = bit 0); l1+triangle and
   l1+square for both (the dark blast: an uppercut, square while ducking)."
  (if (string= name "l1+triangle")
      (return (logior (ash 1 10) (ash 1 12)))
      )
  (if (string= name "l1+square")
      (return (logior (ash 1 10) (ash 1 15)))
      )
  (let ((names (new 'static 'boxed-array :type string
                 "select" "l3" "r3" "start" "up" "right" "down" "left"
                 "l2" "r2" "l1" "r1" "triangle" "circle" "x" "square"
                 )
               )
        )
    (dotimes (i (-> names length))
      (if (string= name (-> names i))
          (return (ash 1 i))
          )
      )
    )
  0
  )

(define *mp-test-awake* 0)
(define *mp-test-asleep* 0)

(defun mp-test-npc-scan ((proc process-drawable))
  "iterate-process-tree callback: count our own NPCs, awake and asleep."
  (when (and (type? proc process-drawable) (not (type? proc mp-replica)) (> (mp-actor-kind proc) 0))
    (if (logtest? (-> proc mask) (process-mask sleep))
        (+! *mp-test-asleep* 1)
        (+! *mp-test-awake* 1)
        )
    )
  #f
  )

(deftype mp-test-motion (structure)
  ((count  int32)
   (handle handle 128)
   (pos    vector 128 :inline)
   (own    int32)    ;; this pass: our NPCs drawn within 60 m, and how many moved since the last
   (own-moved int32)
   (copy   int32)    ;; the same for copies of other players' NPCs
   (copy-moved int32)
   (next   int32)
   (range  float)    ;; how far from us an NPC counts
   (next-handle handle 128)
   (next-pos vector 128 :inline)
   )
  )

(define *mp-test-motion* (new 'global 'mp-test-motion))

(defun mp-test-motion-scan ((proc process-drawable))
  "iterate-process-tree callback (log-motion): an NPC drawn within 60 m of us, ours or a copy:
   count it, and whether it moved more than 5 cm since the last log-motion."
  (when (and (type? proc process-drawable)
             *target*
             (nonzero? (-> proc root))
             (nonzero? (-> proc draw))
             (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
             (not (logtest? (-> proc mask) (process-mask sleep)))
             (< (vector-vector-distance (-> proc root trans) (-> *target* control trans)) (-> *mp-test-motion* range))
             (if (type? proc mp-replica)
                 (not (logtest? (-> (the-as mp-replica proc) net flags) (mp-actor-flag prop owned shot world)))
                 (> (mp-actor-kind proc) 0)
                 )
             )
    (let ((mt *mp-test-motion*)
          (copy? (type? proc mp-replica))
          (moved? #f)
          )
      (dotimes (i (-> mt count))
        (if (= (handle->process (-> mt handle i)) proc)
            (set! moved? (< (meters 0.05) (vector-vector-distance (-> mt pos i) (-> proc root trans))))
            )
        )
      (cond
        (copy?
         (+! (-> mt copy) 1)
         (if moved? (+! (-> mt copy-moved) 1))
         )
        (else
          (+! (-> mt own) 1)
          (if moved? (+! (-> mt own-moved) 1))
          )
        )
      (when (< (-> mt next) 128)
        (set! (-> mt next-handle (-> mt next)) (process->handle proc))
        (vector-copy! (-> mt next-pos (-> mt next)) (-> proc root trans))
        (+! (-> mt next) 1)
        )
      )
    )
  #f
  )

(defun mp-test-log-motion ()
  "log-motion: our NPCs and the copies drawn within 60 m of us, and how many of each moved since
   the last log-motion (frozen ones do not)."
  (let ((mt *mp-test-motion*))
    (set! (-> mt own) 0)
    (set! (-> mt own-moved) 0)
    (set! (-> mt copy) 0)
    (set! (-> mt copy-moved) 0)
    (set! (-> mt next) 0)
    (iterate-process-tree *active-pool* (the-as (function object object) mp-test-motion-scan) *null-kernel-context*)
    (format 0 "[mp-test] motion own ~D moved ~D copies ~D moved ~D~%" (-> mt own) (-> mt own-moved) (-> mt copy) (-> mt copy-moved))
    (set! (-> mt count) (-> mt next))
    (dotimes (i (-> mt next))
      (set! (-> mt handle i) (-> mt next-handle i))
      (vector-copy! (-> mt pos i) (-> mt next-pos i))
      )
    )
  (none)
  )

(defun mp-test-vehicle-scan ((proc process-drawable))
  "iterate-process-tree callback (log-vehicles): a vehicle drawn within 30 m of us, ours (a vehicle
   process) or a copy of another player's (a replica of a vehicle, a driven one's prop included)."
  (when (and (type? proc process-drawable)
             *target*
             (nonzero? (-> proc root))
             (< (vector-vector-distance (-> proc root trans) (-> *target* control trans)) (meters 30))
             (or (mp-inherits? (-> proc type) (quote vehicle))
                 (and (type? proc mp-replica) (logtest? (-> (the-as mp-replica proc) net flags) (mp-actor-flag vehicle)))
                 )
             )
    (format 0 "[mp-test] vehicle ~A at ~,,1m ~,,1m drawn ~A~%" proc (-> proc root trans x) (-> proc root trans z)
            (and (nonzero? (-> proc draw)) (not (logtest? (-> proc draw status) (draw-control-status no-draw))))
            )
    )
  #f
  )

(defun mp-test-log-stretch ()
  "log-stretch: for each remote player's puppet, the bone farthest from its root and how far (a
   model stretched between two places has one far off)."
  (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
    (when manager
      (dotimes (slot MP_MAX_PLAYERS)
        (let ((proc (the-as process-drawable (handle->process (-> manager puppets slot)))))
          (when (and proc (nonzero? (-> proc node-list)))
            (let ((far 0.0)
                  (far-i 0)
                  )
              (dotimes (i (-> proc node-list length))
                (let ((d (vector-vector-distance (-> proc node-list data i bone transform trans) (-> proc root trans))))
                  (when (< far d)
                    (set! far d)
                    (set! far-i i)
                    )
                  )
                )
              (format 0 "[mp-test] stretch ~D bone ~D at ~,,1m from root ~m ~m ~m~%" slot far-i far
                      (-> proc root trans x) (-> proc root trans y) (-> proc root trans z)
                      )
              (format 0 "[mp-test] stretch ~D drawn ~A~%" slot (not (logtest? (-> proc draw status) (draw-control-status no-draw))))
              )
            )
          )
        )
      )
    )
  ;; and every copy with a bone more than 5 m from its root
  (let ((ws *mp-world-state*))
    (dotimes (r (-> ws replica-count))
      (let ((proc (the-as mp-replica (handle->process (-> ws replica r)))))
        (when (and proc (nonzero? (-> proc node-list)) (nonzero? (-> proc draw)))
          (let ((far 0.0))
            (dotimes (i (-> proc node-list length))
              (set! far (fmax far (vector-vector-distance (-> proc node-list data i bone transform trans) (-> proc root trans))))
              )
            (if (< (meters 5) far)
                (format 0 "[mp-test] stretch copy ~S at ~,,1m from root ~m ~m ~m drawn ~A~%"
                        (string<-charp *mp-temp-string* (-> proc net skel)) far
                        (-> proc root trans x) (-> proc root trans y) (-> proc root trans z)
                        (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
                        )
                )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-test-log-paused ((range float))
  "log-paused (the authority): the NPCs we send within `range` of another player, how many the stock
   run-logic? would pause (farther than 50 m from our camera, or idle off screen), how many run."
  (let ((near 0)
        (paused 0)
        (runs 0)
        )
    (dotimes (i (-> *mp-actors-out* count))
      (let ((st (-> *mp-actors-out* state i))
            (proc (the-as process-drawable (handle->process (-> *mp-pose* obj i))))
            )
        (when (and proc
                   (not (logtest? (-> st flags) (mp-actor-flag owned world)))
                   (< (mp-remote-distance (-> st trans)) range)
                   )
          (+! near 1)
          (if (not (if (type? proc enemy)
                       (*mp-stock-enemy-run-logic?* (the-as enemy proc))
                       (*mp-stock-pd-run-logic?* proc)
                       )
                   )
              (+! paused 1)
              )
          (if (run-logic? proc)
              (+! runs 1)
              )
          )
        )
      )
    (format 0 "[mp-test] near another player ~D stock-paused ~D run ~D~%" near paused runs)
    )
  (none)
  )

(defun mp-test-log-pose ((slot int))
  "Print four bones of a player's model relative to its root, in world axes: the local player's
   (slot < 0) or the puppet of remote player `slot`. The same line on the owner's machine and on
   another one compares the pose with its copy."
  (let ((proc (the-as process-drawable
                      (if (< slot 0)
                          *target*
                          (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
                            (if manager
                                (handle->process (-> manager puppets (min slot (+ MP_MAX_PLAYERS -1))))
                                )
                            )
                          )
                      )
              )
        )
    (when (and proc (nonzero? (-> proc node-list)))
      (let ((n (-> proc node-list length))
            (root (-> proc root trans))
            )
        (format 0 "[mp-test] pose ~D bones ~D anim ~D applied ~D~%" slot n (mp-anim-index proc) (-> *mp-pose* poses-applied))
        (dotimes (k 4)
          (let* ((i (/ (* (+ k 1) (+ n -1)) 4))
                 (pos (-> proc node-list data i bone transform trans))
                 )
            (format
              0
              "[mp-test] pose ~D bone ~D offset ~m ~m ~m~%"
              slot
              i
              (- (-> pos x) (-> root x))
              (- (-> pos y) (-> root y))
              (- (-> pos z) (-> root z))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-test-log-seat ()
  "Where our model sits (log-seat): its root and its bones' extent, relative to the seat point, in
   the vehicle's axes (x left, y up, z forward), as this machine draws it. As a passenger, the model
   in the seat; driving, the one drawn (Daxter's in his mode) from the player's position."
  (let* ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
         (riding? (>= *mp-ride-slot* 0))
         (driver (if riding?
                     (mp-remote-state *mp-ride-slot*)
                     *mp-local*
                     )
                 )
         (proc (the-as process-drawable (cond
                                          ((not *target*)
                                           #f
                                           )
                                          (riding?
                                           (if manager
                                               (handle->process (-> manager self-puppet))
                                               )
                                           )
                                          ((not (logtest? (-> *mp-local* flags) (mp-flag driving)))
                                           #f
                                           )
                                          ((mp-playing-daxter? *target*)
                                           (ppointer->process (-> *target* sidekick))
                                           )
                                          (else
                                            *target*
                                            )
                                          )
                       )
               )
         (seat (if riding?
                   (mp-seat-pos driver *mp-ride-seat* (new 'stack-no-clear 'vector))
                   (-> *mp-local* trans)
                   )
               )
         )
    (cond
      ((not (and proc driver (nonzero? (-> proc node-list))))
       (format 0 "[mp-test] seat none~%")
       )
      (else
        (let ((inv (quaternion-conjugate! (new 'stack-no-clear 'quaternion) (-> driver veh-quat)))
              (lo (new 'stack 'vector))
              (hi (new 'stack 'vector))
              (v (new 'stack-no-clear 'vector))
              (nodes (-> proc node-list))
              )
          (vector-! v (-> proc root trans) seat)
          (vector-orient-by-quat! v v inv)
          (format 0 "[mp-test] seat ~A root ~m ~m ~m anim ~D~%" (if riding? 'passenger 'driver) (-> v x) (-> v y) (-> v z) (mp-anim-index proc))
          (format 0 "[mp-test] seat index ~D of ~D, from the driver's seat ~m~%" (if riding? *mp-ride-seat* 0) (-> driver seat-count)
                  (vector-vector-distance seat (-> driver veh-trans))
                  )
          (set-vector! lo 1000000.0 1000000.0 1000000.0 1.0)
          (set-vector! hi -1000000.0 -1000000.0 -1000000.0 1.0)
          (dotimes (i (-> nodes length))
            (when (>= i 3)
              (vector-! v (-> nodes data i bone transform trans) seat)
              (vector-orient-by-quat! v v inv)
              (dotimes (k 3)
                (set! (-> lo data k) (fmin (-> lo data k) (-> v data k)))
                (set! (-> hi data k) (fmax (-> hi data k) (-> v data k)))
                )
              (when (= i 3)
                (format 0 "[mp-test] seat bone 3 ~m ~m ~m~%" (-> v x) (-> v y) (-> v z))
                )
              )
            )
          (format 0 "[mp-test] seat bones x ~m ~m y ~m ~m z ~m ~m~%" (-> lo x) (-> hi x) (-> lo y) (-> hi y) (-> lo z) (-> hi z))
          )
        )
      )
    )
  (none)
  )

(defun mp-test-print-bones ((label string) (id int) (proc process-drawable) (stamp int))
  "Print four joints of `proc` (bones 3 and up: 0-2 are the root, align and prejoint) relative to its
   bone 0, in world axes, stamped with `stamp`, the owner's time of these bones (pc-mp-clock, tenths
   of a ms, printed in ms). The owner's object
   and its copy on another machine print the same values at the same stamp when the copy has the
   owner's pose (scripts/mp-test/compare_poses.py)."
  (when (and proc (nonzero? (-> proc node-list)))
    (let* ((nodes (-> proc node-list))
           (n (-> nodes length))
           (base (-> nodes data 0 bone transform trans))
           )
      (format 0 "[mp-test] ~S ~D bones ~D t ~D.~D~%" label id n (/ stamp 10) (mod stamp 10))
      (dotimes (k 4)
        (let* ((i (min (+ n -1) (+ 3 (/ (* (+ k 1) (max 0 (+ n -4))) 4))))
               (pos (-> nodes data i bone transform trans))
               )
          (format
            0
            "[mp-test] ~S ~D bone ~D offset ~m ~m ~m~%"
            label
            id
            i
            ;; homogeneous: a few joints are sometimes computed with w a little off 1 (0.9992 seen on
            ;; the driver's joints 48 and 64); at world coordinates of millions of units, reading
            ;; their translation alone moves them by meters. The pose sent, relative to the object's
            ;; frame, takes w in: so does this offset.
            (- (-> pos x) (* (-> pos w) (-> base x)))
            (- (-> pos y) (* (-> pos w) (-> base y)))
            (- (-> pos z) (* (-> pos w) (-> base z)))
            )
          )
        )
      )
    )
  (none)
  )

(deftype mp-test-own-requests (structure)
  ((count  int32)
   (kind   string 8)
   (frames int32 8)  ;; frames left to print
   )
  )

(define *mp-test-own* (new 'global 'mp-test-own-requests))
(dotimes (i 8)
  (set! (-> *mp-test-own* kind i) (new 'global 'string 16 (the-as string #f)))
  )

(define-extern mp-test-own-object (function string process-drawable))

;; log-path: the root of one object, every frame, on its owner (each state it sends) and on a viewer
;; (each state drawn), stamped with the owner's clock: the copy's path against the owner's
;; (scripts/mp-test/compare_poses.py, smoothness of a driven vehicle).
(deftype mp-test-path (structure)
  ((skel   string)
   (frames int32)
   )
  )

(define *mp-test-path* (new 'global 'mp-test-path))
(set! (-> *mp-test-path* skel) (new 'global 'string 32 (the-as string #f)))

(define *mp-test-trace-gone* #f) ;; trace-gone: log each NPC counted by log-gone
(define *mp-test-trace-play* (the-as symbol #f)) ;; trace-play: our player's last state logged, #f off

(define *mp-test-tints* 0)
(define *mp-test-managers* 0)

(defun mp-test-log-turret ((p process))
  "log-play: a turret alive (level code, by name): its state and distance to our player."
  (when (mp-inherits? (-> p type) 'target-turret)
    (format 0 " turret ~A:~A ~,,1fm" (-> p type symbol) (if (-> p next-state) (-> p next-state name) 'none)
            (/ (vector-vector-distance (-> (the-as process-drawable p) root trans) (-> *target* control trans)) 4096.0)
            )
    )
  #f
  )

(defun mp-test-log-manager ((p process))
  "log-play: one task manager alive (its type and state), 6 at most."
  (when (and (< *mp-test-managers* 6) (mp-inherits? (-> p type) 'task-manager))
    (+! *mp-test-managers* 1)
    (format 0 " ~A:~A" (-> p type symbol) (if (-> p next-state) (-> p next-state name) 'none))
    )
  #f
  )
(define *mp-test-procs* 0)

(defun mp-test-count-proc ((p process))
  "log-mem: count the processes."
  (+! *mp-test-procs* 1)
  #f
  )

(defun mp-test-log-tint ((p process))
  "log-tints: one line for a vehicle or a citizen of ours (pid, type, color-mult) or for a copy
   (its owner's pid, its skeleton, color-mult)."
  (when (and (< *mp-test-tints* 200) (type? p process-drawable) (nonzero? (-> (the-as process-drawable p) draw)))
    (let ((d (-> (the-as process-drawable p) draw)))
      (cond
        ((type? p mp-replica)
         (+! *mp-test-tints* 1)
         (string<-charp *mp-temp-string* (-> (the-as mp-replica p) net skel))
         (format 0 "[mp-test] tint copy ~D ~S ~,,3f ~,,3f ~,,3f~%" (logand (-> (the-as mp-replica p) net id) #xffffff) *mp-temp-string*
                 (-> d color-mult x) (-> d color-mult y) (-> d color-mult z)
                 )
         )
        ((or (mp-inherits? (-> p type) 'vehicle) (mp-inherits? (-> p type) 'citizen))
         (+! *mp-test-tints* 1)
         (format 0 "[mp-test] tint own ~D ~A ~,,3f ~,,3f ~,,3f distance ~,,1m~%" (-> p pid) (-> p type symbol)
                 (-> d color-mult x) (-> d color-mult y) (-> d color-mult z)
                 (if *target* (vector-vector-distance (-> (the-as process-drawable p) root trans) (-> *target* control trans)) 0.0)
                 )
         )
        )
      )
    )
  #f
  )

(defun mp-test-note-gone ((st mp-actor-state) (proc process-drawable))
  "Print an NPC we sent that vanished near another player (trace-gone): its skeleton, why (left the
   game, inactive, hidden) and its distance to the nearest other player."
  (when *mp-test-trace-gone*
    (format
      0
      "[mp-test] gone ~S ~S ~,,1m~%"
      (string<-charp *mp-temp-string* (-> st skel))
      (cond
        ((not proc) "left")
        ((and (type? proc process-focusable) (focus-test? (the-as process-focusable proc) inactive)) "inactive")
        (else "hidden")
        )
      (mp-remote-distance (-> st trans))
      )
    )
  (none)
  )

(defun mp-test-note-path ((own? symbol) (st mp-actor-state))
  "Print the root of `st` when its skeleton is the one log-path asked for, or it is a shot and
   log-path asked for shots (its own states on the owner, the interpolated ones on a viewer), with
   its id (one shot from another)."
  (when (and (> (-> *mp-test-path* frames) 0)
             (or (string-charp= (-> *mp-test-path* skel) (-> st skel))
                 (and (string= (-> *mp-test-path* skel) "skel-shot") (logtest? (-> st flags) (mp-actor-flag shot)))
                 )
             )
    (format
      0
      "[mp-test] path ~S t ~D.~D pos ~m ~m ~m"
      (if own? "own" "copy")
      (/ (pc-mp-clock (if own? -1 (the-as int (shr (-> st id) 24)))) 10)
      (mod (pc-mp-clock (if own? -1 (the-as int (shr (-> st id) 24)))) 10)
      (-> st trans x)
      (-> st trans y)
      (-> st trans z)
      )
    (format 0 " id ~D~%" (logand (-> st id) #xffffff))
    )
  (none)
  )

(define *mp-test-laser-frames* 0) ;; log-laser: frames left to log the laser sight

(defun mp-test-print-laser ((own? symbol) (slot int) (from vector) (to vector))
  "One laser sight sample: where it starts and ends, stamped with its owner's clock."
  (format
    0
    "[mp-test] laser ~S t ~D.~D from ~m ~m ~m"
    (if own? "own" "copy")
    (/ (pc-mp-clock slot) 10)
    (mod (pc-mp-clock slot) 10)
    (-> from x)
    (-> from y)
    (-> from z)
    )
  (format 0 " to ~m ~m ~m~%" (-> to x) (-> to y) (-> to z))
  (none)
  )

(defun mp-test-note-laser ((proc process-drawable) (from vector) (to vector))
  "The laser sight of a copy of another player's gun, as drawn here (mp-draw-laser), when log-laser
   runs."
  (if (> *mp-test-laser-frames* 0)
      (mp-test-print-laser #f (the-as int (shr (-> (the-as mp-replica proc) id) 24)) from to)
      )
  (none)
  )

(define *mp-test-walk-frames* 0) ;; walk-to-merchant: frames left walking toward Kleiver's spot

(defun mp-test-own-flush ()
  "Print the bones of our objects asked by log-pose-own, once per frame for as many frames as asked.
   Called by the manager, at the point of the frame where the batch reads them (before this frame's
   joint math), so they match what is sent. Every frame is printed, whatever the script's timing:
   after a long frame the script runs several due lines at once and skips none of the game's frames.
   log-path counts its frames here too (the manager runs once a frame)."
  ;; our own laser sight, as the game computes it (gun-info-method-9: laser-point, laser-hit-point)
  (when (> *mp-test-laser-frames* 0)
    (+! *mp-test-laser-frames* -1)
    (if (and *target* (nonzero? (-> *target* gun)) (-> *target* gun laser-active?))
        (mp-test-print-laser #t -1 (-> *target* gun laser-point) (-> *target* gun laser-hit-point))
        )
    )
  (if (> (-> *mp-test-path* frames) 0)
      (+! (-> *mp-test-path* frames) -1)
      )
  (let ((rq *mp-test-own*)
        (kept 0)
        )
    (dotimes (i (-> rq count))
      (let* ((kind (-> rq kind i))
             (proc (mp-test-own-object kind))
             )
        (cond
          ((not proc)
           (format 0 "[mp-test] no own ~S~%" kind)
           )
          ;; bones the batch would not send this frame (a level of detail that leaves some stale,
          ;; not drawn): not what the copy shows, not compared
          ((not (mp-pose-ready? proc (string= kind "npc")))
           (format 0 "[mp-test] own ~S not sent this frame~%" kind)
           )
          (else
            ;; the player's model is named #xffffff on both machines (its pose id)
            (mp-test-print-bones kind (if (string= kind "player") #xffffff (logand (-> proc pid) #xffffff)) proc (pc-mp-clock -1))
            )
          )
        ;; keep the requests with frames left, in order
        (when (> (-> rq frames i) 1)
          (copy-string<-string (-> rq kind kept) kind)
          (set! (-> rq frames kept) (+ (-> rq frames i) -1))
          (+! kept 1)
          )
        )
      )
    (set! (-> rq count) kept)
    )
  (none)
  )

;; The texture page dir keeps, for each texture, a list of the adgif shaders using it, linked by
;; address/16 in 24 bits (shader-ptr): a shader above 256 MB cannot be linked (texture-h.gc).
(defun mp-test-log-shaders ()
  "Walk the shader lists of the texture page dir like unlink-shaders-in-heap, with bounds: count the
   links that leave memory or reach a shader of another texture page (a broken list), and print the
   heap of each level (all of them below #x10000000 when the lists can hold their shaders)."
  (let ((dir *texture-page-dir*)
        (bad 0)
        (nodes 0)
        )
    (dotimes (i (-> dir length))
      (let ((e (-> dir entries i)))
        (when (and (-> e page) (-> e link))
          (dotimes (k (min (-> e page length) (-> e length)))
            (let ((addr (the-as int (* (-> e link next k shader) 16)))
                  (steps 0)
                  )
              (while (and (nonzero? addr) (< steps 10000))
                (+! nodes 1)
                (+! steps 1)
                (cond
                  ((or (< addr #x13fd20) (>= addr #x1ff00000) (!= (-> (the-as adgif-shader addr) texture-id page) i))
                   (+! bad 1)
                   (if (< bad 8)
                       (format 0 "[mp-test] shader link broken: tpage ~D texture ~D -> #x~X~%" i k addr)
                       )
                   (set! addr 0)
                   )
                  (else
                    (set! addr (the-as int (* (-> (the-as adgif-shader addr) next shader) 16)))
                    )
                  )
                )
              )
            )
          )
        )
      )
    (format 0 "[mp-test] shader links ~D broken ~D~%" nodes bad)
    )
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (if (!= (-> lev status) 'inactive)
          (format 0 "[mp-test] level ~A heap #x~X-#x~X~%" (-> lev name) (-> lev heap base) (-> lev heap top-base))
          )
      )
    )
  (none)
  )

(defun mp-test-list-copies ((slot int))
  "Every object of player `slot` received here (log lists 8 at most): its skeleton and id, whether its
   owner hides it, whether its copy is drawn and whether its skeleton and art group are in levels
   loaded here."
  (let ((ws *mp-world-state*)
        (n 0)
        )
    (dotimes (i (-> *mp-actors-in* count))
      (let ((st (-> *mp-actors-in* state i)))
        (when (and (nonzero? (-> st id)) (= (the-as int (shr (-> st id) 24)) slot))
          (let* ((idx (mp-replica-index (-> st id)))
                 (rep (if (>= idx 0)
                          (the-as process-drawable (handle->process (-> ws replica idx)))
                          )
                      )
                 )
            (string<-charp *mp-temp-string* (-> st skel))
            (format
              0
              "[mp-test] copy ~D ~S id ~D owner-hides ~A drawn ~A art ~A~%"
              slot
              *mp-temp-string*
              (logand (-> st id) #xffffff)
              ;; the owner does not draw it (parked traffic...): its copy is hidden too
              (logtest? (-> st flags) (mp-actor-flag hidden))
              (and rep (nonzero? (-> rep draw)) (not (logtest? (-> rep draw status) (draw-control-status no-draw))))
              ;; its skeleton and the art group it draws are both in levels loaded here (levels only
              ;; loaded included), as mp-replica-spawn needs them
              (let ((sg (the-as skeleton-group (mp-art-group-get *mp-temp-string* (the-as (pointer level) #f)))))
                (if (and sg (type? sg skeleton-group) (mp-art-group-get (-> sg art-group-name) (the-as (pointer level) #f)))
                    #t
                    #f
                    )
                )
              )
            (+! n 1)
            )
          )
        )
      )
    (format 0 "[mp-test] copies of ~D: ~D~%" slot n)
    )
  (none)
  )

(defun mp-test-own-object ((kind string))
  "One of the objects we send: the NPC nearest to player 1, Daxter, the gun, the vehicle driven or
   its first wheel."
  (cond
    ((string= kind "npc")
     (let ((st (mp-remote-state 1))
           (best (the-as process-drawable #f))
           (best-dist (meters 1000))
           )
       (when st
         (dotimes (i (-> *mp-actors-out* count))
           (let ((as (-> *mp-actors-out* state i)))
             (when (not (logtest? (-> as flags) (mp-actor-flag owned)))
               (let ((d (vector-vector-distance (-> as trans) (-> st trans))))
                 (when (< d best-dist)
                   (set! best-dist d)
                   (set! best (the-as process-drawable (mp-process-by-pid (the-as int (-> as id)))))
                   )
                 )
               )
             )
           )
         )
       best
       )
     )
    ((not *target*)
     (the-as process-drawable #f)
     )
    ((string= kind "player")
     *target*
     )
    ((string= kind "daxter")
     (the-as process-drawable (ppointer->process (-> *target* sidekick)))
     )
    ((string= kind "gun")
     (if (nonzero? (-> *target* gun))
         (the-as process-drawable (ppointer->process (-> *target* gun gun)))
         )
     )
    ((and (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
     (let ((veh (the-as process-drawable (handle->process (-> *target* pilot vehicle)))))
       (cond
         ((string= kind "vehicle")
          veh
          )
         (veh
           (let ((child (-> veh child))
                 (found (the-as process-drawable #f))
                 )
             (while (and child (not found))
               (let ((node (ppointer->process child)))
                 (if (and node (type? node process) (= (mp-actor-kind (the-as process node)) 3))
                     (set! found (the-as process-drawable node))
                     )
                 (set! child (if node
                                 (-> node brother)
                                 (the-as (pointer process-tree) #f)
                                 )
                       )
                 )
               )
             found
             )
           )
         )
       )
     )
    )
  )

(defun mp-test-log-copies ((slot int) (name string))
  "Print the bones of the copies of player `slot`'s objects whose skeleton is \"skel-<name>\" (all of
   them: four wheels print four times), or with \"*\" of its NPC copy nearest to us."
  (let ((ws *mp-world-state*)
        (best (the-as mp-replica #f))
        (best-dist (meters 1000))
        (found 0)
        )
    ;; the player's own model: its puppet here
    (when (string= name "player")
      (let* ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
             (puppet (if (and manager (>= slot 0) (< slot MP_MAX_PLAYERS))
                         (the-as mp-puppet (handle->process (-> manager puppets slot)))
                         )
                     )
             )
        (if puppet
            (mp-test-print-bones name #xffffff puppet (-> puppet pose-time))
            (format 0 "[mp-test] no puppet ~D~%" slot)
            )
        )
      (return 0)
      )
    (format (clear *mp-temp-string*) "skel-~S" name)
    (dotimes (i (-> ws replica-count))
      (let ((rep (the-as mp-replica (handle->process (-> ws replica i)))))
        (when (and rep (= (shr (-> rep id) 24) slot))
          (cond
            ((string= name "*")
             (when (and *target* (not (logtest? (-> rep net flags) (mp-actor-flag owned))))
               (let ((d (vector-vector-distance (-> rep root trans) (-> *target* control trans))))
                 (when (< d best-dist)
                   (set! best-dist d)
                   (set! best rep)
                   )
                 )
               )
             )
            ((string-charp= *mp-temp-string* (-> rep net skel))
             (format 0 "[mp-test] copy ~D poses laid ~D last ~D~%" (logand (-> rep id) #xffffff) (-> rep pose-count) (-> rep pose-last))
             (mp-test-print-bones name (the-as int (logand (-> rep id) #xffffff)) rep (-> rep pose-time))
             (+! found 1)
             )
            )
          )
        )
      )
    (when best
      (string<-charp *mp-temp-string* (-> best net skel))
      (format 0 "[mp-test] nearest npc copy: ~S~%" *mp-temp-string*)
      (mp-test-print-bones name (the-as int (logand (-> best id) #xffffff)) best (-> best pose-time))
      (+! found 1)
      )
    (if (zero? found)
        (format 0 "[mp-test] no copy ~S~%" name)
        )
    )
  (none)
  )

(defun mp-test-log-tasks ()
  "Print the story progress: closed task nodes, nodes closed after another player, the first open
   ones."
  (let ((nodes (-> *game-info* sub-task-list))
        (closed 0)
        (shown 0)
        )
    (dotimes (i (-> nodes length))
      (if (and (nonzero? i) (logtest? (-> nodes i flags) (game-task-node-flag closed)))
          (+! closed 1)
          )
      )
    (format 0 "[mp-test] tasks closed ~D of ~D, after others ~D~%" closed (-> nodes length) *mp-progress-received*)
    (let ((open (open-task-nodes (new 'stack 'boxed-array game-task-node-info 8))))
      (dotimes (i (-> open length))
        (format 0 "[mp-test]   open ~D ~S~%" (get-idx-in-task-list (-> open i)) (-> open i name))
        )
      )
    )
  (none)
  )

(defun mp-test-log-sync ()
  "Print the phase of a 4-second test cycle, computed in the manager's context like a world object's
   (host clock sync), stamped with the host's clock (ours on the host, the drawn time on a guest)."
  (let ((manager (handle->process (-> *mp-globals* manager)))
        (cycle (new 'stack 'sync-linear))
        )
    (when manager
      (set! (-> cycle sync-flags) (sync-flags))
      (set! (-> cycle offset) 0.0)
      (set! (-> cycle period) (the-as uint (seconds 4)))
      (with-pp
        (let ((saved pp))
          (set! pp manager)
          (let ((phase (get-norm! cycle 0)))
            (set! pp saved)
            (format
              0
              "[mp-test] sync t ~D phase ~f shift ~D~%"
              (/ (pc-mp-clock (if (= *mp-mode* (mp-mode client)) 0 -1)) 10)
              phase
              (mp-sync-shift cycle)
              )
            )
          )
        )
      )
    )
  (none)
  )

(define *mp-test-near* (the-as process-drawable #f))
(define *mp-test-near-dist* 0.0)
(define *mp-test-near-type* (the-as type #f))
(define *mp-test-near-pos* (new 'global 'vector))

(defun mp-test-near-scan ((proc process-drawable))
  "iterate-process-tree callback: the process of type *mp-test-near-type* nearest *mp-test-near-pos*."
  (when (and (type? proc *mp-test-near-type*) (nonzero? (-> proc root)))
    (let ((d (vector-vector-distance (-> proc root trans) *mp-test-near-pos*)))
      (when (or (not *mp-test-near*) (< d *mp-test-near-dist*))
        (set! *mp-test-near* proc)
        (set! *mp-test-near-dist* d)
        )
      )
    )
  #f
  )

(defun mp-test-nearest ((typ type) (pos vector))
  "The process of type `typ` nearest to `pos`, or #f."
  (set! *mp-test-near* #f)
  (set! *mp-test-near-type* typ)
  (vector-copy! *mp-test-near-pos* pos)
  (iterate-process-tree *active-pool* (the-as (function object object) mp-test-near-scan) *null-kernel-context*)
  *mp-test-near*
  )

(defun mp-test-reference-pos ()
  "Where the object tests look: player 0 (the host) on a guest, ourselves on the host."
  (let ((st (if (= *mp-mode* (mp-mode client))
                (mp-remote-state 0)
                (the-as mp-player-state #f)
                )
            )
        )
    (cond
      (st (-> st trans))
      (*target* (-> *target* control trans))
      (else (the-as vector #f))
      )
    )
  )

(defun mp-test-log-object ((label string) (typ type))
  "Print the object of type `typ` nearest to the reference position: its entity, state and height."
  (let* ((pos (mp-test-reference-pos))
         (proc (if pos
                   (mp-test-nearest typ pos)
                   )
               )
         )
    (if proc
        (format
          0
          "[mp-test] ~S aid ~D state ~A at ~m height ~m~%"
          label
          (if (-> proc entity) (-> proc entity aid) 0)
          (if (-> proc next-state) (-> proc next-state name) #f)
          *mp-test-near-dist*
          (-> proc root trans y)
          )
        (format 0 "[mp-test] no ~S~%" label)
        )
    )
  (none)
  )

(defun mp-test-log ()
  "Print the multiplayer state: session, local player, every remote player and its puppet."
  (format 0 "[mp-test] log mode ~D slot ~D players ~D~%" *mp-mode* *mp-local-slot* (+ 1 (mp-player-count)))
  (when *target*
    ;; format takes at most 8 arguments (destination and format string included)
    (format
      0
      "[mp-test] local pos ~m ~m ~m hp ~f state ~A~%"
      (-> *target* control trans x)
      (-> *target* control trans y)
      (-> *target* control trans z)
      (-> *target* fact health)
      (mp-target-state-name)
      )
    (format
      0
      "[mp-test] local indax ~A pilot ~A level ~A~%"
      (focus-test? *target* indax)
      (focus-test? *target* pilot)
      (if (-> *target* current-level)
          (-> *target* current-level name)
          #f
          )
      )
    )
  (format
    0
    "[mp-test] world sent ~D received ~D replicas ~D asleep ~D~%"
    (-> *mp-actors-out* count)
    (-> *mp-actors-in* count)
    (-> *mp-world-state* replica-count)
    (-> *mp-world-state* suppressed-count)
    )
  (set! *mp-test-awake* 0)
  (set! *mp-test-asleep* 0)
  (iterate-process-tree *active-pool* (the-as (function object object) mp-test-npc-scan) *null-kernel-context*)
  (format 0 "[mp-test] authority ~A own npcs awake ~D asleep ~D~%" *mp-authority* *mp-test-awake* *mp-test-asleep*)
  (format 0 "[mp-test] poses skipped ~D hidden ~D~%" (-> *mp-pose* poses-skipped) (-> *mp-pose* poses-hidden))
  (format
    0
    "[mp-test] poses sent ~D applied ~D emitters sent ~D received ~D shown ~D~%"
    (-> *mp-pose* poses-sent)
    (-> *mp-pose* poses-applied)
    (-> *mp-pose* emitters-sent)
    (-> *mp-pose* emitters-received)
    (-> *mp-pose* emitters-shown)
    )
  (format 0 "[mp-test] sounds sent ~D played ~D~%" (-> *mp-pose* sounds-sent) (-> *mp-pose* sounds-played))
  (format
    0
    "[mp-test] last emitter kind ~D index ~D home #x~X~%"
    (-> *mp-pose* last-kind)
    (-> *mp-pose* last-index)
    (-> *mp-pose* last-home)
    )
  (format
    0
    "[mp-test] fx effects sent ~D shown ~D shots sent ~D shown ~D shot copies ~D~%"
    (-> *mp-fx* total-effects-sent)
    (-> *mp-fx* total-effects-shown)
    (-> *mp-fx* total-shots-sent)
    (-> *mp-fx* total-shots-shown)
    (-> *mp-world-state* shot-copies)
    )
  (format
    0
    "[mp-test] pvp hits taken ~D reacted ~D last pushed ~m~%"
    (-> *mp-hit-stats* taken)
    (-> *mp-hit-stats* reacted)
    (-> *mp-hit-stats* pushed)
    )
  ;; the local props sent with the player
  (when (and *target* (nonzero? (-> *target* gun)))
    (let ((gun (the-as process-drawable (ppointer->process (-> *target* gun gun))))
          (dax (the-as process-drawable (ppointer->process (-> *target* sidekick))))
          )
      (format 0 "[mp-test] props gun ~A skel ~A~%" gun (if (and gun (nonzero? (-> gun draw))) (mp-skel-of gun) #f))
      (format 0 "[mp-test] props dax ~A skel ~A~%" dax (if (and dax (nonzero? (-> dax draw))) (mp-skel-of dax) #f))
      (when gun
        (format 0 "[mp-test] props gun draw ~A skel-ctl ~A ag ~A jgeo ~A~%" (-> gun draw) (-> gun skel) (if (nonzero? (-> gun draw)) (-> gun draw art-group) #f) (if (nonzero? (-> gun draw)) (-> gun draw jgeo) #f))
        )
      )
    )
  ;; what the guest received, and the replica drawn for each
  (dotimes (i (min 8 (-> *mp-actors-in* count)))
    (let* ((st (-> *mp-actors-in* state i))
           (index (mp-replica-index (-> st id)))
           (rep (if (>= index 0)
                    (the-as mp-replica (handle->process (-> *mp-world-state* replica index)))
                    (the-as mp-replica #f)
                    )
                )
           )
      (string<-charp *mp-temp-string* (-> st skel))
      (format 0 "[mp-test] actor ~D ~S pos ~m ~m ~m anim ~D~%" (-> st id) *mp-temp-string* (-> st trans x) (-> st trans y) (-> st trans z) (-> st anim-index))
      ;; the copy of a shot without a model (mp-fx-copy) has no draw-control
      (if (and rep (nonzero? (-> rep draw)))
          (format
            0
            "[mp-test]   replica scale ~f seg #x~X channels ~D mgeo ~A~%"
            (-> rep root scale x)
            (-> rep draw seg-mask)
            (-> rep skel active-channels)
            (-> rep draw mgeo)
            )
          )
      (if rep
          (format
            0
            "[mp-test]   replica pos ~m ~m ~m draw #x~X level ~A state ~A~%"
            (-> rep root trans x)
            (-> rep root trans y)
            (-> rep root trans z)
            (if (nonzero? (-> rep draw))
                (-> rep draw status)
                0
                )
            (if (-> rep level) (-> rep level name) #f)
            (if (-> rep next-state) (-> rep next-state name) #f)
            )
          (format 0 "[mp-test]   no replica~%")
          )
      )
    )
  (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
    (format 0 "[mp-test] manager ~A~%" (if manager #t #f))
    (dotimes (i MP_MAX_PLAYERS)
      (let ((st (mp-remote-state i)))
        (when st
          (string<-charp *mp-temp-string* (-> st name))
          (format
            0
            "[mp-test] remote ~D ~S pos ~m ~m ~m hp ~f~%"
            i
            *mp-temp-string*
            (-> st trans x)
            (-> st trans y)
            (-> st trans z)
            (-> st health)
            )
          (format
            0
            "[mp-test] remote ~D flags #x~X anim ~D veh ~D puppet ~A drawn ~A~%"
            i
            (-> st flags)
            (-> st anim-index)
            (-> st veh-type)
            (if (and manager (handle->process (-> manager puppets i)))
                #t
                #f
                )
            (let ((puppet (if manager
                              (the-as mp-puppet (handle->process (-> manager puppets i)))
                              )
                          )
                  )
              (and puppet (not (logtest? (-> puppet draw status) (draw-control-status no-draw))))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-test-clip-skel ((who string))
  "The model `who` names (log-anim): \"daxter\" (the sidekick, whose model Daxter's mode draws), else Jak's."
  (if (string= who "daxter")
      (mp-character-skel #t 0)
      (mp-character-skel #f (mp-local-outfit))
      )
  )

(defun mp-test-face-player ((slot int))
  "Turn the player toward a remote player."
  (let ((st (mp-remote-state slot)))
    (when (and st *target*)
      (let ((dir (vector-! (new 'stack-no-clear 'vector) (-> st trans) (-> *target* control trans))))
        (set! (-> dir y) 0.0)
        (when (< 1.0 (vector-length dir))
          (vector-normalize! dir 1.0)
          (quaternion-look-at! (-> *target* control quat) dir *up-vector*)
          (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
          ;; the heading the player turns to every frame, or it turns back
          (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
          )
        )
      )
    )
  (none)
  )

(defun mp-test-skel-prefix? ((skel (pointer uint8)) (prefix string))
  "#t when the skeleton name, without its \"skel-\" part, starts with `prefix`."
  (let ((n (length prefix)))
    (dotimes (i n)
      (if (!= (-> skel (+ i 5)) (-> prefix data i))
          (return #f)
          )
      )
    )
  #t
  )

(defun mp-test-goto-npc ((prefix string) (dist float))
  "Stand `dist` from the first NPC received whose skeleton starts with `prefix`, facing it."
  (dotimes (i (-> *mp-actors-in* count))
    (let ((st (-> *mp-actors-in* state i)))
      (when (and *target* (mp-test-skel-prefix? (-> st skel) prefix))
        (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> st trans)))
              (dir (new 'stack-no-clear 'vector))
              )
          (+! (-> pos z) (- dist))
          (move-to-point! (-> *target* control) pos)
          (vector-! dir (-> st trans) pos)
          (set! (-> dir y) 0.0)
          (vector-normalize! dir 1.0)
          (quaternion-look-at! (-> *target* control quat) dir *up-vector*)
          (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
          ;; the heading the player turns to every frame, or it turns back
          (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
          (format 0 "[mp-test] next to npc ~D~%" (-> st id))
          (return #t)
          )
        )
      )
    )
  (format 0 "[mp-test] no npc ~S~%" prefix)
  #f
  )

(define *mp-test-crates* 0)
(define *mp-test-nearest* (the-as process-drawable #f))
(define *mp-test-nearest-dist* 0.0)

(defun mp-test-crate-scan ((proc process-drawable))
  "iterate-process-tree callback: count live crates, keep the nearest to the player."
  (when (and (type? proc crate) *target* (nonzero? (-> proc root)))
    (+! *mp-test-crates* 1)
    (let ((d (vector-vector-distance (-> proc root trans) (-> *target* control trans))))
      (when (or (not *mp-test-nearest*) (< d *mp-test-nearest-dist*))
        (set! *mp-test-nearest* proc)
        (set! *mp-test-nearest-dist* d)
        )
      )
    )
  #f
  )

(defun mp-test-orb-scan ((proc process-drawable))
  "iterate-process-tree callback: keep the nearest precursor orb (a collectable whose entity is of
   type skill) to the player."
  (when (and (type? proc collectable) *target* (nonzero? (-> proc root)) (-> proc entity)
             (= (-> (the-as entity-actor (-> proc entity)) etype symbol) 'skill)
             )
    (let ((d (vector-vector-distance (-> proc root trans) (-> *target* control trans))))
      (when (or (not *mp-test-nearest*) (< d *mp-test-nearest-dist*))
        (set! *mp-test-nearest* proc)
        (set! *mp-test-nearest-dist* d)
        )
      )
    )
  #f
  )

(define *mp-test-racers-stopped* 0)

(defun mp-test-stop-racer ((proc process-drawable))
  "iterate-process-tree callback (race-stop-racers): a vehicle of ours not driven by our player is
   removed (a race drives its racers every frame: they would not stop); its place in the race stays
   where it was."
  (when (and (type? proc process-drawable)
             (not (type? proc mp-replica))
             (mp-inherits? (-> proc type) 'vehicle)
             (!= proc (mp-local-vehicle))
             )
    (deactivate proc)
    (+! *mp-test-racers-stopped* 1)
    )
  #f
  )

(defun mp-test-flut-scan ((proc process-drawable))
  "iterate-process-tree callback: keep the nearest lizard waiting to be ridden (its idle state)."
  (when (and (type? proc flut) *target* (nonzero? (-> proc root)) (-> proc next-state)
             (= (-> proc next-state name) 'idle)
             )
    (let ((d (vector-vector-distance (-> proc root trans) (-> *target* control trans))))
      (when (or (not *mp-test-nearest*) (< d *mp-test-nearest-dist*))
        (set! *mp-test-nearest* proc)
        (set! *mp-test-nearest-dist* d)
        )
      )
    )
  #f
  )

(define *mp-test-flut-idle* 0)   ;; log-fluts: lizards within 40 m waiting to be ridden
(define *mp-test-flut-hidden* 0) ;; ... hidden (ridden, or taken by another player)
(define *mp-test-flut-second* 0) ;; ... seconds placed for co-op (named flut-mp)

(defun mp-test-flut-count ((proc process-drawable))
  "iterate-process-tree callback: count the lizards within 40 m of the player, by state."
  (when (and (type? proc flut) *target* (nonzero? (-> proc root)) (-> proc next-state)
             (< (vector-vector-distance (-> proc root trans) (-> *target* control trans)) (meters 40))
             )
    (case (-> proc next-state name)
      (('idle 'wait-for-start)
       (+! *mp-test-flut-idle* 1)
       )
      (('wait-for-return 'pickup)
       (+! *mp-test-flut-hidden* 1)
       )
      )
    (if (string= (-> proc name) "flut-mp")
        (+! *mp-test-flut-second* 1)
        )
    (format 0 "[mp-test] flut ~S state ~A at ~m entity-own ~A drawn ~A~%" (-> proc name) (-> proc next-state name)
            (vector-vector-distance (-> proc root trans) (-> *target* control trans))
            (and (-> proc entity) (= (-> proc entity extra process) proc))
            (not (logtest? (-> proc draw status) (draw-control-status no-draw)))
            )
    )
  #f
  )

(defun mp-test-mh-scan ((proc process-drawable))
  "iterate-process-tree callback: keep the nearest living Metal Head (an enemy that can carry a skull
   gem) to the player."
  (when (and (type? proc enemy) *target* (nonzero? (-> proc root))
             (> (-> (the-as enemy proc) enemy-info gem-joint) 0)
             (not (focus-test? (the-as enemy proc) dead))
             )
    (let ((d (vector-vector-distance (-> proc root trans) (-> *target* control trans))))
      (when (or (not *mp-test-nearest*) (< d *mp-test-nearest-dist*))
        (set! *mp-test-nearest* proc)
        (set! *mp-test-nearest-dist* d)
        )
      )
    )
  #f
  )

(defun mp-test-crates ()
  "Count the live crates (and find the nearest)."
  (set! *mp-test-crates* 0)
  (set! *mp-test-nearest* #f)
  (iterate-process-tree *active-pool* (the-as (function object object) mp-test-crate-scan) *null-kernel-context*)
  (format
    0
    "[mp-test] crates ~D nearest ~A at ~m~%"
    *mp-test-crates*
    (if *mp-test-nearest* (-> *mp-test-nearest* entity aid) #f)
    *mp-test-nearest-dist*
    )
  (none)
  )

(defun mp-test-run ()
  "Run the command in (-> *mp-test* line)."
  (format 0 "[mp-test] run ~S~%" (-> *mp-test* line))
  (when (mp-test-word)
    (let ((cmd (-> *mp-test* word)))
      (cond
        ((string= cmd "enable")
         (mp-set-enabled! #t)
         )
        ((string= cmd "name")
         (mp-test-word)
         (copy-string<-string *mp-name* (-> *mp-test* word))
         (mp-config-save!)
         )
        ((string= cmd "color")
         (set! (-> *mp-config* color) (mp-test-int))
         (mp-config-save!)
         )
        ((string= cmd "character")
         (set! (-> *mp-config* character) (mp-test-int))
         (mp-config-save!)
         )
        ((string= cmd "host")
         (mp-test-word)
         (copy-string<-string *mp-address* (-> *mp-test* word))
         (mp-host!)
         )
        ((string= cmd "join")
         (mp-test-word)
         (copy-string<-string *mp-address* (-> *mp-test* word))
         (mp-join!)
         )
        ((string= cmd "address")
         ;; address: the server address field only (Join Game connects to it)
         (mp-test-word)
         (copy-string<-string *mp-address* (-> *mp-test* word))
         )
        ((string= cmd "log-lobby")
         ;; log-lobby: the menu page shown, the title screen's entries, and the lobby as drawn
         (let ((menu (if *progress-process* (-> *progress-process* 0 current) 'none))
               (host-at -1)
               (join-at -1)
               )
           (dotimes (i (-> *title-pc* options length))
             (if (= (-> *title-pc* options i) *mp-title-host*)
                 (set! host-at i)
                 )
             (if (= (-> *title-pc* options i) *mp-title-join*)
                 (set! join-at i)
                 )
             )
           (format 0 "[mp-test] lobby menu ~A title ~D host-at ~D join-at ~D~%" menu (-> *title-pc* options length) host-at join-at)
           )
         (format 0 "[mp-test] lobby mode ~D players ~D coop ~A all-ready ~A ready ~A~%"
                 *mp-mode* (+ 1 (mp-player-count)) (mp-lobby-coop?) (mp-lobby-all-ready?) *mp-lobby-ready*
                 )
         (format 0 "[mp-test] lobby character ~D config-mode ~D coop-start ~D mission ~D max ~D~%" (-> *mp-config* character)
                 (-> *mp-config* mode) (-> *mp-session* coop-start) (-> *mp-session* coop-mission) (mp-max-players)
                 )
         (format 0 "[mp-test] lobby line ~S~%" (mp-lobby-mode-line *mp-lobby-line*))
         (format 0 "[mp-test] lobby countdown ~D ms, cancelled ~D s ago~%" (mp-lobby-countdown-ms)
                 (if (nonzero? (-> *mp-globals* lobby-cancel)) (/ (- (mp-now) (-> *mp-globals* lobby-cancel)) 300) -1)
                 )
         (dotimes (row (+ 1 (mp-player-count)))
           (let* ((slot (mp-lobby-slot row))
                  (st (mp-slot-state slot))
                  )
             (when st
               (string<-charp *mp-temp-string* (-> st name))
               (format 0 "[mp-test] lobby row ~D slot ~D name ~A character ~D status ~D~%" row slot *mp-temp-string*
                       (logand (-> st character) 15) (mp-lobby-status-id st slot)
                       )
               )
             )
           )
         )
        ((string= cmd "log-seat")
         (mp-test-log-seat)
         )
        ((string= cmd "log-joints")
         ;; log-joints: Daxter's joints (the sidekick's skeleton): index, name, parent
         (let ((dax (if *target*
                        (the-as process-drawable (ppointer->process (-> *target* sidekick)))
                        )
                    )
               )
           (when dax
             (let ((jgeo (-> dax draw jgeo)))
               (dotimes (i (-> jgeo length))
                 (format 0 "[mp-test] joint ~D ~S parent ~S~%" i (-> jgeo data i name)
                         (if (-> jgeo data i parent) (-> jgeo data i parent name) "none")
                         )
                 )
               )
             )
           )
         )
        ((string= cmd "log-anim")
         ;; log-anim <daxter|jak> <index>: the element at that index of the model's art group (a clip
         ;; is loaded when it is an art-joint-anim)
         (mp-test-word)
         (let* ((sg (mp-test-clip-skel (-> *mp-test* word)))
                (ag (art-group-get-by-name *level* (-> sg art-group-name) (the-as (pointer level) #f)))
                (index (mp-test-int))
                )
           (if (and ag (< index (-> ag length)))
               (format 0 "[mp-test] anim ~S ~D ~A~%" (-> sg art-group-name) index (-> ag data index))
               (format 0 "[mp-test] anim ~S ~D none~%" (-> sg art-group-name) index)
               )
           )
         )
        ((string= cmd "log-name")
         ;; log-name: the player name kept, and the on-screen keyboard's text
         (format 0 "[mp-test] name ~S keyboard ~S~%" *mp-name* (-> *mp-keyboard* edit))
         )
        ((string= cmd "log-session")
         ;; log-session: the game the host started (free roam, campaign), its unlocks and saves, the
         ;; shoulder Daxter
         (let ((closed 0))
           (dotimes (i (-> *game-info* sub-task-list length))
                 (if (and (nonzero? i) (logtest? (-> *game-info* sub-task-list i flags) (game-task-node-flag closed)))
                 (+! closed 1)
                 )
             )
           (format 0 "[mp-test] session kind ~A unlock-pending ~A saves ~D campaign ~,,1f closed ~D foreign ~A~%"
                   (-> *mp-session* kind) (-> *mp-session* unlock-pending) (-> *mp-session* saves) (mp-campaign-percent)
                   closed (-> *mp-join* foreign?)
                   )
           )
         (format 0 "[mp-test] session features #x~X vehicles #x~X secrets #x~X max ~D~%" (-> *game-info* features)
                 (-> *game-info* vehicles) (-> *game-info* secrets) (mp-max-players)
                 )
         (pc-mp-message *mp-status*)
         (format 0 "[mp-test] session status ~S mode ~D players ~D continue ~S~%" *mp-status* *mp-mode* (+ 1 (mp-player-count))
                 (if (-> *game-info* current-continue) (-> *game-info* current-continue name) "none")
                 )
         ;; a retail boot (run_mp_test.py --retail) has no debug segment
         (format 0 "[mp-test] session debug-segment ~A~%" *debug-segment*)
         (format 0 "[mp-test] session sidekick-hidden ~A sidekick ~A character ~D indax ~A city-win ~A~%"
                 (-> *mp-session* sidekick-hidden?) (and *target* (-> *target* sidekick) #t) (-> *mp-config* character)
                 (and *target* (focus-test? *target* indax))
                 (task-node-closed? (game-task-node city-win-resolution))
                 )
         )
        ((string= cmd "log-missions")
         ;; log-missions: the missions the co-op page offers (row, game-task, continue point)
         (format 0 "[mp-test] missions ~D~%" (mp-mission-count))
         (dotimes (i (min 12 (mp-mission-count)))
           (let ((task (mp-mission-task i)))
             (format 0 "[mp-test] mission ~D task ~D continue ~S~%" i task (-> *game-info* play-list task play-continue))
             )
           )
         )
        ((string= cmd "host-play-mission")
         ;; host-play-mission <name>: the host's Choose a mission in game, on the mission of that
         ;; play-list name (mp-host-play-mission), as X on it in START > Options > Multiplayer does
         (mp-test-word)
         (dotimes (i (-> *game-info* play-list length))
           (when (string= (-> *game-info* play-list i name) (-> *mp-test* word))
             (format 0 "[mp-test] host plays mission ~S (task ~D)~%" (-> *mp-test* word) i)
             (mp-host-play-mission i)
             )
           )
         )
        ((string= cmd "log-input")
         ;; log-input: what our buttons did: our state, the gun mod in use, the ammo of each color,
         ;; Daxter's shots, and whether the START menu is open over the running world
         (when *target*
           (format 0 "[mp-test] input state ~A gun ~D ammo ~,,1f ~,,1f ~,,1f ~,,1f " (mp-target-state-name)
                   (if (nonzero? (-> *target* gun)) (-> *target* gun using-gun-type) -1)
                   (-> *game-info* gun-ammo 0) (-> *game-info* gun-ammo 1) (-> *game-info* gun-ammo 2)
                   (-> *game-info* gun-ammo 3)
                   )
           (format 0 "daxter-shots ~D menu ~A live ~A~%" (-> *mp-daxter-gun* shots) (if *progress-process* #t #f)
                   (-> *mp-pause* live?)
                   )
           )
         )
        ((string= cmd "log-acts")
         ;; log-acts: the missions the mission pages offer, by act (count, the first three's tasks and names)
         (dotimes (a 3)
           (format 0 "[mp-test] act ~D missions ~D" (+ a 1) (mp-act-mission-count (+ a 1)))
           (dotimes (i (min 3 (mp-act-mission-count (+ a 1))))
             (let ((task (mp-act-mission-task (+ a 1) i)))
               (format 0 " ~D:~S" task (-> *game-info* play-list task name))
               )
             )
           (format 0 "~%")
           )
         )
        ((string= cmd "coop-start")
         ;; coop-start <0|1|2> [mission n]: how the co-op campaign starts (new, continue, the n-th mission)
         (set! (-> *mp-session* coop-start) (mp-test-int))
         (let ((n (mp-test-int)))
           (if (= (-> *mp-session* coop-start) 2)
               (set! (-> *mp-session* coop-mission) (mp-mission-task n))
               )
           )
         )
        ((string= cmd "go-state")
         ;; go-state <process type> <state>: the first process of that type goes to that virtual state
         ;; (a mission's task manager taken to a later step, its own code running from there)
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (mp-test-word)
         (let ((proc (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*))))
               (name (string->symbol (-> *mp-test* word)))
               )
           (let ((st (if proc (method-state (-> proc type) name) (the-as state #f))))
             (cond
               (st
                (format 0 "[mp-test] go-state ~A -> ~A~%" *mp-test-type-name* name)
                (go-process proc (the-as (state process) st))
                )
               (else
                 (format 0 "[mp-test] go-state: no ~A or no state ~A~%" *mp-test-type-name* name)
                 )
               )
             )
           )
         )
        ((string= cmd "log-econ")
         ;; log-econ: our balances as the host has them, the shop's answer, the host's accounts state
         (format 0 "[mp-test] econ orbs ~D trophies ~D items #x~X result ~D near ~A open ~A~%"
                 (-> *mp-econ* orbs) (-> *mp-econ* trophies) (-> *mp-econ* items) (-> *mp-econ* result) (-> *mp-econ* near?)
                 (-> *mp-econ* open?)
                 )
         (format 0 "[mp-test] econ host key ~S credits ~D refused ~D saves ~D game skill ~f~%" (-> *mp-econ* key)
                 (-> *mp-econ* credits) (-> *mp-econ* refused) (pc-mp-econ-saves) (-> *game-info* skill)
                 )
         (let ((mgr (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
           ;; the label drawn over his spot (in yellow, mp-draw-merchant-name) in the game's language
           ;; his model at the spot (mp-update-merchant-model): alive, drawn, where, his level's state
           (let ((k (if mgr (the-as process-drawable (handle->process (-> mgr kleiver))))))
             (format 0 "[mp-test] kleiver model ~A borrow ~A lkleever ~A" (if k #t #f) (and mgr (-> mgr kleiver-borrow?))
                     (level-status? *level* 'lkleever #f)
                     )
             (if k
                 (format 0 " at ~m from the spot drawn ~A" (vector-vector-distance (-> k root trans) *mp-merchant-pos*)
                         (not (logtest? (-> k draw status) (draw-control-status no-draw)))
                         )
                 )
             (format 0 "~%")
             ;; solid, his clip, how much he faces us (1 = straight at us), how far we stand
             (when (and k *target* (type? (-> k root) collide-shape))
               (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> k root quat)))
                     (to (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> k root trans)))
                     )
                 (set! (-> fwd y) 0.0)
                 (set! (-> to y) 0.0)
                 (vector-normalize! fwd 1.0)
                 (format 0 "[mp-test] kleiver solid ~A clip ~D facing ~,,2f we stand ~m~%"
                         (logtest? (-> (the-as collide-shape (-> k root)) root-prim prim-core action) (collide-action solid))
                         (-> mgr kleiver-anim)
                         (vector-dot fwd (vector-normalize! to 1.0))
                         (vector-vector-xz-distance (-> *target* control trans) (-> k root trans))
                         )
                 )
               )
             )
           (format 0 "[mp-test] merchant label ~S language ~D~%" (lookup-text! *common-text* (text-id progress-mp-merchant) #f)
                   (-> *setting-control* user-default language)
                   )
           (format 0 "[mp-test] merchant spot ~D at ~m ~m ~m icon ~A name-drawn ~D~%" (-> *mp-econ* spot)
                   (-> *mp-merchant-pos* x) (-> *mp-merchant-pos* y) (-> *mp-merchant-pos* z)
                   (and mgr (-> mgr merchant-icon) #t) (-> *mp-econ* tag-drawn)
                   )
           )
         )
        ((string= cmd "merchant-spot")
         ;; merchant-spot <i>: host, the merchant at spot i, sent to every player (their balances again)
         (when (= *mp-mode* (mp-mode host))
           (mp-merchant-set-spot (mp-test-int))
           (set! (-> *mp-econ* sent) (the-as uint 0))
           )
         )
        ((string= cmd "send-fail")
         ;; send-fail <process type>: the first process of that type (a mission's task manager) is
         ;; told to fail, as the mission's own code does ('fail)
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (let ((proc (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*)))))
           (format 0 "[mp-test] send-fail ~A: ~A~%" *mp-test-type-name* (if proc (send-event proc 'fail) 'none))
           )
         )
        ((string= cmd "spawn-fail-or-retry")
         ;; spawn-fail-or-retry: a failure offering retry (X) or quit (triangle), as the minigames'
         ;; (wascity-pre-game's fail-info): both back to our continue point, quit with a life reset
         (let ((params (new 'stack 'resetter-params))
               (cont (if (-> *game-info* current-continue) (-> *game-info* current-continue name) (the-as string #f)))
               )
           (set! (-> params message) (resetter-message mission-fail-or-retry))
           (set! (-> params flags) (resetter-flag))
           (set! (-> params fail continue) cont)
           (set! (-> params fail node) (game-task-node none))
           (set! (-> params fail reset-mode) 'life)
           (set! (-> params fail execute) #f)
           (set! (-> params retry continue) cont)
           (set! (-> params retry node) (game-task-node none))
           (set! (-> params retry reset-mode) 'try)
           (set! (-> params retry execute) #f)
           (set! (-> params reset-delay) (the-as uint 0))
           (set! (-> params task) (game-task none))
           (set! (-> params text-message) (the-as text-id 0))
           (format 0 "[mp-test] spawn-fail-or-retry at ~A: ~A~%" cont
                   (spawn-resetter! *resetter-control* params (the-as game-task-node-info #f))
                   )
           )
         )
        ((string= cmd "log-fail")
         ;; log-fail: our resetter (a mission's failure), our vote, the decision, the counters, and
         ;; each other player's failure flags
         (let ((r (the-as resetter (get-resetter *resetter-control*)))
               (f *mp-fail*)
               )
           (format 0 "[mp-test] fail resetter ~A state ~A message ~D grabbed ~A vote ~D decided ~A "
                   (if r #t #f) (if (and r (-> r next-state)) (-> r next-state name) 'none) (if r (the-as int (-> r params message)) -1)
                   (and r (-> r grabbed-player?)) (-> f vote) (-> f decided?)
                   )
           (format 0 "shown ~D sent ~D received ~D decisions ~D last ~D~%" (-> f shown) (-> f sent) (-> f received) (-> f decisions)
                   (-> f last)
                   )
           (dotimes (i MP_MAX_PLAYERS)
             (let ((st (mp-remote-state i)))
               (if st
                   (format 0 "[mp-test] fail remote ~D shown ~A retry ~A quit ~A~%" i (logtest? (-> st flags) (mp-flag fail-shown))
                           (logtest? (-> st flags) (mp-flag fail-retry)) (logtest? (-> st flags) (mp-flag fail-quit))
                           )
                   )
               )
             )
           )
         )
        ((string= cmd "walk-to-merchant")
         ;; walk-to-merchant <frames>: walk toward Kleiver's spot that many frames (the stick follows
         ;; the camera)
         (set! *mp-test-walk-frames* (mp-test-int))
         )
        ((string= cmd "goto-merchant")
         ;; goto-merchant [m]: stand at Kleiver's spot in Spargus (his shop), or m meters from it along
         ;; x, facing it
         (let ((m (mp-test-int)))
           (when *target*
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) *mp-merchant-pos*)))
               (+! (-> pos x) (* (meters 1) (the float m)))
               (move-to-point! (-> *target* control) pos)
               (vector-reset! (-> *target* control transv))
               (when (> m 0)
                 (let ((dir (vector-! (new 'stack-no-clear 'vector) *mp-merchant-pos* pos)))
                   (set! (-> dir y) 0.0)
                   (vector-normalize! dir 1.0)
                   (forward-up->quaternion (-> *target* control quat-for-control) dir (new 'static 'vector :y 1.0 :w 1.0))
                   (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))
                   (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
                   )
                 )
               )
             )
           )
         )
        ((string= cmd "goto-orb")
         ;; goto-orb: stand on the nearest precursor orb (a skill pickup with its entity): it is taken
         (set! *mp-test-nearest* #f)
         (iterate-process-tree *active-pool* (the-as (function object object) mp-test-orb-scan) *null-kernel-context*)
         (cond
           ((and *mp-test-nearest* *target*)
            (format 0 "[mp-test] orb entity ~D at ~m~%" (-> *mp-test-nearest* entity aid) *mp-test-nearest-dist*)
            (move-to-point! (-> *target* control) (-> *mp-test-nearest* root trans))
            (vector-reset! (-> *target* control transv))
            )
           (else
             (format 0 "[mp-test] orb none~%")
             )
           )
         )
        ((string= cmd "econ-claim")
         ;; econ-claim <aid>: claim an orb of entity aid we did not take (a cheat the host must refuse);
         ;; aid 0: the nearest orb, claimed from where we stand
         (let ((aid (mp-test-int)))
           (when (zero? aid)
             (set! *mp-test-nearest* #f)
             (iterate-process-tree *active-pool* (the-as (function object object) mp-test-orb-scan) *null-kernel-context*)
             (if *mp-test-nearest*
                 (set! aid (the-as int (-> *mp-test-nearest* entity aid)))
                 )
             )
           (if (= *mp-mode* (mp-mode host))
               (mp-econ-claim-orb *mp-local-slot* (the-as uint aid))
               (mp-send-event (mp-event-kind econ-pick) 0 aid 1.0)
               )
           )
         )
        ((string= cmd "econ-grant")
         ;; econ-grant <slot> <orbs>: the host credits a player (a test of the server's own accounts;
         ;; a guest's command does nothing: only the host keeps accounts)
         (let ((slot (mp-test-int))
               (n (mp-test-int))
               )
           (when (and (= *mp-mode* (mp-mode host)) (-> *mp-econ* open?))
             (pc-mp-econ-credit slot 0 n (mp-econ-player-name slot))
             (mp-econ-send slot 0)
             )
           )
         )
        ((string= cmd "kill-mh")
         ;; kill-mh <slot>: on the host, a lethal blow to the nearest Metal Head (an enemy that can
         ;; carry a skull gem) from player slot's character (ours, or its puppet): its real death,
         ;; credited by the economy to the player whose blow it was
         (let ((slot (mp-test-int))
               (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
               )
           (set! *mp-test-nearest* #f)
           (iterate-process-tree *active-pool* (the-as (function object object) mp-test-mh-scan) *null-kernel-context*)
           (let ((attacker (if (= slot *mp-local-slot*)
                               (the-as process *target*)
                               (if manager (handle->process (-> manager puppets slot)))
                               )
                           )
                 (mh *mp-test-nearest*)
                 )
             (cond
               ((and mh attacker)
                (format 0 "[mp-test] kill-mh ~A at ~m by player ~D~%" (-> mh type symbol) *mp-test-nearest-dist* slot)
                (send-event mh 'attack :from attacker #f
                            (static-attack-info :mask (vehicle-impulse-factor)
                              ((id (new-attack-id)) (mode 'generic) (damage 1000.0) (attacker (process->handle attacker))
                               (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0)
                               )
                              )
                            )
                )
               (else
                 (format 0 "[mp-test] kill-mh none (metal head ~A, attacker ~A)~%" mh attacker)
                 )
               )
             )
           )
         )
        ((string= cmd "die")
         ;; die: a blow that kills our player (co-op: back next to a living teammate)
         (when *target*
           (set! (-> *target* fact health) 1.0)
           (send-event *target* 'attack #f (static-attack-info :mask (vehicle-impulse-factor)
                                             ((id (new-attack-id)) (mode 'generic) (damage 100.0)
                                              (vehicle-damage-factor 1.0) (vehicle-impulse-factor 1.0)
                                              )
                                             )
                       )
           )
         )
        ((string= cmd "log-respawn")
         ;; log-respawn: times we came back next to a teammate, our state, health, the teammate's distance
         (format 0 "[mp-test] respawn ~D state ~A health ~,,1f teammate ~D~%" *mp-respawns* (mp-target-state-name)
                 (if *target* (-> *target* fact health) 0.0) (mp-living-teammate)
                 )
         (format 0 "[mp-test] spectate slot ~D left ~D ms shown ~D camera-on-puppet ~A~%" (-> *mp-spectate* slot)
                 (if (>= (-> *mp-spectate* slot) 0) (/ (- (-> *mp-spectate* until) (mp-now)) 300) 0) (-> *mp-spectate* shown)
                 (and (>= (-> *mp-spectate* slot) 0) *camera*
                      (= (handle->process (-> *camera* focus handle)) (mp-puppet-process (-> *mp-spectate* slot)))
                      )
                 )
         )
        ((string= cmd "shop-buy")
         ;; shop-buy <item>: buy shop item n, as the shop page's X does
         (mp-econ-request-buy (mp-test-int))
         )
        ((string= cmd "log-scene-skins")
         ;; log-scene-skins: each Jak or Daxter actor of the cutscene playing here, and the shirt and fur
         ;; tints it is drawn with this frame (0 none: the stock textures)
         (let ((sp (if *scene-player* (the-as scene-player (ppointer->process *scene-player*)))))
           (cond
             ((and sp (-> sp scene))
              (dotimes (i (-> sp scene actor length))
                (let* ((a (-> sp scene actor i))
                       (proc (the-as process-drawable (if (and (-> a name) (nonzero? (-> a process))) (handle->process (-> a process)))))
                       (row -1)
                       )
                  (when (and proc (or (string-prefix= "jak" (-> a name)) (string-prefix= "sidekick" (-> a name))))
                    (dotimes (k (-> *pc-merc-skins* count))
                      (if (= (-> *pc-merc-skins* dc k) (-> proc draw))
                          (set! row k)
                          )
                      )
                    (format 0 "[mp-test] scene actor ~S shirt #x~X fur #x~X~%" (-> a name)
                            (if (>= row 0) (-> *pc-merc-skins* tint (+ (* row 16) 1)) 0)
                            (if (>= row 0) (-> *pc-merc-skins* tint (+ (* row 16) 10)) 0)
                            )
                    )
                  )
                )
              )
             (else
               (format 0 "[mp-test] scene actor none~%")
               )
             )
           )
         )
        ((string= cmd "ride-flut")
         ;; ride-flut: on a lizard where we stand, as its 'change-mode does (flut.gc), normal mode
         (if *target*
             (send-event *target* 'change-mode 'flut (the-as handle #f) #t -1)
             )
         )
        ((string= cmd "goto-flut")
         ;; goto-flut: stand 2 m from the nearest lizard waiting to be ridden, facing it
         (set! *mp-test-nearest* #f)
         (iterate-process-tree *entity-pool* (the-as (function object object) mp-test-flut-scan) *null-kernel-context*)
         (cond
           ((and *mp-test-nearest* *target*)
            (let ((pos (new 'stack-no-clear 'vector))
                  (dir (vector-! (new 'stack-no-clear 'vector) (-> *target* control trans) (-> *mp-test-nearest* root trans)))
                  )
              (set! (-> dir y) 0.0)
              (vector-normalize! dir (meters 2))
              (vector+! pos (-> *mp-test-nearest* root trans) dir)
              (format 0 "[mp-test] flut at ~m~%" *mp-test-nearest-dist*)
              (move-to-point! (-> *target* control) pos)
              (vector-reset! (-> *target* control transv))
              (forward-up->quaternion (-> *target* control quat-for-control) (vector-negate! dir dir) (new 'static 'vector :y 1.0))
              (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))
              )
            )
           (else
             (format 0 "[mp-test] flut none~%")
             )
           )
         )
        ((string= cmd "log-fluts")
         ;; log-fluts: the lizards within 40 m (waiting, hidden, co-op seconds), whether we ride one,
         ;; and the co-op counters (seconds placed, hidden for another player, left where it got off)
         (set! *mp-test-flut-idle* 0)
         (set! *mp-test-flut-hidden* 0)
         (set! *mp-test-flut-second* 0)
         (iterate-process-tree *entity-pool* (the-as (function object object) mp-test-flut-count) *null-kernel-context*)
         (format 0 "[mp-test] fluts idle ~D hidden ~D seconds-near ~D riding ~A " *mp-test-flut-idle* *mp-test-flut-hidden*
                 *mp-test-flut-second* (and *target* (focus-test? *target* flut))
                 )
         (format 0 "placed ~D hides ~D shows ~D count ~D~%" (-> *mp-flut-watch* seconds) (-> *mp-flut-watch* hides)
                 (-> *mp-flut-watch* shows) (-> *game-info* flut-count)
                 )
         )
        ((string= cmd "log-mount")
         ;; log-mount: the lizard we ride as we send it (its process, the skeleton found for it)
         (let ((lizard (if *target* (the-as process-drawable (ppointer->process (-> *target* manipy))))))
           (format 0 "[mp-test] mount ~A flut ~A skel ~A~%" lizard (and *target* (focus-test? *target* flut))
                   (if (and lizard (type? lizard process-drawable) (nonzero? (-> lizard draw))) (mp-skel-of lizard) 'none)
                   )
           (if (and lizard (type? lizard process-drawable) (nonzero? (-> lizard draw)))
               (format 0 "[mp-test] mount art ~A jgeo ~A status #x~X~%" (-> lizard draw art-group) (-> lizard draw jgeo) (-> lizard draw status))
               )
           )
         )
        ((string= cmd "log-fldax")
         ;; log-fldax: Daxter on a lizard, his art on the player, the state
         (format 0 "[mp-test] fldax on ~A rides ~D art-on ~A daxter ~A state ~A~%" (-> *mp-fldax* on?) (-> *mp-fldax* rides)
                 (and *target* (-> *mp-fldax* art) (= (-> *target* draw art-group) (-> *mp-fldax* art)))
                 (and *target* (mp-playing-daxter? *target*)) (mp-target-state-name)
                 )
         )
        ((string= cmd "end-flut")
         ;; end-flut: off the lizard
         (if *target*
             (send-event *target* 'end-mode 'flut)
             )
         )
        ((string= cmd "eye-fix-off")
         ;; eye-fix-off: the eye fix undone, to see the bug again: our model of Jak playing Daxter
         ;; writes its eyes, the puppets feed none
         (set! *mp-test-eye-fix-off* #t)
         (let ((mgr (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
           (when mgr
             (dotimes (i MP_MAX_PLAYERS)
               (let ((pp (the-as process-drawable (handle->process (-> mgr puppets i)))))
                 (if (and pp (nonzero? (-> pp skel)))
                     (logclear! (-> pp skel status) (joint-control-status eye-anim))
                     )
                 )
               )
             )
           )
         )
        ((string= cmd "log-eyes")
         ;; log-eyes: each remote player's puppet, its eye slot and which process wrote it last
         (let ((mgr (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
           (when mgr
             (dotimes (i MP_MAX_PLAYERS)
               (let ((pp (the-as process-drawable (handle->process (-> mgr puppets i)))))
                 (when (and pp (nonzero? (-> pp draw)) (nonzero? (-> pp draw mgeo header eye-ctrl)))
                   (let* ((idx (-> pp draw mgeo header eye-ctrl eye-ctrl-index))
                          (by (handle->process (-> *eye-control-array* data idx process)))
                          )
                     (format 0 "[mp-test] eyes player ~D slot ~D by ~A puppet ~A target ~A~%" i idx
                             (if by (-> by name) "none") (= by pp) (= by *target*)
                             )
                     )
                   )
                 )
               )
             )
           )
         )
        ((string= cmd "restart")
         ;; restart: START > Restart (restart-mission), as the pause menu runs it
         (restart-mission)
         )
        ((string= cmd "log-restart")
         ;; log-restart: restarts done here, online mode, master mode, our state
         (format 0 "[mp-test] restart count ~D mode ~A master ~A state ~A~%" (-> *mp-session* restarts) *mp-mode*
                 *master-mode* (mp-target-state-name)
                 )
         )
        ((string= cmd "open-menu")
         ;; open-menu <page>: the START menu opened on that page (multiplayer: Options > Multiplayer)
         (mp-test-word)
         (activate-progress *dproc* (string->symbol (-> *mp-test* word)))
         )
        ((string= cmd "econ-grant-self")
         ;; econ-grant-self <0|1>: the Mods menu's host entries, +100 precursor orbs (0) or trophies (1)
         (mp-econ-grant-self (mp-test-int))
         )
        ((string= cmd "net")
         ;; net <latency ms> <jitter ms> <loss %>: the test network from now on (what we receive)
         (let* ((latency (mp-test-int))
                (jitter (mp-test-int))
                (loss (mp-test-int))
                )
           (pc-mp-test-network latency jitter loss)
           )
         )
        ((string= cmd "log-net")
         ;; log-net: each peer's network pressure, qualities both ways, queueing, bytes sent last second
         (pc-mp-log-net)
         )
        ((string= cmd "log-end")
         ;; log-end: sessions ended without us, the note for the title screen, where we are
         (format 0 "[mp-test] end count ~D pending ~A note ~S title ~A menu ~A~%" (-> *mp-end* count) (-> *mp-end* pending?)
                 *mp-end-text* (= (level-status? *level* 'title #f) 'active)
                 (if *progress-process* (-> *progress-process* 0 current) 'none)
                 )
         )
        ((string= cmd "goto-type")
         ;; goto-type <process type>: stand 1.5 m in front of the first process of that type, facing it
         ;; (a mission giver to talk to)
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (let ((proc (the-as process-drawable
                             (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*)))
                             )
                     )
               )
           (cond
             ((and proc *target* (type? proc process-drawable) (nonzero? (-> proc root)))
              (let ((pos (new 'stack-no-clear 'vector))
                    (fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> proc root quat)))
                    )
                (vector+float*! pos (-> proc root trans) fwd (meters 1.5))
                (move-to-point! (-> *target* control) pos)
                (vector-reset! (-> *target* control transv))
                (vector-negate! fwd fwd)
                (forward-up->quaternion (-> *target* control quat-for-control) fwd (new 'static 'vector :y 1.0))
                (quaternion-copy! (-> *target* control quat) (-> *target* control quat-for-control))
                (format 0 "[mp-test] at ~A~%" proc)
                )
              )
             (else
               (format 0 "[mp-test] no ~A~%" *mp-test-type-name*)
               )
             )
           )
         )
        ((string= cmd "respawn-manager")
         ;; respawn-manager <process type>: that task manager killed, then spawned again by the
         ;; task masks, as when its mission starts (its node open, its level active)
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (let ((proc (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*)))))
           (when proc
             (deactivate proc)
             ;; as after a story step our play closed (what a mission start follows)
             (set! (-> *mp-session* step-at) (mp-now))
             (update-task-masks 'event)
             )
           (format 0 "[mp-test] manager ~A respawned ~A gathered ~D~%" *mp-test-type-name* (if proc #t #f) *mp-missions-gathered*)
           )
         )
        ((string= cmd "log-state")
         ;; log-state <process type>: the state of the first process of that type, and where we stand
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (let ((proc (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*)))))
           (format 0 "[mp-test] state ~A ~A~%" *mp-test-type-name* (if (and proc (-> proc state)) (-> proc state name) 'none))
           )
         )
        ((string= cmd "coop-mission-intro")
         ;; coop-mission-intro: the next coop-mission starts at its introduction (its pre-play node
         ;; and continue point, next to whoever gives the mission), not at the mission itself
         (set! *mp-test-coop-intro* #t)
         )
        ((string= cmd "coop-mission")
         ;; coop-mission <name>: co-op starts at the mission of that play-list name (desert-course-race...)
         (mp-test-word)
         (dotimes (i (-> *game-info* play-list length))
           (when (string= (-> *game-info* play-list i name) (-> *mp-test* word))
             (set! (-> *mp-session* coop-start) 2)
             (set! (-> *mp-session* coop-mission) i)
             (format 0 "[mp-test] co-op mission ~S (task ~D, continue ~S)~%" (-> *mp-test* word) i
                     (-> *game-info* play-list i play-continue)
                     )
             )
           )
         )
        ((string= cmd "leave")
         (mp-leave!)
         )
        ((string= cmd "continue")
         (mp-test-word)
         (let ((cp (get-continue-by-name *game-info* (-> *mp-test* word))))
           (if (and cp *target*)
               (send-event *target* 'continue cp)
               (format 0 "[mp-test] cannot continue to ~S~%" (-> *mp-test* word))
               )
           )
         )
        ((string= cmd "press")
         ;; press <button> <ms> [lx ly]: the button held, with the left stick when given (moving
         ;; while firing)
         (mp-test-word)
         (let* ((bit (mp-test-button (-> *mp-test* word)))
                (ms (mp-test-int))
                (lx (if (mp-test-word)
                        (string->int (-> *mp-test* word))
                        128
                        )
                    )
                (ly (if (mp-test-word)
                        (string->int (-> *mp-test* word))
                        128
                        )
                    )
                )
           (pc-mp-test-pad bit lx ly 128 128)
           (set! (-> *mp-test* pad-until) (+ (mp-now) (/ (* ms 300) 1000)))
           )
         )
        ((string= cmd "stick")
         (let* ((lx (mp-test-int))
                (ly (mp-test-int))
                )
           (pc-mp-test-pad 0 lx ly 128 128)
           (set! (-> *mp-test* pad-until) (+ (mp-now) (/ (* (mp-test-int) 300) 1000)))
           )
         )
        ((string= cmd "stick-r")
         ;; stick-r <rx> <ry> <ms>: the right stick (camera), as a player looking around
         (let* ((rx (mp-test-int))
                (ry (mp-test-int))
                )
           (pc-mp-test-pad 0 128 128 rx ry)
           (set! (-> *mp-test* pad-until) (+ (mp-now) (/ (* (mp-test-int) 300) 1000)))
           )
         )
        ((string= cmd "ride-shown-elevator")
         ;; once this machine started an elevator trip because another player did (shown), stand
         ;; 1 m beside player 0: on the elevator it rides, which this machine moves; once only
         (let ((st (mp-remote-state 0)))
           (when (and st *target* (> (-> *mp-world-state* elevator-trips-shown) 0) (not (-> *mp-test-misc* rode?)))
             (set! (-> *mp-test-misc* rode?) #t)
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> st trans))))
               (+! (-> pos x) (meters 1))
               (move-to-point! (-> *target* control) pos)
               (format 0 "[mp-test] rides the elevator the host started~%")
               )
             )
           )
         )
        ((string= cmd "goto-player")
         ;; goto-player <slot> [x] [z]: stand that many meters from the player along x and z, else
         ;; next to it (teleport through its continue point when far)
         (let* ((slot (mp-test-int))
                (dx (mp-test-int))
                (dz (mp-test-int))
                (st (mp-remote-state slot))
                )
           (cond
             ((and st *target* (or (nonzero? dx) (nonzero? dz)))
              (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> st trans))))
                (+! (-> pos x) (* (meters 1) (the float dx)))
                (+! (-> pos z) (* (meters 1) (the float dz)))
                (move-to-point! (-> *target* control) pos)
                )
              )
             (else
               (set! *mp-request-teleport* slot)
               )
             )
           )
         )
        ((string= cmd "goto-behind")
         ;; goto-behind <slot> <meters>: stand that far behind the player (against the way it faces),
         ;; behind its camera, out of its view
         (let* ((st (mp-remote-state (mp-test-int)))
                (dist (* (meters 1) (the float (mp-test-int))))
                )
           (when (and st *target*)
             (let ((fwd (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> st quat)))
                   (pos (vector-copy! (new 'stack-no-clear 'vector) (-> st trans)))
                   )
               (set! (-> fwd y) 0.0)
               (vector-normalize! fwd dist)
               (vector-! pos pos fwd)
               (move-to-point! (-> *target* control) pos)
               )
             )
           )
         )
        ((string= cmd "log-vanished")
         ;; copies of other players' NPCs removed or hidden alive within 40 m of us
         (format 0 "[mp-test] copies vanished near us ~D faded ~D~%" (-> *mp-world-state* vanished-near)
                 (-> *mp-world-state* faded-near)
                 )
         )
        ((string= cmd "trace-fx")
         ;; trace-fx: log each effect another player's machine sent and we replay
         (set! *mp-trace-fx* #t)
         )
        ((string= cmd "trace-vanish")
         (set! *mp-trace-vanish* #t)
         )
        ((string= cmd "log-crates")
         (mp-test-crates)
         )
        ((string= cmd "goto-crate")
         ;; stand 1.5 m from the nearest crate, facing it
         (mp-test-crates)
         (when (and *mp-test-nearest* *target*)
           (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> *mp-test-nearest* root trans)))
                 (dir (new 'stack-no-clear 'vector))
                 )
             (+! (-> pos z) (meters -1.5))
             (move-to-point! (-> *target* control) pos)
             (vector-! dir (-> *mp-test-nearest* root trans) pos)
             (set! (-> dir y) 0.0)
             (vector-normalize! dir 1.0)
             (quaternion-look-at! (-> *target* control quat) dir *up-vector*)
             (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
             ;; the heading the player turns to every frame, or it turns back
             (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
             )
           )
         )
        ((string= cmd "goto-npc")
         ;; goto-npc <prefix> [meters]: 1.5 m from it unless given
         (mp-test-word)
         (let ((prefix (copy-string<-string *mp-temp-string* (-> *mp-test* word)))
               (dist (mp-test-int))
               )
           (mp-test-goto-npc prefix (if (> dist 0)
                                        (meters (the float dist))
                                        (meters 1.5)
                                        )
                             )
           )
         )
        ((string= cmd "kill-own")
         ;; kill-own <prefix>: the first of our vehicles we send whose skeleton starts with prefix
         ;; takes a blow from our player that leaves it no hit points: it crashes and blows up as
         ;; the game makes it
         (mp-test-word)
         (let ((done? #f))
           (dotimes (i (-> *mp-actors-out* count))
             (let ((st (-> *mp-actors-out* state i))
                   (proc (handle->process (-> *mp-pose* obj i)))
                   )
               (when (and (not done?)
                          proc
                          *target*
                          (= (mp-actor-kind proc) 2)
                          (mp-test-skel-prefix? (-> st skel) (-> *mp-test* word))
                          )
                 (send-event
                   proc
                   'attack
                   :from *target*
                   #f
                   (static-attack-info
                     :mask (vehicle-impulse-factor)
                     ((id (new-attack-id))
                      (mode 'explode)
                      (damage 100.0)
                      (attacker (process->handle *target*))
                      (vehicle-damage-factor 1.0)
                      (vehicle-impulse-factor 1.0)
                      )
                     )
                   )
                 (format 0 "[mp-test] kill-own ~S~%" (string<-charp *mp-temp-string* (-> st skel)))
                 (set! done? #t)
                 )
               )
             )
           )
         )
        ((string= cmd "goto-own")
         ;; goto-own <prefix>: stand 8 m from the first of our NPCs we send whose skeleton (without
         ;; "skel-") starts with prefix, facing it
         (mp-test-word)
         (let ((done? #f))
         (dotimes (i (-> *mp-actors-out* count))
           (let ((st (-> *mp-actors-out* state i)))
             (when (and (not done?) *target* (mp-test-skel-prefix? (-> st skel) (-> *mp-test* word)))
               (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> st trans)))
                     (dir (new 'stack-no-clear 'vector))
                     )
                 (+! (-> pos z) (meters -8))
                 (move-to-point! (-> *target* control) pos)
                 (set-vector! dir 0.0 0.0 1.0 1.0)
                 (quaternion-look-at! (-> *target* control quat) dir *up-vector*)
                 (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
                 (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
                 (format 0 "[mp-test] goto-own ~S~%" (string<-charp *mp-temp-string* (-> st skel)))
                 (set! done? #t)
                 )
               )
             )
           )
           )
         )
        ((string= cmd "goto-actor")
         ;; stand 3 m from the n-th NPC received from the host, facing it
         (let ((n (mp-test-int)))
           (when (and *target* (< n (-> *mp-actors-in* count)))
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> *mp-actors-in* state n trans)))
                   (dir (new 'stack-no-clear 'vector))
                   )
               (+! (-> pos z) (meters -3))
               (move-to-point! (-> *target* control) pos)
               (set-vector! dir 0.0 0.0 1.0 1.0)
               (quaternion-look-at! (-> *target* control quat) dir *up-vector*)
               (quaternion-copy! (-> *target* control quat-for-control) (-> *target* control quat))
               ;; the heading the player turns to every frame, or it turns back
               (quaternion-copy! (-> *target* control dir-targ) (-> *target* control quat))
               )
             )
           )
         )
        ((string= cmd "face-player")
         (mp-test-face-player (mp-test-int))
         )
        ((string= cmd "look-player")
         ;; look-player <slot>: face that player, the camera put 6 m behind us and 2 m up on the
         ;; line to that player, 1.5 m to the side, looking at us (a screenshot then shows that player
         ;; ahead)
         (let* ((slot (mp-test-int))
                (st (mp-remote-state slot))
                )
           (mp-test-face-player slot)
           (when (and st *target*)
             (let ((dir (vector-! (new 'stack-no-clear 'vector) (-> st trans) (-> *target* control trans)))
                   (pos (new 'stack-no-clear 'vector))
                   )
               (set! (-> dir y) 0.0)
               (vector-normalize! dir 1.0)
               (vector+float*! pos (-> *target* control trans) dir (meters -6))
               (+! (-> pos y) (meters 2))
               ;; 1.5 m to the side: our own model does not cover that player
               (+! (-> pos x) (* (meters 1.5) (-> dir z)))
               (+! (-> pos z) (* (meters -1.5) (-> dir x)))
               (send-event *camera* 'teleport-to-vector-start-string pos)
               )
             )
           )
         )
        ((string= cmd "cheat")
         (mp-test-word)
         (let ((which (-> *mp-test* word)))
           (cond
             ((string= which "ammo") (mp-cheat-ammo))
             ((string= which "health") (mp-cheat-health))
             ((string= which "dark") (mp-cheat-dark-eco))
             ((string= which "light") (mp-cheat-light-eco))
             ((string= which "invuln") (set! *mp-invulnerable* (not *mp-invulnerable*)))
             ((string= which "weapons") (mp-give-all-weapons))
             )
           )
         )
        ((string= cmd "gun")
         ;; gun [pickup-type]: unlock every gun mod with ammo and take the gun out; with a
         ;; pickup-type (26 red-1 ... 31 yellow-3 ... 35 dark-1 ... 37 dark-3), switch to that mod
         (let ((kind (mp-test-int)))
           (logior! (-> *game-info* features) (game-feature gun))
           (dotimes (i 12)
             (logior! (-> *game-info* features) (the-as game-feature (ash 1 (+ i 6))))
             )
           (dotimes (i 4)
             (set! (-> *game-info* gun-ammo i) 100.0)
             )
           (when *target*
             (send-event *target* 'change-mode 'gun #f (pickup-type gun-yellow-1))
             (if (and (>= kind 26) (<= kind 37))
                 (send-event *target* 'gun-type kind)
                 )
             )
           )
         )
        ((string= cmd "daxter-mod")
         ;; daxter-mod <pickup-type>: the mod Daxter fires, as the D-pad chooses it in his mode
         (if *target*
             (set! (-> *target* gun using-gun-type) (the-as pickup-type (mp-test-int)))
             )
         )
        ((string= cmd "log-daxter-gun")
         ;; log-daxter-gun: Daxter's gun: out, mod, shots fired, ammo of that mod, gun place and aim
         (let* ((dg *mp-daxter-gun*)
                (ammo (if (>= (-> dg gun-type) 26) (the-as int (gun->ammo (the-as pickup-type (-> dg gun-type)))) 15))
                )
           (format 0 "[mp-test] daxter-gun out ~A mod ~D shots ~D ammo ~,,1f indax ~A~%"
                   (-> dg out?) (-> dg gun-type) (-> dg shots) (-> *game-info* gun-ammo (+ ammo -15))
                   (and *target* (focus-test? *target* indax))
                   )
           (format 0 "[mp-test] daxter-gun aim ~,,2f ~,,2f ~,,2f~%" (-> dg aim x) (-> dg aim y) (-> dg aim z))
           (when *target*
             (format 0 "[mp-test] daxter-gun at ~,,2m from Daxter, features #x~X~%"
                     (vector-vector-distance (-> *target* gun gun-pos trans) (-> *target* control trans))
                     (-> *game-info* features)
                     )
             ;; his clip holding the gun (upper body), and the gun to his hand (the sidekick's gun joint)
             (let ((gp (the-as process-drawable (ppointer->process (-> *target* gun gun)))))
               (format 0 "[mp-test] daxter-gun scale ~,,2f state ~A~%"
                       (-> *target* gun gun-pos scale x)
                       (if gp
                           (-> gp next-state name)
                           )
                       )
               ;; the gun model: where it is drawn from his right hand, its draw status, its clip
               (when (and gp (nonzero? (-> *target* sidekick)))
                 (format 0 "[mp-test] daxter-gun model ~,,2m from his right hand, status #x~X clip ~A~%"
                         (vector-vector-distance (-> gp root trans) (-> *target* sidekick 0 node-list data 23 bone transform trans))
                         (-> gp draw status)
                         (if (> (-> gp skel active-channels) 0) (-> gp skel root-channel 0 frame-group))
                         )
                 )
               )
             (format 0 "[mp-test] daxter-gun clip ~D frame ~,,1f daxter ~,,2f select #x~X hand ~,,2m~%"
                     (-> dg top-index) (-> dg top-frame) (-> *target* gun gun-daxter)
                     (if (nonzero? (-> *target* sidekick)) (-> *target* sidekick 0 skel interp-select 0) 0)
                     (if (nonzero? (-> *target* sidekick))
                         (vector-vector-distance
                           (-> *target* gun gun-pos trans)
                           (-> *target* sidekick 0 node-list data 28 bone transform trans)
                           )
                         -1.0
                         )
                     )
             )
           ;; the clip each other player's Daxter holds the gun with, as its state says
           (dotimes (i MP_MAX_PLAYERS)
             (let ((st (mp-remote-state i)))
               (if (and st (>= (-> st top-index) 0))
                   (format 0 "[mp-test] daxter-gun player ~D clip ~D frame ~,,1f~%" i (-> st top-index) (-> st top-frame))
                   )
               )
             )
           )
         )
        ((string= cmd "unlock-board")
         ;; unlock-board: the hoverboard and its zap unlocked, nothing more (R2 then takes it out)
         (logior! (-> *game-info* features) (game-feature board board-zap))
         )
        ((string= cmd "board")
         ;; unlock the hoverboard and its zap, and get on it
         (logior! (-> *game-info* features) (game-feature board board-zap))
         (if *target*
             (send-event *target* 'change-mode 'board #f)
             )
         )
        ((string= cmd "vehicle")
         ;; vehicle <vehicle-type>: get in a new vehicle of that type where the player stands
         (let ((vtype (mp-test-int)))
           (if *target*
               (send-event *target* 'change-mode (mp-pilot-mode) #f vtype #t)
               )
           )
         )
        ((string= cmd "spawn-vehicle")
         ;; spawn-vehicle <vehicle-type>: an empty vehicle of that type 3 m in front of the player, as
         ;; the target spawns one for 'change-mode 'pilot #f (engine/target/target-handler.gc)
         (let ((vtype (mp-test-int)))
           (when *target*
             (let ((params (new 'stack 'traffic-object-spawn-params)))
               (set! (-> params object-type) (traffic-type guard-a))
               (set! (-> params behavior) (the-as uint 4))
               (set! (-> params id) (the-as uint 0))
               (set! (-> params nav-mesh) #f)
               (set! (-> params nav-branch) #f)
               (set! (-> params proc) #f)
               (set! (-> params handle) (the-as handle #f))
               (set! (-> params user-data) (the-as uint 0))
               (set! (-> params flags) (traffic-spawn-flags tsf5 tsf6))
               (set! (-> params guard-type) (the-as uint 11))
               (set! (-> params entity) #f)
               (vector-reset! (-> params velocity))
               (vector+float*!
                 (-> params position)
                 (-> *target* control trans)
                 (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> *target* control quat))
                 (meters 3)
                 )
               (+! (-> params position y) (meters 1))
               (quaternion-copy! (-> params rotation) (-> *target* control quat))
               (format 0 "[mp-test] spawned ~A~%" (vehicle-spawn (the-as vehicle-type vtype) params))
               )
             )
           )
         )
        ((string= cmd "zone")
         (mp-teleport-zone (mp-test-int))
         )
        ((string= cmd "screenshot")
         (mp-test-word)
         (pc-mp-test-screenshot (-> *mp-test* word))
         )
        ((string= cmd "log")
         (mp-test-log)
         )
        ((string= cmd "log-pose-own")
         ;; printed by the manager from this frame on, `frames` frames (mp-test-own-flush)
         (mp-test-word)
         (let ((rq *mp-test-own*))
           (when (< (-> rq count) 8)
             ;; the name first: reading the frame count overwrites the word
             (copy-string<-string (-> rq kind (-> rq count)) (-> *mp-test* word))
             (set! (-> rq frames (-> rq count)) (max 1 (mp-test-int)))
             (+! (-> rq count) 1)
             )
           )
         )
        ((string= cmd "log-pose-copy")
         (let ((slot (mp-test-int)))
           (mp-test-word)
           (mp-test-log-copies slot (-> *mp-test* word))
           )
         )
        ((string= cmd "log-tasks")
         (mp-test-log-tasks)
         )
        ((string= cmd "wait-joined")
         ;; the script waits until this guest is in the host's world, next to it
         (set! (-> *mp-test-wait* kind) 'joined)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-menu")
         ;; the script waits until the menu shows page <name> (title, mp-host-game, mp-lobby-join...)
         (mp-test-word)
         (set! (-> *mp-test-wait* menu) (string->symbol (-> *mp-test* word)))
         (set! (-> *mp-test-wait* since) 0)
         (set! (-> *mp-test-wait* kind) 'menu)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-countdown")
         ;; the script waits until the lobby's start countdown runs (the host's, for a guest)
         (set! (-> *mp-test-wait* kind) 'countdown)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-pause")
         ;; the script waits until the host's pause for everyone is on (1) or off (0) here
         (set! (-> *mp-test-wait* slot) (mp-test-int))
         (set! (-> *mp-test-wait* kind) 'pause)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "race-gate")
         ;; race-gate: a race start of a test, waiting as the races' task managers do (mp-race-hold?)
         (process-spawn mp-test-race-gate :name "mp-test-race-gate" :to *default-pool* :stack-size #x4000)
         )
        ((string= cmd "log-race")
         ;; log-race: the race start waiting here, the players aboard, starts, vehicles got, our state
         (format 0 "[mp-test] race waiting ~A aboard ~D/~D starts ~D gifts ~D exit ~A~%" (mp-race-waiting?) (-> *mp-race* aboard)
                 (-> *mp-race* players) (-> *mp-race* starts) (-> *mp-race* gifts) (-> *setting-control* user-current pilot-exit)
                 )
         (format 0 "[mp-test] race me driving ~A riding ~A perched ~A state ~A~%" (logtest? (-> *mp-local* flags) (mp-flag driving))
                 (logtest? (-> *mp-local* flags) (mp-flag riding)) (logtest? (-> *mp-local* flags) (mp-flag perched)) (mp-target-state-name)
                 )
         (let ((r *mp-race*))
           (format 0 "[mp-test] race place ~D progress ~,,3f bits ~D node ~D in-race ~A context ~A~%" (-> *game-info* race-position)
                   (-> r slot-progress (-> r own-slot)) (-> r slot-bits (-> r own-slot)) (-> r own-node)
                   (< (- (mp-now) (-> r in-race-at)) (seconds 1)) (mp-race-context?)
                   )
           (format 0 "[mp-test] race bound ~D slot ~D partner ~D (~D) verdict ~D~%"
                   (-> r bound-node) (-> r own-slot) (-> r partner-slot) (-> r partner) (-> r verdict)
                   )
           (format 0 "[mp-test] race host-race ~D sent ~,,1f s ago~%" (-> r host-count)
                   (* 0.0033333334 (the float (- (mp-now) (-> r host-time))))
                   )
           (format 0 "[mp-test] race slots ~,,2f ~,,2f ~,,2f ~,,2f ~,,2f~%" (-> r slot-progress 0) (-> r slot-progress 1)
                   (-> r slot-progress 2) (-> r slot-progress 3) (-> r slot-progress 4)
                   )
           )
         )
        ((string= cmd "race-stop-racers")
         ;; race-stop-racers: every vehicle of ours but our player's stops (a race's racers), so the
         ;; players finish first
         (set! *mp-test-racers-stopped* 0)
         (iterate-process-tree *active-pool* (the-as (function object object) mp-test-stop-racer) *null-kernel-context*)
         (format 0 "[mp-test] racers stopped ~D~%" *mp-test-racers-stopped*)
         )
        ((string= cmd "race-autopilot")
         ;; race-autopilot: once a race runs (its timer going), the vehicle we drive is driven by the
         ;; racers' AI ('set-control-hook-race-ai, wvehicle.gc), to the finish
         (let ((veh (mp-local-vehicle)))
           (when (and veh (> (-> *game-info* race-timer) 0))
             (send-event veh 'set-control-hook-race-ai)
             )
           (format 0 "[mp-test] race autopilot ~A timer ~D~%" (if (and veh (> (-> *game-info* race-timer) 0)) #t #f)
                   (-> *game-info* race-timer)
                   )
           )
         )
        ((string= cmd "goto-own-vehicle")
         ;; goto-own-vehicle: stand 2.5 m beside the vehicle we drove last (and left)
         (let ((veh (the-as process-drawable (handle->process (-> *mp-globals* last-vehicle)))))
           (when (and veh *target*)
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> veh root trans))))
               (vector+float*! pos pos (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> veh root quat)) (meters 2.5))
               (move-to-point! (-> *target* control) pos)
               (vector-reset! (-> *target* control transv))
               )
             )
           (format 0 "[mp-test] own vehicle ~A~%" (if veh #t #f))
           (let ((last (the-as process-drawable (handle->process (-> *mp-globals* last-vehicle)))))
             (format 0 "[mp-test] last vehicle ~A draw #x~X asleep ~A~%" last (if last (-> last draw status) 0)
                     (and last (logtest? (-> last mask) (process-mask sleep)))
                     )
             )
           )
         )
        ((string= cmd "beam-at-host")
         ;; beam-at-host <dx> <dz>: a waypoint beam dx, dz meters from the host, whose process checks
         ;; that we are within 3 m of it with (target-pos 0), as missions do
         (let* ((host (if (= *mp-mode* (mp-mode host)) *mp-local* (mp-remote-state 0)))
                (pos (new 'stack-no-clear 'vector))
                )
           (when host
             (vector-copy! pos (-> host trans))
             (+! (-> pos x) (meters (the float (mp-test-int))))
             (+! (-> pos z) (meters (the float (mp-test-int))))
             (process-spawn mp-test-beam pos :name "mp-test-beam" :to *default-pool* :stack-size #x4000)
             )
           )
         )
        ((string= cmd "goto-beam")
         ;; goto-beam: stand at the nearest waypoint beam
         (when (and *target* (> (-> *mp-beams* count) 0))
           (move-to-point! (-> *target* control) (-> *mp-beams* pos 0))
           (vector-reset! (-> *target* control transv))
           )
         )
        ((string= cmd "log-beams")
         ;; log-beams: the beams shown, how far their owner sees us, the count, the test beam reached
         (format 0 "[mp-test] beams ~D here ~D/~D near ~A held ~D reached ~D~%" (-> *mp-beams* count) (-> *mp-beams* here)
                 (-> *mp-beams* players) (-> *mp-beams* near?) (-> *mp-beams* held) *mp-test-beams-reached*
                 )
         ;; the count at the bottom of the screen: frames drawn, its last text
         (format 0 "[mp-test] beam count shown ~D line ~S~%" (-> *mp-beams* shown) *mp-beam-line*)
         (dotimes (i (-> *mp-beams* count))
           (format 0 "[mp-test] beam ~D at ~m from us, hold ~m~%" i
                   (vector-vector-xz-distance (-> *mp-beams* pos i) (if *target* (-> *target* control trans) (math-camera-pos)))
                   (-> *mp-beams* hold i)
                   )
           )
         )
        ((string= cmd "wait-scene")
         ;; the script waits until a cutscene that can be skipped plays here
         (set! (-> *mp-test-wait* kind) 'scene)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "log-skip")
         ;; log-skip: the cutscene playing here, our vote, the votes and the players watching
         (let ((sp (mp-skippable-scene)))
           (format 0 "[mp-test] skip scene ~A voted ~A votes ~D viewers ~D skips ~D~%"
                   (if sp (-> sp scene name) 'none) (-> *mp-skip* voted?) (-> *mp-skip* votes) (-> *mp-skip* viewers)
                   (-> *mp-skip* skips)
                   )
           )
         )
        ((string= cmd "wait-driving")
         ;; the script waits until player <slot> drives a vehicle, for 2 s
         (set! (-> *mp-test-wait* slot) (mp-test-int))
         (set! (-> *mp-test-wait* since) 0)
         (set! (-> *mp-test-wait* kind) 'driving)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-resume")
         ;; the script waits until the host's resume countdown runs
         (set! (-> *mp-test-wait* kind) 'resume)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-challenge")
         ;; wait-challenge <phase>: the script waits until our challenge reaches that phase (1
         ;; invited, 3 playing, 4 our result in, 5 decided)
         (set! (-> *mp-test-wait* slot) (mp-test-int))
         (set! (-> *mp-test-wait* kind) 'challenge)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "wait-player")
         ;; the script waits until player <slot> is in game for 2 s
         (set! (-> *mp-test-wait* slot) (mp-test-int))
         (set! (-> *mp-test-wait* since) 0)
         (set! (-> *mp-test-wait* kind) 'player)
         (pc-mp-test-pause #t)
         )
        ((string= cmd "log-laser")
         ;; log-laser <frames>: the gun's laser sight each frame, ours and the copies'
         (set! *mp-test-laser-frames* (mp-test-int))
         )
        ((string= cmd "log-path")
         ;; log-path <skeleton> <frames>: the object's root every frame (owner and viewers alike)
         (mp-test-word)
         (format (clear (-> *mp-test-path* skel)) "skel-~S" (-> *mp-test* word))
         (set! (-> *mp-test-path* frames) (mp-test-int))
         )
        ((string= cmd "mode")
         ;; game mode when hosting: 0 free roam, 1 co-op
         (set! (-> *mp-config* mode) (mp-test-int))
         (mp-config-save!)
         (if (= *mp-mode* (mp-mode host))
             (mp-apply-mode!)
             )
         )
        ((string= cmd "title")
         ;; back to the title screen, as the pause menu's quit does
         (set! (-> *game-info* mode) 'play)
         (initialize! *game-info* 'game (the-as game-save #f) "title-restart" (the-as resetter-spec #f))
         (set-master-mode 'game)
         )
        ((string= cmd "log-join")
         ;; joining the host's world: stage, world received, saves refused, where we stand
         (format
           0
           "[mp-test] join stage ~D foreign ~A worlds sent ~D loaded ~D bytes ~D saves refused ~D~%"
           (-> *mp-join* stage)
           (-> *mp-join* foreign?)
           (-> *mp-join* sent)
           (-> *mp-join* loaded)
           (-> *mp-join* bytes)
           (-> *mp-join* blocked)
           )
         (format
           0
           "[mp-test] join continue ~S title ~A in-game ~A language ~D~%"
           (if (-> *game-info* current-continue) (-> *game-info* current-continue name) "none")
           (= (level-status? *level* 'title #f) 'active)
           (mp-in-game?)
           (-> *setting-control* user-default language)
           )
         (let ((host (mp-remote-state 0)))
           (if (and host *target*)
               (format 0 "[mp-test] join distance to the host ~m~%" (vector-vector-distance (-> *target* control trans) (-> host trans)))
               )
           )
         )
        ((string= cmd "try-save")
         ;; an auto-save, as a checkpoint asks it
         (auto-save-command 'auto-save 0 0 *default-pool* #f)
         )
        ((string= cmd "log-coop")
         ;; log-coop: the mode, the authority, the character played, Daxter on a shoulder
         (format 0 "[mp-test] coop ~A authority ~A character ~D perch ~D perched ~D state ~A~%" (mp-coop?) *mp-authority*
                 (-> *mp-config* character) *mp-perch-slot* *mp-perch-count* (mp-target-state-name)
                 )
         ;; Daxter on a shoulder: the rider on ours, the climbs our Daxter played, his clip and whether
         ;; he is drawn; whether our own model is drawn (a rider is hidden)
         (let ((dax (if (and *target* (nonzero? (-> *target* sidekick))) (the-as process-drawable (ppointer->process (-> *target* sidekick))))))
           (format 0 "[mp-test] climb rider ~D climbs ~D frames ~D playing ~A " (-> *mp-climb* rider) (-> *mp-climb* climbs)
                   (-> *mp-climb* played) (nonzero? (-> *mp-climb* from))
                   )
           (format 0 "sidekick ~A clip ~A self-drawn ~A~%"
                   (and dax (not (logtest? (-> dax draw status) (draw-control-status no-draw))))
                   (if (and dax (> (-> dax skel active-channels) 0) (-> dax skel channel 0 frame-group))
                       (-> dax skel channel 0 frame-group name)
                       'none
                       )
                   (and *target* (not (logtest? (-> *target* draw status) (draw-control-status no-draw))))
                   )
           )
         (let ((host (mp-remote-state 0)))
           (if (and host *target*)
               (format 0 "[mp-test] coop distance to the host ~m host anim ~D flags #x~X candidate ~D~%"
                       (vector-vector-distance (-> *target* control trans) (-> host trans)) (-> host anim-index) (-> host flags)
                       *mp-perch-candidate*
                       )
               )
           )
         )
        ((string= cmd "log-weather")
         (format
           0
           "[mp-test] weather cloud ~f fog ~f special ~f override ~A ~f ~f~%"
           (-> *mood-control* current-interp cloud)
           (-> *mood-control* current-interp fog)
           (-> *mood-control* current-special-interp)
           (-> *mood-control* overide-weather-flag)
           (-> *mood-control* overide cloud)
           (-> *mood-control* overide fog)
           )
         )
        ((string= cmd "close-task")
         ;; close-task [n]: close the first open task node, n times, as if completed here
         (let ((times (max 1 (mp-test-int))))
           (dotimes (k times)
             (let ((open (open-task-nodes (new 'stack 'boxed-array game-task-node-info 8))))
               (when (> (-> open length) 0)
                 (format 0 "[mp-test] closing ~D ~S~%" (get-idx-in-task-list (-> open 0)) (-> open 0 name))
                 (open! (-> open 0) 'event)
                 )
               )
             )
           )
         )
        ((string= cmd "scene")
         ;; start a cutscene here, as a mission would
         (mp-test-word)
         (let ((name (new 'global 'string 32 (-> *mp-test* word))))
           (process-spawn scene-player :init scene-player-init name #t (the-as string #f) :name "scene-player")
           )
         )
        ((string= cmd "log-copies")
         (mp-test-list-copies (mp-test-int))
         )
        ((string= cmd "log-look")
         ;; how player slot's color shows here: not on its model (color-mult 1, emissive 0), on its
         ;; minimap icon and on the marker before its name
         (let* ((slot (mp-test-int))
                (manager (the-as mp-manager (handle->process (-> *mp-globals* manager))))
                (puppet (if (and manager (>= slot 0) (< slot MP_MAX_PLAYERS))
                            (the-as mp-puppet (handle->process (-> manager puppets slot)))
                            )
                        )
                (st (mp-remote-state slot))
                )
           (cond
             ((and puppet st (nonzero? (-> puppet draw)))
              (format
                0
                "[mp-test] look model color-mult ~,,3f ~,,3f ~,,3f emissive ~,,3f ~,,3f ~,,3f~%"
                (-> puppet draw color-mult x)
                (-> puppet draw color-mult y)
                (-> puppet draw color-mult z)
                (-> puppet draw color-emissive x)
                (-> puppet draw color-emissive y)
                (-> puppet draw color-emissive z)
                )
              (format
                0
                "[mp-test] look ~D player color #x~X minimap #x~X markers drawn ~D last #x~X~%"
                slot
                (mp-color-rgba (-> st color))
                ;; the dot's class of that color (hidden where its cone shows: mp-puppet-update)
                (if (-> puppet minimap)
                    (-> *mp-minimap-nodes* node (mp-color-index (-> st color)) color)
                    0
                    )
                (-> *mp-marker-stats* drawn)
                (-> *mp-marker-stats* color)
                )
              )
             (else
               (format 0 "[mp-test] look ~D no puppet~%" slot)
               )
             )
           )
         )
        ((string= cmd "synth-skels")
         (set! *mp-synth-skels* (!= (mp-test-int) 0))
         )
        ((string= cmd "announce-all-kinds")
         ;; describe every kind of object of our place to the others (art-level and skel-def)
         (mp-note-all-kinds)
         (format 0 "[mp-test] kinds of this place noted ~D~%" (-> *mp-art-out* count))
         )
        ((string= cmd "log-kinds-coverage")
         ;; every kind another player described: complete description, art group file here
         (let ((defs *mp-skel-defs*)
               (complete 0)
               (files 0)
               )
           (dotimes (i (-> defs count))
             (when (-> defs complete i)
               (+! complete 1)
               (if (> (pc-mp-art-file-size (-> defs sg i art-group-name)) 0)
                   (+! files 1)
                   (format 0 "[mp-test] kind ~S: no art file ~S-ag.go~%" (-> defs sg i name) (-> defs sg i art-group-name))
                   )
               )
             )
           (format 0 "[mp-test] kinds described ~D complete ~D art files ~D~%" (-> defs count) complete files)
           )
         )
        ((string= cmd "log-art-kinds")
         ;; every skeleton another player announced (art-level): can it be drawn here (its group,
         ;; ours or rebuilt, and its art group)?
         (let ((tbl *mp-art-in*)
               (ok 0)
               )
           (dotimes (i (-> tbl count))
             (let* ((name (symbol->string (-> tbl skel i)))
                    (sg (the-as skeleton-group (mp-art-group-get name (the-as (pointer level) #f))))
                    (art (and sg (type? sg skeleton-group) (mp-art-group-get (-> sg art-group-name) (the-as (pointer level) #f))))
                    )
               ;; drawable: its group here (ours or rebuilt) and its art loaded or loadable alone
               (let ((loadable (and sg (type? sg skeleton-group) (or art (> (pc-mp-art-file-size (-> sg art-group-name)) 0)))))
                 (format 0 "[mp-test] kind ~S group ~A rebuilt ~A art ~A loadable ~A~%" name (if sg #t #f) (if (mp-skel-def-get name) #t #f) (if art #t #f) (if loadable #t #f))
                 (if loadable
                     (+! ok 1)
                     )
                 )
               )
             )
           (format 0 "[mp-test] kinds announced ~D drawable ~D groups rebuilt ~D~%" (-> tbl count) ok (-> *mp-skel-defs* rebuilt))
           )
         )
        ((string= cmd "far-levels")
         (set! *mp-far-enabled* (!= (mp-test-int) 0))
         )
        ((string= cmd "trace-gone")
         (set! *mp-test-trace-gone* #t)
         )
        ((string= cmd "power")
         ;; power <dark|light>: Dark Jak or Light Jak, unlocked and with its eco, as the game turns it on
         (mp-test-word)
         (when *target*
           (logior! (-> *game-info* features) (game-feature darkjak lightjak))
           (set! (-> *game-info* eco-pill-dark) (-> *FACT-bank* eco-pill-dark-max-default))
           (set! (-> *game-info* eco-pill-light) (-> *FACT-bank* eco-pill-light-max-default))
           (if (string= (-> *mp-test* word) "dark")
               (send-event *target* 'change-mode 'darkjak #f (darkjak-stage active))
               (send-event *target* 'change-mode 'lightjak #f (lightjak-stage ls0 ls2 ls7))
               )
           )
         )
        ((string= cmd "dark-bomb")
         ;; dark-bomb: our Dark Jak (power dark) can do the dark bomb and the dark blast, as at the end of
         ;; the game: their features and stages on, its eco full; a dive attack (jump, then square) sets
         ;; the bomb off (target-flop), an uppercut (L1 held, square) the blast (target-attack-uppercut)
         (when (and *target* (nonzero? (-> *target* darkjak)))
           (logior! (-> *game-info* features) (game-feature darkjak-bomb0 darkjak-bomb1))
           (logior! (-> *target* darkjak stage) (darkjak-stage bomb0 bomb1))
           (set! (-> *game-info* eco-pill-dark) (-> *FACT-bank* eco-pill-dark-max-default))
           )
         )
        ((string= cmd "log-dark")
         ;; log-dark: what the dark blast needs (target-attack-uppercut, engine/target/target.gc)
         (when (and *target* (nonzero? (-> *target* darkjak)))
           (format 0 "[mp-test] dark focus ~A stage #x~X ext-anim ~D features ~A ~A~%"
                   (focus-test? *target* dark) (-> *target* darkjak stage) (-> *target* ext-anim)
                   (logtest? (game-feature darkjak-bomb1) (-> *setting-control* user-current features))
                   (logtest? (game-feature darkjak-bomb1) (-> *target* game features))
                   )
           (format 0 "[mp-test] dark latch ~D eco ~,,1f min ~,,1f state ~A bolts retargeted ~D~%"
                   (-> *target* darkjak latch-out-time) (-> *target* game eco-pill-dark) (-> *FACT-bank* darkjak-bomb-min)
                   (mp-target-state-name) *mp-lightning-retargeted*
                   )
           )
         )
        ((string= cmd "log-power")
         ;; log-power: our Dark / Light Jak, and what each puppet shows of another player's
         (when *target*
           (format 0 "[mp-test] power own dark ~,,2f light ~,,2f effect #x~X~%" (-> *target* darkjak-interp)
                   (-> *target* lightjak-interp) (-> *target* target-effect)
                   )
           )
         (let ((manager (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
           (when manager
             (dotimes (slot MP_MAX_PLAYERS)
               (let ((pup (the-as mp-puppet (handle->process (-> manager puppets slot)))))
                 (when (and pup (-> pup skel override) (nonzero? (-> pup skel override)))
                   (format 0 "[mp-test] power puppet ~D blend ~,,2f dark ~,,2f effect #x~X fade ~A~%" slot
                           (-> pup skel override 0) (-> pup skel override 2) (-> pup draw global-effect)
                           (logtest? (-> pup draw status) (draw-control-status force-fade))
                           )
                   ;; its own Dark Jak skin (renderer), and the skin every model of Jak shares (ours)
                   (format 0 "[mp-test] power puppet ~D skin ~D own-morph ~,,2f skin-draws ~D color-mult ~,,2f~%" slot
                           (-> *pc-merc-outlines* dark slot) (-> *darkjak-texture-anim-array* array-data 0 frame-time)
                           (pc-mp-dark-skin-draws) (-> pup draw color-mult y)
                           )
                   )
                 )
               )
             )
           )
         )
        ((string= cmd "log-weapons")
         (format 0 "[mp-test] weapons shown red2 ~D dark2 ~D arc ~D blue3 ~D yellow2 ~D red3 ~D~%" (-> *mp-weapons-shown* 0)
                 (-> *mp-weapons-shown* 1) (-> *mp-weapons-shown* 2) (-> *mp-weapons-shown* 3) (-> *mp-weapons-shown* 4)
                 (-> *mp-weapons-shown* 5)
                 )
         (format 0 "[mp-test] weapons effects past a copy's joints ~D~%" *mp-fx-joint-clamped*)
         ;; and each player's arc as received here: points, its tracker, its bolts' state
         (dotimes (slot 8)
           (let ((arc (-> *mp-arcs* arc slot)))
             (when (nonzero? (-> arc time))
               (let ((proc (the-as gun-blue-2-lightning-tracker (handle->process (-> arc proc)))))
                 (format 0 "[mp-test] arc ~D age ~D pts ~D from ~,,1m ~,,1m ~,,1m~%" slot (- (mp-now) (-> arc time))
                         (-> arc info num-pts) (-> arc info pts 0 x) (-> arc info pts 0 y) (-> arc info pts 0 z)
                         )
                 (format 0 "[mp-test]   to ~,,1m ~,,1m ~,,1m~%" (-> arc info pts (max 0 (+ (-> arc info num-pts) -1)) x)
                         (-> arc info pts (max 0 (+ (-> arc info num-pts) -1)) y) (-> arc info pts (max 0 (+ (-> arc info num-pts) -1)) z)
                         )
                 (if proc
                     (format 0 "[mp-test]   tracker ~A bolt state ~D spans ~D~%" proc (lightning-bolt-method-14 (-> proc lt-array 0))
                             (-> proc lt-array 0 num-active-spans)
                             )
                     )
                 )
               )
             )
           )
         )
        ((string= cmd "log-paused")
         ;; log-paused [meters]: within 40 m of another player unless given
         (let ((m (mp-test-int)))
           (mp-test-log-paused (meters (the float (if (> m 0) m 40))))
           )
         )
        ((string= cmd "run-near-others")
         ;; run-near-others <0|1>: our NPCs near another player run as near our camera (default 1)
         (set! *mp-run-near-others* (!= (mp-test-int) 0))
         )
        ((string= cmd "hide-copies")
         (set! *mp-test-hide-copies* (!= (mp-test-int) 0))
         )
        ((string= cmd "log-aimable")
         ;; log-aimable: what the area weapons find within 20 m of us (the actor hash, as they search it)
         (when *target*
           (let ((box (new 'stack-no-clear 'vector))
                 (found (new 'stack-no-clear 'array 'collide-shape 64))
                 )
             (vector-copy! box (-> *target* control trans))
             (set! (-> box w) (meters 20))
             (countdown (i (fill-actor-list-for-box *actor-hash* box found 64))
               (let* ((cs (-> found i))
                      (proc (-> cs process))
                      )
                 (format 0 "[mp-test] aimable ~A mask #x~X focus ~A action #x~X as #x~X~%" proc (-> proc mask)
                         (if (type? proc process-focusable) (-> (the-as process-focusable proc) focus-status) 'none)
                         (-> cs root-prim prim-core action) (-> cs root-prim prim-core collide-as)
                         )
                 (format 0 "[mp-test]   sphere ~,,2m ~,,2m ~,,2m r ~,,2m~%" (-> cs root-prim prim-core world-sphere x)
                         (-> cs root-prim prim-core world-sphere y) (-> cs root-prim prim-core world-sphere z)
                         (-> cs root-prim prim-core world-sphere w)
                         )
                 )
               )
             )
           )
         )
        ((string= cmd "hide-puppets")
         (set! *mp-test-hide-puppets* (!= (mp-test-int) 0))
         )
        ((string= cmd "log-stretch")
         (mp-test-log-stretch)
         )
        ((string= cmd "log-ping")
         ;; log-ping: each player's round trip to the host as the player list shows it, the list
         ;; shown, and whether the game is paused (SELECT shows the list, it must not pause)
         (format 0 "[mp-test] ping own ~D list ~A paused ~A health ~,,1f/~,,1f~%" (pc-mp-player-ping *mp-local-slot*)
                 (mp-player-list-shown?) (paused?) (-> *mp-local* health) (-> *mp-local* health-max)
                 )
         (dotimes (i MP_MAX_PLAYERS)
           (let ((st (mp-remote-state i)))
             (if st
                 (format 0 "[mp-test] ping player ~D ~D health ~,,1f/~,,1f delay ~D~%" i (pc-mp-player-ping i) (-> st health)
                         (-> st health-max) (pc-mp-player-delay i)
                         )
                 )
             )
           )
         )
        ((string= cmd "log-outline")
         ;; log-outline: outlined models the renderer drew since boot (other players through walls),
         ;; and the players in the outline table with their color
         (format 0 "[mp-test] outlines drawn ~D hidden pixels ~D~%" (pc-mp-outlines-drawn) (pc-mp-outline-pixels))
         (dotimes (i MP_MAX_PLAYERS)
           (let ((dc (-> *pc-merc-outlines* dc i)))
             (if (and (nonzero? dc) dc)
                 (format 0 "[mp-test] outline player ~D color #x~X~%" i (-> *pc-merc-outlines* color i))
                 )
             )
           )
         )
        ((string= cmd "log-vehicles")
         ;; log-vehicles: every vehicle within 30 m of us, ours and copies, drawn or not
         (format 0 "[mp-test] vehicles near us:~%")
         (iterate-process-tree *active-pool* (the-as (function object object) mp-test-vehicle-scan) *null-kernel-context*)
         )
        ((string= cmd "log-motion")
         ;; log-motion [meters]: within 60 m of us unless given
         (let ((m (mp-test-int)))
           (set! (-> *mp-test-motion* range) (meters (the float (if (> m 0) m 60))))
           )
         (mp-test-log-motion)
         )
        ((string= cmd "log-gone")
         (format 0 "[mp-test] npcs gone near another player ~D~%" (-> *mp-world-state* gone-near))
         )
        ((string= cmd "art-range")
         ;; art-range <meters>: the art of other players' objects loads this far from our player
         (set! *mp-art-range* (* (meters 1) (the float (mp-test-int))))
         )
        ((string= cmd "log-shaders")
         (mp-test-log-shaders)
         )
        ((string= cmd "log-levels")
         (dotimes (i (-> *level* length))
           (let ((lev (-> *level* level i)))
             (if (-> lev name)
                 (format
                   0
                   "[mp-test] level ~A ~A display ~A art-heap ~A~%"
                   (-> lev name)
                   (-> lev status)
                   (-> lev display?)
                   (= lev (-> *mp-far* host))
                   )
                 )
             )
           )
         (format
           0
           "[mp-test] art heap in ~A opened ~D closed ~D restored ~D~%"
           (-> *mp-far* host)
           (-> *mp-far* opened)
           (-> *mp-far* closed)
           (-> *mp-far* restored)
           )
         (format
           0
           "[mp-test] art loaded ~D failed ~D, art levels known ~D~%"
           (-> *mp-art-in* loaded)
           (-> *mp-art-in* failed)
           (-> *mp-art-in* count)
           )
         (format
           0
           "[mp-test] scenes sent ~D shown ~D playing ~A~%"
           (-> *mp-scene* sent)
           (-> *mp-scene* shown)
           (if (process-by-name "scene-player" *active-pool*) #t #f)
           )
         )
        ((string= cmd "log-sync")
         (mp-test-log-sync)
         )
        ((string= cmd "log-float")
         ;; the floating platform nearest to player 0 (guest) or to us (host): height and tilt
         (let* ((typ (-> (the-as symbol 'rigid-body-platform) value))
                (pos (mp-test-reference-pos))
                (proc (if (and pos typ (nonzero? typ) (type? typ type))
                          (mp-test-nearest (the-as type typ) pos)
                          )
                      )
                )
           (if proc
               (format
                 0
                 "[mp-test] float aid ~D t ~D height ~m tilt ~f weight sent ~D followed ~D~%"
                 (if (-> proc entity) (-> proc entity aid) 0)
                 (/ (pc-mp-clock (if (= *mp-mode* (mp-mode client)) 0 -1)) 10)
                 (-> proc root trans y)
                 (-> proc root quat y)
                 (-> *mp-riders* sent)
                 (-> *mp-world-state* world-driven)
                 )
               (format 0 "[mp-test] no float~%")
               )
           )
         )
        ((string= cmd "goto-float")
         ;; stand on the nearest floating platform
         (let* ((typ (-> (the-as symbol 'rigid-body-platform) value))
                (proc (if (and *target* typ (nonzero? typ) (type? typ type))
                          (mp-test-nearest (the-as type typ) (-> *target* control trans))
                          )
                      )
                )
           (when proc
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> proc root trans))))
               (+! (-> pos y) (meters 3))
               (move-to-point! (-> *target* control) pos)
               (format 0 "[mp-test] at goto-float ~D~%" (if (-> proc entity) (-> proc entity aid) 0))
               )
             )
           )
         )
        ((string= cmd "log-door")
         (mp-test-log-object "door" com-airlock)
         ;; co-op: whether it waits for a teammate behind it, and our side of it
         (let ((door (the-as com-airlock (mp-test-nearest com-airlock (mp-test-reference-pos)))))
           (if (and door *target*)
               (format 0 "[mp-test] door hold ~A shown ~A our side ~m~%" (mp-door-hold? door)
                       (< (- (mp-now) *mp-door-wait-time*) (seconds 0.5))
                       (check-crossing-distance door (target-pos 0) #f)
                       )
               )
           )
         )
        ((string= cmd "goto-door-at")
         ;; goto-door-at <meters>: stand that far in front of the nearest door, along its axis (its
         ;; front side, where closing runs its scripts; negative: behind it)
         (let ((door (if *target* (the-as com-airlock (mp-test-nearest com-airlock (-> *target* control trans)))))
               (d (* 4096.0 (if (mp-test-word) (string->float (-> *mp-test* word)) 0.0)))
               )
           (when door
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> door root trans))))
               (vector+float*! pos pos (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> door root quat)) d)
               (move-to-point! (-> *target* control) pos)
               (vector-reset! (-> *target* control transv))
               (format 0 "[mp-test] at door ~D, ~m in front~%" (if (-> door entity) (-> door entity aid) 0) d)
               )
             )
           )
         )
        ((string= cmd "log-elevator")
         (mp-test-log-object "elevator" elevator)
         (let ((elev (the-as elevator (mp-test-nearest elevator (mp-test-reference-pos)))))
           (if elev
               (format
                 0
                 "[mp-test] elevator path-pos ~f stops ~f ~f status #x~X states applied ~D~%"
                 (-> elev path-pos)
                 (-> elev move-pos 0)
                 (-> elev move-pos 1)
                 (-> elev elevator-status)
                 (-> *mp-world-state* elevator-states)
                 )
               )
           )
         (format
           0
           "[mp-test] elevator trips sent ~D shown ~D muted ~D continue ~S~%"
           (-> *mp-world-state* elevator-trips-sent)
           (-> *mp-world-state* elevator-trips-shown)
           (let ((n 0))
             (dotimes (i (-> *mp-world-state* elev-count))
               (if (-> *mp-world-state* elev-muted i)
                   (+! n 1)
                   )
               )
             n
             )
           (-> *game-info* current-continue name)
           )
         )
        ((or (string= cmd "goto-door") (string= cmd "goto-elevator"))
         ;; stand 2 m in front of the nearest door, or on top of the nearest elevator
         (let* ((door? (string= cmd "goto-door"))
                (proc (if *target*
                          (mp-test-nearest (if door? com-airlock elevator) (-> *target* control trans))
                          )
                      )
                )
           (when proc
             (let ((pos (vector-copy! (new 'stack-no-clear 'vector) (-> proc root trans))))
               (cond
                 (door?
                   (let ((dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> proc root quat))))
                     (vector+float*! pos pos dir (meters 2))
                     )
                   )
                 (else
                   (+! (-> pos y) (meters 1))
                   )
                 )
               (move-to-point! (-> *target* control) pos)
               (format 0 "[mp-test] at ~S ~D~%" cmd (if (-> proc entity) (-> proc entity aid) 0))
               )
             )
           )
         )
        ((string= cmd "skin")
         ;; skin <group> <rrggbb> <percent>: our outfit's part, saved and sent as the page's X does
         (let* ((group (mp-test-int))
                (rgb (begin (mp-test-word) (mp-test-hex (-> *mp-test* word))))
                (strength (/ (* (mp-test-int) 255) 100))
                )
           (when (and (> group 0) (<= group MP_SKIN_LAST))
             (set! (-> *mp-config* skin group) (the-as uint (logior (shl strength 24) (logand rgb #xffffff))))
             (mp-config-save!)
             (if (mp-online?)
                 (mp-send-skin -1)
                 )
             )
           )
         )
        ((string= cmd "skin-page")
         ;; skin-page: the Appearance page, as Options > Multiplayer > Appearance opens it
         (cond
           (*progress-process*
             (mp-skin-open (-> *progress-process* 0))
             )
           (else
             (mp-skin-begin)
             (activate-progress *dproc* 'mp-skin)
             )
           )
         )
        ((string= cmd "log-skin")
         ;; log-skin: our outfit (saved, draft), the others' as received, the models wearing one this
         ;; frame, the draws tinted since boot, the page's preview
         (format 0 "[mp-test] skin own")
         (dotimes (i 13)
           (format 0 " ~X" (-> *mp-config* skin i))
           )
         (format 0 "~%[mp-test] skin editing ~A group ~D slider ~D draft-shirt ~X preview ~A~%"
                 (-> *mp-skins* editing?) (-> *mp-skin-edit* group) (-> *mp-skin-edit* slider) (-> *mp-skins* draft 1)
                 (if (handle->process (-> *mp-skins* preview)) #t #f)
                 )
         (format 0 "[mp-test] skin sent ~D received ~D responds ~D last-keys #x~X~%" (-> *mp-skins* sent) (-> *mp-skins* received)
                 (-> *mp-skin-edit* responds) (-> *mp-skin-edit* last-keys)
                 )
         ;; the preview's place against the camera, its draw status, what the renderers draw now
         (let ((pv (the-as process-drawable (handle->process (-> *mp-skins* preview)))))
           (when pv
             (format 0 "[mp-test] skin render vu1 #x~X tex #x~X menu-mode ~A~%" (-> *display* vu1-enable-user)
                     (-> *texture-pool* texture-enable-user) (get-menu-mode *blit-displays-work*)
                     )
             )
           )
         (when *progress-process*
           (format 0 "[mp-test] skin menu ~A next ~A transition ~,,2f ring ~,,1f want ~,,1f~%"
                   (-> *progress-process* 0 current) (-> *progress-process* 0 next) (-> *progress-process* 0 menu-transition)
                   (-> *progress-process* 0 ring-angle) (-> *progress-process* 0 ring-want-angle)
                   )
           (format 0 "[mp-test] skin menu option ~D selected ~A frame ~D~%" (-> *progress-process* 0 option-index)
                   (-> *progress-process* 0 selected-option) (-> *display* real-frame-clock frame-counter)
                   )
           )
         (dotimes (slot MP_MAX_PLAYERS)
           (when (mp-remote-state slot)
             (format 0 "[mp-test] skin player ~D" slot)
             (dotimes (i 13)
               (format 0 " ~X" (-> (mp-slot-skin slot) i))
               )
             (format 0 "~%")
             )
           )
         (let ((pv (the-as manipy (handle->process (-> *mp-skins* preview)))))
           (when pv
             (format 0 "[mp-test] skin preview ~A status #x~X seg #x~X effect #x~X lod ~D~%" (-> pv draw art-group name)
                     (-> pv draw status) (-> pv draw seg-mask) (-> pv draw effect-mask) (-> pv draw cur-lod)
                     )
             (format 0 "[mp-test] skin preview at ~m from the camera, scale ~,,2f anim ~A~%"
                     (vector-vector-distance (-> pv root trans) (math-camera-pos)) (-> pv root scale y)
                     (if (> (-> pv skel active-channels) 0) (-> pv skel root-channel 0 frame-group name))
                     )
             )
           )
         (format 0 "[mp-test] skin models ~D draws ~D:" (-> *pc-merc-skins* count) (pc-mp-skin-draws))
         (dotimes (i (-> *pc-merc-skins* count))
           (format 0 " ~A" (-> *pc-merc-skins* dc i process name))
           )
         (format 0 "~%")
         )
        ((string= cmd "log-pause")
         ;; log-pause: master mode, the host's pause as seen here, the menu over a running world, and
         ;; the clocks of the target and of the entities (they move when those processes run)
         (format 0 "[mp-test] pause master ~A applied ~A world ~A resume ~D live ~A~%"
                 *master-mode* (-> *mp-pause* applied?) (mp-world-paused?) (mp-resume-ms) (-> *mp-pause* live?)
                 )
         (format 0 "[mp-test] pause prevent-progress ~A menu-mode ~A~%"
                 (logtest? (-> *kernel-context* prevent-from-run) (process-mask progress))
                 (get-menu-mode *blit-displays-work*)
                 )
         (format 0 "[mp-test] pause clocks target ~D entity ~D pad-frames ~D pauses ~D list ~A~%"
                 (-> *display* target-clock frame-counter) (-> *display* entity-clock frame-counter)
                 (-> *mp-pause* pad-frames) (-> *mp-pause* pauses) (mp-player-list-shown?)
                 )
         )
        ((string= cmd "choose-character")
         ;; choose-character <0|1>: our character chosen in game, as Options > Multiplayer > Character
         ;; does (in co-op the other player takes the other one)
         (mp-choose-character (mp-test-int))
         )
        ((string= cmd "log-role")
         ;; log-role: our character, whether we play Daxter's mode, the roles swapped so far, the
         ;; other player's character, its minimap dot and cone here and the cone's color
         (format 0 "[mp-test] role character ~D indax ~A swapped ~D" (-> *mp-config* character)
                 (and *target* (focus-test? *target* indax)) *mp-roles-swapped*
                 )
         (let ((mgr (the-as mp-manager (handle->process (-> *mp-globals* manager)))))
           (dotimes (i MP_MAX_PLAYERS)
             (let ((st (mp-remote-state i))
                   (pup (if mgr (the-as mp-puppet (handle->process (-> mgr puppets i)))))
                   )
               (when st
                 (format 0 " remote ~D character ~D dot ~A cone ~A" i (logand (-> st character) 15)
                         (and pup (-> pup minimap) #t) (and pup (-> pup cone) #t)
                         )
                 (if (and pup (-> pup cone))
                     (format 0 " cone-color #x~X class ~S" (-> pup cone class color) (-> pup cone class name))
                     )
                 (if (and pup (-> pup minimap))
                     (format 0 " dot-shown ~A" (!= (-> pup minimap class) *mp-minimap-no-dot*))
                     )
                 )
               )
             )
           )
         (format 0 "~%")
         )
        ((string= cmd "pickup-turret")
         ;; pickup-turret: the idle turret within 20 m takes us, as a mission's arrival does
         ;; (mp-arrival-update: 'pickup sent as our player), Daxter included
         (let ((gun (search-process-tree *active-pool* (the-as (function process-tree object) mp-free-turret?))))
           (format 0 "[mp-test] pickup-turret ~A~%" gun)
           (when (and gun *target*)
             (let ((msg (new 'stack-no-clear 'event-message-block)))
               (set! (-> msg from) (process->ppointer *target*))
               (set! (-> msg num-params) 0)
               (set! (-> msg message) 'pickup)
               (send-event-function (the-as process gun) msg)
               )
             )
           )
         )
        ((string= cmd "trace-play")
         ;; trace-play: log each new state of our player from now on (mp-test-update)
         (set! *mp-test-trace-play* 'none)
         )
        ((string= cmd "log-play")
         ;; log-play: what our player does in a mission: its state, its modes (vehicle, board,
         ;; lizard, Daxter, turret, rail, tube, mech, grabbed, dead), the task managers alive
         (when *target*
           (format 0 "[mp-test] play state ~A modes" (mp-target-state-name))
           (let ((fs (-> *target* focus-status)))
             (if (logtest? fs (focus-status pilot)) (format 0 " pilot"))
             (if (logtest? fs (focus-status pilot-riding)) (format 0 " riding"))
             (if (logtest? fs (focus-status board)) (format 0 " board"))
             (if (logtest? fs (focus-status flut)) (format 0 " flut"))
             (if (logtest? fs (focus-status indax)) (format 0 " indax"))
             (if (logtest? fs (focus-status turret)) (format 0 " turret"))
             (if (logtest? fs (focus-status rail)) (format 0 " rail"))
             (if (logtest? fs (focus-status tube)) (format 0 " tube"))
             (if (logtest? fs (focus-status mech)) (format 0 " mech"))
             (if (logtest? fs (focus-status grabbed)) (format 0 " grabbed"))
             (if (logtest? fs (focus-status dead)) (format 0 " dead"))
             (if (logtest? fs (focus-status in-head)) (format 0 " in-head"))
             )
           (format 0 " level ~A managers" (if (-> *target* current-level) (-> *target* current-level name) #f))
           (set! *mp-test-managers* 0)
           (iterate-process-tree *active-pool* (the-as (function object object) mp-test-log-manager) *null-kernel-context*)
           (iterate-process-tree *active-pool* (the-as (function object object) mp-test-log-turret) *null-kernel-context*)
           (format 0 "~%")
           )
         )
        ((string= cmd "close-node")
         ;; close-node <name>: that task node closed, as the story closes it (a challenge's
         ;; prerequisite done)
         (mp-test-word)
         (dotimes (i (-> *game-info* sub-task-list length))
           (when (and (nonzero? i) (string= (-> *game-info* sub-task-list i name) (-> *mp-test* word)))
             (task-node-close! (the-as game-task-node i) 'event)
             (format 0 "[mp-test] close-node ~S: closed ~A~%" (-> *mp-test* word) (task-node-closed? (the-as game-task-node i)))
             )
           )
         )
        ((string= cmd "challenge-start")
         ;; challenge-start <task>: what talking to its burning bush does, the skull gems aside: its
         ;; introduction node closed by our play (the task's play-list entry names it)
         (mp-test-word)
         (dotimes (i (-> *game-info* play-list length))
           (when (string= (-> *game-info* play-list i name) (-> *mp-test* word))
             (format 0 "[mp-test] challenge-start ~S: introduction ~S open ~A~%" (-> *mp-test* word)
                     (-> *game-info* sub-task-list (-> *game-info* play-list i pre-play-node) name)
                     (task-node-open? (-> *game-info* play-list i pre-play-node))
                     )
             (task-node-close! (-> *game-info* play-list i pre-play-node) 'event)
             )
           )
         )
        ((string= cmd "log-bodax")
         ;; log-bodax: our player on the jet-board as Daxter: state, his art on, the board's scale and
         ;; whether it is drawn, the sidekick drawn, rides
         (when *target*
           (let ((brd (if (and (nonzero? (-> *target* board)) (-> *target* board board)) (-> *target* board board 0)))
                 (sk (the-as process-drawable (ppointer->process (-> *target* sidekick))))
                 )
             (format 0 "[mp-test] bodax state ~A on ~A art ~A board ~A scale ~,,2f drawn ~A "
                     (mp-target-state-name) (-> *mp-bodax* on?) (-> *mp-bodax* camera?)
                     (and brd #t) (if brd (-> brd root scale x) 0.0) (and brd (not (logtest? (-> brd draw status) (draw-control-status no-draw))))
                     )
             (when (and sk (nonzero? (-> sk draw)))
               (let ((dax (-> sk draw art-group))
                     (loaded 0)
                     (first-missing -1)
                     )
                 (dotimes (i 67)
                   (if (and (< (+ 147 i) (-> dax length)) (-> dax data (+ 147 i)) (= (-> dax data (+ 147 i) type) art-joint-anim))
                       (+! loaded 1)
                       (if (< first-missing 0) (set! first-missing (+ 147 i)))
                       )
                   )
                 (format 0 "[mp-test] bodax daxter-art ~A length ~D board-clips ~D/67 first-missing ~D jak-art ~A missing"
                         (-> dax name) (-> dax length) loaded first-missing (-> *target* draw art-group name)
                         )
                 (dotimes (i 67)
                   (if (not (and (< (+ 147 i) (-> dax length)) (-> dax data (+ 147 i)) (= (-> dax data (+ 147 i) type) art-joint-anim)))
                       (format 0 " ~D" (+ 147 i))
                       )
                   )
                 (format 0 "~%")
                 )
               )
             (format 0 "[mp-test] bodax feature game ~A settings ~A r2 ~A~%"
                     (logtest? (game-feature board) (-> *target* game features))
                     (logtest? (game-feature board) (-> *setting-control* user-current features))
                     (cpad-hold? 0 r2)
                     )
             (format 0 "sidekick-drawn ~A rides ~D height ~m~%"
                     (and sk (not (logtest? (-> sk draw status) (draw-control-status no-draw))))
                     (-> *mp-bodax* rides)
                     (if brd (- (-> *target* control trans y) (-> brd root trans y)) 0.0)
                     )
             )
           )
         )
        ((string= cmd "trick-points")
         ;; trick-points <n>: our player's trick points (what the jet-board's judge scores)
         (when *target*
           (set! (-> *target* fact trick-point) (the float (mp-test-int)))
           (format 0 "[mp-test] trick-points ~,,0f~%" (-> *target* fact trick-point))
           )
         )
        ((string= cmd "goto-challenge-orb")
         ;; goto-challenge-orb: our player onto what our challenge's task manager left to reach (the
         ;; precursor orb of a get-to challenge), as reaching it
         (let* ((mgr (handle->process (-> *mp-challenge* manager)))
                (child (if mgr (-> mgr child)))
                (orb (the-as process-drawable #f))
                )
           (while child
             (let ((p (ppointer->process child)))
               (if (and (not orb) (type? p process-drawable) (nonzero? (-> (the-as process-drawable p) root)))
                   (set! orb (the-as process-drawable p))
                   )
               (set! child (-> p brother))
               )
             )
           (cond
             ((and orb *target*)
              (format 0 "[mp-test] goto-challenge-orb ~A at ~m ~m ~m~%" (-> orb type symbol) (-> orb root trans x) (-> orb root trans y) (-> orb root trans z))
              (move-to-point! (-> *target* control) (-> orb root trans))
              )
             (else
               (format 0 "[mp-test] goto-challenge-orb: none~%")
               )
             )
           )
         )
        ((string= cmd "send-complete")
         ;; send-complete <process type>: the first process of that type (a task manager) is told
         ;; its objective is reached ('complete), as its own code does
         (mp-test-word)
         (set! *mp-test-type-name* (string->symbol (-> *mp-test* word)))
         (let ((proc (search-process-tree *active-pool* (lambda ((p process)) (= (-> p type symbol) *mp-test-type-name*)))))
           (format 0 "[mp-test] send-complete ~A: ~A~%" *mp-test-type-name* (if proc (send-event proc 'complete) 'none))
           )
         )
        ((string= cmd "log-challenge")
         ;; log-challenge: our challenge's phase, players, results, winners, held and given reward,
         ;; our precursor orbs
         (let ((ch *mp-challenge*))
           (format 0 "[mp-test] challenge phase ~D node ~D starter ~D players #x~X results #x~X reached #x~X "
                   (-> ch phase) (-> ch node) (-> ch starter) (-> ch players) (-> ch results) (-> ch reached)
                   )
           (format 0 "winners #x~X pending ~,,1f given ~,,1f skill ~,,1f invites ~D decisions ~D~%"
                   (-> ch winners) (-> ch pending) (-> ch given) (-> *game-info* skill) (-> ch invites) (-> ch decisions)
                   )
           (let ((judge (process-by-name "judge" *active-pool*)))
             (format 0 "[mp-test] challenge manager ~A live ~,,2f judge ~A character ~D indax ~A~%" (-> ch last-state) (-> ch live-score)
                     (if (and judge (-> judge next-state)) (-> judge next-state name) 'none)
                     (-> *mp-config* character) (and *target* (focus-test? *target* indax))
                     )
             )
           )
         )
        ((string= cmd "log-mem")
         ;; log-mem: the process heap (free, used), the global heap's free room, the processes alive,
         ;; our copies and the NPCs forced to compute every bone, the art groups loaded for others
         (set! *mp-test-procs* 0)
         (iterate-process-tree *active-pool* (the-as (function object object) mp-test-count-proc) *null-kernel-context*)
         (format 0 "[mp-test] mem heap-free ~D heap-used ~D global-free ~D procs ~D "
                 (memory-free *nk-dead-pool*) (memory-used *nk-dead-pool*) (&- (-> global top) (-> global current)) *mp-test-procs*
                 )
         (format 0 "replicas ~D forced ~D art ~D tried ~D~%"
                 (-> *mp-world-state* replica-count) (-> *mp-world-state* forced-count) (-> *mp-art-in* count) (-> *mp-art-in* tried-count)
                 )
         )
        ((string= cmd "tints-off")
         ;; tints-off: copies keep their default tint, as before their owner's was sent
         (set! *mp-test-tints-off* #t)
         )
        ((string= cmd "log-tints")
         ;; log-tints: the tint of our traffic vehicles and citizens (by pid) and of the copies here
         ;; (by their owner's pid), 200 lines at most
         (set! *mp-test-tints* 0)
         (iterate-process-tree *active-pool* (the-as (function object object) mp-test-log-tint) *null-kernel-context*)
         )
        ((string= cmd "log-places")
         ;; log-places <level>...: the place of each level named (mp-level-space)
         (while (mp-test-word)
           (format 0 "[mp-test] level-place ~S ~D~%" (-> *mp-test* word) (mp-level-space (-> *mp-test* word data)))
           )
         )
        ((string= cmd "places-off")
         ;; places-off: every level counts as one place, as before "Places at the same coordinates"
         (set! *mp-test-places-off* #t)
         )
        ((string= cmd "log-place")
         ;; log-place: our level, place and role; each other player's level and place, whether its
         ;; puppet is drawn and marked on the minimap here, how far, and how many of its copies
         (string<-charp *mp-temp-string* (-> *mp-local* level))
         (format 0 "[mp-test] place ours ~S space ~D authority ~A~%" *mp-temp-string* (mp-slot-space *mp-local-slot*) *mp-authority*)
         (dotimes (i MP_MAX_PLAYERS)
           (let ((st (mp-remote-state i)))
             (when st
               (let ((pup (the-as mp-puppet (mp-puppet-process i)))
                     (copies 0)
                     )
                 (dotimes (k (-> *mp-world-state* replica-count))
                   (if (= (the-as int (shr (-> *mp-world-state* replica-id k) 24)) i)
                       (+! copies 1)
                       )
                   )
                 (string<-charp *mp-temp-string* (-> st level))
                 (format 0 "[mp-test] place player ~D level ~S space ~D here ~A " i *mp-temp-string* (mp-slot-space i) (mp-slot-here? i))
                 (format 0 "drawn ~A minimap ~A distance ~,,1m copies ~D~%"
                         (and pup (not (logtest? (-> pup draw status) (draw-control-status no-draw))))
                         (and pup (-> pup minimap) #t)
                         (if *target* (vector-vector-distance (-> *target* control trans) (-> st trans)) 0.0)
                         copies
                         )
                 )
               )
             )
           )
         )
        ((string= cmd "log-me")
         ;; one short line: own position, speed and state (fine-grained probes)
         (when *target*
           (format
             0
             "[mp-test] me ~m ~m ~m speed ~m state ~A~%"
             (-> *target* control trans x)
             (-> *target* control trans y)
             (-> *target* control trans z)
             (vector-length (-> *target* control transv))
             (mp-target-state-name)
             )
           )
         )
        ((string= cmd "log-part")
         ;; log-part <index>: where entry <index> of *part-id-table* lives (level heaps)
         (let* ((index (mp-test-int))
                (launcher (-> *part-id-table* index))
                (lev (mp-heap-level (the-as uint launcher)))
                )
           (format 0 "[mp-test] part ~D at #x~X level ~A~%" index launcher (if lev (-> lev name) #f))
           (countdown (li 11)
             (let ((l (-> *level* level li)))
               (format 0 "[mp-test]   level ~D ~A ~A #x~X #x~X~%" li (-> l name) (-> l status) (-> l heap base) (-> l heap top-base))
               )
             )
           )
         )
        ((string= cmd "log-pose")
         (let ((slot (if (mp-test-word)
                         (string->int (-> *mp-test* word))
                         -1
                         )
                     )
               )
           (mp-test-log-pose slot)
           )
         )
        (else
          (format 0 "[mp-test] unknown command ~S~%" cmd)
          )
        )
      )
    )
  (none)
  )

(defun mp-test-wait-over? ()
  "#t when the script's wait is over: wait-joined, the guest is in the host's world; wait-player,
   that player is in game (shown) for 2 s; wait-menu, that menu page is shown for 1.5 s."
  (let ((w *mp-test-wait*))
    (case (-> w kind)
      (('joined)
       (= (-> *mp-join* stage) 4)
       )
      (('challenge)
       (>= (-> *mp-challenge* phase) (-> w slot))
       )
      (('countdown)
       (> (mp-lobby-countdown-ms) 0)
       )
      (('pause)
       (= (mp-world-paused?) (= (-> w slot) 1))
       )
      (('resume)
       (> (mp-resume-ms) 0)
       )
      (('scene)
       (if (mp-skippable-scene) #t #f)
       )
      (('driving)
       (let ((st (mp-remote-state (-> w slot))))
         (cond
           ((not (and st (logtest? (-> st flags) (mp-flag driving))))
            (set! (-> w since) 0)
            #f
            )
           ((zero? (-> w since))
            (set! (-> w since) (mp-now))
            #f
            )
           (else
             (>= (- (mp-now) (-> w since)) (seconds 2))
             )
           )
         )
       )
      (('menu)
       (cond
         ((not (and *progress-process* (= (-> *progress-process* 0 current) (-> w menu))))
          (set! (-> w since) 0)
          ;; the title screen opens its menu on a press ("press start"): tap X every 2 s until then; a
          ;; retail boot first plays the intro, whose cutscenes triangle skips (back to the title)
          (when (and (= (-> w menu) 'title) (not *progress-process*) (>= (- (mp-now) (-> w tapped)) (seconds 2)))
            (set! (-> w tapped) (mp-now))
            (pc-mp-test-pad (mp-test-button (if (mp-skippable-scene) "triangle" "x")) 128 128 128 128)
            (set! (-> *mp-test* pad-until) (+ (mp-now) (seconds 0.1)))
            )
          #f
          )
         ((zero? (-> w since))
          (set! (-> w since) (mp-now))
          #f
          )
         (else
           (>= (- (mp-now) (-> w since)) (seconds 1.5))
           )
         )
       )
      (('player)
       (let ((st (mp-remote-state (-> w slot))))
         (cond
           ((or (not st) (logtest? (-> st flags) (mp-flag hidden)))
            (set! (-> w since) 0)
            #f
            )
           ((zero? (-> w since))
            (set! (-> w since) (mp-now))
            #f
            )
           (else
             (>= (- (mp-now) (-> w since)) (seconds 2))
             )
           )
         )
       )
      (else
        #t
        )
      )
    )
  )

(defun mp-test-walk-stick ()
  "walk-to-merchant: the left stick pushed toward Kleiver's spot as the camera sees it (the stick is
   camera relative): the angle from the camera's ground heading to the spot's, as the stick's."
  (when (and (> *mp-test-walk-frames* 0) *target*)
    (+! *mp-test-walk-frames* -1)
    (let* ((cam (camera-pos))
           (me (-> *target* control trans))
           (fx (- (-> me x) (-> cam x)))
           (fz (- (-> me z) (-> cam z)))
           (dx (- (-> *mp-merchant-pos* x) (-> me x)))
           (dz (- (-> *mp-merchant-pos* z) (-> me z)))
           (a (atan (- (* fz dx) (* fx dz)) (+ (* fx dx) (* fz dz))))
           )
      (pc-mp-test-pad 0 (- 128 (the int (* 127.0 (sin a)))) (- 128 (the int (* 127.0 (cos a)))) 128 128)
      (set! (-> *mp-test* pad-until) (+ (mp-now) (seconds 0.1)))
      )
    )
  (none)
  )

(defun mp-test-update ()
  "Release forced input when its time is over, end a wait when it is over, then run the due script
   commands."
  (mp-test-walk-stick)
  (when (and (nonzero? (-> *mp-test* pad-until)) (>= (mp-now) (-> *mp-test* pad-until)))
    (pc-mp-test-pad 0 128 128 128 128)
    (set! (-> *mp-test* pad-until) 0)
    )
  (when (and (-> *mp-test-wait* kind) (mp-test-wait-over?))
    (format 0 "[mp-test] wait ~A over~%" (-> *mp-test-wait* kind))
    (set! (-> *mp-test-wait* kind) #f)
    (pc-mp-test-pause #f)
    )
  (while (pc-mp-test-poll (-> *mp-test* line))
    (mp-test-run)
    )
  ;; trace-play: each new state of our player, from the join on
  (when (and *mp-test-trace-play* *target*)
    (let ((s (mp-target-state-name)))
      (when (!= s *mp-test-trace-play*)
        (set! *mp-test-trace-play* s)
        (format 0 "[mp-test] state now ~A~%" s)
        )
      )
    )
  (none)
  )
