;;-*-Lisp-*-
(in-package goal)

;; name: multiplayer.gc
;; dgos: GAME
;;
;; Jak 3 multiplayer mod -- everything that runs in game. The network session itself (TCP host or
;; client, relay, interpolation of remote players) is C++: game/kernel/jak3/kmultiplayer.cpp,
;; reached through the pc-mp-* kernel functions declared below. The menus live in
;; multiplayer-menu.gc.
;;
;; How a frame goes:
;;   1. `mp-frame-hook` (installed on *mods-menu-hook*, runs every frame, even paused) describes the
;;      local player in *mp-local*, pumps the network with it, copies every remote player's
;;      interpolated state into *mp-players*, then draws names and health bars over them.
;;   2. The `mp-manager` process (frozen while paused) keeps one `mp-puppet` per remote player,
;;      applies network events, switches the player to Daxter, and handles shared vehicles.
;;
;; Every feature is off until the player enables "Multiplayer" in the Mods menu (L3 + SELECT):
;; with the toggle off, the hook only runs the Mods menu and the two wrapped methods (enemy
;; `mark-as-dead`, progress `set-menu-options`) behave as stock.

;; ------------------------------------------------------------------------------------------------
;; Shared types (mirrored field for field by kmultiplayer.h)
;; ------------------------------------------------------------------------------------------------

(defconstant MP_MAX_PLAYERS 8)
(defconstant MP_FX_TRACKERS 8) ;; particle groups one copy can show at once (mp-play-emitters)

;; Session mode, as returned by pc-mp-update.
(defenum mp-mode
  :type int32
  (offline 0)
  (connecting 1)
  (client 2)
  (host 3)
  )

;; What a player is doing, sent with its state.
(defenum mp-flag
  :type uint32
  :bitfield #t
  (driving 0)      ;; drives a vehicle: the veh-* and seat-* fields are valid
  (riding 1)       ;; sits next to the driver in ride-slot
  (dead 2)         ;; dying or respawning
  (hidden 3)       ;; not drawn (no player, cutscene, model hidden)
  (invulnerable 4) ;; invincibility cheat on
  (indax 5)        ;; plays as Daxter: anim-index is an index in Daxter's art group
  (paused 6)       ;; in a menu
  (authority 7)    ;; simulates the NPCs around it (see multiplayer-world.gc)
  )

;; Network events (mp-event kind). The C++ session only routes them.
(defenum mp-event-kind
  :type int32
  (kill-entity 1) ;; iarg 0: aid of an enemy that died on the sender's screen
  (steal 2)       ;; to a driver: the sender takes your vehicle, get out
  (hit 3)         ;; to a player: an enemy hit your character on the sender's screen, fvec x = damage
  (teleport 4)    ;; to a player or everyone: go to player iarg 0 (administration)
  (world 5)       ;; host to everyone: iarg 0 = mp-world-flag bits, fvec x = time of day, text = the
                  ;; frame counters of the game clocks *mp-synced-clocks* (int32 each)
  (pvp 6)         ;; to a player: another player hit you, fvec xyz = attacker position, w = damage
  (actor-hit 7)   ;; to an object's owner: the sender hit the replica of its object iarg 0 (pid);
                  ;; iarg 1 = attack mode index, iarg 2-3 = penetrate-using, fvec w = damage
  (vehicle-taken 8) ;; to the host: a guest took NPC vehicle iarg 0 (pid) and drives its own copy
  (effect 9)      ;; to everyone: a one-shot particle effect started; iarg 0 = group id, iarg 1 =
                  ;; duration, fvec = position
  (projectile 10) ;; to everyone: a projectile was fired; text = its type, fvec = position, iarg 0-2
                  ;; = velocity (float bits), iarg 3 = owner pid, -1 for the sender's player
  (progress 11)   ;; story progress: text = bitmap of the closed task nodes iarg 0 .. iarg 0 + 255
  (elevator 12)   ;; an elevator of entity iarg 0 started a trip here, to path position fvec x
  (scene 13)      ;; a cutscene started here: iarg 0 = scene index (text = its name) or -1 for the
                  ;; last part (text = continue point, iarg 1 = scene count), iarg 2 = wait flag
  (art-level 15)  ;; a skeleton the sender sends (text) has its art in level iarg 0-3 (16 chars)
  (skel-def 16)   ;; a skeleton-group the sender sends, in 3 parts (iarg 0): 0 name, jgeo janim,
                  ;; max-lod, longest edge, bounds; 1 art group name, mgeo, shadow and joints,
                  ;; lod distances 0-3; 2 lod distances 4-5, global effects
  (world-request 17) ;; to the host: a guest that joined asks for the host's world (blob reply)
  (coop-wait 18)  ;; co-op: the sender waits for the others at story step iarg 0 (-1: no more),
                  ;; fvec = where
  )

;; Server settings chosen by the host in the administration page.
(defenum mp-world-flag
  :type int32
  :bitfield #t
  (cheats 0)    ;; guests may use the cheats of the Mods menu
  (sync-time 1) ;; guests follow the host's time of day
  (pvp 2)       ;; players can hit each other
  (progress 3)  ;; players share their story progress (closed task nodes)
  (coop 4)      ;; co-op mode (else free roam)
  )

;; One player's state. 192 bytes, mirrors mp::PlayerState.
(deftype mp-player-state (structure)
  ((trans      vector     :inline)
   (quat       quaternion :inline)
   (vel        vector     :inline)
   (veh-trans  vector     :inline)
   (veh-quat   quaternion :inline)
   (seat-trans vector     :inline)
   (anim-frame float)
   (health     float)
   (health-max float)
   (flags      mp-flag)
   (anim-index int16)
   (veh-type   int16)
   (character  int8)       ;; low 4 bits: 0 Jak, 1 Daxter; high 4 bits: outfit (target-geo - 3)
   (color      int8)
   (seat-count int8)
   (ride-slot  int8)
   (time-ms    uint32)
   (seg-mask   uint32)     ;; body segments shown (low half of the draw-control seg-mask)
   (name       uint8 16)
   (level      uint8 16)
   (cont       uint8 32)
   )
  :size-assert #xc0
  )

;; One network event. 80 bytes, mirrors mp::Event.
(deftype mp-event (structure)
  ((kind mp-event-kind)
   (from int32)
   (to   int32)
   (iarg int32 4)
   (pad  int32)
   (fvec vector :inline)
   (text uint8 32)
   )
  :size-assert #x50
  )

;; Settings kept between boots in <settings>/multiplayer.cfg. 64 bytes, mirrors mp::Config.
(deftype mp-config (structure)
  ((name      uint8 16)
   (address   uint8 32)
   (character int32)
   (color     int32)
   (enabled   int32)
   (mode      int32)   ;; game mode when hosting: 0 free roam, 1 co-op
   )
  :size-assert #x40
  )

;; The remote players' interpolated states, refreshed every frame by the hook.
(deftype mp-player-table (structure)
  ((state mp-player-state MP_MAX_PLAYERS :inline)
   (valid symbol MP_MAX_PLAYERS)
   )
  )

;; Kernel functions (game/kernel/jak3/kmultiplayer.cpp).
(define-extern pc-mp-host (function string int symbol))
(define-extern pc-mp-join (function string symbol))
(define-extern pc-mp-leave (function none))
(define-extern pc-mp-update (function mp-player-state int))
(define-extern pc-mp-get-player (function int mp-player-state symbol))
(define-extern pc-mp-send-event (function mp-event none))
(define-extern pc-mp-pop-event (function mp-event symbol))
(define-extern pc-mp-kick (function int symbol none))
(define-extern pc-mp-local-slot (function int))
(define-extern pc-mp-message (function string none))
(define-extern pc-mp-config-load (function mp-config symbol))
(define-extern pc-mp-config-save (function mp-config none))

;; ------------------------------------------------------------------------------------------------
;; Global state
;; ------------------------------------------------------------------------------------------------

(define *mp-config* (new 'global 'mp-config))
(define *mp-local* (new 'global 'mp-player-state))
(define *mp-players* (new 'global 'mp-player-table))
(dotimes (i MP_MAX_PLAYERS)
  (set! (-> *mp-players* valid i) #f)
  )

;; Editable copies of the config strings (the start menu edits these).
(define *mp-name* (new 'global 'string 16 (the-as string #f)))
(define *mp-address* (new 'global 'string 32 (the-as string #f)))

(define *mp-mode* (mp-mode offline))
(define *mp-local-slot* -1)
;; Host: the settings sent to guests. Guest: the settings received from the host.
(define *mp-world* (mp-world-flag cheats sync-time pvp progress))
;; Invincibility cheat (Mods menu).
(define *mp-invulnerable* #f)
;; #t while this player simulates the NPCs around it (always for the host), see mp-update-authority
(define *mp-authority* #f)
(define *mp-invulnerable-applied* #f)
;; Slot of the driver this player rides with, -1 when not riding.
(define *mp-ride-slot* -1)
;; Slot of the remote vehicle the player stands next to (interaction prompt), -1 for none.
(define *mp-prompt-slot* -1)
;; Teleport-to-player requested from the Mods menu, applied by the manager. -1 for none.
(define *mp-request-teleport* -1)

;; Joining the host's world, and co-op (both described with their code, below).
(deftype mp-join-state (structure)
  ((stage    int32)      ;; guest: 0 in its own world, 1 world asked, 2 loading it, 3 going to the
                         ;; host, 4 in the host's world
   (since    time-frame) ;; when the stage began (real clock)
   (foreign? symbol)     ;; playing in another player's world: nothing is saved
   (sent     int32)      ;; counters for the test log
   (loaded   int32)
   (bytes    int32)
   (blocked  int32)      ;; saves refused
   )
  )

(define *mp-join* (new 'global 'mp-join-state))
(set! (-> *mp-join* foreign?) #f)

(deftype mp-coop-state (structure)
  ((far-since  time-frame)  ;; guest: when it went beyond the leash
   (pending    int32 8)     ;; task nodes held until every player is there
   (pending-count int32)
   (spot       vector :inline) ;; where the held node closed
   (wait-from  int32)       ;; another player waits for us at wait-spot (-1 none)
   (wait-spot  vector :inline)
   (wait-time  time-frame)
   (held       int32)       ;; counters for the test log
   (released   int32)
   (leashed    int32)
   (closing?   symbol)      ;; closing a held node: let it through
   )
  )

(define *mp-coop* (new 'global 'mp-coop-state))
(set! (-> *mp-coop* wait-from) -1)
(set! (-> *mp-coop* closing?) #f)

;; Values wider than 32 bits. A global symbol only holds 32 bits (goalc writes symbol values with a
;; 32-bit store): a handle kept in one loses its pid (upper half) and never resolves again.
(deftype mp-globals (structure)
  ((manager       handle)     ;; the mp-manager process
   (manager-retry time-frame) ;; real-clock time of the last failed manager spawn
   (message-time  time-frame) ;; real-clock time the notification was set
   )
  )

(define *mp-globals* (new 'global 'mp-globals))
(set! (-> *mp-globals* manager) (the-as handle #f))

;; On-screen notification (joins, leaves, kicks...).
(define *mp-message* (new 'global 'string 128 (the-as string #f)))
(define *mp-status* (new 'global 'string 128 (the-as string #f)))
(define *mp-temp-string* (new 'global 'string 64 (the-as string #f)))

;; Last time a hit was forwarded to each player (real clock), to rate-limit them.
(define *mp-hit-sent* (new 'global 'boxed-array time-frame MP_MAX_PLAYERS))

;; aid of enemies recently killed because another player said so: their death is not echoed back.
(define *mp-remote-kills* (new 'global 'boxed-array uint32 8))
(define *mp-remote-kill-index* 0)

;; Each player's color, shown as a small marker next to its name and as its minimap dot (the
;; model itself is not tinted). The start menu lists them in the same order (multiplayer-menu.gc).
(define *mp-colors*
  (new 'static 'boxed-array :type rgba
    (new 'static 'rgba :r #x80 :g #x80 :b #x80 :a #x80) ;; white
    (new 'static 'rgba :r #x80 :g #x18 :b #x18 :a #x80) ;; red
    (new 'static 'rgba :r #x20 :g #x40 :b #x80 :a #x80) ;; blue
    (new 'static 'rgba :r #x20 :g #x80 :b #x20 :a #x80) ;; green
    (new 'static 'rgba :r #x80 :g #x80 :b #x18 :a #x80) ;; yellow
    (new 'static 'rgba :r #x60 :g #x28 :b #x80 :a #x80) ;; purple
    (new 'static 'rgba :r #x80 :g #x50 :b #x10 :a #x80) ;; orange
    (new 'static 'rgba :r #x18 :g #x80 :b #x80 :a #x80) ;; cyan
    (new 'static 'rgba :r #x80 :g #x40 :b #x70 :a #x80) ;; pink
    (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a #x80) ;; gray
    )
  )

;; One minimap icon class per color: copies of the stock red-clamped-dot (class 117: small dot,
;; kept on the edge when far, shown on the big map) with the player's color. A connection's class
;; is a pointer, so a puppet's icon points at its color's node (minimap.gc reads (-> class color)).
(deftype mp-minimap-nodes (structure)
  ((node minimap-class-node 10 :inline)
   )
  )

(define *mp-minimap-nodes* (new 'global 'mp-minimap-nodes))

(dotimes (i 10)
  (mem-copy! (the-as pointer (-> *mp-minimap-nodes* node i)) (the-as pointer (-> *minimap-class-list* 117)) (size-of minimap-class-node))
  (set! (-> *mp-minimap-nodes* node i color) (-> *mp-colors* i))
  )

;; Teleport destinations of the Mods menu: label, then continue point (engine/level/level-info.gc).
(define *mp-zones*
  (new 'static 'boxed-array :type string
    "Haven City: port" "ctyport-start"
    "Haven City: slums" "ctysluma-start"
    "Haven City: industrial" "ctygenb-start"
    "Haven City: Hip Hog Saloon" "hiphog-start"
    "Haven City: Freedom HQ" "freehq-start"
    "Haven City: sewers" "sewer-start"
    "Spargus: city" "wascitya-start"
    "Spargus: upper city" "wascityb-start"
    "Spargus: arena" "wasstada-start"
    "Spargus: palace" "waspala-start"
    "Wasteland: desert" "desert-start"
    "Eco mine" "minea-start"
    "Forest" "foresta-start"
    "Precursor temple" "templex-start"
    "Volcano" "volcanox-start"
    "Metal Head nest" "nsta-start"
    "Metal Head tower" "towera-start"
    "KG war factory" "factoryb-start"
    "Precursor core" "precura-start"
    )
  )

;; Vehicle type names, indexed by `vehicle-type` (engine/ai/traffic-h.gc). The vehicle classes
;; are level code, unknown to this GAME file, so vehicles are recognized by their type name, and
;; their model is found as "skel-<name>".
(define *mp-vehicle-types*
  (new 'static 'boxed-array :type symbol
    'h-bike-a 'h-bike-b 'h-bike-c 'h-car-a 'h-car-b 'h-car-c 'h-bike-d 'h-hellcat 'h-warf 'h-glider
    'h-sled 'h-kg-pickup 'v-turtle 'v-snake 'v-scorpion 'v-toad 'v-fox 'v-rhino 'v-mirage 'v-x-ride
    'v-marauder 'v-faccar 'v-catapult 'v-marauder-b
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Small helpers
;; ------------------------------------------------------------------------------------------------

(defun mp-enabled? ()
  "#t when the multiplayer mod is enabled (Mods menu toggle)."
  (nonzero? (-> *mp-config* enabled))
  )

(defun mp-online? ()
  "#t while hosting or connected to a host."
  (or (= *mp-mode* (mp-mode host)) (= *mp-mode* (mp-mode client)))
  )

(defun mp-cheats-allowed? ()
  "Cheats are always allowed offline and for the host; guests need the host's permission."
  (or (!= *mp-mode* (mp-mode client)) (logtest? *mp-world* (mp-world-flag cheats)))
  )

(defun mp-now ()
  "Real-time clock (keeps running while paused), for UI timers."
  (-> *display* real-clock frame-counter)
  )

(defun mp-show-message ((msg string))
  "Show `msg` at the bottom of the screen for a few seconds."
  (copy-string<-string *mp-message* msg)
  (set! (-> *mp-globals* message-time) (mp-now))
  (none)
  )

(defun mp-color-index ((index int))
  "A valid color index."
  (max 0 (min index (+ (-> *mp-colors* length) -1)))
  )

(defun mp-color-rgba ((index int))
  "A player's color."
  (-> *mp-colors* (mp-color-index index))
  )

(defun mp-remote-state ((slot int))
  "The interpolated state of a remote player, or #f when that slot is empty."
  (if (and (>= slot 0) (< slot MP_MAX_PLAYERS) (-> *mp-players* valid slot))
      (-> *mp-players* state slot)
      (the-as mp-player-state #f)
      )
  )

(defun mp-level-active? ((name (pointer uint8)))
  "#t when the level called `name` (a C string) is loaded and active here, so a player standing in
   it can be drawn."
  (dotimes (i (-> *level* length))
    (let ((lev (-> *level* level i)))
      (if (and (= (-> lev status) 'active) (string-charp= (symbol->string (-> lev name)) name))
          (return #t)
          )
      )
    )
  #f
  )

(defun mp-inherits? ((typ type) (name symbol))
  "#t when `typ` is the type called `name` or one of its children (walks at most 16 parents)."
  (dotimes (i 16)
    (if (= (-> typ symbol) name)
        (return #t)
        )
    (set! typ (-> typ parent))
    )
  #f
  )

(defun mp-vehicle-type-of ((proc process))
  "The vehicle-type of a vehicle process, or -1 when its class is not in *mp-vehicle-types*."
  (let ((typ (-> proc type)))
    (dotimes (depth 16)
      (dotimes (i (-> *mp-vehicle-types* length))
        (if (= (-> typ symbol) (-> *mp-vehicle-types* i))
            (return i)
            )
        )
      (set! typ (-> typ parent))
      )
    )
  -1
  )

(defun mp-vehicle-seat-count ((veh process))
  "Seats of a vehicle. Calls vehicle method 65 (vehicle-util.gc) through the method table, since
   the vehicle type is level code this GAME file cannot name."
  ((the-as (function process int) (-> veh type method-table 65)) veh)
  )

(defun mp-vehicle-seat-pos ((veh process) (seat int) (out vector))
  "World position of a vehicle seat, through vehicle method 66 (see mp-vehicle-seat-count)."
  ((the-as (function process vector int none) (-> veh type method-table 66)) veh out seat)
  out
  )

(defun mp-vehicle-skel ((vtype int))
  "The model of a vehicle type, or #f when its art is not loaded here."
  (when (and (>= vtype 0) (< vtype (-> *mp-vehicle-types* length)))
    (format (clear *mp-temp-string*) "skel-~S" (symbol->string (-> *mp-vehicle-types* vtype)))
    (return (the-as skeleton-group (art-group-get-by-name *level* *mp-temp-string* (the-as (pointer level) #f))))
    )
  (the-as skeleton-group #f)
  )

(defun mp-character-skel ((daxter? symbol) (outfit int))
  "The model of a character: Daxter (resident in GAME), or Jak in `outfit` (target-geo - 3: 1 Jak 2,
   2 old Jak 2, 3 Jak 3, as target-skel-group picks them), else in the local player's outfit when
   that model is not loaded here."
  (cond
    (daxter?
     (the-as skeleton-group (art-group-get-by-name *level* "skel-sidekick" (the-as (pointer level) #f)))
     )
    (else
      (let ((sg (case outfit
                  ((1) (art-group-get-by-name *level* "skel-jchar-normal" (the-as (pointer level) #f)))
                  ((2) (art-group-get-by-name *level* "skel-jchar-old" (the-as (pointer level) #f)))
                  ((3) (art-group-get-by-name *level* "skel-jchar-c" (the-as (pointer level) #f)))
                  (else (the-as art-group #f))
                  )
                )
            )
        (if (and sg (type? sg skeleton-group))
            (the-as skeleton-group sg)
            (target-skel-group)
            )
        )
      )
    )
  )

(defun mp-local-outfit ()
  "The local player's outfit as sent in the character byte (target-geo - 3, 0 when unknown)."
  (if (and *target* (>= (the-as int (-> *target* ext-geo)) 4))
      (+ (the-as int (-> *target* ext-geo)) -3)
      0
      )
  )

(defun mp-state-outfit ((st mp-player-state))
  "Outfit of a remote player, from its character byte."
  (logand (shr (the-as int (-> st character)) 4) 15)
  )

(defun mp-send-event ((kind mp-event-kind) (to int) (arg0 int) (f float))
  "Send a network event to player `to` (-1 = everyone else)."
  (let ((ev (new 'stack 'mp-event)))
    (set! (-> ev kind) kind)
    (set! (-> ev to) to)
    (set! (-> ev iarg 0) arg0)
    (set! (-> ev fvec x) f)
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-target-state-name ()
  "Name of the player's current (or next) state, or #f."
  (if (and *target* (-> *target* next-state))
      (-> *target* next-state name)
      #f
      )
  )

;; ------------------------------------------------------------------------------------------------
;; Config
;; ------------------------------------------------------------------------------------------------

(defun mp-config-save! ()
  "Write the editable settings back to the config and save it to disk."
  (copyn-charp<-string (-> *mp-config* name) *mp-name* 16)
  (copyn-charp<-string (-> *mp-config* address) *mp-address* 32)
  (pc-mp-config-save *mp-config*)
  (none)
  )

(defun mp-config-load! ()
  "Load the saved settings, or set defaults on the first run."
  (copyn-charp<-string (-> *mp-config* name) "Player" 16)
  (copyn-charp<-string (-> *mp-config* address) "127.0.0.1:7777" 32)
  (set! (-> *mp-config* character) 0)
  (set! (-> *mp-config* color) 0)
  (set! (-> *mp-config* enabled) 0)
  (set! (-> *mp-config* mode) 0)
  (pc-mp-config-load *mp-config*)
  (string<-charp *mp-name* (-> *mp-config* name))
  (string<-charp *mp-address* (-> *mp-config* address))
  (none)
  )

(mp-config-load!)

;; ------------------------------------------------------------------------------------------------
;; Session control (called from the start menu)
;; ------------------------------------------------------------------------------------------------

(defun mp-apply-mode! ()
  "The game mode of the config (Options > Multiplayer > Game mode) in the server settings."
  (if (= (-> *mp-config* mode) 1)
      (logior! *mp-world* (mp-world-flag coop))
      (logclear! *mp-world* (mp-world-flag coop))
      )
  (none)
  )

(defun mp-host! ()
  "Start a server on the port of the address field."
  ;; only from offline: a menu button also fires on the confirm that deselects it
  (when (= *mp-mode* (mp-mode offline))
    (mp-config-save!)
    (mp-apply-mode!)
    (pc-mp-host *mp-address* MP_MAX_PLAYERS)
    (pc-mp-message *mp-status*)
    (mp-show-message *mp-status*)
    )
  (none)
  )

(defun mp-join! ()
  "Connect to the server of the address field."
  ;; only from offline: a menu button also fires on the confirm that deselects it
  (when (= *mp-mode* (mp-mode offline))
    (mp-config-save!)
    (pc-mp-join *mp-address*)
    (pc-mp-message *mp-status*)
    (mp-show-message *mp-status*)
    )
  (none)
  )

(defun mp-leave! ()
  "Leave the session (a host stops its server)."
  (when (!= *mp-mode* (mp-mode offline))
    (pc-mp-leave)
    (set! *mp-mode* (mp-mode offline))
    (pc-mp-message *mp-status*)
    (mp-show-message *mp-status*)
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Local player -> network
;; ------------------------------------------------------------------------------------------------

(defun mp-build-local-state ()
  "Describe the local player in *mp-local*. Runs every frame from the hook, even paused."
  (let ((st *mp-local*))
    (copyn-charp<-string (-> st name) *mp-name* 16)
    (set! (-> st character) (logior (logand (-> *mp-config* character) 15) (shl (mp-local-outfit) 4)))
    (set! (-> st color) (-> *mp-config* color))
    (set! (-> st flags) (mp-flag))
    (set! (-> st anim-index) -1)
    (set! (-> st veh-type) -1)
    (set! (-> st seat-count) 0)
    (set! (-> st ride-slot) *mp-ride-slot*)
    (if (paused?)
        (logior! (-> st flags) (mp-flag paused))
        )
    (if *mp-invulnerable*
        (logior! (-> st flags) (mp-flag invulnerable))
        )
    (if (>= *mp-ride-slot* 0)
        (logior! (-> st flags) (mp-flag riding))
        )
    (if *mp-authority*
        (logior! (-> st flags) (mp-flag authority))
        )
    (set! (-> st seg-mask) (the-as uint 0))
    (cond
      ;; joining: still at the title screen or loading the host's world
      ((or (not *target*) (and (> (-> *mp-join* stage) 0) (< (-> *mp-join* stage) 3)))
       (logior! (-> st flags) (mp-flag hidden))
       )
      (else
        (let ((tgt *target*))
          (vector-copy! (-> st trans) (-> tgt control trans))
          (quaternion-copy! (-> st quat) (-> tgt control quat))
          (vector-copy! (-> st vel) (-> tgt control transv))
          (set! (-> st health) (-> tgt fact health))
          (set! (-> st health-max) (-> tgt fact health-max))
          (set! (-> st seg-mask) (the-as uint (-> tgt draw seg-mask)))
          (if (focus-test? tgt indax)
              (logior! (-> st flags) (mp-flag indax))
              )
          (if (focus-test? tgt dead)
              (logior! (-> st flags) (mp-flag dead))
              )
          ;; a passenger's own model is hidden on purpose: others still draw it in the seat
          (if (and (logtest? (-> tgt draw status) (draw-control-status no-draw)) (< *mp-ride-slot* 0))
              (logior! (-> st flags) (mp-flag hidden))
              )
          ;; current animation, as an index in the art group (the same on every machine)
          (let ((skel (-> tgt skel))
                (ag (-> tgt draw art-group))
                )
            (when (> (-> skel active-channels) 0)
              (let ((fg (-> skel root-channel 0 frame-group)))
                (when fg
                  (dotimes (i (-> ag length))
                    (when (= (-> ag data i) fg)
                      (set! (-> st anim-index) i)
                      (set! (-> st anim-frame) (-> skel root-channel 0 frame-num))
                      (set! i (-> ag length))
                      )
                    )
                  )
                )
              )
            )
          ;; driven vehicle
          (when (and (focus-test? tgt pilot) (nonzero? (-> tgt pilot)))
            (let ((veh (handle->process (-> tgt pilot vehicle))))
              (when (and veh (mp-inherits? (-> veh type) 'vehicle))
                (logior! (-> st flags) (mp-flag driving))
                (set! (-> st veh-type) (mp-vehicle-type-of veh))
                (vector-copy! (-> st veh-trans) (-> (the-as process-drawable veh) root trans))
                (quaternion-copy! (-> st veh-quat) (-> (the-as process-drawable veh) root quat))
                (set! (-> st seat-count) (mp-vehicle-seat-count veh))
                (if (> (-> st seat-count) 1)
                    (mp-vehicle-seat-pos veh 1 (-> st seat-trans))
                    (vector-copy! (-> st seat-trans) (-> st veh-trans))
                    )
                )
              )
            )
          ;; where the player is, for drawing and teleports
          (let ((lev (-> tgt current-level)))
            (if lev
                (copyn-charp<-string (-> st level) (symbol->string (-> lev name)) 16)
                (set! (-> st level 0) (the-as uint 0))
                )
            )
          (if (-> *game-info* current-continue)
              (copyn-charp<-string (-> st cont) (-> *game-info* current-continue name) 32)
              (set! (-> st cont 0) (the-as uint 0))
              )
          )
        )
      )
    )
  (none)
  )

(define-extern mp-send-all-progress (function int none)) ;; below, "Shared story progress"

(defun mp-read-remote-states ()
  "Copy every remote player's interpolated state into *mp-players*, announcing joins and leaves."
  (dotimes (i MP_MAX_PLAYERS)
    (let ((was (-> *mp-players* valid i))
          (now (pc-mp-get-player i (-> *mp-players* state i)))
          )
      (set! (-> *mp-players* valid i) now)
      ;; a player who joins gets the host's story progress (it plays in the host's world, its own
      ;; progress is not merged)
      (if (and now (not was) (= *mp-mode* (mp-mode host)) (logtest? *mp-world* (mp-world-flag progress)))
          (mp-send-all-progress i)
          )
      ;; no announcement once the session is over: the reason it ended stays on screen
      (when (and (!= was now) (mp-online?))
        (string<-charp *mp-temp-string* (-> *mp-players* state i name))
        (format (clear *mp-message*) (if now "~S joined the game" "~S left the game") *mp-temp-string*)
        (set! (-> *mp-globals* message-time) (mp-now))
        )
      )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Remote player puppet
;; ------------------------------------------------------------------------------------------------

;; Draws one remote player: its character in its color, playing the animation it plays, with a
;; ghost of the vehicle it drives. Focusable and listed with the player (collide-spec jak), so
;; enemies may choose it as their target; their hits are forwarded to that player.
(deftype mp-puppet (process-focusable)
  ((slot       int32)          ;; player slot shown
   (daxter?    symbol)         ;; #t: Daxter model, else Jak
   (outfit     int32)          ;; Jak's outfit (mp-character-skel)
   (local?     symbol)         ;; #t: shows the local player sitting as a passenger
   (skel-group skeleton-group) ;; model in use, to notice an outfit change
   (minimap    connection-minimap)
   (ghost      handle)         ;; manipy drawing the driven vehicle
   (ghost-type int32)
   (ghost-skel skeleton-group)
   (ghost-retry time-frame)    ;; last failed ghost spawn (process pool full)
   (hurtbox    handle)         ;; mp-hurtbox: what the local player's attacks hit
   (last-attack uint32)        ;; id of the last attack forwarded, so one blow counts once
   (fx-group   int32 MP_FX_TRACKERS) ;; particle groups the player's model emits (mp-play-emitters)
   (fx-tracker handle MP_FX_TRACKERS)
   (pose-time  int32)          ;; owner's time (tenths of a ms) of the pose laid last (test logs)
   )
  )

;; Full poses and continuous emitters (multiplayer-world.gc, linked after this file).
(define-extern mp-pose-postbind (function draw-control cspace-array joint-control none))
(define-extern mp-play-emitters (function process-drawable uint (pointer int32) (pointer handle) none))

(defun mp-puppet-pose-id ((slot int))
  "Id under which a player's own model is sent in pose batches (its props use their pid)."
  (the-as uint (logior (shl slot 24) #xffffff))
  )

(defun mp-forward-hit ((slot int))
  "An enemy hit the puppet of `slot` here: tell that player (at most once a second)."
  (when (and (mp-online?) (>= slot 0) (< slot MP_MAX_PLAYERS)
             (>= (- (mp-now) (-> *mp-hit-sent* slot)) (seconds 1))
             )
    (set! (-> *mp-hit-sent* slot) (mp-now))
    (mp-send-event (mp-event-kind hit) slot 0 1.0)
    )
  (none)
  )

(defbehavior mp-puppet-kill-ghost mp-puppet ()
  "Remove the vehicle ghost, if any."
  (let ((ghost (handle->process (-> self ghost))))
    (if ghost
        (deactivate ghost)
        )
    )
  (set! (-> self ghost) (the-as handle #f))
  (none)
  )

(defbehavior mp-puppet-update-ghost mp-puppet ((st mp-player-state) (shown? symbol))
  "Keep a ghost of the vehicle the player drives, at its interpolated place. The ghost is removed
   as soon as its art stops being loaded here (its level is leaving), before the art is freed."
  (cond
    ((and shown? (logtest? (-> st flags) (mp-flag driving)) (>= (-> st veh-type) 0))
     (let ((sg (mp-vehicle-skel (-> st veh-type)))
           (ghost (handle->process (-> self ghost)))
           )
       (when (and ghost (or (!= (-> self ghost-type) (-> st veh-type)) (!= (-> self ghost-skel) sg)))
         (mp-puppet-kill-ghost)
         (set! ghost #f)
         )
       (when (and (not ghost) sg (time-elapsed? (-> self ghost-retry) (seconds 1)))
         (let ((proc (process-spawn
                       manipy
                       :init manipy-init
                       (-> st veh-trans)
                       (the-as entity-actor #f)
                       sg
                       (the-as vector #f)
                       (the-as manipy-options 0)
                       :name "mp-ghost-vehicle"
                       :to self
                       :stack-size #x10000
                       )
                     )
               )
           (cond
             (proc
               (set! (-> self ghost) (ppointer->handle proc))
               (set! (-> self ghost-type) (-> st veh-type))
               (set! (-> self ghost-skel) sg)
               (set! ghost (ppointer->process proc))
               )
             (else
               (set-time! (-> self ghost-retry))
               )
             )
           )
         )
       (when ghost
         (send-event ghost 'trans (-> st veh-trans))
         (send-event ghost 'rot-quat (-> st veh-quat))
         )
       )
     )
    (else
      (mp-puppet-kill-ghost)
      )
    )
  (none)
  )

(defbehavior mp-puppet-update mp-puppet ()
  "Copy the player's state onto the puppet: place, visibility, tint, animation, vehicle."
  (let ((st (if (-> self local?)
                *mp-local*
                (mp-remote-state (-> self slot))
                )
            )
        )
    (when st
      ;; the player's model is resident: it is drawn wherever the player stands, even in a level
      ;; not loaded here (seen from afar, over the low-detail view of that place)
      (let ((shown? (not (logtest? (-> st flags) (mp-flag hidden)))))
        (when (-> self local?)
          ;; the passenger's own view: always shown, in the seat
          (set! shown? #t)
          )
        ;; a passenger sits in its driver's seat as this machine sees that vehicle: its own reported
        ;; position comes through the network twice and would trail behind the vehicle
        (let ((driver (cond
                        ((or (-> self local?) (not (logtest? (-> st flags) (mp-flag riding))))
                         (the-as mp-player-state #f)
                         )
                        ((= (-> st ride-slot) *mp-local-slot*)
                         *mp-local*
                         )
                        (else
                          (mp-remote-state (-> st ride-slot))
                          )
                        )
                      )
              )
          (cond
            ((and driver (logtest? (-> driver flags) (mp-flag driving)))
             (move-to-point! (-> self root) (-> driver seat-trans))
             (quaternion-copy! (-> self root quat) (-> driver veh-quat))
             )
            (else
              (move-to-point! (-> self root) (-> st trans))
              (quaternion-copy! (-> self root quat) (-> st quat))
              )
            )
          )
        (vector-copy! (-> (the-as collide-shape-moving (-> self root)) transv) (-> st vel))
        (cond
          (shown?
            (logclear! (-> self draw status) (draw-control-status no-draw))
            (set! (-> self focus-status) (if (logtest? (-> st flags) (mp-flag dead))
                                             (focus-status dead)
                                             (focus-status)
                                             )
                  )
            )
          (else
            (logior! (-> self draw status) (draw-control-status no-draw))
            (set! (-> self focus-status) (focus-status disable))
            )
          )
        ;; body segments shown (helmet, gun holster...), like the player's own model
        (if (and (nonzero? (-> st seg-mask)) (!= (the-as uint (-> self draw seg-mask)) (-> st seg-mask)))
            (setup-masks (-> self draw) -1 (the-as int (-> st seg-mask)))
            )
        ;; the color is a marker, not a tint: only the minimap dot takes it
        (if (-> self minimap)
            (set! (-> self minimap class) (-> *mp-minimap-nodes* node (mp-color-index (-> st color))))
            )
        ;; the animation the player plays, by index; one that is not loaded here falls back to
        ;; the idle stance (resident). Indices: engine/data/art-elts.gc. This only drives the
        ;; animation effects (footsteps, sounds) and the model while no pose arrived: the player's
        ;; exact pose replaces the bones (mp-pose-postbind).
        (let* ((ag (-> self draw art-group))
               (idx (-> st anim-index))
               (anim (if (and (>= idx 0) (< idx (-> ag length)))
                         (-> ag data idx)
                         (the-as art-element #f)
                         )
                     )
               )
          (if (not (and anim (type? anim art-joint-anim)))
              (set! anim (cond
                           ((-> self daxter?)
                            (-> ag data 473) ;; daxter-indax-stance-ja
                            )
                           ;; driving or riding: the pilot animations stream in only on the
                           ;; driver's machine, so crouch (closer to sitting than standing)
                           ((logtest? (-> st flags) (mp-flag driving riding))
                            (-> ag data 33) ;; jakb-duck-stance-ja
                            )
                           (else
                             (-> ag data 18) ;; jakb-stance-loop-ja
                             )
                           )
                    )
              )
          (when (and anim (type? anim art-joint-anim))
            (let ((ja-anim (the-as art-joint-anim anim)))
              (ja :group! ja-anim
                  :num! (identity (fmax 0.0 (fmin (-> st anim-frame) (the float (+ (-> ja-anim frames num-frames) -1)))))
                  )
              )
            )
          )
        ;; the vehicle a remote player drives is drawn by its replica (multiplayer-world.gc)
        )
      )
    )
  (none)
  )

;; What the local player's punches, kicks and shots hit on a remote player. The puppet itself must
;; stay in the player collide list with (collide-spec jak) so enemies can focus it, but the
;; player's attacks only look at *collide-hit-by-others-list* (the actor hash) and at collide-as
;; bits like bot or civilian (target-collide-set!, gun shots' collide-with). This child sits there,
;; follows the puppet, and hands every hit to it. A plain process-drawable: no enemy focuses it.
(deftype mp-hurtbox (process-drawable)
  ((root collide-shape :override)
   )
  )

(defun mp-from-local-player? ((proc process))
  "#t when `proc` is the local player or one of its children (gun, shots)."
  (dotimes (i 4)
    (cond
      ((not proc)
       (return #f)
       )
      ((= proc *target*)
       (return #t)
       )
      (else
        (set! proc (the-as process (ppointer->process (-> proc parent))))
        )
      )
    )
  #f
  )

(defstate mp-hurtbox-idle (mp-hurtbox)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       ;; returning #t tells the attacker the blow landed (the projectile stops, the punch hits)
       (send-event (ppointer->process (-> self parent)) 'mp-hit proc (-> block param 1))
       #t
       )
      )
    )
  :code (behavior ()
    (loop
      (suspend)
      )
    )
  :post (behavior ()
    (let ((puppet (the-as mp-puppet (ppointer->process (-> self parent)))))
      (when puppet
        (move-to-point! (-> self root) (-> puppet root trans))
        ;; no hit while the player is not drawn or not hittable, nor while it sits in a vehicle:
        ;; the sphere would be inside the vehicle and stop it (the vehicle's copy takes the hits)
        (let ((st (mp-remote-state (-> puppet slot))))
          (set! (-> self root root-prim prim-core collide-as)
                (if (or (logtest? (-> puppet focus-status) (focus-status disable dead))
                        (and st (logtest? (-> st flags) (mp-flag driving riding)))
                        )
                    (collide-spec)
                    (collide-spec bot civilian)
                    )
                )
          )
        )
      )
    )
  )

(defbehavior mp-hurtbox-init-by-other mp-hurtbox ()
  "A solid sphere in the actor hash, the size of a standing player."
  (let ((cshape (new 'process 'collide-shape self (collide-list-enum usually-hit-by-player))))
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (collide-spec bot civilian))
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set! (-> prim prim-core action) (collide-action solid))
      (set-vector! (-> prim local-sphere) 0.0 (meters 1) 0.0 (meters 0.9))
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) prim)
      )
    (set! (-> cshape nav-radius) (meters 0.75))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> self root) cshape)
    )
  (let ((puppet (the-as mp-puppet (ppointer->process (-> self parent)))))
    (if puppet
        (move-to-point! (-> self root) (-> puppet root trans))
        )
    )
  (go mp-hurtbox-idle)
  )

(defbehavior mp-puppet-hit mp-puppet ((attacker process) (info attack-info))
  "Something hit this remote player here. The local player's blows and shots go to that player as a
   player hit (with knockback); an enemy's go as an enemy hit. Each attack id counts once."
  (let ((id (if (and info (logtest? (attack-mask id) (-> info mask)))
                (-> info id)
                (the-as uint 0)
                )
            )
        )
    (when (or (zero? id) (!= id (-> self last-attack)))
      (set! (-> self last-attack) id)
      (cond
        ((mp-from-local-player? attacker)
         (when (and *target* (logtest? *mp-world* (mp-world-flag pvp)))
           (let ((ev (new 'stack 'mp-event))
                 (damage (if (and info (logtest? (attack-mask damage) (-> info mask)))
                             (fmax 1.0 (fmin 3.0 (-> info damage)))
                             1.0
                             )
                         )
                 )
             (set! (-> ev kind) (mp-event-kind pvp))
             (set! (-> ev to) (-> self slot))
             (vector-copy! (-> ev fvec) (-> *target* control trans))
             (set! (-> ev fvec w) damage)
             (pc-mp-send-event ev)
             )
           )
         )
        ((type? attacker projectile)
         ;; a shot (an NPC's, or a copy of another player's): each machine damages only its own
         ;; player with its own copy of the shot, so the original is not forwarded
         )
        (else
          (mp-forward-hit (-> self slot))
          )
        )
      )
    )
  (none)
  )

(defstate mp-puppet-idle (mp-puppet)
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('attack)
       ;; an enemy of this machine hit this player: the damage happens on that player's machine
       (if (not (-> self local?))
           (mp-puppet-hit proc (the-as attack-info (-> block param 1)))
           )
       #t
       )
      (('mp-hit)
       (mp-puppet-hit (the-as process (-> block param 0)) (the-as attack-info (-> block param 1)))
       #t
       )
      )
    )
  :exit (behavior ()
    (mp-puppet-kill-ghost)
    (when (-> self minimap)
      (kill-callback (-> *minimap* engine) (-> self minimap))
      (set! (-> self minimap) #f)
      )
    )
  :code (behavior ()
    (loop
      (suspend)
      )
    )
  :post (behavior ()
    (mp-puppet-update)
    (if (not (-> self local?))
        (mp-play-emitters self (mp-puppet-pose-id (-> self slot)) (-> self fx-group) (-> self fx-tracker))
        )
    (ja-post)
    )
  )

(defbehavior mp-puppet-init-by-other mp-puppet ((slot int) (daxter? symbol) (local? symbol))
  "Set up a puppet for `slot`. `daxter?` picks the model; `local?` shows the local player (passenger
   view) and keeps the puppet out of enemies' sight, the minimap and the hit forwarding."
  (set! (-> self slot) slot)
  (set! (-> self daxter?) daxter?)
  (set! (-> self local?) local?)
  (set! (-> self ghost) (the-as handle #f))
  (set! (-> self ghost-type) -1)
  (set! (-> self minimap) #f)
  ;; one sphere, listed with the player: enemies may pick it as their focus
  (let ((cshape (new 'process 'collide-shape-moving self (collide-list-enum hit-by-others))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> prim prim-core collide-as) (if local?
                                                (collide-spec)
                                                (collide-spec jak)
                                                )
            )
      (set! (-> prim prim-core collide-with) (collide-spec))
      (set-vector! (-> prim local-sphere) 0.0 (meters 1) 0.0 (meters 1))
      (set! (-> cshape total-prims) (the-as uint 1))
      (set! (-> cshape root-prim) prim)
      )
    (set! (-> cshape nav-radius) (meters 0.75))
    (let ((prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> prim prim-core collide-with))
      )
    (set! (-> self root) cshape)
    )
  (let ((st (if local?
                *mp-local*
                (mp-remote-state slot)
                )
            )
        )
    (if st
        (vector-copy! (-> self root trans) (-> st trans))
        )
    )
  ;; the manager only spawns a puppet when this model is available
  (set! (-> self outfit) (let ((st (if local?
                                       *mp-local*
                                       (mp-remote-state slot)
                                       )
                                   )
                               )
                           (if st
                               (mp-state-outfit st)
                               0
                               )
                           )
        )
  (let ((sg (mp-character-skel daxter? (-> self outfit))))
    (set! (-> self skel-group) sg)
    (initialize-skeleton self sg (the-as pair 0))
    )
  (ja-channel-set! 1)
  ;; the bones take the player's own pose once computed
  (set! (-> self skel postbind-function) mp-pose-postbind)
  (dotimes (i MP_FX_TRACKERS)
    (set! (-> self fx-group i) -1)
    (set! (-> self fx-tracker i) (the-as handle #f))
    )
  (set! (-> self focus-status) (focus-status disable))
  (set! (-> self hurtbox) (the-as handle #f))
  (when (not local?)
    (set! (-> self minimap) (add-icon! *minimap* self (the-as uint 124) (the-as int #f) (the-as vector #t) 0))
    (let ((hurtbox (process-spawn mp-hurtbox :name "mp-hurtbox" :to self)))
      (if hurtbox
          (set! (-> self hurtbox) (ppointer->handle hurtbox))
          )
      )
    )
  (go mp-puppet-idle)
  )

;; ------------------------------------------------------------------------------------------------
;; Passenger seat marker
;; ------------------------------------------------------------------------------------------------

;; An invisible point that follows the passenger seat of a remote driver's vehicle. The local
;; player rides it with the stock `target-grab-ride` state, which moves the player to the trans of
;; the process that asked for the ride, every frame. Its root is a plain trsqv: no collision, so
;; nothing ever picks it as a focus.
(deftype mp-seat (process-focusable)
  ((driver int32)
   )
  )

(defbehavior mp-seat-follow mp-seat ()
  "Move to the driver's passenger seat."
  (let ((st (mp-remote-state (-> self driver))))
    (when st
      (vector-copy! (-> self root trans) (-> st seat-trans))
      (quaternion-copy! (-> self root quat) (-> st veh-quat))
      )
    )
  (none)
  )

(defstate mp-seat-idle (mp-seat)
  :code (behavior ()
    (loop
      (mp-seat-follow)
      (suspend)
      )
    )
  )

(defbehavior mp-seat-init-by-other mp-seat ((driver int))
  "Set up a seat marker for the vehicle of player `driver`."
  (set! (-> self driver) driver)
  (set! (-> self root) (the-as collide-shape (new 'process 'trsqv)))
  (mp-seat-follow)
  (go mp-seat-idle)
  )

;; ------------------------------------------------------------------------------------------------
;; Enemies: shared deaths
;; ------------------------------------------------------------------------------------------------

(defun mp-remote-kill? ((aid uint))
  "#t when `aid` died because another player said so (its death must not be echoed back)."
  (dotimes (i (-> *mp-remote-kills* length))
    (if (= (-> *mp-remote-kills* i) aid)
        (return #t)
        )
    )
  #f
  )

(defun mp-on-enemy-died ((this enemy))
  "An enemy died on this machine: the other players kill their copy of it."
  (when (and (mp-online?) (-> this entity) (nonzero? (-> this entity aid)) (not (mp-remote-kill? (-> this entity aid))))
    (mp-send-event (mp-event-kind kill-entity) -1 (the-as int (-> this entity aid)) 0.0)
    )
  (none)
  )

(defun mp-apply-remote-kill ((aid uint))
  "Another player killed the enemy of entity `aid` (its death animation plays here too), or broke the
   crate or took the pickup of entity `aid` (it is removed here; the break effect comes with the
   shared effects)."
  (let ((ent (entity-by-aid aid)))
    (when ent
      (let ((proc (-> (the-as entity-actor ent) extra process)))
        (when proc
          (cond
            ((and (type? proc enemy) (not (focus-test? (the-as enemy proc) dead)))
             (set! (-> *mp-remote-kills* *mp-remote-kill-index*) aid)
             (set! *mp-remote-kill-index* (mod (+ *mp-remote-kill-index* 1) (-> *mp-remote-kills* length)))
             (send-event proc 'instant-death)
             )
            ((or (type? proc crate) (type? proc collectable))
             (set! (-> *mp-remote-kills* *mp-remote-kill-index*) aid)
             (set! *mp-remote-kill-index* (mod (+ *mp-remote-kill-index* 1) (-> *mp-remote-kills* length)))
             (process-entity-status! proc (entity-perm-status dead) #t)
             (deactivate proc)
             )
            )
          )
        )
      )
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock enemy death bookkeeping (engine/common-obs/enemy-states.gc) to
;; share deaths. Every enemy death goes through it (from on-dying); no enemy class overrides it.
;; define-perm keeps the stock method when this file is reloaded in a REPL session.
(define-perm *mp-stock-mark-as-dead* (function enemy none)
  (the-as (function enemy none) (method-of-type enemy mark-as-dead))
  )

(defmethod mark-as-dead ((this enemy))
  "Stock behavior, then tell the other players (multiplayer mod, no-op offline)."
  (*mp-stock-mark-as-dead* this)
  (mp-on-enemy-died this)
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Shared story progress
;; ------------------------------------------------------------------------------------------------

;; Story progress is the set of closed task nodes (*game-info* sub-task-list). Every closure goes
;; through the node's `open!` method (it closes the parents a node needs too), wrapped below: the
;; others close the same node, with the same rewards. A player who joins gets every node closed by
;; the others, and sends its own, so all end with the union. The host can turn it off.

(define *mp-progress-replaying* #f) ;; closing nodes another player closed: do not send them back
(define *mp-progress-received* 0)   ;; nodes closed because another player did, for the test log

(defun mp-send-progress ((to int) (first int) (only int))
  "Send to player `to` (-1: everyone) the closed task nodes among first .. first + 255, as a bitmap;
   only node `only` when it is not -1."
  (let ((ev (new 'stack 'mp-event))
        (nodes (-> *game-info* sub-task-list))
        )
    (set! (-> ev kind) (mp-event-kind progress))
    (set! (-> ev to) to)
    (set! (-> ev iarg 0) first)
    (dotimes (i 32)
      (set! (-> ev text i) (the-as uint 0))
      )
    (dotimes (i 256)
      (let ((n (+ first i)))
        (when (and (> n 0)
                   (< n (-> nodes length))
                   (or (= only -1) (= n only))
                   (logtest? (-> nodes n flags) (game-task-node-flag closed))
                   )
          (set! (-> ev text (/ i 8)) (logior (-> ev text (/ i 8)) (the-as uint (ash 1 (logand i 7)))))
          )
        )
      )
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-send-all-progress ((to int))
  "Send every closed task node to player `to`."
  (let ((first 0))
    (while (< first (-> *game-info* sub-task-list length))
      (mp-send-progress to first -1)
      (+! first 256)
      )
    )
  (none)
  )

(defun mp-on-task-closed ((node game-task-node-info))
  "A task node closed here: the other players close it too, unless they told us to."
  (when (and (mp-online?) (logtest? *mp-world* (mp-world-flag progress)) (not *mp-progress-replaying*))
    (let ((index (get-idx-in-task-list node)))
      (if (> index 0)
          (mp-send-progress -1 index index)
          )
      )
    )
  (none)
  )

(defun mp-apply-progress ((ev mp-event))
  "Close the task nodes another player has closed, as if done here (rewards included)."
  (when (logtest? *mp-world* (mp-world-flag progress))
    (let ((nodes (-> *game-info* sub-task-list))
          (first (-> ev iarg 0))
          (count 0)
          )
      (set! *mp-progress-replaying* #t)
      (dotimes (i 256)
        (let ((n (+ first i)))
          (when (and (> n 0)
                     (< n (-> nodes length))
                     (logtest? (-> ev text (/ i 8)) (ash 1 (logand i 7)))
                     (not (logtest? (-> nodes n flags) (game-task-node-flag closed)))
                     )
            (open! (-> nodes n) 'event)
            (+! count 1)
            )
          )
        )
      (set! *mp-progress-replaying* #f)
      (when (> count 0)
        (+! *mp-progress-received* count)
        (format 0 "[multiplayer] ~D task node(s) closed after player ~D~%" count (-> ev from))
        )
      )
    )
  (none)
  )

;; MOD multiplayer -- wrap the stock task node closure (engine/game/task/task-control.gc).
(define-perm *mp-stock-task-node-open!* (function game-task-node-info symbol int)
  (the-as (function game-task-node-info symbol int) (method-of-type game-task-node-info open!))
  )

(define-extern mp-coop-hold? (function game-task-node-info symbol)) ;; "Co-op mode", below

(defmethod open! ((this game-task-node-info) (arg0 symbol))
  "Stock behavior (closes the node and the parents it needs); the other players close it too
   (multiplayer mod, no-op offline). In co-op it waits until every player is there."
  (if (and (not (logtest? (-> this flags) (game-task-node-flag closed))) (mp-coop-hold? this))
      0
      (let* ((was-closed? (logtest? (-> this flags) (game-task-node-flag closed)))
             (result (*mp-stock-task-node-open!* this arg0))
             )
        (if (and (not was-closed?) (logtest? (-> this flags) (game-task-node-flag closed)))
            (mp-on-task-closed this)
            )
        result
        )
      )
  )

;; ------------------------------------------------------------------------------------------------
;; Manager process
;; ------------------------------------------------------------------------------------------------

;; Shared world (multiplayer-world.gc, linked after this file).
(declare-type mp-manager process)
(define-extern mp-world-update (function none :behavior mp-manager))
(define-extern mp-world-client-stop (function none :behavior mp-manager))
(define-extern mp-on-actor-hit (function mp-event none :behavior mp-manager))
(define-extern mp-on-vehicle-taken (function mp-event none :behavior mp-manager))
(define-extern mp-nearest-replica-vehicle (function vector int))
(define-extern mp-take-replica-vehicle (function int symbol :behavior mp-manager))

;; ------------------------------------------------------------------------------------------------
;; The host's world for a guest
;; ------------------------------------------------------------------------------------------------

;; A guest who joins plays in the host's world, whatever its own save: the host writes its game into
;; a save in memory (save-game, engine/game/game-save.gc) and sends it (pc-mp-send-blob); the guest
;; loads it as the stock Load Game does (initialize! 'game: the host's checkpoint, a loading screen,
;; its progress, equipment and world), then goes next to the host. The guest's memory card is never
;; read nor written for it, its own settings (language, screen, subtitles) stay its own, and while it
;; plays in the host's world it saves nothing (auto-save-command, below): its save stays as it was.
;; From the title screen too (Options > Multiplayer > Join the server).

(define-extern mp-draw-prompt (function text-id none)) ;; overlay, below
(define-extern mp-player-count (function int)) ;; multiplayer-menu.gc
(define-extern mp-draw-text (function dma-buffer string int int float int))

(define *mp-world-save* (the-as game-save #f)) ;; the save sent or received, allocated once

(define-extern pc-mp-send-blob (function int pointer int none))
(define-extern pc-mp-blob-ready (function int))
(define-extern pc-mp-blob-take (function pointer int int))

(defun mp-world-save-buffer ()
  "The in-memory save: as large as a memory card save (#x1e000 bytes of tags)."
  (if (not *mp-world-save*)
      (set! *mp-world-save* (new 'global 'game-save #x1e000))
      )
  *mp-world-save*
  )

(defbehavior mp-send-world-save mp-manager ((to int))
  "Host: our game, written into the in-memory save, to player `to` (who just joined)."
  (let ((save (mp-world-save-buffer)))
    (save-game *game-info* save "multiplayer")
    (let ((size (+ (-> save type size) (-> save length))))
      (pc-mp-send-blob to (the-as pointer (&-> save type)) (the-as int size))
      (+! (-> *mp-join* sent) 1)
      (set! (-> *mp-join* bytes) (the-as int size))
      (format 0 "[multiplayer] world sent to player ~D (~D bytes, continue ~S)~%" to size (-> *game-info* current-continue name))
      )
    )
  (none)
  )

(defun mp-save-keep-own-settings ((save game-save))
  "Our own settings stay ours: the tags of `save` that set the language, the screen, subtitles,
   camera and hints become sfx-volume tags, which load-game skips (pc-settings keeps them)."
  (let ((tag (the-as game-save-tag (-> save tag)))
        (end (the-as pointer (&-> save tag 0 user-int8 (-> save length))))
        )
    (while (< (the-as int tag) (the-as int end))
      (case (-> tag elt-type)
        (((game-save-elt language)
          (game-save-elt screenx)
          (game-save-elt screeny)
          (game-save-elt play-hints)
          (game-save-elt video-mode)
          (game-save-elt aspect-ratio)
          (game-save-elt camera-stick-dir)
          (game-save-elt subtitle-language)
          (game-save-elt stereo-mode)
          (game-save-elt brightness)
          (game-save-elt contrast)
          (game-save-elt audio-language)
          (game-save-elt flip-horizontal)
          (game-save-elt flip-vertical)
          )
         (set! (-> tag elt-type) (game-save-elt sfx-volume))
         )
        )
      (set! tag (the-as game-save-tag (&+ (the-as pointer tag) (logand -16 (+ (* (-> tag elt-size) (-> tag elt-count)) 31)))))
      )
    )
  (none)
  )

(defbehavior mp-load-world-save mp-manager ()
  "Guest: the host's world arrived: load it as the stock Load Game does (game-save.gc, auto-save
   restore). #t when it is loading."
  (let* ((save (mp-world-save-buffer))
         (n (pc-mp-blob-take (the-as pointer (&-> save type)) (the-as int (+ (-> save type size) #x1e000))))
         )
    ;; the type word came from the host's memory
    (set! (-> save type) game-save)
    (cond
      ((and (> n (the-as int (-> save type size))) (= (-> save version) 4))
       (mp-save-keep-own-settings save)
       (set! (-> *mp-join* foreign?) #t)
       (+! (-> *mp-join* loaded) 1)
       (set! (-> *mp-join* bytes) n)
       (format 0 "[multiplayer] loading the host's world (~D bytes)~%" n)
       (set! (-> *game-info* mode) 'play)
       (initialize! *game-info* 'game save (the-as string #f) (the-as resetter-spec #f))
       (set-master-mode 'game)
       #t
       )
      (else
        (format 0 "[multiplayer] the host's world could not be read (~D bytes, version ~D)~%" n (-> save version))
        #f
        )
      )
    )
  )

(defun mp-in-game? ()
  "#t when our player is in the game, out of the title screen and of a loading screen."
  (and *target*
       (not (= (level-status? *level* 'title #f) 'active))
       (-> *target* next-state)
       (not (= (-> *target* next-state name) 'target-continue))
       (not (= (-> *target* next-state name) 'target-title))
       )
  )

;; MOD multiplayer -- no save while in another player's world (engine/game/game-save.gc). The card
;; operations go through auto-save-command: the pause menu's saves, checkpoints and missions'
;; auto-saves, a new game's first save.
(define-perm *mp-stock-auto-save-command* (function symbol int int process-tree symbol (pointer auto-save))
  auto-save-command
  )

(defun auto-save-command ((arg0 symbol) (arg1 int) (arg2 int) (arg3 process-tree) (arg4 symbol))
  "Stock behavior (multiplayer mod): no save is written while the player plays in another player's
   world, its own save stays as it was; the menu that asked is told it failed. Back at the title
   screen, or loading its own save, the player is in its own world again."
  (when (and (-> *mp-join* foreign?)
             (or (= arg0 'restore) (= (level-status? *level* 'title #f) 'active))
             )
    (set! (-> *mp-join* foreign?) #f)
    )
  (cond
    ((and (-> *mp-join* foreign?)
          (or (= arg0 'save) (= arg0 'save-last) (= arg0 'auto-save) (= arg0 'create-file) (= arg0 'format-card) (= arg0 'unformat-card))
          )
     (+! (-> *mp-join* blocked) 1)
     (format 0 "[multiplayer] no save in another player's world (~A)~%" arg0)
     (if (and arg3 (type? arg3 process))
         (send-event (the-as process arg3) 'notify 'error (mc-status-code no-process))
         )
     (the-as (pointer auto-save) #f)
     )
    (else
      (*mp-stock-auto-save-command* arg0 arg1 arg2 arg3 arg4)
      )
    )
  )

;; ------------------------------------------------------------------------------------------------
;; Co-op mode
;; ------------------------------------------------------------------------------------------------

;; The host picks the game mode (Options > Multiplayer > Game mode). In free roam every player goes
;; where it wants in the shared world. In co-op the players share one place: a guest never
;; simulates NPCs of its own (the host's are shown everywhere it goes), a guest that strays more than
;; MP_COOP_LEASH from the host comes back next to it, everyone follows the host's weather, and a
;; story step (a task node) only closes once every player stands where it closed: the player there
;; waits for the others, who are told where to go.

(defconstant MP_COOP_LEASH (meters 150))
(defconstant MP_COOP_TOGETHER (meters 25))


(defun mp-coop? ()
  "#t in a co-op session."
  (and (mp-online?) (logtest? *mp-world* (mp-world-flag coop)))
  )

(defun mp-everyone-near? ((pos vector) (radius float))
  "#t when every other player stands within `radius` of `pos` (or there is no other player)."
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i)))
      (if (and st (< radius (vector-vector-distance (-> st trans) pos)))
          (return #f)
          )
      )
    )
  #t
  )

(defun mp-coop-hold? ((node game-task-node-info))
  "Co-op: hold the closure of `node` (#t) when it closes on our player's doing while another player
   is away from here; it closes once everyone came (mp-update-coop). Closures from another player
   (shared progress), from loading a world, from a cutscene, or while alone pass."
  (when (and (mp-coop?)
             (not *mp-progress-replaying*)
             (not (-> *mp-coop* closing?))
             (> (mp-player-count) 0)
             *target*
             (mp-in-game?)
             (not (and *scene-player* (-> *scene-player* 0)))
             (not (mp-everyone-near? (-> *target* control trans) MP_COOP_TOGETHER))
             )
    (let ((cs *mp-coop*)
          (index (get-idx-in-task-list node))
          (known? #f)
          )
      (dotimes (i (-> cs pending-count))
        (if (= (-> cs pending i) index)
            (set! known? #t)
            )
        )
      (when (and (not known?) (< (-> cs pending-count) 8))
        (set! (-> cs pending (-> cs pending-count)) index)
        (+! (-> cs pending-count) 1)
        (vector-copy! (-> cs spot) (-> *target* control trans))
        (+! (-> cs held) 1)
        (format 0 "[multiplayer] co-op: task node ~D waits for the other players~%" index)
        ;; the others are told where to come
        (let ((ev (new 'stack 'mp-event)))
          (set! (-> ev kind) (mp-event-kind coop-wait))
          (set! (-> ev to) -1)
          (set! (-> ev iarg 0) index)
          (vector-copy! (-> ev fvec) (-> *target* control trans))
          (pc-mp-send-event ev)
          )
        )
      #t
      )
    )
  )

(defun mp-apply-coop-wait ((ev mp-event))
  "Another player waits for us at a story step (iarg 0 = node, -1 none any more)."
  (let ((cs *mp-coop*))
    (cond
      ((>= (-> ev iarg 0) 0)
       (set! (-> cs wait-from) (-> ev from))
       (vector-copy! (-> cs wait-spot) (-> ev fvec))
       (set-time! (-> cs wait-time))
       )
      ((= (-> cs wait-from) (-> ev from))
       (set! (-> cs wait-from) -1)
       )
      )
    )
  (none)
  )

(defbehavior mp-update-coop mp-manager ()
  "Co-op, every frame: the held story steps close once every player is there; a guest beyond the
   leash comes back next to the host; the host's weather."
  (let ((cs *mp-coop*))
    (cond
      ((not (mp-coop?))
       (set! (-> cs pending-count) 0)
       (set! (-> cs wait-from) -1)
       )
      (else
        ;; held steps: everyone is there, they close (and with shared progress, everywhere)
        (when (and (> (-> cs pending-count) 0) (mp-everyone-near? (-> cs spot) MP_COOP_TOGETHER))
          (set! (-> cs closing?) #t)
          (dotimes (i (-> cs pending-count))
            (let ((node (-> *game-info* sub-task-list (-> cs pending i))))
              (if (not (logtest? (-> node flags) (game-task-node-flag closed)))
                  (open! node 'event)
                  )
              )
            )
          (set! (-> cs closing?) #f)
          (+! (-> cs released) (-> cs pending-count))
          (format 0 "[multiplayer] co-op: everyone is here, ~D task node(s) close~%" (-> cs pending-count))
          (set! (-> cs pending-count) 0)
          (mp-send-event (mp-event-kind coop-wait) -1 -1 0.0)
          )
        ;; the leash
        (when (and (= *mp-mode* (mp-mode client)) (= (-> *mp-join* stage) 4) (mp-in-game?))
          (let ((host (mp-remote-state 0)))
            (cond
              ((or (not host) (< (vector-vector-distance (-> *target* control trans) (-> host trans)) MP_COOP_LEASH))
               (set! (-> cs far-since) 0)
               )
              ((zero? (-> cs far-since))
               (set-time! (-> cs far-since))
               )
              ((time-elapsed? (-> cs far-since) (seconds 3))
               (set! (-> cs far-since) 0)
               (+! (-> cs leashed) 1)
               (set! *mp-request-teleport* 0)
               (mp-show-message "Co-op: back next to the host")
               )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-draw-coop-wait ()
  "Co-op: the step another player waits for us at, or ours waiting for the others."
  (cond
    ((> (-> *mp-coop* pending-count) 0)
     (mp-draw-prompt (text-id progress-mp-coop-wait))
     )
    ((and (>= (-> *mp-coop* wait-from) 0) *target*)
     (string<-charp *mp-temp-string* (-> *mp-players* state (-> *mp-coop* wait-from) name))
     (format
       (clear *mp-status*)
       "~S waits for you here (~,,0m m away)"
       *mp-temp-string*
       (vector-vector-distance (-> *target* control trans) (-> *mp-coop* wait-spot))
       )
     (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
       (mp-draw-text buf *mp-status* 256 300 0.5)
       )
     )
    )
  (none)
  )


(define-extern mp-replay-effect (function mp-event none))
(define-extern mp-apply-elevator (function mp-event none))
(define-extern mp-apply-scene (function mp-event none :behavior mp-manager))
(define-extern mp-apply-art-level (function mp-event none))
(define-extern mp-apply-skel-def (function mp-event none))
(define-extern mp-test-own-flush (function none)) ;; multiplayer-test.gc
(define-extern mp-replay-projectile (function mp-event none))
(define *mp-prompt-replica* -1) ;; replica table index of the NPC vehicle the player stands next to

;; Lives in *pc-pool*, so it is frozen while the game is paused. Created by the hook when the mod
;; is enabled, killed when it is disabled.
(deftype mp-manager (process)
  ((puppets     handle MP_MAX_PLAYERS)
   (self-puppet handle)     ;; the local player's own model while riding as a passenger
   (seat        handle)     ;; mp-seat ridden
   (ride-want   int32)      ;; driver to ride with once the player can, -1
   (steal-want  int32)      ;; driver to rob once the player can, -1
   (steal-veh   handle)     ;; our vehicle that was stolen, removed once we got out
   (steal-time  time-frame)
   (tri-slot    int32)      ;; vehicle under the triangle press, -1
   (tri-time    time-frame)
   (tp-slot     int32)      ;; player to reach once a continue point is loaded, -1
   (tp-time     time-frame)
   (world-time  time-frame)
   (last-hit    time-frame)
   (spawn-retry time-frame) ;; last failed puppet spawn (process pool full)
   (event       mp-event :inline)
   )
  )

(defbehavior mp-manager-update-puppets mp-manager ()
  "One puppet per remote player, with the model of its current character."
  (dotimes (i MP_MAX_PLAYERS)
    (let ((st (mp-remote-state i))
          (proc (the-as mp-puppet (handle->process (-> self puppets i))))
          )
      (when (and proc
                 (or (not st)
                     (!= (-> proc daxter?) (logtest? (-> st flags) (mp-flag indax)))
                     (!= (-> proc skel-group) (mp-character-skel (-> proc daxter?) (mp-state-outfit st)))
                     )
                 )
        (deactivate proc)
        (set! proc #f)
        (set! (-> self puppets i) (the-as handle #f))
        )
      (when (and st
                 (not proc)
                 (mp-character-skel (logtest? (-> st flags) (mp-flag indax)) (mp-state-outfit st))
                 (time-elapsed? (-> self spawn-retry) (seconds 1))
                 )
        (let ((new-proc (process-spawn
                          mp-puppet
                          i
                          (logtest? (-> st flags) (mp-flag indax))
                          #f
                          :name "mp-puppet"
                          :to self
                          :stack-size #x20000
                          )
                        )
              )
          (if new-proc
              (set! (-> self puppets i) (ppointer->handle new-proc))
              (set-time! (-> self spawn-retry))
              )
          )
        )
      )
    )
  ;; the passenger sees its own model in the seat (its real one is hidden while riding)
  (let ((proc (handle->process (-> self self-puppet))))
    (cond
      ((and (>= *mp-ride-slot* 0) (not proc) (mp-character-skel (= (-> *mp-config* character) 1) (mp-local-outfit)))
       (let ((new-proc (process-spawn
                         mp-puppet
                         *mp-local-slot*
                         (= (-> *mp-config* character) 1)
                         #t
                         :name "mp-puppet-self"
                         :to self
                         :stack-size #x20000
                         )
                       )
             )
         (if new-proc
             (set! (-> self self-puppet) (ppointer->handle new-proc))
             )
         )
       )
      ((and (< *mp-ride-slot* 0) proc)
       (deactivate proc)
       (set! (-> self self-puppet) (the-as handle #f))
       )
      )
    )
  (none)
  )

(defbehavior mp-move-target-to mp-manager ((pos vector))
  "Put the player next to `pos` (same loaded level)."
  (let ((dst (new 'stack-no-clear 'vector)))
    (vector-copy! dst pos)
    (+! (-> dst x) (meters 1.5))
    (+! (-> dst y) (meters 0.5))
    (move-to-point! (-> *target* control) dst)
    (vector-reset! (-> *target* control transv))
    )
  (none)
  )

(defbehavior mp-teleport-to-player mp-manager ((slot int))
  "Go to player `slot`: directly when its level is loaded here, else through its continue point,
   then to the player once that level is in."
  (let ((st (mp-remote-state slot)))
    (cond
      ((not st)
       (mp-show-message "This player is not connected")
       )
      ((focus-test? *target* pilot)
       (mp-show-message "Get out of your vehicle first")
       )
      ((mp-level-active? (-> st level))
       (mp-move-target-to (-> st trans))
       )
      (else
        (string<-charp *mp-temp-string* (-> st cont))
        (let ((cp (get-continue-by-name *game-info* *mp-temp-string*)))
          (cond
            (cp
              (send-event *target* 'continue cp)
              (set! (-> self tp-slot) slot)
              (set-time! (-> self tp-time))
              )
            (else
              (mp-show-message "Cannot reach this player")
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior mp-on-stolen mp-manager ()
  "Another player took our vehicle: get out; the vehicle is removed once we are out."
  (when (and (focus-test? *target* pilot) (nonzero? (-> *target* pilot)))
    (set! (-> self steal-veh) (-> *target* pilot vehicle))
    (set-time! (-> self steal-time))
    (send-event *target* 'end-mode 'pilot)
    (mp-show-message "Your vehicle was stolen!")
    )
  (none)
  )

;; Hits taken from other players and the reaction seen after each, for the test log.
(deftype mp-hit-stats (structure)
  ((taken   int32)
   (reacted int32)          ;; hits followed by the stock hit reaction state (target-hit)
   (watch?  symbol)         ;; the last hit's reaction is being watched
   (seen?   symbol)         ;; ... and was seen
   (pushed  float)          ;; how far the last hit pushed the player
   (from    vector :inline) ;; where the player stood when hit
   (time    time-frame)
   )
  )

(define *mp-hit-stats* (new 'global 'mp-hit-stats))
(set! (-> *mp-hit-stats* watch?) #f)

(defun mp-watch-hit-reaction ()
  "For 1.5 s after a hit taken from another player: note whether the player went through the stock
   hit reaction (target-hit) and how far it was pushed."
  (let ((hs *mp-hit-stats*))
    (when (and (-> hs watch?) *target*)
      (set! (-> hs pushed) (fmax (-> hs pushed) (vector-vector-xz-distance (-> *target* control trans) (-> hs from))))
      (when (and (= (mp-target-state-name) 'target-hit) (not (-> hs seen?)))
        (set! (-> hs seen?) #t)
        (+! (-> hs reacted) 1)
        )
      (if (time-elapsed? (-> hs time) (seconds 1.5))
          (set! (-> hs watch?) #f)
          )
      )
    )
  (none)
  )

(defbehavior mp-take-hit mp-manager ((from vector) (damage float))
  "Take a hit dealt on another machine: the damage and the stock hit reaction, pushed away from
   `from` (backwards when #f). At most one every half second. The attack always carries a vector:
   without one, target-hit pushes away from the sender's root, and the manager has none."
  (when (and (time-elapsed? (-> self last-hit) (seconds 0.5))
             (not *mp-invulnerable*)
             (not (focus-test? *target* dead grabbed))
             )
    (set-time! (-> self last-hit))
    (let ((push (new 'stack-no-clear 'vector)))
      (if from
          (vector-! push (-> *target* control trans) from)
          (vector-negate! push (vector-z-quaternion! push (-> *target* control quat)))
          )
      (set! (-> push y) 0.0)
      (if (< (vector-length push) 1.0)
          (vector-z-quaternion! push (-> *target* control quat))
          )
      (vector-xz-normalize! push (meters 3))
      (set! (-> push y) (meters 1))
      (send-event
        *target*
        'attack
        #f
        (static-attack-info
          :mask (vehicle-impulse-factor)
          ((id (new-attack-id))
           (mode 'generic)
           (vector push)
           (shove-back (meters 3))
           (shove-up (meters 1))
           (damage damage)
           (vehicle-damage-factor 1.0)
           (vehicle-impulse-factor 1.0)
           )
          )
        )
      )
    ;; the reaction is watched for the test log (mp-watch-hit-reaction)
    (let ((hs *mp-hit-stats*))
      (+! (-> hs taken) 1)
      (set! (-> hs watch?) #t)
      (set! (-> hs seen?) #f)
      (set! (-> hs pushed) 0.0)
      (vector-copy! (-> hs from) (-> *target* control trans))
      (set-time! (-> hs time))
      )
    )
  (none)
  )

;; Objects that move on a cycle (platforms, wheels, lights...) take their phase from their
;; process's clock (sync-info, engine/util/sync-info.gc), and every machine's clocks started at its
;; own boot. The host sends its clocks with the world settings; a guest shifts the phase of every
;; cycle by the difference (multiplayer-world.gc wraps the sync-info methods), minus 100 ms so the
;; cycles match the host's state as its copies are drawn. The clocks themselves are left alone:
;; every timer of the game keeps its meaning.
(define *mp-synced-clocks* (new 'static 'boxed-array :type int32 1 2 6 7 8 9 10 11))

(deftype mp-clock-sync (structure)
  ((known? symbol)    ;; the host's clocks arrived
   (shift  int32 22)  ;; per *display* clock: host frame counter - ours - 100 ms
   )
  )

(define *mp-clock-sync* (new 'global 'mp-clock-sync))
(set! (-> *mp-clock-sync* known?) #f)

(defun mp-send-world ()
  "Host: server settings, time of day and game clocks to everyone."
  (let ((ev (new 'stack 'mp-event)))
    (set! (-> ev kind) (mp-event-kind world))
    (set! (-> ev to) -1)
    (set! (-> ev iarg 0) (the-as int *mp-world*))
    (set! (-> ev fvec x) (-> *time-of-day-context* time))
    ;; the weather: clouds, fog, and the special weather (storms)
    (set! (-> ev fvec y) (-> *mood-control* current-interp cloud))
    (set! (-> ev fvec z) (-> *mood-control* current-interp fog))
    (set! (-> ev fvec w) (-> *mood-control* current-special-interp))
    (let ((clocks (the-as (pointer int32) (-> ev text))))
      (dotimes (i (-> *mp-synced-clocks* length))
        (set! (-> clocks i) (the-as int (-> *display* clock (-> *mp-synced-clocks* i) frame-counter)))
        )
      )
    (pc-mp-send-event ev)
    )
  (none)
  )

(defun mp-apply-clocks ((ev mp-event))
  "Guest: the shift between the host's clocks (in `ev`) and ours, drawn 100 ms behind."
  (let ((clocks (the-as (pointer int32) (-> ev text))))
    (dotimes (i (-> *mp-synced-clocks* length))
      (let* ((index (-> *mp-synced-clocks* i))
             ;; 32-bit frame counters: the difference is taken modulo 2^32
             (diff (- (logand (-> clocks i) #xffffffff)
                      (logand (-> *display* clock index frame-counter) #xffffffff)
                      )
                   )
             )
        (cond
          ((>= diff #x80000000) (set! diff (- diff #x100000000)))
          ((< diff (- #x80000000)) (set! diff (+ diff #x100000000)))
          )
        (set! (-> *mp-clock-sync* shift index) (+ diff (- (seconds 0.1))))
        )
      )
    )
  (set! (-> *mp-clock-sync* known?) #t)
  (none)
  )

(defbehavior mp-apply-world mp-manager ((ev mp-event))
  "Settings, time of day and game clocks from the host."
  (when (and (= *mp-mode* (mp-mode client)) (zero? (-> ev from)))
    (set! *mp-world* (the-as mp-world-flag (-> ev iarg 0)))
    (mp-apply-clocks ev)
    ;; the host's weather, in co-op or when following its time of day: ours stops changing at random
    ;; (mood-control override) and takes the host's clouds, fog and special weather
    (cond
      ((logtest? *mp-world* (mp-world-flag coop sync-time))
       (set! (-> *mood-control* overide-weather-flag) #t)
       (set! (-> *mood-control* overide cloud) (-> ev fvec y))
       (set! (-> *mood-control* overide fog) (-> ev fvec z))
       (set! (-> *mood-control* target-special-interp) (-> ev fvec w))
       )
      (else
        (set! (-> *mood-control* overide-weather-flag) #f)
        )
      )
    (when (and (logtest? *mp-world* (mp-world-flag sync-time)) *time-of-day*)
      (let* ((host-time (-> ev fvec x))
             (diff (fabs (- host-time (-> *time-of-day-context* time))))
             )
        ;; 15 minutes of drift is tolerated (and the 24h -> 0h wrap is not a drift)
        (when (and (< 0.25 diff) (< diff 23.75))
          (let ((hour (the int host-time)))
            (send-event
              (ppointer->process *time-of-day*)
              'change
              'hour
              hour
              (the int (* 60.0 (- host-time (the float hour))))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defbehavior mp-manager-handle-events mp-manager ()
  "Apply the events received since last frame."
  (let ((ev (-> self event)))
    (while (pc-mp-pop-event ev)
      (case (-> ev kind)
        (((mp-event-kind kill-entity))
         (mp-apply-remote-kill (the-as uint (-> ev iarg 0)))
         )
        (((mp-event-kind progress))
         (mp-apply-progress ev)
         )
        (((mp-event-kind world-request))
         ;; a host at the title screen or loading has no world to give yet: the guest asks again
         ;; every 10 s
         (if (and (= *mp-mode* (mp-mode host)) (mp-in-game?))
             (mp-send-world-save (-> ev from))
             )
         )
        (((mp-event-kind coop-wait))
         (mp-apply-coop-wait ev)
         )
        (((mp-event-kind elevator))
         (mp-apply-elevator ev)
         )
        (((mp-event-kind scene))
         (mp-apply-scene ev)
         )
        (((mp-event-kind art-level))
         (mp-apply-art-level ev)
         )
        (((mp-event-kind skel-def))
         (mp-apply-skel-def ev)
         )
        (((mp-event-kind steal))
         (if *target*
             (mp-on-stolen)
             )
         )
        (((mp-event-kind hit))
         (if *target*
             (mp-take-hit (the-as vector #f) (-> ev fvec x))
             )
         )
        (((mp-event-kind actor-hit))
         (mp-on-actor-hit ev)
         )
        (((mp-event-kind vehicle-taken))
         (mp-on-vehicle-taken ev)
         )
        (((mp-event-kind effect))
         (mp-replay-effect ev)
         )
        (((mp-event-kind projectile))
         (mp-replay-projectile ev)
         )
        (((mp-event-kind pvp))
         (if (and *target* (logtest? *mp-world* (mp-world-flag pvp)))
             (mp-take-hit (-> ev fvec) (-> ev fvec w))
             )
         )
        (((mp-event-kind teleport))
         (when (and *target* (!= (-> ev iarg 0) *mp-local-slot*))
           (mp-show-message "The host teleports you")
           (mp-teleport-to-player (-> ev iarg 0))
           )
         )
        (((mp-event-kind world))
         (mp-apply-world ev)
         )
        )
      )
    )
  (none)
  )

(defbehavior mp-update-character mp-manager ()
  "Play as the chosen character: Daxter is the stock playable-Daxter mode (indax), entered and
   left from the idle stance only, and never while riding or driving."
  (let ((daxter? (= (-> *mp-config* character) 1))
        (state (mp-target-state-name))
        )
    (cond
      ((and daxter?
            (< *mp-ride-slot* 0)
            (< (-> self ride-want) 0)
            (< (-> self steal-want) 0)
            (= state 'target-stance)
            (not (focus-test? *target* indax pilot dead grabbed))
            )
       (send-event *target* 'change-mode 'indax #f 'stance)
       )
      ((and (not daxter?) (focus-test? *target* indax) (= state 'target-indax-stance))
       (send-event *target* 'end-mode 'indax)
       )
      )
    )
  (none)
  )

(defbehavior mp-update-invulnerability mp-manager ()
  "Keep the invincibility flag on while the cheat is on (dark Jak clears it when he ends)."
  (if (and *mp-invulnerable* (not (mp-cheats-allowed?)))
      (set! *mp-invulnerable* #f)
      )
  (cond
    (*mp-invulnerable*
      ;; tf4 is what the stock invulnerability secret relies on: no damage, but falls and lava
      ;; still kill, so the player cannot get stuck
      (logior! (-> *target* target-flags) (target-flags tf4))
      (set! *mp-invulnerable-applied* #t)
      )
    (*mp-invulnerable-applied*
      (logclear! (-> *target* target-flags) (target-flags tf4))
      (set! *mp-invulnerable-applied* #f)
      )
    )
  (none)
  )

(defbehavior mp-stop-riding mp-manager ()
  "Get off a remote player's vehicle."
  (if (= (mp-target-state-name) 'target-grab-ride)
      (send-event *target* 'end-mode 'grab)
      )
  (send-event *target* 'draw #t)
  (let ((seat (handle->process (-> self seat))))
    (if seat
        (deactivate seat)
        )
    )
  (set! (-> self seat) (the-as handle #f))
  (set! *mp-ride-slot* -1)
  (none)
  )

(defun mp-seat-free? ((driver int))
  "#t when the vehicle of `driver` has a passenger seat no other player uses."
  (let ((st (mp-remote-state driver)))
    (when (and st (< 1 (-> st seat-count)))
      (dotimes (i MP_MAX_PLAYERS)
        (let ((other (mp-remote-state i)))
          (if (and other (logtest? (-> other flags) (mp-flag riding)) (= (-> other ride-slot) driver))
              (return #f)
              )
          )
        )
      (return #t)
      )
    )
  #f
  )

(defbehavior mp-update-ride mp-manager ()
  "Passenger mode: sit next to a remote driver until they stop, or until triangle is pressed."
  (let ((state (mp-target-state-name)))
    (cond
      ((>= (-> self ride-want) 0)
       (let ((st (mp-remote-state (-> self ride-want))))
         (cond
           ((or (not st) (not (logtest? (-> st flags) (mp-flag driving))))
            (set! (-> self ride-want) -1)
            )
           ((focus-test? *target* indax)
            ;; Daxter's mode has its own grab states: back to Jak for the ride
            (send-event *target* 'end-mode 'indax)
            )
           ;; on the ground, standing or crouched (next to a vehicle the player may crouch)
           ((and (not (focus-test? *target* in-air hit grabbed pilot dead)) (!= state 'target-grab-ride))
            (let ((seat (process-spawn mp-seat (-> self ride-want) :name "mp-seat" :to self)))
              (when seat
                (set! (-> self seat) (ppointer->handle seat))
                (set! *mp-ride-slot* (-> self ride-want))
                (send-event *target* 'change-mode 'grab-ride #t :from (ppointer->process seat))
                (send-event *target* 'draw #f)
                )
              )
            (set! (-> self ride-want) -1)
            )
           )
         )
       )
      ((>= *mp-ride-slot* 0)
       (let ((st (mp-remote-state *mp-ride-slot*)))
         (if (or (not st)
                 (not (logtest? (-> st flags) (mp-flag driving)))
                 (cpad-pressed? 0 triangle)
                 (!= state 'target-grab-ride)
                 )
             (mp-stop-riding)
             )
         )
       )
      )
    )
  (none)
  )

(defbehavior mp-get-vehicle-at mp-manager ((vtype int) (pos vector) (quat quaternion))
  "Stand at `pos` facing `quat` and get a new vehicle of type `vtype` there. #t when the player is
   now getting in. Only the player vehicles: city bikes and cars (0-6, spawner in CWI) and Spargus
   buggies (12-19, WASALL); the others (catapult, marauders...) have art in levels without the
   vehicle spawner. Their art being loaded means the code that spawns them is loaded too."
  (when (and (or (and (>= vtype 0) (<= vtype 6)) (and (>= vtype 12) (<= vtype 19))) (mp-vehicle-skel vtype))
    (move-to-point! (-> *target* control) pos)
    (quaternion-copy! (-> *target* control quat) quat)
    (quaternion-copy! (-> *target* control quat-for-control) quat)
    ;; #f vehicle: the target spawns one of this type where it stands (target-handler.gc)
    (send-event *target* 'change-mode 'pilot #f vtype #t)
    (if (= (mp-target-state-name) 'target-pilot-start)
        (return #t)
        )
    )
  (mp-show-message "This vehicle cannot be taken here")
  #f
  )

(defbehavior mp-steal-now mp-manager ((slot int))
  "Take the vehicle of player `slot`: it leaves it, and we get the same vehicle in its place."
  (let ((st (mp-remote-state slot)))
    ;; the driver only gets out once we really got a vehicle
    (if (and st
             (logtest? (-> st flags) (mp-flag driving))
             (mp-get-vehicle-at (-> st veh-type) (-> st veh-trans) (-> st veh-quat))
             )
        (mp-send-event (mp-event-kind steal) slot 0 0.0)
        )
    )
  (none)
  )

(defbehavior mp-update-steal mp-manager ()
  "Steal requests that wait for Daxter to turn back into Jak, and removal of our stolen vehicle."
  (when (>= (-> self steal-want) 0)
    (cond
      ((focus-test? *target* indax)
       (send-event *target* 'end-mode 'indax)
       )
      ((= (mp-target-state-name) 'target-stance)
       (mp-steal-now (-> self steal-want))
       (set! (-> self steal-want) -1)
       )
      )
    )
  ;; our vehicle was taken: once we are out, it disappears (the thief drives its own copy)
  (let ((veh (handle->process (-> self steal-veh))))
    (when (and veh (not (focus-test? *target* pilot)) (time-elapsed? (-> self steal-time) (seconds 0.5)))
      (send-event veh 'go-die)
      (set! (-> self steal-veh) (the-as handle #f))
      )
    )
  (none)
  )

(defbehavior mp-update-vehicle-interaction mp-manager ()
  "Next to a remote player's vehicle, on foot: press triangle to steal it, hold it to ride along."
  (set! *mp-prompt-slot* -1)
  (when (and (< *mp-ride-slot* 0)
             (< (-> self ride-want) 0)
             (< (-> self steal-want) 0)
             (not (focus-test? *target* pilot grabbed dead))
             )
    (let ((best -1)
          (best-dist (meters 5))
          )
      (dotimes (i MP_MAX_PLAYERS)
        (let ((st (mp-remote-state i)))
          ;; distance to the vehicle where its player state puts it (what is drawn here), whatever
          ;; the level names of the two players' places
          (when (and st
                     (logtest? (-> st flags) (mp-flag driving))
                     (>= (-> st veh-type) 0)
                     )
            (let ((d (vector-vector-distance (-> *target* control trans) (-> st veh-trans))))
              (when (< d best-dist)
                (set! best i)
                (set! best-dist d)
                )
              )
            )
          )
        )
      (set! *mp-prompt-slot* best)
      (set! *mp-prompt-replica* (if (< best 0)
                                    (mp-nearest-replica-vehicle (-> *target* control trans))
                                    -1
                                    )
            )
      (cond
        ((and (< best 0) (>= *mp-prompt-replica* 0))
         ;; an NPC vehicle another player simulates: press triangle to take it
         (set! (-> self tri-slot) -1)
         (when (cpad-pressed? 0 triangle)
           (if (focus-test? *target* indax)
               (send-event *target* 'end-mode 'indax)
               (mp-take-replica-vehicle *mp-prompt-replica*)
               )
           )
         )
        ((< best 0)
         (set! (-> self tri-slot) -1)
         )
        ((cpad-pressed? 0 triangle)
         (set! (-> self tri-slot) best)
         (set-time! (-> self tri-time))
         )
        ((!= (-> self tri-slot) best)
         )
        ((and (cpad-hold? 0 triangle) (time-elapsed? (-> self tri-time) (seconds 0.5)))
         (set! (-> self tri-slot) -1)
         (if (mp-seat-free? best)
             (set! (-> self ride-want) best)
             (mp-show-message "No free seat in this vehicle")
             )
         )
        ((not (cpad-hold? 0 triangle))
         (set! (-> self tri-slot) -1)
         (set! (-> self steal-want) best)
         )
        )
      )
    )
  (none)
  )

(defbehavior mp-update-join mp-manager ()
  "Guest: ask the host for its world once connected (again after 10 s without it), load it, then go
   next to the host."
  (let ((js *mp-join*))
    (cond
      ((!= *mp-mode* (mp-mode client))
       (set! (-> js stage) 0)
       )
      ((and (= (-> js stage) 0) (mp-remote-state 0))
       (mp-send-event (mp-event-kind world-request) 0 0 0.0)
       (set! (-> js stage) 1)
       (set-time! (-> js since))
       )
      ((= (-> js stage) 1)
       (cond
         ((> (pc-mp-blob-ready) 0)
          (if (mp-load-world-save)
              (set! (-> js stage) 2)
              (set! (-> js stage) 0)
              )
          (set-time! (-> js since))
          )
         ((time-elapsed? (-> js since) (seconds 10))
          (set! (-> js stage) 0)
          )
         )
       )
      ;; the loading screen is over: next to the host
      ((and (= (-> js stage) 2) (time-elapsed? (-> js since) (seconds 1)) (mp-in-game?))
       (set! *mp-request-teleport* 0)
       (set! (-> js stage) 3)
       (set-time! (-> js since))
       )
      ;; next to the host once the teleport is over (through the host's continue point when its
      ;; level is not active here yet, mp-update-pending-teleport), or after 30 s anyway
      ((and (= (-> js stage) 3)
            (time-elapsed? (-> js since) (seconds 1))
            (or (and (< *mp-request-teleport* 0) (< (-> self tp-slot) 0) (mp-in-game?))
                (time-elapsed? (-> js since) (seconds 30))
                )
            )
       (set! (-> js stage) 4)
       (format 0 "[multiplayer] in the host's world~%")
       )
      )
    )
  (none)
  )

(defbehavior mp-update-pending-teleport mp-manager ()
  "Finish a teleport to a player once the continue point loaded its level."
  (when (>= *mp-request-teleport* 0)
    (mp-teleport-to-player *mp-request-teleport*)
    (set! *mp-request-teleport* -1)
    )
  (when (>= (-> self tp-slot) 0)
    (let ((st (mp-remote-state (-> self tp-slot))))
      (cond
        ((or (not st) (time-elapsed? (-> self tp-time) (seconds 30)))
         (set! (-> self tp-slot) -1)
         )
        ((and (not (focus-test? *target* teleporting)) (mp-level-active? (-> st level)))
         (mp-move-target-to (-> st trans))
         (set! (-> self tp-slot) -1)
         )
        )
      )
    )
  (none)
  )

(defbehavior mp-manager-update mp-manager ()
  "Everything the mod does in game, once per (unpaused) frame."
  (when (mp-online?)
    (mp-manager-handle-events)
    (when (and (= *mp-mode* (mp-mode host)) (time-elapsed? (-> self world-time) (seconds 2)))
      (set-time! (-> self world-time))
      (mp-send-world)
      )
    (mp-update-join)
    (mp-update-coop)
    )
  (mp-manager-update-puppets)
  (cond
    (*target*
      (mp-update-character)
      (mp-update-invulnerability)
      (mp-update-ride)
      (mp-update-steal)
      (mp-update-vehicle-interaction)
      (mp-update-pending-teleport)
      )
    (else
      (set! *mp-ride-slot* -1)
      (set! *mp-prompt-slot* -1)
      (set! *mp-prompt-replica* -1)
      )
    )
  (mp-world-update)
  (mp-watch-hit-reaction)
  (mp-test-own-flush)
  (none)
  )

(defstate mp-manager-active (mp-manager)
  :exit (behavior ()
    (if (and *target* (>= *mp-ride-slot* 0))
        (mp-stop-riding)
        )
    (if (and *target* *mp-invulnerable-applied*)
        (logclear! (-> *target* target-flags) (target-flags tf4))
        )
    (set! *mp-invulnerable-applied* #f)
    (set! *mp-ride-slot* -1)
    (set! *mp-prompt-slot* -1)
    (mp-world-client-stop)
    )
  :code (behavior ()
    (loop
      (mp-manager-update)
      (suspend)
      )
    )
  )

(defbehavior mp-manager-init-by-other mp-manager ()
  "Start with no puppet and nothing pending."
  (dotimes (i MP_MAX_PLAYERS)
    (set! (-> self puppets i) (the-as handle #f))
    )
  (set! (-> self self-puppet) (the-as handle #f))
  (set! (-> self seat) (the-as handle #f))
  (set! (-> self steal-veh) (the-as handle #f))
  (set! (-> self ride-want) -1)
  (set! (-> self steal-want) -1)
  (set! (-> self tri-slot) -1)
  (set! (-> self tp-slot) -1)
  (go mp-manager-active)
  )

;; ------------------------------------------------------------------------------------------------
;; Overlay: names and health bars over the players, prompts, notifications
;; ------------------------------------------------------------------------------------------------

(defun mp-draw-text ((buf dma-buffer) (str string) (x int) (y int) (scale float))
  "Draw `str` centered at x, y (512x416 screen). Returns its width."
  (pc-encode-utf8-string str *pc-encoded-temp-string*)
  (let ((ctx (new 'stack 'font-context *font-default-matrix* x y 0.0 (font-color default) (font-flags shadow kerning middle large))))
    (set! (-> ctx scale) scale)
    (let ((width (the int (-> (get-string-length *pc-encoded-temp-string* ctx) length))))
      (draw-string-adv *pc-encoded-temp-string* buf ctx)
      width
      )
    )
  )

;; Name markers drawn, for the test log (log-look): the color is shown there, not on the model.
(deftype mp-marker-stats (structure)
  ((drawn int32) ;; color squares drawn before a name
   (color rgba)  ;; color of the last one
   )
  )

(define *mp-marker-stats* (new 'global 'mp-marker-stats))

(defun mp-draw-nameplate ((buf dma-buffer) (slot int))
  "Name and health bar over a remote player standing in a level loaded here."
  (let ((st (-> *mp-players* state slot))
        (pos (new 'stack-no-clear 'vector))
        (scr (new 'stack-no-clear 'vector))
        )
    (vector-copy! pos (-> st trans))
    (+! (-> pos y) (if (logtest? (-> st flags) (mp-flag indax))
                       (meters 1.6)
                       (meters 2.6)
                       )
        )
    (when (and (< (vector-vector-distance pos (math-camera-pos)) (meters 80)) (transform-point-vector! scr pos))
      (let ((x (the int (+ -1792.0 (-> scr x))))
            (y (the int (+ -1840.0 (-> scr y))))
            )
        (when (and (< 24 x) (< x 488) (< 24 y) (< y 400))
          ;; health bar: green, yellow under half, red under a quarter
          (let ((ratio (fmax 0.0 (fmin 1.0 (/ (-> st health) (fmax 1.0 (-> st health-max)))))))
            (draw-sprite2d-xy buf (+ x -21) (+ y -1) 42 6 (new 'static 'rgba :a #x80) #x3fffff)
            (draw-sprite2d-xy
              buf
              (+ x -20)
              y
              (the int (* 40.0 ratio))
              4
              (cond
                ((< ratio 0.26) (new 'static 'rgba :r #x80 :g #x18 :b #x10 :a #x80))
                ((< ratio 0.51) (new 'static 'rgba :r #x80 :g #x70 :b #x10 :a #x80))
                (else (new 'static 'rgba :r #x20 :g #x80 :b #x20 :a #x80))
                )
              #x3fffff
              )
            )
          ;; name, with the player's color as a small square in front of it
          (string<-charp *mp-temp-string* (-> st name))
          (let ((width (mp-draw-text buf *mp-temp-string* x (+ y -14) 0.45)))
            (draw-sprite2d-xy buf (- x (+ (/ width 2) 10)) (+ y -12) 7 7 (new 'static 'rgba :a #x80) #x3fffff)
            (draw-sprite2d-xy buf (- x (+ (/ width 2) 9)) (+ y -11) 5 5 (mp-color-rgba (-> st color)) #x3fffff)
            (+! (-> *mp-marker-stats* drawn) 1)
            (set! (-> *mp-marker-stats* color) (mp-color-rgba (-> st color)))
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-draw-prompt ((id text-id))
  "Prompt `id` (a text with its <PAD_...> button icon), where and as the game draws its own
   vehicle prompt (vehicle-method-144, levels/city/traffic/vehicle/vehicle-util.gc)."
  (let ((ctx (new 'stack 'font-context *font-default-matrix* 22 320 0.0 (font-color default) (font-flags shadow kerning)))
        (lang (-> *setting-control* user-default language))
        )
    (set-width! ctx 350)
    (set-height! ctx 80)
    (set! (-> ctx scale) (if (or (= lang (language-enum korean)) (= lang (language-enum russian)))
                             0.9
                             0.7
                             )
          )
    (set! (-> ctx flags) (font-flags shadow kerning large))
    (print-game-text (lookup-text! *common-text* id #f) ctx #f 44 (bucket-id hud-draw-hud-alpha))
    )
  (none)
  )

(defun mp-draw-overlay ()
  "Draw the multiplayer overlay. Runs from the hook, after the frame's draw."
  (when (and *target* (not (paused?)) (not (movie?)))
    (with-dma-buffer-add-bucket ((buf (-> (current-frame) global-buf)) (bucket-id debug-no-zbuf1))
      (dma-buffer-add-gs-set-flusha buf
                                    (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                    (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))
                                    )
      (dotimes (i MP_MAX_PLAYERS)
        (let ((st (mp-remote-state i)))
          (if (and st
                   (not (logtest? (-> st flags) (mp-flag hidden)))
                   (mp-level-active? (-> st level))
                   )
              (mp-draw-nameplate buf i)
              )
          )
        )
      (when (< (- (mp-now) (-> *mp-globals* message-time)) (seconds 4))
        (mp-draw-text buf *mp-message* 256 360 0.5)
        )
      )
    ;; prompts with their button icon, as the game draws its own (outside the bucket above: they
    ;; fill their own DMA)
    (cond
      ((>= *mp-prompt-slot* 0)
       (mp-draw-prompt (text-id progress-mp-prompt-steal))
       )
      ((>= *mp-prompt-replica* 0)
       (mp-draw-prompt (text-id progress-mp-prompt-take))
       )
      ((>= *mp-ride-slot* 0)
       (mp-draw-prompt (text-id progress-mp-prompt-get-off))
       )
      ((and (> (-> *mp-join* stage) 0) (< (-> *mp-join* stage) 3))
       (mp-draw-prompt (text-id progress-mp-joining))
       )
      (else
        (mp-draw-coop-wait)
        )
      )
    )
  (none)
  )

;; ------------------------------------------------------------------------------------------------
;; Per-frame hook
;; ------------------------------------------------------------------------------------------------

(defun mp-shutdown ()
  "Mod disabled: leave the session and remove the manager (and with it every puppet)."
  (when (!= *mp-mode* (mp-mode offline))
    (pc-mp-leave)
    (set! *mp-mode* (mp-mode offline))
    )
  (let ((proc (handle->process (-> *mp-globals* manager))))
    (if proc
        (deactivate proc)
        )
    )
  (set! (-> *mp-globals* manager) (the-as handle #f))
  (dotimes (i MP_MAX_PLAYERS)
    (set! (-> *mp-players* valid i) #f)
    )
  (none)
  )

;; Automated tests (multiplayer-test.gc), inert unless MP_TEST_SCRIPT is set.
(define-extern pc-mp-test-active? (function symbol))
(define-extern mp-test-update (function none))

(define-extern mp-keep-seen-npcs (function none)) ;; multiplayer-world.gc

(defun mp-frame-hook ()
  "Called every frame from main.gc through *mods-menu-hook*, even while paused: runs the Mods menu,
   then, when the mod is enabled, the network and the overlay. Network traffic must keep flowing
   while paused, or the other players would time out."
  (mods-menu-update)
  (if (pc-mp-test-active?)
      (mp-test-update)
      )
  (cond
    ((mp-enabled?)
     (let ((was *mp-mode*))
       (mp-build-local-state)
       (set! *mp-mode* (the-as mp-mode (pc-mp-update *mp-local*)))
       (set! *mp-local-slot* (pc-mp-local-slot))
       ;; the session ended on its own (host gone, kicked...): say why
       (when (and (!= was (mp-mode offline)) (= *mp-mode* (mp-mode offline)))
         (pc-mp-message *mp-status*)
         (mp-show-message *mp-status*)
         )
       )
     (mp-read-remote-states)
     ;; when the process pool is full, retry once a second instead of every frame
     (when (and (not (handle->process (-> *mp-globals* manager)))
                (>= (- (mp-now) (-> *mp-globals* manager-retry)) (seconds 1))
                )
       (let ((proc (process-spawn mp-manager :name "mp-manager" :to *pc-pool*)))
         (if proc
             (set! (-> *mp-globals* manager) (ppointer->handle proc))
             (set! (-> *mp-globals* manager-retry) (mp-now))
             )
         )
       )
     (mp-draw-overlay)
     (mp-keep-seen-npcs)
     )
    ((or (!= *mp-mode* (mp-mode offline)) (handle->process (-> *mp-globals* manager)))
     (mp-shutdown)
     )
    )
  (none)
  )

;; MOD multiplayer -- chain the per-frame hook: mods-menu.gc installed mods-menu-update, which
;; mp-frame-hook calls first.
(set! *mods-menu-hook* mp-frame-hook)
